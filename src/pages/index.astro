---
import BaseLayout from '../layouts/BaseLayout.astro';
import LastUpdated from '../components/LastUpdated.astro';
import { fetchAllArticles } from '../lib/airtable';
import coursesData from '../data/courses.json';
import surveyCountData from '../data/survey-count.json';
import { buildIdentityGraph, getFoundationJsonLd, NAOMI_SAME_AS } from '../lib/identity';
import CampaignCallout from '../components/CampaignCallout.astro';
import campaigns from '../data/campaigns.json';
import campaignSnapshot from '../data/campaign-snapshot.json';

const providerDirectory = campaigns.find((c) => c.id === 'provider-directory');
const providerSnapshot = campaignSnapshot['provider-directory'] || null;

const articles = await fetchAllArticles();
const articleCount = articles.length;
const surveyCount = surveyCountData?.total ?? 0;
// Round down to nearest 1,000 for honest "more than" framing.
// total = liveDistinct (CF Pages, exact) + sqspLegacyExact (1,512) +
// wixLegacyEstimate (Wix-only, approximate; refine via Wix Members API).
const surveyCountRounded = Math.floor(surveyCount / 1000) * 1000;

const liveCourseCount = coursesData.filter((c: any) => !c.comingSoon && !c.isAffiliate).length;

// Identity graph (Organization + People) sourced from SSOT via buildIdentityGraph().
// Inline augmentations below add homepage-specific properties the SSOT does not yet emit
// (extra sameAs entries, parentOrganization @id ref + EIN identifier, OfferCatalog with
// itemOffered Course refs, Naomi identifiers). Once SSOT is expanded these can be dropped.
const identityNodes = buildIdentityGraph();
const orgIdx = identityNodes.findIndex((n: any) => n['@id'] === 'https://rrmacademy.org/#organization');
const naomiIdx = identityNodes.findIndex((n: any) => n['@id'] === 'https://rrmacademy.org/#naomi-whittaker');

if (orgIdx >= 0) {
  const org = identityNodes[orgIdx] as Record<string, unknown>;
  // W1-2: ensure all three @types are declared.
  org['@type'] = ['Organization', 'EducationalOrganization', 'MedicalOrganization'];
  // RRM Academy is a program of the RRM Foundation, a distinct legal entity.
  // The registered legalName + EIN belong to the Foundation node (pushed below),
  // NOT the Academy node. This keeps the IRS-BMF / Ad Grants applicant match on
  // the homepage (now on the Foundation node) while decoupling the two entities.
  org.parentOrganization = { '@id': 'https://rrm.foundation/#organization' };
  // Naomi founded RRM Academy (historical org-founding role; Brian-authorized
  // 2026-06-07). Reciprocal of her Person node. Employer stays UPMC (her
  // jobTitle/worksFor are untouched).
  org.founder = { '@id': 'https://rrmacademy.org/#naomi-whittaker' };
  // W1-6: expand sameAs with the strongest entity anchors available. SSOT-bound
  // entries are preserved; inline entries are appended (de-duped).
  const ssotSameAs = Array.isArray(org.sameAs) ? (org.sameAs as string[]) : [];
  const inlineSameAs = [
    'https://www.instagram.com/rrmacademy',
    'https://www.youtube.com/@rrmacademy',
    'https://x.com/rrm_academy',
  ];
  org.sameAs = Array.from(new Set([...ssotSameAs, ...inlineSameAs]));
  // W1-30: subjectOf for agent-discovery surfaces.
  org.subjectOf = [
    { '@type': 'CreativeWork', url: 'https://rrmacademy.org/.well-known/agent-card.json', name: 'Agent Card' },
    { '@type': 'CreativeWork', url: 'https://rrmacademy.org/llms.txt', name: 'LLMs Index' },
  ];
  // W1-8: OfferCatalog with itemOffered Course refs + Course nodes emitted at top level.
  org.hasOfferCatalog = {
    '@type': 'OfferCatalog',
    name: 'RRM Academy Courses',
    url: 'https://rrmacademy.org/courses/',
    numberOfItems: liveCourseCount,
    itemListElement: coursesData
      .filter((c: any) => !c.comingSoon && !c.isAffiliate)
      .map((c: any) => ({
        '@type': 'Offer',
        url: `https://rrmacademy.org/courses/${c.slug}/`,
        name: c.title,
        category: 'Medical Education',
        price: c.isFree ? '0.00' : ((c.priceCents ?? 0) / 100).toFixed(2),
        priceCurrency: 'USD',
        availability: 'https://schema.org/InStock',
        seller: { '@id': 'https://rrmacademy.org/#organization' },
        itemOffered: { '@id': `https://rrmacademy.org/courses/${c.slug}/#course` },
      })),
  };
  identityNodes[orgIdx] = org;
}

// Distinct legal-entity node (shared builder): RRM Academy is a program of this
// 501(c)(3); the registered legalName + EIN + charity profiles live on the
// Foundation, not the Academy. The Academy's parentOrganization points here.
identityNodes.push(getFoundationJsonLd());

if (naomiIdx >= 0) {
  const naomi = identityNodes[naomiIdx] as Record<string, unknown>;
  // W1-7: ensure ORCID + NPI identifiers and worksFor are present on the homepage emit.
  // (SSOT audit pending; this inline guarantee survives until SSOT carries them natively.)
  const existingIdentifiers = Array.isArray(naomi.identifier) ? (naomi.identifier as any[]) : [];
  const idMap = new Map(existingIdentifiers.map((i: any) => [i?.propertyID, i]));
  if (!idMap.has('ORCID')) {
    existingIdentifiers.push({ '@type': 'PropertyValue', propertyID: 'ORCID', value: '0000-0003-3706-3112' });
  }
  if (!idMap.has('NPI')) {
    existingIdentifiers.push({ '@type': 'PropertyValue', propertyID: 'NPI', value: '1881034908' });
  }
  naomi.identifier = existingIdentifiers;
  // Entity-anchor sameAs (Wikidata/ORCID/OpenAlex/NPI + social). SSOT snapshot
  // does not carry these on the Person node, so set from the shared constant.
  naomi.sameAs = [...NAOMI_SAME_AS];
  if (!naomi.worksFor) {
    naomi.worksFor = { '@id': 'https://rrmacademy.org/#organization' };
  }
  if (!naomi.medicalSpecialty) {
    naomi.medicalSpecialty = ['Obstetrics and Gynecology', 'Reproductive Medicine', 'Minimally Invasive Gynecologic Surgery'];
  }
  identityNodes[naomiIdx] = naomi;
}

// W1-4: FAQPage answers expanded to 80-120 words; nested under WebPage mainEntity;
// each Answer carries author + publisher refs.
const faqEntries = [
  {
    question: 'Is Restorative Reproductive Medicine backed by real evidence?',
    answer:
      `Yes. Restorative Reproductive Medicine is built on a published evidence base spanning reproductive endocrinology, surgical outcomes, cycle-based diagnostics, and NaProTechnology. The RRM Academy Research Library contains ${articleCount.toLocaleString()} scholarly works, indexed from medical journals, textbooks, and clinical references, organized so any reader can follow the citations to the source. Most are peer-reviewed; all are catalogued for review. The evidence has always been available; most patients were simply never told about it. The library is free to read and the citations are intact.`,
  },
  {
    question: 'Will RRM Academy help me advocate for myself with my doctors?',
    answer:
      'That is exactly what it is for. Students leave knowing how to screen a surgeon, what to expect from a real diagnostic workup, and how to tell the difference between a provider who is investigating their condition and one who is just suppressing their symptoms. The courses teach the language clinicians use, the questions a thorough workup should answer, and the difference between excision and ablation, between cause-based diagnostics and standardized protocols. Some students stay with their current doctor and have better conversations. Others find a clinician who already practices RRM. Either way, you walk in informed.',
  },
  {
    question: 'I am not a medical professional. Is RRM Academy for me?',
    answer:
      'Many students are patients, not clinicians. Some are both. The courses are built so that anyone dealing with a reproductive health challenge can understand what is happening in their body, what their options are, and what good care actually looks like. You do not need a medical degree to deserve that information. Patients who finish the foundational courses describe a shift from being a passive recipient of care to an informed participant in their own diagnostic process. Body literacy is a clinical tool, and learning it changes the conversations you have with every provider you see.',
  },
  {
    question: 'How do I find a surgeon or provider I can trust?',
    answer:
      'Start with the right questions. Do they perform excision, not ablation? Do they evaluate both partners? Do they chart cycles before diagnosing? Do they investigate the cause before prescribing suppression? RRM Academy gives you the knowledge to evaluate any provider, not just the ones on a list. If you want a starting list while you build that confidence, the curated how-to-find-a-provider pathway is at /what-is-rrm/#get-started. Some students stay with their current doctor and have better conversations after taking a foundational course. Others seek out an RRM-trained clinician.',
  },
];

const faqNode: Record<string, unknown> = {
  '@type': 'FAQPage',
  '@id': 'https://rrmacademy.org/#faq',
  mainEntity: faqEntries.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
      author: { '@id': 'https://rrmacademy.org/#naomi-whittaker' },
      publisher: { '@id': 'https://rrmacademy.org/#organization' },
    },
  })),
};

const webPageNode = {
  '@type': 'WebPage',
  '@id': 'https://rrmacademy.org/#webpage',
  url: 'https://rrmacademy.org/',
  name: 'RRM Academy',
  isPartOf: { '@id': 'https://rrmacademy.org/#website' },
  about: { '@id': 'https://rrmacademy.org/#organization' },
  mainEntity: { '@id': 'https://rrmacademy.org/#faq' },
  publisher: { '@id': 'https://rrmacademy.org/#organization' },
};

const websiteNode = {
  '@type': 'WebSite',
  '@id': 'https://rrmacademy.org/#website',
  name: 'RRM Academy',
  url: 'https://rrmacademy.org/',
  inLanguage: 'en',
  publisher: { '@id': 'https://rrmacademy.org/#organization' },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: 'https://rrmacademy.org/library/?q={search_term_string}',
    },
    'query-input': 'required name=search_term_string',
  },
};

// W1-25: Quotation node for Naomi's blockquote.
const quotationNode = {
  '@type': 'Quotation',
  '@id': 'https://rrmacademy.org/#founder-quote',
  text:
    "I'll never forget a patient I saw during my residency. She had a history of miscarriages and was pregnant again, terrified. My attending told me to do nothing. 'If she's going to miscarry, she's going to miscarry.' That moment broke my heart.",
  spokenByCharacter: { '@id': 'https://rrmacademy.org/#naomi-whittaker' },
};

// W1-5: BreadcrumbList kept as @id-shaped node; single-item homepage breadcrumb.
const breadcrumbNode = {
  '@type': 'BreadcrumbList',
  '@id': 'https://rrmacademy.org/#breadcrumb',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      item: { '@id': 'https://rrmacademy.org/', name: 'Home' },
    },
  ],
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    websiteNode,
    webPageNode,
    ...identityNodes,
    faqNode,
    breadcrumbNode,
    quotationNode,
  ],
};
---
<BaseLayout
  title="RRM Academy | Evidence-Based Restorative Reproductive Medicine Education"
  description={`RRM Academy: ${articleCount.toLocaleString()}+ scholarly works, NaProTechnology-grounded courses, and clinical guidance from Dr. Naomi Whittaker, MD, on Restorative Reproductive Medicine for patients and clinicians.`}
  canonicalUrl="https://rrmacademy.org/"
  jsonLd={jsonLd}
  speakable={['.hp-hero h1', '.hp-hero__subtitle', '.hp-section:first-of-type p:first-of-type']}
  markdownUrl="/index.md"
>
  <div class="hp">
    <!-- Hero -->
    <section class="hp-hero" aria-labelledby="hp-hero-h1">
      <div class="container container--narrow">
        <p class="hp-hero__descriptor">An education project of Restorative Reproductive Medicine Foundation, Inc.</p>
        <h1 id="hp-hero-h1">Reclaim Reproductive Health with the Evidence</h1>
        <p class="hp-hero__subtitle">
          The online educational home of <strong>Restorative Reproductive Medicine</strong>.
          Free courses, patient guides, and clinical training to find root causes and restore function, not manage symptoms.
        </p>
        <div class="hp-hero__cta">
          <a href="/what-is-rrm/" class="btn btn--primary btn--lg" data-track-cta="hero-start-learning">
            Start Learning
            <svg class="hp-hero__cta-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
          <a href="/endo-survey/" class="btn btn--secondary btn--lg" data-track-cta="hero-endo-survey">
            Take the Endo Self-Assessment
          </a>
        </div>
        <p class="hp-hero__links">
          <a href="/guides/" class="hp-hero__link" data-track-cta="hero-for-patients">For Patients</a>
          <span class="hp-hero__link-dot" aria-hidden="true">·</span>
          <a href="/courses/" class="hp-hero__link" data-track-cta="hero-for-clinicians">For Clinicians</a>
          <span class="hp-hero__link-dot" aria-hidden="true">·</span>
          <a href="/donate/" class="hp-hero__link" data-track-cta="hero-donate">Donate</a>
        </p>
        <p class="hp-hero__legal">A 501(c)(3) public charity · EIN 93-4594315</p>
        <p class="hp-hero__updated"><LastUpdated path="/" /></p>
      </div>
      <div class="hp-hero__trust">
        <p class="hp-trust__tagline">Our research library indexes studies from</p>
        <div class="hp-trust__logos">
          <span class="hp-trust__logo hp-trust__logo--nejm" role="img" aria-label="The New England Journal of Medicine"></span>
          <span class="hp-trust__logo hp-trust__logo--jama">JAMA</span>
          <span class="hp-trust__logo hp-trust__logo--lancet">The Lancet</span>
          <span class="hp-trust__logo hp-trust__logo--fs">Fertility &amp; Sterility</span>
        </div>
      </div>
    </section>

    <div class="page-body">
    <!-- Fundraiser band: rendered only when campaign.foreground is true. Held false pre-launch to avoid showing a $0 thermometer for days; flip to true at launch. -->
    {providerDirectory && providerDirectory.foreground && (
      <section class="hp-section">
        <div class="container container--narrow">
          <CampaignCallout campaign={providerDirectory} variant="band" snapshot={providerSnapshot} />
        </div>
      </section>
    )}
    <!-- Intro -->
    <section class="hp-section">
      <div class="container container--narrow">
        <h2>What Is Restorative Reproductive Medicine?</h2>
        <p>
          If you have been told your pain is normal, your cycles are difficult, or your infertility is unexplained,
          and something inside you has been quietly insisting that cannot be the whole story, you are reading the right page.
        </p>
        <p>
          Painful periods are not a personality trait. Irregular cycles are not "just how you are."
          Infertility is not unexplained. It is undiagnosed.
        </p>
        <p>
          RRM Academy is the educational home for <a href="/what-is-rrm/">Restorative Reproductive Medicine</a>.
          The courses here train patients to understand their own cycles and clinicians to identify
          the root cause of reproductive dysfunction and treat it directly.
        </p>
        <p>
          RRM Academy was founded by <a href="/commentary/rrm-spotlight-naomi-whittaker-md/" rel="author">Dr. Naomi Whittaker, MD</a>,
          Board-Certified OBGYN, MIGS, NFPMC, FCI. She is a <a href="/naprotechnology/">NaProTechnology</a> fellowship-trained surgeon.
          The diagnostics, surgical standards, and educational content here reflect her NaProTechnology fellowship training and clinical practice.
        </p>
        <p>
          The goal is not indefinite condition management. It is answers. Restored function. And the years ahead that belong to you.
        </p>
      </div>
    </section>

    <!-- Analogy -->
    <section class="hp-section hp-section--alt">
      <div class="container container--narrow">
        <h2>Why Symptom Suppression Fails: The Check Engine Light</h2>
        <p>
          If you have spent years being told to live with what you know is not normal, this analogy will sound familiar.
        </p>
        <p>
          When the warning light comes on in your car, you don't cover it with tape. You open the hood.
        </p>
        <p>
          For decades, women have been handed the tape. Suppressive medications to mask the pain.
          Hormones to quiet the cycle. Bypass procedures when the cycle is too damaged to read.
          For the partner, abnormal semen parameters are overlooked or attributed to stress.
          The underlying disease keeps advancing, unseen.
        </p>
        <p>
          <a href="/what-is-rrm/">Restorative Reproductive Medicine</a>
          is the under-the-hood approach. RRM-trained clinicians investigate the fundamental why behind
          your symptoms. They identify whether the problem is hormonal, anatomical, inflammatory,
          nutritional, or some combination. Then they treat it.
        </p>
        <p>
          It addresses the underlying cause rather than managing symptoms, and it belongs at the start of care.
        </p>
      </div>
    </section>

    <!-- How RRM Works -->
    <section class="hp-section">
      <div class="container container--narrow">
        <h2>How Restorative Reproductive Medicine Works</h2>
        <p>
          Every patient is different, and RRM does not follow a single fixed protocol. The same principles guide every case: find the cause, treat the disease, restore the function.
        </p>
        <p>
          <strong>It starts with the question: why?</strong> RRM <a href="/faqs/?q=evaluates-both-partners">evaluates both partners</a>. A woman's
          cycle is diagnostic data, not background noise. For an RRM-trained physician, a complete
          cycle chart surfaces what conventional workups miss. But the workup does not stop there.
          Male factor assessment, hormonal panels, semen analysis: diagnostics for both partners
          are part of the picture from the start.
        </p>
        <p>
          <strong>Treatment targets the disease, not the symptom.</strong> What that looks like
          depends on what is found. For endometriosis, it may mean
          <a href="/faqs/?q=excision-surgery">excision surgery</a> to remove the disease itself rather than suppressing it with hormones.
          For tubal blockage, it may mean selective catheterization to clear and reopen the
          fallopian tubes without full surgery. For hormonal dysfunction, it may mean targeted medical support timed
          to the cycle. Because
          RRM is multidisciplinary, the care team might include physicians, naturopaths, nutritionists,
          pelvic floor physical therapists, mental health professionals, or fertility awareness
          educators, depending on what you need.
        </p>
        <p>
          <strong>When the underlying cause is treated, function returns.</strong> When treatment reaches the underlying disease, hormonal rhythms normalize and ovulation can return. For couples who want
          to conceive, natural conception becomes possible, sometimes for the first time. RRM
          repairs the reproductive system rather than routing around it. Most people working through
          an RRM workup see a clearer diagnostic picture within three to six cycles, though the path
          and pace depend on what is found.
        </p>
        <p>
          <strong>You are part of the process.</strong> RRM cooperates with the natural cycle. You
          become an active participant in your own care, not a passive recipient of a protocol.
          Body literacy is a clinical tool, and understanding your own body changes the
          conversations you have with every provider.
        </p>
        <h3>What the early work looks like</h3>
        <ul>
          <li><strong>Both-partner assessment:</strong> hormonal panels, semen analysis, and male factor evaluation alongside the female workup. This is usually the entry point.</li>
          <li><strong>Cycle charting:</strong> a complete cycle chart that surfaces what conventional workups miss. Often layered with the assessment above; sometimes precedes it, depending on where you start.</li>
          <li><strong>Finding a provider trained in cause-based care:</strong> the curated pathway at <a href="/what-is-rrm/#get-started">/what-is-rrm/#get-started</a>. Some patients find their provider before charting; most build the early data first and then bring it to a clinician who knows what to do with it.</li>
        </ul>
      </div>
    </section>

    <!-- A Different Path -->
    <section class="hp-section hp-section--alt">
      <div class="container container--narrow">
        <h2>Two Approaches. One Choice.</h2>
        <p>
          RRM starts from a different question. Not "how do we work around this?" but "what is actually wrong, and can it be addressed?" For most couples, the answer is yes.
        </p>

        <div class="hp-comparison">
          <div class="hp-comparison__col">
            <h3>Restorative Reproductive Medicine</h3>
            <ul>
              <li><strong>Goal:</strong> Find the cause. Treat the disease. Restore normal function.</li>
              <li><strong>Method:</strong> Cause-based diagnostics for both partners. Cycle charting. Targeted medical and surgical treatment from a multidisciplinary team that may include physicians, naturopaths, nutritionists, pelvic floor physical therapists, mental health professionals, and fertility awareness educators.</li>
              <li><strong>Your Role:</strong> An informed participant in your own care. You are not a recipient of a protocol. You are the one who understands what is happening, and why.</li>
            </ul>
          </div>
          <div class="hp-comparison__col">
            <h3>Conventional Suppressive and Bypass Medicine</h3>
            <ul>
              <li><strong>Goal:</strong> Suppress symptoms or bypass the problem.</li>
              <li><strong>Method:</strong> Suppressive medications. Standardized protocols. Procedures that route around reproductive function rather than restoring it.</li>
              <li><strong>Your Role:</strong> A recipient of the protocol.</li>
              <li><strong>The cost:</strong> Symptoms are masked while disease keeps advancing underneath. Diagnoses are delayed by years on average. <a href="/faqs/?q=hormonal-suppression">Hormonal suppression</a> does not stop disease, it hides it.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- You Are in the Right Place -->
    <section class="hp-section">
      <div class="container container--narrow">
        <h2>You Are in the Right Place</h2>

        <h3>If you are looking for answers about your own body</h3>
        <p>You belong here if:</p>
        <ul>
          <li>You have been told your painful or irregular cycles are "normal," and you know they are not.</li>
          <li>You have been diagnosed with <a href="/courses/masterclass-in-endometriosis-and-surgery/">endometriosis</a>, PCOS, or recurrent miscarriage and want more than indefinite symptom management.</li>
          <li>You carry a diagnosis of <a href="/what-is-rrm/">"unexplained"</a> infertility. (Undiagnosed is the more accurate word. RRM finds what was missed.)</li>
          <li>You and your partner want to understand why conception has not happened and want a cause-based answer.</li>
          <li>You have been through one or more IVF cycles, or been told donor eggs or a hysterectomy is your only option, and you are looking for a different question to be asked about your body.</li>
          <li>You have been told your age or AMH puts you out of options, and you want to know what a different workup might still find.</li>
          <li>You prefer natural conception and want to know what that path actually requires. <a href="/courses/rrm-vs-ivf/">See the RRM vs. IVF course.</a></li>
        </ul>

        <h3>If you are a clinician or allied professional</h3>
        <p>You belong here if:</p>
        <ul>
          <li>You are a physician in OB/GYN or family medicine who wants to offer patients real diagnostic and restorative options beyond suppressive medications and specialist referrals.</li>
          <li>You are a nurse practitioner, midwife, nutritionist, mental health provider, or allied health professional who wants deeper expertise in cycle-based diagnostics and root-cause care.</li>
          <li>You are a <a href="/femm/">fertility awareness educator</a> who wants clinical grounding for the work you do with clients.</li>
          <li>You want to understand how <a href="/naprotechnology/">NaProTechnology</a>-based medicine, restorative surgery, and complementary disciplines integrate into a full patient care model.</li>
        </ul>
      </div>
    </section>

    <!-- Endo self-survey -->
    <section class="hp-section">
      <div class="container container--narrow">
        <h2>The Endometriosis Self-Survey</h2>
        <p>
          More than {surveyCountRounded.toLocaleString()} women have taken the
          <a href="/endo-survey/"><strong>Endometriosis Self-Survey</strong></a>.
          Many tell us it confirmed their suspicions.
          Pain timing, cycle irregularity, cramping, bowel and bladder symptoms:
          the survey reads them as the connected picture they are, not as isolated
          complaints clinicians can dismiss one at a time.
        </p>
        <p>
          It is not a diagnosis. It is a structured self-assessment that maps your
          experience to the patterns investigative care actually looks for, so you
          can walk into your next appointment with the right questions and a clearer
          account of what your body has been telling you.
        </p>
        <p>
          <a href="/endo-survey/" class="btn btn--primary">Take the Self-Survey &rarr;</a>
        </p>
      </div>
    </section>

    <!-- Guided by Expertise -->
    <section class="hp-section hp-section--alt">
      <div class="container container--narrow">
        <h2>Built on a Moment That Should Not Have Happened</h2>

        <blockquote>
          <p>
            "I'll never forget a patient I saw during my residency. She had a history of
            miscarriages and was pregnant again, terrified. My attending told me to do nothing. 'If she's going to miscarry, she's
            going to miscarry.' That moment broke my heart."
          </p>
        </blockquote>

        <div class="hp-founder">
          <img
            src="/images/authors/naomi-whittaker.webp"
            alt="Dr. Naomi Whittaker, MD, Board-Certified OBGYN and Founder of RRM Academy"
            class="hp-founder__photo"
            width="120"
            height="120"
            loading="lazy"
            decoding="async"
          />
          <div class="hp-founder__meta">
            <span class="hp-founder__name">
              <a href="/commentary/rrm-spotlight-naomi-whittaker-md/"><strong>Dr. Naomi Whittaker, MD</strong></a>
            </span>
            <span class="hp-founder__cred">Board-Certified OBGYN, MIGS, NFPMC, FCI &middot; Founder, RRM Academy</span>
          </div>
        </div>
        <p>
          Dr. Whittaker built RRM Academy because of her. And the thousands like her. Women with
          real, diagnosable conditions who were told their pain was normal. Clinicians who wanted
          to help and were never taught how. Those are two separate failures, and they compound
          each other. Dr. Whittaker is a Board-Certified OBGYN and <a href="/naprotechnology/">NaProTechnology</a>
          fellowship-trained physician. She knows what it looks like when the training gap meets
          the care gap. RRM Academy exists to close both: rigorous education for professionals
          across medicine, nursing, nutrition, and allied health, and honest, evidence-grounded
          information for patients who are tired of waiting for answers that never come.
          If you have been carrying a question your doctor would not answer, you are exactly who Dr. Whittaker built this for.
        </p>
