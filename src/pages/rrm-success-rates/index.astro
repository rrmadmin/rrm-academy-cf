---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MaybeShell from '../../components/MaybeShell.astro';
import SectionTocChips from '../../components/SectionTocChips.astro';
import { isShellEnabled } from '../../lib/shell-routes';
import BackToTop from '../../components/BackToTop.astro';
import LastUpdated from '../../components/LastUpdated.astro';
import pageDates from '../../data/page-dates.json';
import { buildScholarlyArticleStub } from '../../lib/identity';
import SectionShare from '../../components/SectionShare.astro';
import data from '../../data/rrm-success-rates.json';

const SHELL_ENABLED = isShellEnabled('guides');

// Verified, non-excluded corpus. Studies + safety comparators are the citation
// compendium that anchors this page's authority.
const included = data.studies.filter((s) => s.verified && !s.excluded);
const safety = data.safety_comparators.filter((s) => s.verified && !s.excluded);

// ---------------------------------------------------------------------------
// T8 helpers: outcome formatting, badges, table grouping, references ordering.
// Every label is composed from the row's own fields so a conception row can
// never be mislabeled as live birth (outcome_type_rule in the SSOT _meta).
// ---------------------------------------------------------------------------

const pct = (v: number) => `${(v * 100).toFixed(1).replace(/\.0$/, '')}%`;

type Study = (typeof included)[number];

// formatOutcome composes the Outcome cell with explicit metric labels. It NEVER
// says "LBR" for a conception/pregnancy/methods/review row, and it NEVER labels a
// crude proportion as "adj. cum.". The two conception fields are mutually
// exclusive per row and carry distinct semantics:
//   - adjCumConception  -> a genuine life-table / Kaplan-Meier cumulative figure
//                          ("adj. cum. conception X% @Nmo")
//   - crudeConception   -> a crude proportion (conceived / denominator); the noun
//                          ("conception" vs "pregnancy") comes from the row's
//                          crudeConceptionMetric field, matching its source note.
function crudeConceptionLabel(s: Study): string {
  const noun = (s as { crudeConceptionMetric?: string }).crudeConceptionMetric || 'conception';
  const methodsTag = s.outcomeType === 'methods' ? ' (methods cohort)' : '';
  return `crude ${noun} ${pct(s.crudeConception as number)}${methodsTag}`;
}

function formatOutcome(s: Study): string {
  const parts: string[] = [];
  const mo = s.followUpMonths ? ` @${s.followUpMonths}mo` : '';

  if (s.outcomeType === 'live-birth') {
    if (s.crudeLbr != null) parts.push(`crude LBR ${pct(s.crudeLbr)}`);
    if (s.adjCumLbr != null) parts.push(`adj. cum. LBR ${pct(s.adjCumLbr)}${mo}`);
    if (s.adjCumConception != null) parts.push(`adj. cum. conception ${pct(s.adjCumConception)}${mo}`);
    if (s.crudeConception != null) parts.push(crudeConceptionLabel(s));
  } else if (s.outcomeType === 'conception') {
    if (s.adjCumConception != null) parts.push(`adj. cum. conception ${pct(s.adjCumConception)}${mo}`);
    if (s.crudeConception != null) parts.push(crudeConceptionLabel(s));
  } else if (s.outcomeType === 'methods') {
    if (s.adjCumConception != null) parts.push(`adj. cum. conception ${pct(s.adjCumConception)}${mo}`);
    if (s.crudeConception != null) parts.push(crudeConceptionLabel(s));
  } else if (s.outcomeType === 'review') {
    parts.push('Narrative / systematic review (no single cohort rate)');
  }
  return parts.length ? parts.join('; ') : 'See source';
}

// Engineer-authored badge labels, composed from JSON fields. ganci-2026-fs is
// flagged in notes as a skeptical review -> neutral "Independent review" label.
function badgesFor(s: Study): string[] {
  const out: string[] = [];
  if (s.preprint === true) out.push('Preprint, not peer reviewed');
  if (s.journalTier === 'lower-tier') out.push('Lower-tier journal');
  if (s.id === 'ganci-2026-fs') out.push('Independent review');
  else if (s.outcomeType === 'review') out.push('Review');
  if (s.outcomeType === 'methods') out.push('Methods paper');
  return out;
}

// Journal · Year · Country composite for the middle column.
function provenance(s: Study): string {
  return [s.journal, s.year, s.country].filter(Boolean).join(' · ');
}

// Three visually distinct groups. outcomeType drives membership; methods+review
// share the "Methods papers & reviews" table.
const liveBirthRows = included.filter((s) => s.outcomeType === 'live-birth');
const conceptionRows = included.filter((s) => s.outcomeType === 'conception');
const methodsRows = included.filter((s) => s.outcomeType === 'methods' || s.outcomeType === 'review');

const studyGroups = [
  { key: 'live-birth', heading: 'Live-birth cohorts', rows: liveBirthRows },
  { key: 'conception', heading: 'Conception and pregnancy cohorts', rows: conceptionRows },
  { key: 'methods', heading: 'Methods papers and reviews', rows: methodsRows },
];

// Full reference list: every study + safety comparator, sorted by year then
// authors. Safety comparators have no outcomeType but carry authors/year/journal.
type RefRow = {
  authors: string;
  year: number;
  journal: string;
  doi?: string | null;
  librarySlug: string;
};
const referenceRows: RefRow[] = [...included, ...safety].sort((a, b) => {
  if (a.year !== b.year) return a.year - b.year;
  return a.authors.localeCompare(b.authors);
});

// At-a-glance headline numbers, derived (not hardcoded) from the corpus.
const lbrStudies = liveBirthRows;
const crudeLbrValues = lbrStudies.map((s) => s.crudeLbr).filter((v): v is number => v != null);
const adjLbrValues = lbrStudies.map((s) => s.adjCumLbr).filter((v): v is number => v != null);
const crudeLow = Math.min(...crudeLbrValues);
const crudeHigh = Math.max(...crudeLbrValues);
const adjLow = Math.min(...adjLbrValues);
const adjHigh = Math.max(...adjLbrValues);
const studyCount = included.length;
const countryCount = new Set(
  included.flatMap((s) => (s.country ? String(s.country).split('/') : [])).map((c) => c.trim()).filter(Boolean)
).size;

// SECTIONS is the single source for: the TOC, the rendered section list, and the
// JSON-LD articleSection + hasPart arrays. Edit here, everything follows.
const SECTIONS = [
  { id: 'at-a-glance', title: 'The Evidence at a Glance' },
  { id: 'outcome-studies', title: 'The Outcome Studies' },
  { id: 'rrm-vs-ivf', title: 'How RRM Compares to IVF and ART' },
  { id: 'obstetric-safety', title: 'Obstetric Safety' },
  { id: 'by-condition', title: 'Effectiveness by Condition' },
  { id: 'spotlight-studies', title: 'Spotlight Studies' },
  { id: 'how-to-read-these-numbers', title: 'How to Read These Numbers' },
  { id: 'faq', title: 'Frequently Asked Questions' },
  { id: 'references', title: 'References' },
  { id: 'downloads', title: 'Downloads and Sharing' },
];
const TOC_ITEMS = SECTIONS.map((s) => ({ href: `#${s.id}`, label: s.title }));

const PAGE_PATH = '/rrm-success-rates/';
const PAGE_URL = 'https://rrmacademy.org/rrm-success-rates/';
const LIBRARY_BASE = 'https://rrmacademy.org/library/';
const PUBLISH_DATE = '2026-06-03';
const LAST_MODIFIED = pageDates.dates[PAGE_PATH] || PUBLISH_DATE;

// Helper: build a ScholarlyArticle stub for citation embedding (strip @context),
// then attach the library URL + DOI sameAs. Precedent: naprotechnology citeStub.
function citeStub(props: { name: string; author: string; datePublished: string; journal?: string }) {
  const node = buildScholarlyArticleStub(props) as Record<string, unknown> & { '@context'?: unknown };
  const { '@context': _ctx, ...rest } = node;
  return rest;
}

// Citation compendium: every verified study + safety comparator becomes a
// ScholarlyArticle node. name = library record title not in this SSOT, so it is
// composed as "authors (year) journal"; sameAs = DOI (omitted when null); url =
// library record. This array is the strategic core of the page.
function toCitation(s: {
  authors: string;
  year: number;
  journal: string;
  doi?: string | null;
  librarySlug: string;
}) {
  const name = `${s.authors} (${s.year}). ${s.journal}.`;
  const node: Record<string, unknown> = {
    ...citeStub({
      name,
      author: s.authors,
      datePublished: String(s.year),
      journal: s.journal,
    }),
    url: `${LIBRARY_BASE}${s.librarySlug}/`,
  };
  if (s.doi) node.sameAs = `https://doi.org/${s.doi}`;
  return node;
}

const citationCompendium = [...included, ...safety].map(toCitation);

// FAQ placeholder. T10 fills this; the FAQPage node is emitted ONLY when this is
// non-empty so we never ship an empty FAQPage to validators.
const FAQS: { question: string; answer: string }[] = []; // T10 fills

// Single JSON-LD @graph block (precedent: art-registries-and-codes).
const graph: Record<string, unknown>[] = [
  {
    '@type': ['Article', 'MedicalWebPage'],
    headline: 'RRM Success Rates: What the Published Evidence Shows',
    description:
      'Every published RRM and NaProTechnology outcome study from 2008 to today: live birth rates, IVF comparisons, obstetric safety, and costs, with links to every source.',
    image: 'https://rrmacademy.org/og/rrm-success-rates.png',
    author: { '@id': 'https://rrmacademy.org/#organization' },
    reviewedBy: { '@id': 'https://rrmacademy.org/#naomi-whittaker' },
    publisher: {
      '@type': 'EducationalOrganization',
      '@id': 'https://rrmacademy.org/#organization',
      name: 'RRM Academy',
    },
    datePublished: PUBLISH_DATE,
    dateModified: LAST_MODIFIED,
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': PAGE_URL,
    },
    about: {
      '@type': 'MedicalTherapy',
      name: 'Restorative Reproductive Medicine',
      alternateName: 'RRM',
    },
    articleSection: SECTIONS.map((s) => s.title),
    hasPart: SECTIONS.map((s) => ({
      '@type': 'WebPageElement',
      name: s.title,
      url: `${PAGE_URL}#${s.id}`,
    })),
    citation: citationCompendium,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://rrmacademy.org/' },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://rrmacademy.org/guides/' },
      { '@type': 'ListItem', position: 3, name: 'RRM Success Rates', item: PAGE_URL },
    ],
  },
];

// Emit FAQPage only when FAQS is populated (T10).
if (FAQS.length > 0) {
  graph.push({
    '@type': 'FAQPage',
    mainEntity: FAQS.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  });
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': graph,
};
---

<BaseLayout
  title="RRM Success Rates: What the Published Evidence Shows"
  description="Every published RRM and NaProTechnology outcome study from 2008 to today: live birth rates, IVF comparisons, obstetric safety, and costs, with links to every source."
  canonicalUrl={PAGE_URL}
  ogType="article"
  publishDate={PUBLISH_DATE}
  jsonLd={jsonLd}
  speakable={['.pillar-lead', 'h1']}
  chrome={SHELL_ENABLED ? 'shell' : 'default'}
  trackScroll
>
  <MaybeShell enabled={SHELL_ENABLED} context="page" currentPath={Astro.url.pathname} saveTitle="RRM Success Rates">
  <div class="page-wrapper" data-pagefind-body>
    <span data-pagefind-meta="type:Guide" style="display:none"></span>
    <span data-pagefind-meta="title:RRM Success Rates" style="display:none"></span>
    <div class="container">

      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true"> &rsaquo; </span>
        <a href="/guides/">Guides</a>
        <span aria-hidden="true"> &rsaquo; </span>
        <span>RRM Success Rates</span>
      </nav>

      <h1>RRM Success Rates: What the Published Evidence Shows</h1>

      {/* Org-authored + clinically reviewed byline. Canonical
          .author-avatar-stack + .has-reviewer pattern (precedent:
          art-registries-and-codes / glossary). JSON-LD upstream mirrors this
          with author=#organization + reviewedBy=#naomi-whittaker. */}
      <div class="author-byline">
        <div class="author-avatar-stack">
          <img src="/apple-touch-icon.png" alt="RRM Academy" class="author-byline__photo" width="48" height="48" />
          <img src="/images/authors/naomi-whittaker.webp" alt="Dr. Naomi Whittaker, MD" class="author-byline__photo" width="48" height="48" />
        </div>
        <div class="author-byline__text has-reviewer">
          <span class="byline-author">By <strong>RRM Academy</strong></span>
          <span class="byline-reviewer">Reviewed by <strong><a href="/commentary/rrm-spotlight-naomi-whittaker-md/">Dr. Naomi Whittaker, MD, Board-Certified OBGYN, MIGS, NFPMC, FCI</a></strong></span>
          <LastUpdated path="/rrm-success-rates/" class="byline-date" />
        </div>
      </div>

      <!-- T9: Gianna lede. The pillar-lead is the speakable answer span. -->
      <p class="pillar-lead"><strong><!-- T9: Gianna lede --></strong></p>
      <!--
        T9 (Gianna) fills:
          - pillar-lead: one-paragraph definitional answer (the "what the evidence shows" thesis)
          - Key Takeaways aside
          - all section prose (intro paragraphs, framing, transitions)
          - "How to Read These Numbers" methodology explainer
        T8 fills: the master outcome-studies table + charts (outcome-studies, rrm-vs-ivf,
                  obstetric-safety, by-condition, spotlight-studies sections)
        T10 fills: FAQ section + FAQS[] array above (FAQPage node auto-emits when populated)
        T11 fills: print CSS + downloads section (PDF/print affordances)
      -->

      <!-- Mobile TOC -->
      <details class="toc-mobile">
        <summary>On this page</summary>
        <ol>
          {TOC_ITEMS.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ol>
      </details>

      {SHELL_ENABLED && <SectionTocChips items={TOC_ITEMS} />}

      <div class:list={['article-layout', { 'article-layout--no-toc': SHELL_ENABLED }]}>

        {!SHELL_ENABLED && (
          <nav class="toc" aria-label="Table of contents">
            <p class="toc-heading">On this page</p>
            <ol>
              {TOC_ITEMS.map((item) => (
                <li><a href={item.href}>{item.label}</a></li>
              ))}
            </ol>
          </nav>
        )}

        <article class="prose">

          {/* Section skeletons. SectionShare renders the H2 (id + share/anchor
              controls) -- do NOT emit a second h2 inside any section. Each
              section's body is filled by a later task per the slot comment. */}

          <section id="at-a-glance">
            <SectionShare id="at-a-glance" title="The Evidence at a Glance" />
            {/* T9: Key Takeaways aside + at-a-glance framing prose. */}

            {/* T8: headline summary stat cards, derived from the verified corpus. */}
            <div class="stat-grid">
              <div class="stat-card">
                <span class="stat-card__value">{pct(crudeLow)} to {pct(crudeHigh)}</span>
                <span class="stat-card__label">Crude live-birth rate across cohorts</span>
              </div>
              <div class="stat-card">
                <span class="stat-card__value">{pct(adjLow)} to {pct(adjHigh)}</span>
                <span class="stat-card__label">Adjusted cumulative live-birth rate</span>
              </div>
              <div class="stat-card">
                <span class="stat-card__value">{studyCount}</span>
                <span class="stat-card__label">Verified studies across {countryCount} countries</span>
              </div>
              <div class="stat-card">
                <span class="stat-card__value">${data.cost.rrm_range_usd.replace('-', ' to $')}</span>
                <span class="stat-card__label">Typical RRM cost vs ${data.cost.art_range_usd.replace('-', ' to $')} per IVF cycle</span>
              </div>
            </div>

            <figure class="chart-figure">
              <img src="/images/rrm-success-rates/cross-study-lbr.svg" alt="Grouped horizontal bars of adjusted cumulative live-birth rate at 24 months across seven RRM cohorts, with crude live-birth rate as a second paler bar. Ukraine 2020 flagged lower-tier journal; Australia 2021 flagged medRxiv preprint." class="chart-light" loading="lazy" width="760" height="640" />
              <img src="/images/rrm-success-rates/cross-study-lbr-dark.svg" alt="Grouped horizontal bars of adjusted cumulative live-birth rate at 24 months across seven RRM cohorts, with crude live-birth rate as a second paler bar. Ukraine 2020 flagged lower-tier journal; Australia 2021 flagged medRxiv preprint." class="chart-dark" loading="lazy" width="760" height="640" />
              <figcaption>Adjusted cumulative (life-table or Kaplan-Meier) live-birth rate at 24 months for the seven live-birth cohorts, paired with each cohort's crude rate. Cohorts differ in case mix, denominators and follow-up, so this is a compendium rather than a randomized comparison.</figcaption>
            </figure>
          </section>

          <section id="outcome-studies">
            <SectionShare id="outcome-studies" title="The Outcome Studies" />
            {/* T9: section intro prose. */}

            {/* T8: master evidence table, grouped by outcome type. Each group is a
                separate table inside the same .table-wrap scroll flow with a
                group subheading, so live-birth, conception and methods/review
                rows are visually distinct and never blended. */}
            <div class="table-wrap">
              {studyGroups.map((group) => (
                <div class="study-group">
                  <h3 class="study-group__heading">{group.heading}</h3>
                  <table>
                    <thead>
                      <tr>
                        <th scope="col">Study</th>
                        <th scope="col">Journal · Year · Country</th>
                        <th scope="col">n</th>
                        <th scope="col">Population</th>
                        <th scope="col">Outcome</th>
                      </tr>
                    </thead>
                    <tbody>
                      {group.rows.map((s) => (
                        <tr>
                          <td>
                            <a href={`/library/${s.librarySlug}/`}>{s.authors} ({s.year})</a>
                          </td>
                          <td>{provenance(s)}</td>
                          <td>{s.n != null ? s.n.toLocaleString('en-US') : '—'}</td>
                          <td>{s.population}</td>
                          <td>
                            {formatOutcome(s)}
                            {badgesFor(s).length > 0 && (
                              <span class="badge-row">
                                {badgesFor(s).map((b) => (
                                  <span class="ev-badge">{b}</span>
                                ))}
                              </span>
                            )}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              ))}
            </div>

            <figure class="chart-figure">
              <img src="/images/rrm-success-rates/by-country.svg" alt="A replication and coverage table, one row per country, showing the number of independent studies and the headline RRM success rate as text with its outcome-type label. Rates are shown as text, not as bars on a shared scale, because the outcome types (live-birth vs conception, crude vs adjusted-cumulative) are not directly comparable across countries." class="chart-light" loading="lazy" width="760" height="600" />
              <img src="/images/rrm-success-rates/by-country-dark.svg" alt="A replication and coverage table, one row per country, showing the number of independent studies and the headline RRM success rate as text with its outcome-type label. Rates are shown as text, not as bars on a shared scale, because the outcome types (live-birth vs conception, crude vs adjusted-cumulative) are not directly comparable across countries." class="chart-dark" loading="lazy" width="760" height="600" />
              <figcaption>International replication: 14 independent studies across 11 countries. Each headline rate is shown as text and labeled by outcome type (live-birth versus conception, crude versus adjusted-cumulative) because those denominators are not directly comparable across countries.</figcaption>
            </figure>
          </section>

          <section id="rrm-vs-ivf">
            <SectionShare id="rrm-vs-ivf" title="How RRM Compares to IVF and ART" />
            {/* T9: comparison framing prose (denominator caveats, head-to-head context). */}

            <figure class="chart-figure">
              <img src="/images/rrm-success-rates/rrm-vs-ivf.svg" alt="Vertical bars comparing RRM live-birth rates (Boyle 2025 crude 41 percent; Sanchez-Mendez adjusted cumulative 50 percent at 24 months and 62.1 percent at plateau) against the HFEA per-single-embryo-cycle IVF reference of 33 percent. Cumulative and per-cycle denominators are labeled and are not directly equivalent." class="chart-light" loading="lazy" width="760" height="470" />
              <img src="/images/rrm-success-rates/rrm-vs-ivf-dark.svg" alt="Vertical bars comparing RRM live-birth rates (Boyle 2025 crude 41 percent; Sanchez-Mendez adjusted cumulative 50 percent at 24 months and 62.1 percent at plateau) against the HFEA per-single-embryo-cycle IVF reference of 33 percent. Cumulative and per-cycle denominators are labeled and are not directly equivalent." class="chart-dark" loading="lazy" width="760" height="470" />
              <figcaption>RRM rates (Boyle 2025 crude live birth; Sanchez-Mendez adjusted cumulative) are measured over a treatment window, while the HFEA 2021 IVF reference is the live-birth rate per single-embryo cycle for women under 35. A cumulative rate and a per-cycle rate are different measures shown side by side for context, not a like-for-like ratio.</figcaption>
            </figure>

            <figure class="chart-figure">
              <img src="/images/rrm-success-rates/cost-comparison.svg" alt="Paired range bars comparing typical cost in US dollars: restorative reproductive medicine 2,000 to 5,000 dollars versus ART (IVF per cycle) 10,000 to 15,000 dollars, per Bulletti 2025." class="chart-light" loading="lazy" width="760" height="380" />
              <img src="/images/rrm-success-rates/cost-comparison-dark.svg" alt="Paired range bars comparing typical cost in US dollars: restorative reproductive medicine 2,000 to 5,000 dollars versus ART (IVF per cycle) 10,000 to 15,000 dollars, per Bulletti 2025." class="chart-dark" loading="lazy" width="760" height="380" />
              <figcaption>Typical cost ranges from Bulletti et al. 2025 (Tables 7 and 8). The RRM range reflects targeted surgery and common interventions; the ART figure is per IVF cycle and excludes the cost of repeat cycles.</figcaption>
            </figure>
          </section>

          <section id="obstetric-safety">
            <SectionShare id="obstetric-safety" title="Obstetric Safety" />
            {/* T9: safety framing prose. */}

            <figure class="chart-figure">
              <img src="/images/rrm-success-rates/obstetric-safety.svg" alt="Two-panel chart. Panel A: preterm and twin rates as percentages (RRM singleton preterm 4.0 percent vs CDC 11.8 percent; RRM all-pregnancy preterm 6.5 percent vs SART 14.4 percent; RRM twins 1.4 percent). Panel B: adverse-outcome odds ratios for ART vs untreated or never-treated comparators (ART preterm 3.28, ART low-birthweight 2.91, IVF preterm 4.24, IUI preterm 3.17). Rates and odds ratios are on separate scales and must not be compared directly." class="chart-light" loading="lazy" width="960" height="540" />
              <img src="/images/rrm-success-rates/obstetric-safety-dark.svg" alt="Two-panel chart. Panel A: preterm and twin rates as percentages (RRM singleton preterm 4.0 percent vs CDC 11.8 percent; RRM all-pregnancy preterm 6.5 percent vs SART 14.4 percent; RRM twins 1.4 percent). Panel B: adverse-outcome odds ratios for ART vs untreated or never-treated comparators (ART preterm 3.28, ART low-birthweight 2.91, IVF preterm 4.24, IUI preterm 3.17). Rates and odds ratios are on separate scales and must not be compared directly." class="chart-dark" loading="lazy" width="960" height="540" />
              <figcaption>Panel A reports RRM versus IVF preterm and twin rates as percentages (Boyle 2018 and 2025), keeping singleton and all-pregnancy denominators separate. Panel B reports ART, IVF and IUI adverse-outcome odds ratios with 95% confidence intervals (Simonsen 2016, Sanders 2022); rates and odds ratios are different measures on different scales and are never plotted on one axis.</figcaption>
            </figure>
          </section>

          <section id="by-condition">
            <SectionShare id="by-condition" title="Effectiveness by Condition" />
            {/* T9: condition-level interpretation prose. */}

            <figure class="chart-figure">
              <img src="/images/rrm-success-rates/sm-by-diagnosis.svg" alt="Horizontal bars of crude take-home-baby (live birth) rate within each diagnostic subgroup from Sanchez-Mendez 2025, ranging from 36.9 percent for general conditions to 24.0 percent for other conditions, each labeled with its count over subgroup total." class="chart-light" loading="lazy" width="760" height="540" />
              <img src="/images/rrm-success-rates/sm-by-diagnosis-dark.svg" alt="Horizontal bars of crude take-home-baby (live birth) rate within each diagnostic subgroup from Sanchez-Mendez 2025, ranging from 36.9 percent for general conditions to 24.0 percent for other conditions, each labeled with its count over subgroup total." class="chart-dark" loading="lazy" width="760" height="540" />
              <figcaption>Crude take-home-baby rate within each diagnostic subgroup from Sanchez-Mendez et al. 2025 (Table 1). Couples may carry more than one diagnosis, so the subgroups are not mutually exclusive.</figcaption>
            </figure>
          </section>

          <section id="spotlight-studies">
            <SectionShare id="spotlight-studies" title="Spotlight Studies" />
            {/* T9: spotlight narrative for the landmark cohorts (Boyle 2025, Sanchez-Mendez 2025, Stanford 2008). */}

            <figure class="chart-figure">
              <img src="/images/rrm-success-rates/boyle-funnel.svg" alt="Funnel chart of the Boyle 2025 cohort: 249 couples had at least one RRM consultation, 187 committed to treatment (75 percent), 98 conceived (52 percent of treated), and 77 had a live birth (41 percent of treated)." class="chart-light" loading="lazy" width="760" height="470" />
