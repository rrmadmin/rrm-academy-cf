---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CiteThisPage from '../../components/CiteThisPage.astro';
import MaybeShell from '../../components/MaybeShell.astro';
import SectionTocChips from '../../components/SectionTocChips.astro';
import { isShellEnabled } from '../../lib/shell-routes';
import BackToTop from '../../components/BackToTop.astro';
import LastUpdated from '../../components/LastUpdated.astro';
import pageDates from '../../data/page-dates.json';
import { buildScholarlyArticleStub } from '../../lib/identity';
import SectionShare from '../../components/SectionShare.astro';
import data from '../../data/rrm-success-rates.json';

const SHELL_ENABLED = isShellEnabled('guides');

// Verified, non-excluded corpus. Studies + safety comparators are the citation
// compendium that anchors this page's authority.
const included = data.studies.filter((s) => s.verified && !s.excluded);
const safety = data.safety_comparators.filter((s) => s.verified && !s.excluded);

// ---------------------------------------------------------------------------
// T8 helpers: outcome formatting, badges, table grouping, references ordering.
// Every label is composed from the row's own fields so a conception row can
// never be mislabeled as live birth (outcome_type_rule in the SSOT _meta).
// ---------------------------------------------------------------------------

const pct = (v: number) => `${(v * 100).toFixed(1).replace(/\.0$/, '')}%`;

type Study = (typeof included)[number];

// formatOutcome composes the Outcome cell with explicit metric labels. It NEVER
// says "LBR" for a conception/pregnancy/methods/review row, and it NEVER labels a
// crude proportion as "adj. cum.". The two conception fields are mutually
// exclusive per row and carry distinct semantics:
//   - adjCumConception  -> a genuine life-table / Kaplan-Meier cumulative figure
//                          ("adj. cum. conception X% @Nmo")
//   - crudeConception   -> a crude proportion (conceived / denominator); the noun
//                          ("conception" vs "pregnancy") comes from the row's
//                          crudeConceptionMetric field, matching its source note.
function crudeConceptionLabel(s: Study): string {
  const noun = (s as { crudeConceptionMetric?: string }).crudeConceptionMetric || 'conception';
  const methodsTag = s.outcomeType === 'methods' ? ' (methods cohort)' : '';
  return `crude ${noun} ${pct(s.crudeConception as number)}${methodsTag}`;
}

function formatOutcome(s: Study): string {
  const parts: string[] = [];
  const mo = s.followUpMonths ? ` @${s.followUpMonths}mo` : '';

  if (s.outcomeType === 'live-birth') {
    if (s.crudeLbr != null) parts.push(`crude LBR ${pct(s.crudeLbr)}`);
    if (s.adjCumLbr != null) parts.push(`adj. cum. LBR ${pct(s.adjCumLbr)}${mo}`);
    if (s.adjCumConception != null) parts.push(`adj. cum. conception ${pct(s.adjCumConception)}${mo}`);
    if (s.crudeConception != null) parts.push(crudeConceptionLabel(s));
  } else if (s.outcomeType === 'conception') {
    if (s.adjCumConception != null) parts.push(`adj. cum. conception ${pct(s.adjCumConception)}${mo}`);
    if (s.crudeConception != null) parts.push(crudeConceptionLabel(s));
  } else if (s.outcomeType === 'methods') {
    if (s.adjCumConception != null) parts.push(`adj. cum. conception ${pct(s.adjCumConception)}${mo}`);
    if (s.crudeConception != null) parts.push(crudeConceptionLabel(s));
  } else if (s.outcomeType === 'review') {
    parts.push('Narrative / systematic review (no single cohort rate)');
  }
  return parts.length ? parts.join('; ') : 'See source';
}

// Engineer-authored badge labels, composed from JSON fields. ganci-2026-fs is
// flagged in notes as a skeptical review -> neutral "Independent review" label.
function badgesFor(s: Study): string[] {
  const out: string[] = [];
  if (s.preprint === true) out.push('Preprint, not peer reviewed');
  if (s.journalTier === 'lower-tier') out.push('Lower-tier journal');
  if (s.id === 'ganci-2026-fs') out.push('Independent review');
  else if (s.outcomeType === 'review') out.push('Review');
  if (s.outcomeType === 'methods') out.push('Methods paper');
  return out;
}

// Journal · Year · Country composite for the middle column.
function provenance(s: Study): string {
  return [s.journal, s.year, s.country].filter(Boolean).join(' · ');
}

// Three visually distinct groups. outcomeType drives membership; methods+review
// share the "Methods papers & reviews" table.
const liveBirthRows = included.filter((s) => s.outcomeType === 'live-birth');
const conceptionRows = included.filter((s) => s.outcomeType === 'conception');
const methodsRows = included.filter((s) => s.outcomeType === 'methods' || s.outcomeType === 'review');

const studyGroups = [
  { key: 'live-birth', heading: 'Live-birth cohorts', rows: liveBirthRows },
  { key: 'conception', heading: 'Conception and pregnancy cohorts', rows: conceptionRows },
  { key: 'methods', heading: 'Methods papers and reviews', rows: methodsRows },
];

// Full reference list: every study + safety comparator, sorted by year then
// authors. Safety comparators have no outcomeType but carry authors/year/journal.
type RefRow = {
  authors: string;
  year: number;
  journal: string;
  doi?: string | null;
  librarySlug: string;
};
const referenceRows: RefRow[] = [...included, ...safety].sort((a, b) => {
  if (a.year !== b.year) return a.year - b.year;
  return a.authors.localeCompare(b.authors);
});

// At-a-glance headline numbers, derived (not hardcoded) from the corpus.
const lbrStudies = liveBirthRows;
const crudeLbrValues = lbrStudies.map((s) => s.crudeLbr).filter((v): v is number => v != null);
const adjLbrValues = lbrStudies.map((s) => s.adjCumLbr).filter((v): v is number => v != null);
const crudeLow = Math.min(...crudeLbrValues);
const crudeHigh = Math.max(...crudeLbrValues);
const adjLow = Math.min(...adjLbrValues);
const adjHigh = Math.max(...adjLbrValues);
const studyCount = included.filter((s) => s.outcomeType !== 'review').length;
const countryCount = new Set(
  included.flatMap((s) => (s.country ? String(s.country).split('/') : [])).map((c) => c.trim()).filter(Boolean)
).size;

// SECTIONS is the single source for: the TOC, the rendered section list, and the
// JSON-LD articleSection + hasPart arrays. Edit here, everything follows.
const SECTIONS = [
  { id: 'at-a-glance', title: 'The Evidence at a Glance' },
  { id: 'outcome-studies', title: 'The Outcome Studies' },
  { id: 'rrm-vs-ivf', title: 'How RRM Compares to IVF and ART' },
  { id: 'obstetric-safety', title: 'Obstetric Safety' },
  { id: 'by-condition', title: 'Effectiveness by Condition' },
  { id: 'spotlight-studies', title: 'Spotlight Studies' },
  { id: 'how-to-read-these-numbers', title: 'How to Read These Numbers' },
  { id: 'faq', title: 'Frequently Asked Questions' },
  { id: 'references', title: 'References' },
  { id: 'downloads', title: 'Downloads and Sharing' },
];
const TOC_ITEMS = SECTIONS.map((s) => ({ href: `#${s.id}`, label: s.title }));

const PAGE_PATH = '/rrm-success-rates/';
const PAGE_URL = 'https://rrmacademy.org/rrm-success-rates/';
const LIBRARY_BASE = 'https://rrmacademy.org/library/';
const PUBLISH_DATE = '2026-06-03';
const LAST_MODIFIED = pageDates.dates[PAGE_PATH] || PUBLISH_DATE;

// Helper: build a ScholarlyArticle stub for citation embedding (strip @context),
// then attach the library URL + DOI sameAs. Precedent: naprotechnology citeStub.
function citeStub(props: { name: string; author: string; datePublished: string; journal?: string }) {
  const node = buildScholarlyArticleStub(props) as Record<string, unknown> & { '@context'?: unknown };
  const { '@context': _ctx, ...rest } = node;
  return rest;
}

// Citation compendium: every verified study + safety comparator becomes a
// ScholarlyArticle node. name = library record title not in this SSOT, so it is
// composed as "authors (year) journal"; sameAs = DOI (omitted when null); url =
// library record. This array is the strategic core of the page.
function toCitation(s: {
  authors: string;
  year: number;
  journal: string;
  doi?: string | null;
  librarySlug: string;
}) {
  const name = `${s.authors} (${s.year}). ${s.journal}.`;
  const node: Record<string, unknown> = {
    ...citeStub({
      name,
      author: s.authors,
      datePublished: String(s.year),
      journal: s.journal,
    }),
    url: `${LIBRARY_BASE}${s.librarySlug}/`,
  };
  if (s.doi) node.sameAs = `https://doi.org/${s.doi}`;
  return node;
}

const citationCompendium = [...included, ...safety].map(toCitation);

// FAQ data. Each entry has:
//   question   - plain text question (also used as JSON-LD schema name)
//   answer     - plain text answer (used by FAQPage JSON-LD acceptedAnswer.text)
//   answerHtml - answer with inline citation links (used for rendered markup only)
// Single source drives both the FAQPage schema node and the rendered #faq section.
const FAQS: { question: string; answer: string; answerHtml: string }[] = [
  {
    question: 'What is the success rate of NaProTechnology?',
    answer:
      'In published cohorts, NaProTechnology live-birth rates range from 18.4% (crude, 24-month follow-up, population with 100% prior failed IVF) to 62.1% (adjusted-cumulative plateau reached at the 31 to 33 month band, mixed infertility population). The variation is not measurement error. It reflects genuinely different populations, follow-up windows, and rate-calculation methods.\n\nThe most rigorous way to interpret any single figure is to identify: (1) whether it is a crude rate or an adjusted-cumulative life-table rate, (2) the follow-up period it covers, (3) the age profile of the enrolled population, and (4) whether prior treatment failure was an inclusion criterion. A 35-year-old with no prior treatment will have a different expected trajectory than a 39-year-old with two prior IVF cycles. The age-specific data from the 1,310-couple Madrid cohort offers the most useful reference: 83.7% adjusted-cumulative for women 18-30, 63.2% for ages 31-35, 53.3% for ages 36-40, and 24.4% for women over 40.',
    answerHtml:
      'In published cohorts, NaProTechnology live-birth rates range from 18.4% (crude, 24-month follow-up, population with 100% prior failed IVF) to 62.1% (adjusted-cumulative plateau reached at the 31 to 33 month band, mixed infertility population) <a href="/library/natural-procreative-technology-naprotechnology-for-infertility-take-home-baby-ra-recv02qu0r8ycnzoa/" class="faq-cite">[source]</a> <a href="/library/healthy-singleton-pregnancies-from-restorative-reproductive-medicine-rrm-after-f-recior3akxtg2a6ya/" class="faq-cite">[source]</a>. The variation is not measurement error. It reflects genuinely different populations, follow-up windows, and rate-calculation methods.\n\nThe most rigorous way to interpret any single figure is to identify: (1) whether it is a crude rate or an adjusted-cumulative life-table rate, (2) the follow-up period it covers, (3) the age profile of the enrolled population, and (4) whether prior treatment failure was an inclusion criterion. A 35-year-old with no prior treatment will have a different expected trajectory than a 39-year-old with two prior IVF cycles. The age-specific data from the 1,310-couple Madrid cohort offers the most useful reference: 83.7% adjusted-cumulative for women 18-30, 63.2% for ages 31-35, 53.3% for ages 36-40, and 24.4% for women over 40 <a href="/library/natural-procreative-technology-naprotechnology-for-infertility-take-home-baby-ra-recv02qu0r8ycnzoa/" class="faq-cite">[source]</a>.',
  },
  {
    question: 'Is RRM more effective than IVF?',
    answer:
      'In published observational data, the rates are comparable in age-matched populations, with different risk profiles. The 2025 Dublin cohort reported 42-44% crude live-birth rates in women under 43, against SART and CDC IVF benchmarks of 40-41% for the same age range. A 2025 systematic review found RRM success rates of 40-60% versus ART success rates of 30-40% across the reviewed literature.\n\nThese are observational comparisons, not randomized trials. The populations differ, the denominators differ, and the comparison is not controlled. What the data does not support is the premise that IVF is categorically more effective than RRM for all populations. What it also does not support is an unqualified superiority claim in either direction. An independent systematic review published in Fertility and Sterility in 2026 is explicitly skeptical of RRM effectiveness claims and readers engaged in policy or clinical decision-making should read it directly. The honest summary: the effectiveness comparison remains open, which is itself a finding worth noting given how long ART has dominated the clinical infrastructure.',
    answerHtml:
      'In published observational data, the rates are comparable in age-matched populations, with different risk profiles. The 2025 Dublin cohort reported 42-44% crude live-birth rates in women under 43, against SART and CDC IVF benchmarks of 40-41% for the same age range <a href="/library/restorative-reproductive-medicine-rrm-outcomes-compared-to-in-vitro-fertilization-rec4qqhafqb8stlnd/" class="faq-cite">[source]</a>. A 2025 systematic review found RRM success rates of 40-60% versus ART success rates of 30-40% across the reviewed literature <a href="/library/revitalizing-reproductive-health-innovations-and-future-frontiers-in-restorative-reccddj5kun7yn1ir/" class="faq-cite">[source]</a>.\n\nThese are observational comparisons, not randomized trials. The populations differ, the denominators differ, and the comparison is not controlled. What the data does not support is the premise that IVF is categorically more effective than RRM for all populations. What it also does not support is an unqualified superiority claim in either direction. An independent systematic review published in Fertility and Sterility in 2026 is explicitly skeptical of RRM effectiveness claims and readers engaged in policy or clinical decision-making should read it directly <a href="/library/the-effectiveness-and-safety-of-restorative-reproductive-medicine-rrm-compared-t-vrqg1wuo/" class="faq-cite">[source]</a>. The honest summary: the effectiveness comparison remains open, which is itself a finding worth noting given how long ART has dominated the clinical infrastructure.',
  },
  {
    question: 'How does RRM compare to IVF on safety?',
    answer:
      'The available evidence points in one direction. In the first head-to-head cohort comparing RRM directly against IVF benchmarks, RRM singleton preterm births came in at 4.0%, against 11.8% in the CDC IVF benchmark for the same year: roughly two-thirds lower. Across all pregnancies, the preterm rate was 6.5% for RRM versus 14.4% in the SART IVF benchmark: more than half lower. Separate population studies found the adjusted odds of an early birth were about 3 times higher after ART versus never-treated women and about 4 times higher after IVF among subfertile women. The mechanism is not mysterious: RRM achieves conception without transferring multiple embryos, so multiple pregnancies are rare, and multiples are the main engine of preterm births and NICU admissions after IVF. These are observational findings, not randomized trial results. But the pattern is consistent and clinically meaningful.',
    answerHtml:
      'The available evidence points in one direction. In the first head-to-head cohort comparing RRM directly against IVF benchmarks, RRM singleton preterm births came in at 4.0%, against 11.8% in the CDC IVF benchmark for the same year: roughly two-thirds lower. Across all pregnancies, the preterm rate was 6.5% for RRM versus 14.4% in the SART IVF benchmark: more than half lower <a href="/library/restorative-reproductive-medicine-rrm-outcomes-compared-to-in-vitro-fertilization-rec4qqhafqb8stlnd/" class="faq-cite">[source]</a>. Separate population studies found the adjusted odds of an early birth were about 3 times higher after ART versus never-treated women <a href="/library/fertility-treatments-and-adverse-perinatal-outcomes-in-a-population-based-sampli-rec9u2zrqqgyuipxq/" class="faq-cite">[source]</a> and about 4 times higher after IVF among subfertile women <a href="/library/fertility-treatments-and-the-risk-of-preterm-birth-among-women-with-subfertility-recpxh63cqyktiu3x/" class="faq-cite">[source]</a>. The mechanism is not mysterious: RRM achieves conception without transferring multiple embryos, so multiple pregnancies are rare, and multiples are the main engine of preterm births and NICU admissions after IVF. These are observational findings, not randomized trial results. But the pattern is consistent and clinically meaningful.',
  },
  {
    question: 'Is RRM evidence-based?',
    answer:
      'In published literature, yes, with the usual caveats that apply to observational evidence. This page indexes 14 cohort studies and 2 systematic reviews, spanning 2008-2026, across 11 countries, with populations ranging from 41 to 1,310 couples. The studies are predominantly published in indexed peer-reviewed journals. One is a preprint. One review, published in Fertility and Sterility in 2026, is explicitly skeptical of the evidence base.\n\nThe body of evidence is observational. No randomized controlled trials comparing RRM to IVF exist. The individual cohorts use different populations, different follow-up windows, and different rate-calculation methods, which is why the ranges on this page span a wide band. The evidence is sufficient to establish that RRM produces documented live births in defined populations at rates that are clinically meaningful. It is not sufficient to make unqualified effectiveness claims, predict individual outcomes, or rule out selection bias in the cohorts. Evidence-based means the practice is grounded in published literature. It does not mean settled. RRM meets the first standard. The second is a higher bar that reproductive medicine as a field, across all approaches, has not fully reached.',
    answerHtml:
      'In published literature, yes, with the usual caveats that apply to observational evidence. This page indexes 14 cohort studies and 2 systematic reviews, spanning 2008-2026, across 11 countries, with populations ranging from 41 to 1,310 couples. The studies are predominantly published in indexed peer-reviewed journals. One is a preprint. One review, published in Fertility and Sterility in 2026, is explicitly skeptical of the evidence base <a href="/library/the-effectiveness-and-safety-of-restorative-reproductive-medicine-rrm-compared-t-vrqg1wuo/" class="faq-cite">[source]</a>.\n\nThe body of evidence is observational. No randomized controlled trials comparing RRM to IVF exist. The individual cohorts use different populations, different follow-up windows, and different rate-calculation methods, which is why the ranges on this page span a wide band. The evidence is sufficient to establish that RRM produces documented live births in defined populations at rates that are clinically meaningful. It is not sufficient to make unqualified effectiveness claims, predict individual outcomes, or rule out selection bias in the cohorts. Evidence-based means the practice is grounded in published literature. It does not mean settled. RRM meets the first standard. The second is a higher bar that reproductive medicine as a field, across all approaches, has not fully reached.',
  },
  {
    question: 'Are there randomized controlled trials comparing RRM and IVF?',
    answer:
      'No. As of 2026, no randomized controlled trials have been published comparing RRM (or NaProTechnology) to IVF as primary treatments for infertility. The best available comparison is the 2025 Dublin retrospective cohort benchmarked against contemporaneous IVF registry data, which is informative but not equivalent to a randomized design.\n\nThe absence of RCTs is a real limitation of the RRM evidence base. It is frequently raised in critical reviews of RRM, including the 2026 Fertility and Sterility systematic review. At the same time, IVF was adopted at scale and became the dominant infertility treatment before any RCTs existed comparing it to expectant management or other approaches. A Cochrane review documented that only two small RCTs (86 women total) examined IVF versus expectant management. The standard is applied unevenly. That does not resolve the limitation for RRM, but it is relevant context for evaluating what level of evidence is actually available across the field.',
    answerHtml:
      'No. As of 2026, no randomized controlled trials have been published comparing RRM (or NaProTechnology) to IVF as primary treatments for infertility. The best available comparison is the 2025 Dublin retrospective cohort benchmarked against contemporaneous IVF registry data <a href="/library/restorative-reproductive-medicine-rrm-outcomes-compared-to-in-vitro-fertilization-rec4qqhafqb8stlnd/" class="faq-cite">[source]</a>, which is informative but not equivalent to a randomized design.\n\nThe absence of RCTs is a real limitation of the RRM evidence base. It is frequently raised in critical reviews of RRM, including the 2026 Fertility and Sterility systematic review <a href="/library/the-effectiveness-and-safety-of-restorative-reproductive-medicine-rrm-compared-t-vrqg1wuo/" class="faq-cite">[source]</a>. At the same time, IVF was adopted at scale and became the dominant infertility treatment before any RCTs existed comparing it to expectant management or other approaches. A Cochrane review documented that only two small RCTs (86 women total) examined IVF versus expectant management. The standard is applied unevenly. That does not resolve the limitation for RRM, but it is relevant context for evaluating what level of evidence is actually available across the field.',
  },
];

// Single JSON-LD @graph block (precedent: art-registries-and-codes).
const graph: Record<string, unknown>[] = [
  {
    '@type': ['Article', 'MedicalWebPage'],
    headline: 'RRM Success Rates: What the Published Evidence Shows',
    description:
      'What does the published evidence show for Restorative Reproductive Medicine? Outcomes across 14 cohorts, 11 countries, 2008-2026, including the first head-to-head RRM vs IVF comparison.',
    image: 'https://rrmacademy.org/og/rrm-success-rates.png',
    author: { '@id': 'https://rrmacademy.org/#organization' },
    reviewedBy: { '@id': 'https://rrmacademy.org/#naomi-whittaker' },
    publisher: {
      '@type': 'EducationalOrganization',
      '@id': 'https://rrmacademy.org/#organization',
      name: 'RRM Academy',
    },
    datePublished: PUBLISH_DATE,
    dateModified: LAST_MODIFIED,
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': PAGE_URL,
    },
    about: {
      '@type': 'MedicalTherapy',
      name: 'Restorative Reproductive Medicine',
      alternateName: 'RRM',
    },
    articleSection: SECTIONS.map((s) => s.title),
    hasPart: SECTIONS.map((s) => ({
      '@type': 'WebPageElement',
      name: s.title,
      url: `${PAGE_URL}#${s.id}`,
    })),
    citation: citationCompendium,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://rrmacademy.org/' },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://rrmacademy.org/guides/' },
      { '@type': 'ListItem', position: 3, name: 'RRM Success Rates', item: PAGE_URL },
    ],
  },
];

// Emit FAQPage only when FAQS is populated (T10).
if (FAQS.length > 0) {
  graph.push({
    '@type': 'FAQPage',
    mainEntity: FAQS.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  });
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': graph,
};
---

<BaseLayout
  title="RRM Success Rates: What the Published Evidence Shows"
  description="RRM live-birth rates across 14 peer-reviewed cohorts, 11 countries, 2008-2026. Crude and adjusted-cumulative outcomes with follow-up windows, by condition and age group."
  canonicalUrl={PAGE_URL}
  markdownUrl="/rrm-success-rates.md"
  ogType="article"
  publishDate={PUBLISH_DATE}
  jsonLd={jsonLd}
  speakable={['.pillar-lead', 'h1']}
  chrome={SHELL_ENABLED ? 'shell' : 'default'}
  trackScroll
>
  <MaybeShell enabled={SHELL_ENABLED} context="page" currentPath={Astro.url.pathname} saveTitle="RRM Success Rates">
  <div class="page-wrapper" data-pagefind-body>
    <span data-pagefind-meta="type:Guide" style="display:none"></span>
    <span data-pagefind-meta="title:RRM Success Rates" style="display:none"></span>
    <div class="container">

      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true"> &rsaquo; </span>
        <a href="/guides/">Guides</a>
        <span aria-hidden="true"> &rsaquo; </span>
        <span>RRM Success Rates</span>
      </nav>

      <h1>RRM Success Rates: What the Published Evidence Shows</h1>

      {/* Org-authored + clinically reviewed byline. Canonical
          .author-avatar-stack + .has-reviewer pattern (precedent:
          art-registries-and-codes / glossary). JSON-LD upstream mirrors this
          with author=#organization + reviewedBy=#naomi-whittaker. */}
      <div class="author-byline">
        <div class="author-avatar-stack">
          <img src="/apple-touch-icon.png" alt="RRM Academy" class="author-byline__photo" width="48" height="48" />
          <img src="/images/authors/naomi-whittaker.webp" alt="Dr. Naomi Whittaker, MD" class="author-byline__photo" width="48" height="48" />
        </div>
        <div class="author-byline__text has-reviewer">
          <span class="byline-author">By <strong>RRM Academy</strong></span>
          <span class="byline-reviewer">Reviewed by <strong><a href="/commentary/rrm-spotlight-naomi-whittaker-md/">Dr. Naomi Whittaker, MD, Board-Certified OBGYN, MIGS, NFPMC, FCI</a></strong></span>
          <LastUpdated path="/rrm-success-rates/" class="byline-date" />
        </div>
      </div>

      <!-- Mobile TOC -->
      <details class="toc-mobile">
        <summary>On this page</summary>
        <ol>
          {TOC_ITEMS.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ol>
      </details>

      {SHELL_ENABLED && <SectionTocChips items={TOC_ITEMS} />}

      <div class:list={['article-layout', { 'article-layout--no-toc': SHELL_ENABLED }]}>

        {!SHELL_ENABLED && (
          <nav class="toc" aria-label="Table of contents">
            <p class="toc-heading">On this page</p>
            <ol>
              {TOC_ITEMS.map((item) => (
                <li><a href={item.href}>{item.label}</a></li>
              ))}
            </ol>
          </nav>
        )}

        <article class="prose">

          {/* Lede lives inside the prose column (right 2/3) so the sticky TOC
              aligns to it from the top, per the standard pillar layout. The
              pillar-lead is the speakable answer span. */}
          <p class="pillar-lead"><strong>This page brings together the published research on how well Restorative Reproductive Medicine (RRM) and NaProTechnology work. It collects outcome studies from 2008 to today and lays out what each one found, with the context needed to read the numbers correctly.</strong></p>
          <p>The page covers live birth and pregnancy rates, how RRM results compare with IVF, pregnancy safety, cost, and findings for specific conditions including endometriosis, PCOS, and recurrent miscarriage. Every study links to its full library record.</p>
          <p>The studies measured success in different ways, in different groups of couples, and over different time periods. Rates vary as a result. These are real-world studies, not controlled trials, and the populations in them are not a random cross-section of couples seeking care. No single number fits everyone. Each figure on this page appears with its source and the study context it came from.</p>

          {/* Section skeletons. SectionShare renders the H2 (id + share/anchor
              controls) -- do NOT emit a second h2 inside any section. Each
              section's body is filled by a later task per the slot comment. */}

          <section id="at-a-glance">
            <SectionShare id="at-a-glance" title="The Evidence at a Glance" />
            {/* T9: Key Takeaways aside + at-a-glance framing prose. */}

            <aside class="tldr" aria-label="Key takeaways">
              <h3>Key Takeaways</h3>
              <ul>
                <li>Crude live-birth rates across 14 RRM cohorts range from 18.4% (<a href="/library/healthy-singleton-pregnancies-from-restorative-reproductive-medicine-rrm-after-f-recior3akxtg2a6ya/">RRM after IVF failure, 24 months</a>) to 41.5% (<a href="/library/restorative-reproductive-medicine-for-infertility-and-recurrent-miscarriage-in-t-0016c5f1/">mixed infertility, 24 months</a>).</li>
                <li>Adjusted-cumulative live-birth rates range from 29% to 73.6% across the same corpus, with the variance driven by <a href="/library/restorative-reproductive-medicine-for-infertility-and-recurrent-miscarriage-in-t-0016c5f1/">population</a> and <a href="/library/restorative-reproductive-medicine-for-infertility-in-two-family-medicine-clinics-recyiv7uvglmix9ex/">follow-up window</a>.</li>
                <li>Age is the strongest predictor: in the <a href="/library/natural-procreative-technology-naprotechnology-for-infertility-take-home-baby-ra-recv02qu0r8ycnzoa/">largest published cohort (n=1,310)</a>, adjusted-cumulative live-birth rates ranged from 83.7% (ages 18-30) to 24.4% (over 40).</li>
                <li>The <a href="/library/restorative-reproductive-medicine-rrm-outcomes-compared-to-in-vitro-fertilization-rec4qqhafqb8stlnd/">first head-to-head comparison</a> found RRM crude live-birth rates of 42-44% comparable to contemporaneous SART/CDC IVF benchmarks of 40-41% in the same age band, with lower RRM singleton preterm rates (4.0% vs 11.8% CDC IVF).</li>
                <li>All data are from observational cohorts. No randomized controlled trials comparing RRM to IVF have been published. Selection effects and heterogeneous populations limit direct comparisons across cohorts.</li>
                <li>A full <a href="/library/revitalizing-reproductive-health-innovations-and-future-frontiers-in-restorative-reccddj5kun7yn1ir/">RRM course runs ~$2,000-$5,000</a>; US IVF is <a href="https://www.asrm.org/practice-guidance/ethics-opinions/disparities-in-access-to-effective-treatment-for-infertility-in-the-united-states-an-ethics-committee-opinion-2021/" rel="noopener">~$19,200 per cycle</a> and frequently <a href="/library/costs-of-infertility-treatment-results-from-an-18month-prospective-cohort-study-8owrwrej/">$50,000+ cumulatively to one live birth</a>.</li>
              </ul>
            </aside>

            <p>The stat cards above display two ranges: crude live-birth rates (18.4% to 41.5%) and adjusted-cumulative live-birth rates (29% to 73.6%). These are not the same metric. Crude rates count live births among all couples who started treatment. Adjusted-cumulative (life-table) rates account for couples who withdrew or whose follow-up ended early, estimating the probability of a live birth over the full follow-up window. A crude rate and an adjusted-cumulative rate from different cohorts cannot be compared against each other. The ranges also span heterogeneous cohorts: different populations, follow-up lengths, entry criteria, and RRM methods. Fourteen cohort studies, two systematic reviews, and a narrative review informed this page. What the numbers share is that they come from published literature with documented populations and defined endpoints.</p>

            {/* T8: headline summary stat cards, derived from the verified corpus. */}
            <div class="stat-grid">
              <div class="stat-card">
                <span class="stat-card__value">{pct(crudeLow)} to {pct(crudeHigh)}</span>
                <span class="stat-card__label">Crude live-birth rate across cohorts</span>
              </div>
              <div class="stat-card">
                <span class="stat-card__value">{pct(adjLow)} to {pct(adjHigh)}</span>
                <span class="stat-card__label">Adjusted cumulative live-birth rate</span>
              </div>
              <div class="stat-card">
                <span class="stat-card__value">{studyCount}</span>
                <span class="stat-card__label">Verified cohort studies across {countryCount} countries</span>
              </div>
              <div class="stat-card">
                <span class="stat-card__value">${data.cost.rrm_course_usd.replace('-', ' to $')}</span>
                <span class="stat-card__label">RRM course ~$2-5K vs US IVF ~$19K per cycle</span>
              </div>
            </div>

            <figure class="chart-figure">
              <img src="/images/rrm-success-rates/cross-study-lbr.svg" alt="Grouped horizontal bars of adjusted cumulative live-birth rate at 24 months across seven RRM cohorts, with crude live-birth rate as a second paler bar. Ukraine 2020 flagged lower-tier journal; Australia 2021 flagged medRxiv preprint." class="chart-light" loading="lazy" width="760" height="640" />
              <img src="/images/rrm-success-rates/cross-study-lbr-dark.svg" alt="Grouped horizontal bars of adjusted cumulative live-birth rate at 24 months across seven RRM cohorts, with crude live-birth rate as a second paler bar. Ukraine 2020 flagged lower-tier journal; Australia 2021 flagged medRxiv preprint." class="chart-dark" loading="lazy" width="760" height="640" />
              <figcaption>Adjusted cumulative (life-table or Kaplan-Meier) live-birth rate at 24 months for the seven live-birth cohorts, paired with each cohort's crude rate. Cohorts differ in case mix, denominators and follow-up, so this is a compendium rather than a randomized comparison.</figcaption>
            </figure>
          </section>

          <section id="outcome-studies">
            <SectionShare id="outcome-studies" title="The Outcome Studies" />
            {/* T9: section intro prose. */}

            <p>Reading reproductive medicine outcome data accurately requires knowing exactly what was measured. Two concepts cause the most confusion.</p>
            <p><strong>Crude vs. adjusted-cumulative rates.</strong> A crude live-birth rate divides the number of live births by the number of couples who started treatment, treating everyone who dropped out as a non-success. An adjusted-cumulative (life-table) rate censors withdrawals and estimates the probability of success over time, accounting for the fact that some couples left before the study ended, not because they failed. The same cohort can show a crude rate of 18% and an adjusted-cumulative rate of 32%, and both figures are correct; they measure <a href="/library/healthy-singleton-pregnancies-from-restorative-reproductive-medicine-rrm-after-f-recior3akxtg2a6ya/">different things</a>.</p>
            <p><strong>Per-couple vs. per-cycle rates.</strong> Most RRM outcome studies report per-couple rates: what fraction of couples who enrolled achieved a live birth over a defined follow-up period. Most IVF registry benchmarks report per-cycle or per-embryo-transferred rates: what fraction of individual transfer events resulted in a live birth. A 24-month per-couple RRM rate and a per-embryo-transferred IVF rate are not the same denominator. The most common reading error in reproductive medicine outcomes literature is comparing these two figures as if they were equivalent. This page labels every rate's denominator type explicitly.</p>
            <p>The studies in the table below are grouped by primary outcome type: live-birth cohorts, conception cohorts, systematic reviews, and safety comparators. Within each group, studies appear in chronological order. Follow-up windows are noted for every cohort because a 12-month rate and a 36-month rate from the same cohort cannot be compared to each other without that context.</p>

            {/* T8: master evidence table, grouped by outcome type. Each group is a
                separate table inside the same .table-wrap scroll flow with a
                group subheading, so live-birth, conception and methods/review
                rows are visually distinct and never blended. */}
            <div class="table-wrap">
              {studyGroups.map((group) => (
                <div class="study-group">
                  <h3 class="study-group__heading">
                    <span class="study-group__title">{group.heading}</span>
                    <span class="study-group__count">{group.rows.length} {group.rows.length === 1 ? 'study' : 'studies'}</span>
                  </h3>
                  <table>
                    <thead>
                      <tr>
                        <th scope="col">Study</th>
                        <th scope="col">Journal · Year · Country</th>
                        <th scope="col">n</th>
                        <th scope="col">Population</th>
                        <th scope="col">Outcome</th>
                      </tr>
                    </thead>
                    <tbody>
                      {group.rows.map((s) => (
                        <tr>
                          <td>
                            <a href={`/library/${s.librarySlug}/`}>{s.authors} ({s.year})</a>
                          </td>
                          <td>{provenance(s)}</td>
                          <td>{s.n != null ? s.n.toLocaleString('en-US') : '—'}</td>
                          <td>{s.population}</td>
                          <td>
                            {formatOutcome(s)}
                            {badgesFor(s).length > 0 && (
                              <span class="badge-row">
                                {badgesFor(s).map((b) => (
                                  <span class="ev-badge">{b}</span>
                                ))}
                              </span>
                            )}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              ))}
            </div>

            <p class="table-footnote"><strong>Footnote on intervention scope.</strong> Not every study in the conception and methods groups tested a full medical and surgical RRM protocol. Several evaluated fertility-awareness training alone. Marshell and colleagues 2019 stratified couples by Billings cervical-mucus charting; Frank-Herrmann and colleagues 2017 trained couples in the Sensiplan symptothermal method. Both report conception outcomes from charting-based timing without the targeted diagnostic and treatment component that defines comprehensive NaProTechnology. Read those rates as fertility-awareness training outcomes, not as comprehensive RRM outcomes.</p>

            <p class="table-footnote"><strong>Footnote on iNEST.</strong> The iNEST paper (Stanford and colleagues 2022) is an enrollment and methods report, not an outcomes cohort. By its own account, clinical sites had missing data for about one-third of participants, and the authors caution that this level of missing data limits generalizability and that differential loss to follow-up may bias outcomes. Treat its 57% any-pregnancy and 44% any-live-birth figures as descriptive feasibility numbers, not as efficacy estimates.</p>

            <figure class="chart-figure">
              <img src="/images/rrm-success-rates/by-country.svg" alt="A replication and coverage table, one row per country, showing the number of independent studies and the headline RRM success rate as text with its outcome-type label. Rates are shown as text, not as bars on a shared scale, because the outcome types (live-birth vs conception, crude vs adjusted-cumulative) are not directly comparable across countries." class="chart-light" loading="lazy" width="760" height="600" />
