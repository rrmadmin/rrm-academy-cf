    /* Full-width article: collapse the 2-column TOC + prose grid to one column. */
    :global(.article-layout) {
      display: block;
      grid-template-columns: 1fr;
    }

    /* Show full reference + DOI URLs after links so a printed copy is
       self-contained. Scoped to #references so body links stay clean. */
    #references a[href^="https://"]::after,
    #references a[href^="/"]::after {
      content: " (" attr(href) ")";
      font-size: 0.85em;
      word-break: break-all;
    }
  }
</style>

<script>
  // T11: wire the Print or save-as-PDF button. First (and only) window.print()
  // on the page. The beforeprint handler opens every <details> so FAQ answers
  // print expanded.
  document.getElementById('sr-print')?.addEventListener('click', () => window.print());
  window.addEventListener('beforeprint', () => document.querySelectorAll('details').forEach((d) => (d.open = true)));
</script>
