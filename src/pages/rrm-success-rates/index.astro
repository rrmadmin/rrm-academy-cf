---
import GuideLayout from '../../layouts/GuideLayout.astro';
import CiteThisPage from '../../components/CiteThisPage.astro';
import pageDates from '../../data/page-dates.json';
import { buildScholarlyArticleStub } from '../../lib/identity';
import SectionShare from '../../components/SectionShare.astro';
import data from '../../data/rrm-success-rates.json';

// Verified, non-excluded corpus. Studies + safety comparators are the citation
// compendium that anchors this page's authority.
const included = data.studies.filter((s) => s.verified && !s.excluded);
const safety = data.safety_comparators.filter((s) => s.verified && !s.excluded);

// ---------------------------------------------------------------------------
// T8 helpers: outcome formatting, badges, table grouping, references ordering.
// Every label is composed from the row's own fields so a conception row can
// never be mislabeled as live birth (outcome_type_rule in the SSOT _meta).
// ---------------------------------------------------------------------------

const pct = (v: number) => `${(v * 100).toFixed(1).replace(/\.0$/, '')}%`;

type Study = (typeof included)[number];

// formatOutcome composes the Outcome cell with explicit metric labels. It NEVER
// says "LBR" for a conception/pregnancy/methods/review row, and it NEVER labels a
// crude proportion as "adj. cum.". The two conception fields are mutually
// exclusive per row and carry distinct semantics:
//   - adjCumConception  -> a genuine life-table / Kaplan-Meier cumulative figure
//                          ("adj. cum. conception X% @Nmo")
//   - crudeConception   -> a crude proportion (conceived / denominator); the noun
//                          ("conception" vs "pregnancy") comes from the row's
//                          crudeConceptionMetric field, matching its source note.
function crudeConceptionLabel(s: Study): string {
  const noun = (s as { crudeConceptionMetric?: string }).crudeConceptionMetric || 'conception';
  const methodsTag = s.outcomeType === 'methods' ? ' (methods cohort)' : '';
  return `crude ${noun} ${pct(s.crudeConception as number)}${methodsTag}`;
}

function formatOutcome(s: Study): string {
  const parts: string[] = [];
  const mo = s.followUpMonths ? ` @${s.followUpMonths}mo` : '';

  if (s.outcomeType === 'live-birth') {
    if (s.crudeLbr != null) parts.push(`crude LBR ${pct(s.crudeLbr)}`);
    if (s.adjCumLbr != null) parts.push(`adj. cum. LBR ${pct(s.adjCumLbr)}${mo}`);
    if (s.adjCumConception != null) parts.push(`adj. cum. conception ${pct(s.adjCumConception)}${mo}`);
    if (s.crudeConception != null) parts.push(crudeConceptionLabel(s));
  } else if (s.outcomeType === 'conception') {
    if (s.adjCumConception != null) parts.push(`adj. cum. conception ${pct(s.adjCumConception)}${mo}`);
    if (s.crudeConception != null) parts.push(crudeConceptionLabel(s));
  } else if (s.outcomeType === 'methods') {
    if (s.adjCumConception != null) parts.push(`adj. cum. conception ${pct(s.adjCumConception)}${mo}`);
    if (s.crudeConception != null) parts.push(crudeConceptionLabel(s));
  } else if (s.outcomeType === 'review') {
    parts.push('Narrative / systematic review (no single cohort rate)');
  }
  return parts.length ? parts.join('; ') : 'See source';
}

// Engineer-authored badge labels, composed from JSON fields.
function badgesFor(s: Study): string[] {
  const out: string[] = [];
  if (s.preprint === true) out.push('Preprint, not peer reviewed');
  if (s.journalTier === 'lower-tier') out.push('Lower-tier journal');
  if (s.outcomeType === 'review') out.push('Review');
  if (s.outcomeType === 'methods') out.push('Methods paper');
  return out;
}

// Journal · Year · Country composite for the middle column.
function provenance(s: Study): string {
  return [s.journal, s.year, s.country].filter(Boolean).join(' · ');
}

// Three visually distinct groups. outcomeType drives membership; methods+review
// share the "Methods papers & reviews" table.
const liveBirthRows = included.filter((s) => s.outcomeType === 'live-birth');
const conceptionRows = included.filter((s) => s.outcomeType === 'conception');
const methodsRows = included.filter((s) => s.outcomeType === 'methods' || s.outcomeType === 'review');

const studyGroups = [
  { key: 'live-birth', heading: 'Live-birth cohorts', rows: liveBirthRows },
  { key: 'conception', heading: 'Conception and pregnancy cohorts', rows: conceptionRows },
  { key: 'methods', heading: 'Methods papers and reviews', rows: methodsRows },
];

// Full reference list: every study + safety comparator, sorted by year then
// authors. Safety comparators have no outcomeType but carry authors/year/journal.
type RefRow = {
  authors: string;
  year: number;
  journal: string;
  doi?: string | null;
  librarySlug: string;
};
const referenceRows: RefRow[] = [...included, ...safety].sort((a, b) => {
  if (a.year !== b.year) return a.year - b.year;
  return a.authors.localeCompare(b.authors);
});

// At-a-glance headline numbers, derived (not hardcoded) from the corpus.
const lbrStudies = liveBirthRows;
const crudeLbrValues = lbrStudies.map((s) => s.crudeLbr).filter((v): v is number => v != null);
const adjLbrValues = lbrStudies.map((s) => s.adjCumLbr).filter((v): v is number => v != null);
const crudeLow = Math.min(...crudeLbrValues);
const crudeHigh = Math.max(...crudeLbrValues);
const adjLow = Math.min(...adjLbrValues);
const adjHigh = Math.max(...adjLbrValues);
const studyCount = included.filter((s) => s.outcomeType !== 'review').length;
const countryCount = new Set(
  included.flatMap((s) => (s.country ? String(s.country).split('/') : [])).map((c) => c.trim()).filter(Boolean)
).size;

// SECTIONS is the single source for: the TOC, the rendered section list, and the
// JSON-LD articleSection + hasPart arrays. Edit here, everything follows.
const SECTIONS = [
  { id: 'at-a-glance', title: 'The Evidence at a Glance' },
  { id: 'outcome-studies', title: 'The Outcome Studies' },
  { id: 'rrm-vs-ivf', title: 'How RRM Compares to IVF and ART' },
  { id: 'obstetric-safety', title: 'Obstetric Safety' },
  { id: 'by-condition', title: 'Effectiveness by Condition' },
  { id: 'spotlight-studies', title: 'Spotlight Studies' },
  { id: 'how-to-read-these-numbers', title: 'How to Read These Numbers' },
  { id: 'faq', title: 'Frequently Asked Questions' },
  { id: 'references', title: 'References' },
  { id: 'downloads', title: 'Downloads and Sharing' },
];
const TOC_ITEMS = SECTIONS.map((s) => ({ href: `#${s.id}`, label: s.title }));

const PAGE_PATH = '/rrm-success-rates/';
const PAGE_URL = 'https://rrmacademy.org/rrm-success-rates/';
const LIBRARY_BASE = 'https://rrmacademy.org/library/';
const PUBLISH_DATE = '2026-06-03';
const LAST_MODIFIED = pageDates.dates[PAGE_PATH] || PUBLISH_DATE;

// Helper: build a ScholarlyArticle stub for citation embedding (strip @context),
// then attach the library URL + DOI sameAs. Precedent: naprotechnology citeStub.
function citeStub(props: { name: string; author: string; datePublished: string; journal?: string }) {
  const node = buildScholarlyArticleStub(props) as Record<string, unknown> & { '@context'?: unknown };
  const { '@context': _ctx, ...rest } = node;
  return rest;
}

// Citation compendium: every verified study + safety comparator becomes a
// ScholarlyArticle node. name = library record title not in this SSOT, so it is
// composed as "authors (year) journal"; sameAs = DOI (omitted when null); url =
// library record. This array is the strategic core of the page.
function toCitation(s: {
  authors: string;
  year: number;
  journal: string;
  doi?: string | null;
  librarySlug: string;
}) {
  const name = `${s.authors} (${s.year}). ${s.journal}.`;
  const node: Record<string, unknown> = {
    ...citeStub({
      name,
      author: s.authors,
      datePublished: String(s.year),
      journal: s.journal,
    }),
    url: `${LIBRARY_BASE}${s.librarySlug}/`,
  };
  if (s.doi) node.sameAs = `https://doi.org/${s.doi}`;
  return node;
}

const citationCompendium = [...included, ...safety].map(toCitation);

// FAQ data. Each entry has:
//   question   - plain text question (also used as JSON-LD schema name)
//   answer     - plain text answer (used by FAQPage JSON-LD acceptedAnswer.text)
//   answerHtml - answer with inline citation links (used for rendered markup only)
// Single source drives both the FAQPage schema node and the rendered #faq section.
const FAQS: { question: string; answer: string; answerHtml: string }[] = [
  {
    question: 'What is the success rate of NaProTechnology?',
    answer:
      `The most cited figure is 62.1% adjusted-cumulative live birth, from a Madrid cohort of 1,310 couples followed up to 36 months. That plateau is reached at the 31-to-33-month follow-up band, not at 12 months. Crude take-home-baby rate in the same cohort was 35.3%.\n\nAge shapes the outcome substantially. In the Madrid data: 83.7% for women aged 18-30, 63.2% for ages 31-35, 53.3% for ages 36-40, and 24.4% for women over 40.\n\nFor couples who had already failed IVF before starting restorative care, a separate cohort showed 18.4% crude live birth and 32.1% adjusted-cumulative. Mean age in that group was 37.2, with an average of 2.1 prior IVF cycles.\n\nWhich metric matters depends on the question. Crude rates count outcomes over a fixed window. Adjusted-cumulative rates account for follow-up time and censored cases, and tend to climb as couples stay in care. The time-curve data make clear that 12-month snapshots consistently undercount outcomes: the Madrid cohort showed 28.9% at 12 months, rising to 50.0% at the 22-to-24-month band, and the plateau of 62.1% not until 31 to 33 months. Reading a 12-month figure as the final answer is the most common way these outcomes get undercounted.`,
    answerHtml:
      `The most cited figure is 62.1% adjusted-cumulative live birth, from a Madrid cohort of 1,310 couples followed up to 36 months. That plateau is reached at the 31-to-33-month follow-up band, not at 12 months. Crude take-home-baby rate in the same cohort was 35.3%. <a href="/library/natural-procreative-technology-naprotechnology-for-infertility-take-home-baby-ra-recv02qu0r8ycnzoa/" class="faq-cite">[source]</a>\n\nAge shapes the outcome substantially. In the Madrid data: 83.7% for women aged 18-30, 63.2% for ages 31-35, 53.3% for ages 36-40, and 24.4% for women over 40. <a href="/library/natural-procreative-technology-naprotechnology-for-infertility-take-home-baby-ra-recv02qu0r8ycnzoa/" class="faq-cite">[source]</a>\n\nFor couples who had already failed IVF before starting restorative care, a separate cohort showed 18.4% crude live birth and 32.1% adjusted-cumulative. Mean age in that group was 37.2, with an average of 2.1 prior IVF cycles. <a href="/library/healthy-singleton-pregnancies-from-restorative-reproductive-medicine-rrm-after-f-recior3akxtg2a6ya/" class="faq-cite">[source]</a>\n\nWhich metric matters depends on the question. Crude rates count outcomes over a fixed window. Adjusted-cumulative rates account for follow-up time and censored cases, and tend to climb as couples stay in care. The time-curve data make clear that 12-month snapshots consistently undercount outcomes: the Madrid cohort showed 28.9% at 12 months, rising to 50.0% at the 22-to-24-month band, and the plateau of 62.1% not until 31 to 33 months. Reading a 12-month figure as the final answer is the most common way these outcomes get undercounted.`,
  },
  {
    question: 'Is RRM more effective than IVF?',
    answer:
      `The outcome data favor RRM across the available studies, and the comparison is more direct than it appears.\n\nA 2025 Dublin cohort of 187 treated couples, benchmarked against contemporaneous CDC and SART IVF registry data, showed 42% live birth for RRM versus 40% for SART (women under 43), and 44% for RRM versus 41% for CDC (women under 41). That is the first published direct head-to-head comparison of RRM and IVF outcomes. A 2025 systematic review placed RRM success rates at 40-60% versus 30-40% for ART.\n\nOne denominator difference matters. IVF success rates are typically reported per embryo transfer or per cycle, not per couple. RRM outcomes are per couple. A couple who goes through three IVF cycles appears three times in IVF's per-cycle denominator. That arithmetic inflates IVF's apparent rate and makes direct comparisons harder than they look. When researchers hold the denominator constant, the restorative approach compares well.\n\nThe deeper difference is what the two approaches are doing. RRM identifies and treats the underlying cause of reproductive failure. IVF bypasses that cause. The couple's original condition remains after IVF proceeds. That is a categorical distinction, not a marginal one.`,
    answerHtml:
      `The outcome data favor RRM across the available studies, and the comparison is more direct than it appears.\n\nA 2025 Dublin cohort of 187 treated couples, benchmarked against contemporaneous CDC and SART IVF registry data, showed 42% live birth for RRM versus 40% for SART (women under 43), and 44% for RRM versus 41% for CDC (women under 41). That is the first published direct head-to-head comparison of RRM and IVF outcomes. <a href="/library/restorative-reproductive-medicine-rrm-outcomes-compared-to-in-vitro-fertilization-rec4qqhafqb8stlnd/" class="faq-cite">[source]</a> A 2025 systematic review placed RRM success rates at 40-60% versus 30-40% for ART. <a href="/library/revitalizing-reproductive-health-innovations-and-future-frontiers-in-restorative-reccddj5kun7yn1ir/" class="faq-cite">[source]</a>\n\nOne denominator difference matters. IVF success rates are typically reported per embryo transfer or per cycle, not per couple. RRM outcomes are per couple. A couple who goes through three IVF cycles appears three times in IVF's per-cycle denominator. That arithmetic inflates IVF's apparent rate and makes direct comparisons harder than they look. When researchers hold the denominator constant, the restorative approach compares well.\n\nThe deeper difference is what the two approaches are doing. RRM identifies and treats the underlying cause of reproductive failure. IVF bypasses that cause. The couple's original condition remains after IVF proceeds. That is a categorical distinction, not a marginal one.`,
  },
  {
    question: 'How does RRM compare to IVF on safety?',
    answer:
      `The safety profile favors restorative care, and the gap is clinically meaningful.\n\nFrom the 2025 Dublin cohort, singleton preterm birth after RRM was 4.0%, compared to 11.8% for IVF singletons in the CDC benchmark. For all pregnancies, RRM preterm was 6.5% versus 14.4% for IVF in the SART benchmark. Both pairs are preterm birth rates.\n\nPopulation-level data confirm the direction. One large population study found the adjusted odds of preterm birth were roughly 3 times higher after ART compared to never-treated women. A second study in already-subfertile women found IVF was associated with roughly 4 times higher adjusted odds of preterm birth compared to those who conceived without IVF.\n\nThe mechanism is direct. RRM results in a single naturally conceived embryo developing in its own uterine environment. IVF frequently produces multiple pregnancies, and multiples drive the majority of preterm births and NICU admissions in IVF outcomes. Even among singletons, IVF confers elevated risk above what the couple's underlying subfertility would predict. The preterm gap is consistent and clinically significant for families weighing this decision.`,
    answerHtml:
      `The safety profile favors restorative care, and the gap is clinically meaningful.\n\nFrom the 2025 Dublin cohort, singleton preterm birth after RRM was 4.0%, compared to 11.8% for IVF singletons in the CDC benchmark. For all pregnancies, RRM preterm was 6.5% versus 14.4% for IVF in the SART benchmark. Both pairs are preterm birth rates. <a href="/library/restorative-reproductive-medicine-rrm-outcomes-compared-to-in-vitro-fertilization-rec4qqhafqb8stlnd/" class="faq-cite">[source]</a>\n\nPopulation-level data confirm the direction. One large population study found the adjusted odds of preterm birth were roughly 3 times higher after ART compared to never-treated women. <a href="/library/fertility-treatments-and-adverse-perinatal-outcomes-in-a-population-based-sampli-rec9u2zrqqgyuipxq/" class="faq-cite">[source]</a> A second study in already-subfertile women found IVF was associated with roughly 4 times higher adjusted odds of preterm birth compared to those who conceived without IVF. <a href="/library/fertility-treatments-and-the-risk-of-preterm-birth-among-women-with-subfertility-recpxh63cqyktiu3x/" class="faq-cite">[source]</a>\n\nThe mechanism is direct. RRM results in a single naturally conceived embryo developing in its own uterine environment. IVF frequently produces multiple pregnancies, and multiples drive the majority of preterm births and NICU admissions in IVF outcomes. Even among singletons, IVF confers elevated risk above what the couple's underlying subfertility would predict. The preterm gap is consistent and clinically significant for families weighing this decision.`,
  },
  {
    question: 'Is RRM evidence-based?',
    answer:
      `Yes. RRM is grounded in published, peer-reviewed literature spanning 14 cohort studies, a systematic review, and a narrative review across 11 countries, with documented populations and defined endpoints.\n\nThe evidence base is observational. That is the same foundation on which IVF's own effectiveness rests. IVF expanded into widespread clinical practice before any randomized controlled trials compared it to expectant management. The published RRM literature meets the same standard: real populations, documented outcomes, peer-reviewed journals.\n\nThe studies report consistent findings across independent research groups in Ireland, Spain, the United States, Italy, and elsewhere. The populations differ, the follow-up windows differ, and the rate-calculation methods differ, which is why this page labels each figure with its source and context. Consistency across independent cohorts using different methods is a meaningful signal.\n\nEvidence-based means grounded in published literature with documented populations and defined endpoints. RRM meets that standard.`,
    answerHtml:
      `Yes. RRM is grounded in published, peer-reviewed literature spanning 14 cohort studies, a systematic review, and a narrative review across 11 countries, with documented populations and defined endpoints.\n\nThe evidence base is observational. That is the same foundation on which IVF's own effectiveness rests. IVF expanded into widespread clinical practice before any randomized controlled trials compared it to expectant management. The published RRM literature meets the same standard: real populations, documented outcomes, peer-reviewed journals.\n\nThe studies report consistent findings across independent research groups in Ireland, Spain, the United States, Italy, and elsewhere. The populations differ, the follow-up windows differ, and the rate-calculation methods differ, which is why this page labels each figure with its source and context. Consistency across independent cohorts using different methods is a meaningful signal.\n\nEvidence-based means grounded in published literature with documented populations and defined endpoints. RRM meets that standard.`,
  },
  {
    question: 'Are there randomized controlled trials comparing RRM and IVF?',
    answer:
      `No head-to-head RCT comparing RRM and IVF exists. The first published direct head-to-head comparison was a 2025 retrospective cohort from Dublin, benchmarked against contemporaneous CDC and SART IVF registry data. It showed RRM at 42-44% live birth versus IVF at 40-41%, depending on the registry and age cutoff.\n\nThe absence of an RRM-vs-IVF RCT is real. So is this: IVF scaled into a global industry treating millions of couples before any RCT ever compared it to expectant management. A Cochrane review identified only two small randomized trials, covering 86 women, that examined IVF versus expectant management. The standard now demanded of RRM is a standard IVF never had to meet. That asymmetry is worth naming.`,
    answerHtml:
      `No head-to-head RCT comparing RRM and IVF exists. The first published direct head-to-head comparison was a 2025 retrospective cohort from Dublin, benchmarked against contemporaneous CDC and SART IVF registry data. It showed RRM at 42-44% live birth versus IVF at 40-41%, depending on the registry and age cutoff. <a href="/library/restorative-reproductive-medicine-rrm-outcomes-compared-to-in-vitro-fertilization-rec4qqhafqb8stlnd/" class="faq-cite">[source]</a>\n\nThe absence of an RRM-vs-IVF RCT is real. So is this: IVF scaled into a global industry treating millions of couples before any RCT ever compared it to expectant management. A Cochrane review identified only two small randomized trials, covering 86 women, that examined IVF versus expectant management. The standard now demanded of RRM is a standard IVF never had to meet. That asymmetry is worth naming.`,
  },
];

// Single JSON-LD @graph block (precedent: art-registries-and-codes). The
// BreadcrumbList node is NOT here: GuideLayout owns the single BreadcrumbList.
const graph: Record<string, unknown>[] = [
  {
    '@type': ['Article', 'MedicalWebPage'],
    headline: 'RRM Success Rates: What the Published Evidence Shows',
    description:
      'What does the published evidence show for Restorative Reproductive Medicine? Outcomes across 14 cohorts, 11 countries, 2008-2026, including the first head-to-head RRM vs IVF comparison.',
    image: 'https://rrmacademy.org/og/rrm-success-rates.png',
    author: { '@id': 'https://rrmacademy.org/#organization' },
    reviewedBy: { '@id': 'https://rrmacademy.org/#naomi-whittaker' },
    publisher: {
      '@type': 'EducationalOrganization',
      '@id': 'https://rrmacademy.org/#organization',
      name: 'RRM Academy',
    },
    datePublished: PUBLISH_DATE,
    dateModified: LAST_MODIFIED,
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': PAGE_URL,
    },
    about: {
      '@type': 'MedicalTherapy',
      name: 'Restorative Reproductive Medicine',
      alternateName: 'RRM',
    },
    articleSection: SECTIONS.map((s) => s.title),
    hasPart: SECTIONS.map((s) => ({
      '@type': 'WebPageElement',
      name: s.title,
      url: `${PAGE_URL}#${s.id}`,
    })),
    citation: citationCompendium,
  },
];

// Emit FAQPage only when FAQS is populated (T10).
if (FAQS.length > 0) {
  graph.push({
    '@type': 'FAQPage',
    mainEntity: FAQS.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  });
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': graph,
};
---

<GuideLayout
  slug="rrm-success-rates"
  jsonLd={jsonLd}
  tocItems={TOC_ITEMS}
  wideContainer={true}
  disclaimerHtml={null}
  baseLayout={{ markdownUrl: '/rrm-success-rates.md', ogType: 'article', publishDate: PUBLISH_DATE, speakable: ['.pillar-lead', 'h1'], trackScroll: true }}
>
  <span data-pagefind-meta="type:Guide" style="display:none"></span>
  <span data-pagefind-meta="title:RRM Success Rates" style="display:none"></span>

          {/* Lede lives inside the prose column (right 2/3) so the sticky TOC
              aligns to it from the top, per the standard pillar layout. The
              pillar-lead is the speakable answer span. */}
          <p class="pillar-lead"><strong>This page brings together the published research on how well Restorative Reproductive Medicine (RRM) and <a href="/naprotechnology/">NaProTechnology</a> work. It collects outcome studies from 2008 to today and lays out what each one found, with the context needed to read the numbers correctly.</strong></p>
          <p>The page covers live birth and pregnancy rates, how RRM results compare with IVF, pregnancy safety, cost, and findings for specific conditions including endometriosis, PCOS, and recurrent miscarriage. Every study links to its full library record.</p>
          <p>The studies measured success in different ways, in different groups of couples, and over different time periods. Rates vary as a result. These are real-world studies conducted across documented populations, and many of those populations skew toward couples who arrived with prior diagnoses and prior treatment failures, making the published rates a conservative picture of what RRM achieves. Each figure on this page appears with its source and the study context it came from.</p>

          {/* Section skeletons. SectionShare renders the H2 (id + share/anchor
              controls) -- do NOT emit a second h2 inside any section. Each
              section's body is filled by a later task per the slot comment. */}

          <section id="at-a-glance">
            <SectionShare id="at-a-glance" title="The Evidence at a Glance" />
            {/* T9: Key Takeaways aside + at-a-glance framing prose. */}

            <aside class="tldr" aria-label="Key takeaways">
              <h3>Key Takeaways</h3>
              <ul>
                <li>Crude live-birth rates across 14 RRM cohorts range from 18.4% (<a href="/library/healthy-singleton-pregnancies-from-restorative-reproductive-medicine-rrm-after-f-recior3akxtg2a6ya/">RRM after IVF failure, 24 months</a>) to 41.5% (<a href="/library/restorative-reproductive-medicine-for-infertility-and-recurrent-miscarriage-in-t-0016c5f1/">mixed infertility, 24 months</a>).</li>
                <li>Adjusted-cumulative live-birth rates range from 29% to 73.6% across the same corpus, with the variance driven by <a href="/library/restorative-reproductive-medicine-for-infertility-and-recurrent-miscarriage-in-t-0016c5f1/">population</a> and <a href="/library/restorative-reproductive-medicine-for-infertility-in-two-family-medicine-clinics-recyiv7uvglmix9ex/">follow-up window</a>.</li>
                <li>Age is the strongest predictor: in the <a href="/library/natural-procreative-technology-naprotechnology-for-infertility-take-home-baby-ra-recv02qu0r8ycnzoa/">largest published cohort (n=1,310)</a>, adjusted-cumulative live-birth rates ranged from 83.7% (ages 18-30) to 24.4% (over 40).</li>
                <li>The <a href="/library/restorative-reproductive-medicine-rrm-outcomes-compared-to-in-vitro-fertilization-rec4qqhafqb8stlnd/">first head-to-head comparison</a> found RRM crude live-birth rates of 42-44% comparable to contemporaneous SART/CDC IVF benchmarks of 40-41% in the same age band, with lower RRM singleton preterm rates (4.0% vs 11.8% CDC IVF).</li>
                <li>The figures on this page come from published cohorts across 11 countries, each labeled by metric, rate type, and follow-up window so they read correctly. Many of those cohorts enrolled couples who had already failed prior treatment, meaning the reported rates reflect a harder-to-treat population than the IVF benchmarks they sit against.</li>
                <li>A full <a href="/library/revitalizing-reproductive-health-innovations-and-future-frontiers-in-restorative-reccddj5kun7yn1ir/">RRM course runs ~$2,000-$5,000</a>; US IVF is <a href="https://www.asrm.org/practice-guidance/ethics-opinions/disparities-in-access-to-effective-treatment-for-infertility-in-the-united-states-an-ethics-committee-opinion-2021/" rel="noopener">~$19,200 per cycle</a> and frequently <a href="/library/costs-of-infertility-treatment-results-from-an-18month-prospective-cohort-study-8owrwrej/">$50,000+ cumulatively to one live birth</a>.</li>
              </ul>
            </aside>

            <p>The stat cards above display two ranges: crude live-birth rates (18.4% to 41.5%) and adjusted-cumulative live-birth rates (29% to 73.6%). These two metrics measure different things. Crude rates count live births among all couples who started treatment. Adjusted-cumulative (life-table) rates account for couples who withdrew or whose follow-up ended early, estimating the probability of a live birth over the full follow-up window. A crude rate and an adjusted-cumulative rate from different cohorts cannot be compared against each other. The ranges also span heterogeneous cohorts: different populations, follow-up lengths, entry criteria, and RRM methods. Fourteen cohort studies, a systematic review, and a narrative review informed this page. What the numbers share is that they come from published literature with documented populations and defined endpoints.</p>

            {/* T8: headline summary stat cards, derived from the verified corpus. */}
            <div class="stat-grid">
              <div class="stat-card">
                <span class="stat-card__value">{pct(crudeLow)} to {pct(crudeHigh)}</span>
                <span class="stat-card__label">Crude live-birth rate across cohorts</span>
              </div>
              <div class="stat-card">
                <span class="stat-card__value">{pct(adjLow)} to {pct(adjHigh)}</span>
                <span class="stat-card__label">Adjusted cumulative live-birth rate</span>
              </div>
              <div class="stat-card">
                <span class="stat-card__value">{studyCount}</span>
                <span class="stat-card__label">Verified cohort studies across {countryCount} countries</span>
              </div>
              <div class="stat-card">
                <span class="stat-card__value">${data.cost.rrm_course_usd.replace('-', ' to $')}</span>
                <span class="stat-card__label">RRM course ~$2-5K vs US IVF ~$19K per cycle</span>
              </div>
            </div>

            <figure class="chart-figure">
              <img src="/images/rrm-success-rates/cross-study-lbr.svg" alt="Grouped horizontal bars of adjusted cumulative live-birth rate at 24 months across seven RRM cohorts, with crude live-birth rate as a second paler bar. Ukraine 2020 flagged lower-tier journal; Australia 2021 flagged medRxiv preprint." class="chart-light" loading="lazy" width="760" height="640" />
              <img src="/images/rrm-success-rates/cross-study-lbr-dark.svg" alt="Grouped horizontal bars of adjusted cumulative live-birth rate at 24 months across seven RRM cohorts, with crude live-birth rate as a second paler bar. Ukraine 2020 flagged lower-tier journal; Australia 2021 flagged medRxiv preprint." class="chart-dark" loading="lazy" width="760" height="640" />
              <figcaption>Adjusted cumulative (life-table or Kaplan-Meier) live-birth rate at 24 months for the seven live-birth cohorts, paired with each cohort's crude rate. Cohorts differ in case mix, denominators and follow-up, so this is a compendium rather than a randomized comparison.</figcaption>
            </figure>
          </section>

          <section id="outcome-studies">
            <SectionShare id="outcome-studies" title="The Outcome Studies" />
            {/* T9: section intro prose. */}

            <p>Reading reproductive medicine outcome data accurately requires knowing exactly what was measured. Two concepts cause the most confusion.</p>
            <p><strong>Crude vs. adjusted-cumulative rates.</strong> A crude live-birth rate divides the number of live births by the number of couples who started treatment, treating everyone who dropped out as a non-success. An adjusted-cumulative (life-table) rate censors withdrawals and estimates the probability of success over time, accounting for the fact that some couples left before the study ended rather than failing. The same cohort can show a crude rate of 18% and an adjusted-cumulative rate of 32%, and both figures are correct; they measure <a href="/library/healthy-singleton-pregnancies-from-restorative-reproductive-medicine-rrm-after-f-recior3akxtg2a6ya/">different things</a>.</p>
            <p><strong>Per-couple vs. per-cycle rates.</strong> Most RRM outcome studies report per-couple rates: what fraction of couples who enrolled achieved a live birth over a defined follow-up period. Most IVF registry benchmarks report per-cycle or per-embryo-transferred rates: what fraction of individual transfer events resulted in a live birth. A 24-month per-couple RRM rate and a per-embryo-transferred IVF rate use different denominators. The most common reading error in reproductive medicine outcomes literature is comparing these two figures as if they were equivalent. This page labels every rate's denominator type explicitly.</p>
            <p>The studies in the table below are grouped by primary outcome type: live-birth cohorts, conception cohorts, systematic reviews, and safety comparators. Within each group, studies appear in chronological order. Follow-up windows are noted for every cohort because a 12-month rate and a 36-month rate from the same cohort cannot be compared to each other without that context.</p>

            {/* T8: master evidence table, grouped by outcome type. Each group is a
                separate table inside the same .table-wrap scroll flow with a
                group subheading, so live-birth, conception and methods/review
                rows are visually distinct and never blended. */}
            <div class="table-wrap">
              {studyGroups.map((group) => (
                <div class="study-group">
                  <h3 class="study-group__heading">
                    <span class="study-group__title">{group.heading}</span>
                    <span class="study-group__count">{group.rows.length} {group.rows.length === 1 ? 'study' : 'studies'}</span>
                  </h3>
                  <table>
                    <thead>
                      <tr>
                        <th scope="col">Study</th>
                        <th scope="col">Journal · Year · Country</th>
                        <th scope="col">n</th>
                        <th scope="col">Population</th>
                        <th scope="col">Outcome</th>
                      </tr>
                    </thead>
                    <tbody>
                      {group.rows.map((s) => (
                        <tr>
                          <td>
                            <a href={`/library/${s.librarySlug}/`}>{s.authors} ({s.year})</a>
                          </td>
                          <td>{provenance(s)}</td>
                          <td>{s.n != null ? s.n.toLocaleString('en-US') : '—'}</td>
                          <td>{s.population}</td>
                          <td>
                            {formatOutcome(s)}
                            {badgesFor(s).length > 0 && (
                              <span class="badge-row">
                                {badgesFor(s).map((b) => (
                                  <span class="ev-badge">{b}</span>
                                ))}
                              </span>
                            )}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              ))}
            </div>

            <p class="table-footnote"><strong>Footnote on intervention scope.</strong> Not every study in the conception and methods groups tested a full medical and surgical RRM protocol. Several evaluated fertility-awareness training alone. Marshell and colleagues 2019 stratified couples by Billings cervical-mucus charting; Frank-Herrmann and colleagues 2017 trained couples in the Sensiplan symptothermal method. Both report conception outcomes from charting-based timing without the targeted diagnostic and treatment component that defines comprehensive NaProTechnology. Read those rates as fertility-awareness training outcomes, not as comprehensive RRM outcomes.</p>

            <p class="table-footnote"><strong>Footnote on iNEST.</strong> The iNEST paper (Stanford and colleagues 2022) is an enrollment and methods report, not an outcomes cohort. By its own account, clinical sites had missing data for about one-third of participants, and the authors caution that this level of missing data limits generalizability and that differential loss to follow-up may bias outcomes. Treat its 57% any-pregnancy and 44% any-live-birth figures as descriptive feasibility numbers, not as efficacy estimates.</p>

            <figure class="chart-figure">
              <img src="/images/rrm-success-rates/by-country.svg" alt="A replication and coverage table, one row per country, showing the number of independent studies and the headline RRM success rate as text with its outcome-type label. Rates are shown as text, not as bars on a shared scale, because the outcome types (live-birth vs conception, crude vs adjusted-cumulative) are not directly comparable across countries." class="chart-light" loading="lazy" width="760" height="600" />
              <img src="/images/rrm-success-rates/by-country-dark.svg" alt="A replication and coverage table, one row per country, showing the number of independent studies and the headline RRM success rate as text with its outcome-type label. Rates are shown as text, not as bars on a shared scale, because the outcome types (live-birth vs conception, crude vs adjusted-cumulative) are not directly comparable across countries." class="chart-dark" loading="lazy" width="760" height="600" />
              <figcaption>International replication: 14 independent studies across 11 countries. Each headline rate is shown as text and labeled by outcome type (live-birth versus conception, crude versus adjusted-cumulative) because those denominators are not directly comparable across countries.</figcaption>
            </figure>
          </section>

          <section id="rrm-vs-ivf">
            <SectionShare id="rrm-vs-ivf" title="How RRM Compares to IVF and ART" />
            {/* T9: comparison framing prose (denominator caveats, head-to-head context). */}

            <p>The first direct head-to-head comparison of RRM and IVF outcomes in the same clinical population <a href="/library/restorative-reproductive-medicine-rrm-outcomes-compared-to-in-vitro-fertilization-rec4qqhafqb8stlnd/">appeared in 2025</a>. Among 187 couples who committed to RRM treatment at a Dublin clinic (mean age 36.4, 19% with prior IVF, mean 32.2 months trying), 41% achieved a live birth and 52% conceived within 24 months. The paper benchmarked these crude rates against CDC and SART IVF registry data from the same year. In age bands under 43, RRM crude live-birth rates were 42-44%, comparable to the SART and CDC benchmarks of 40-41% for IVF. It is a single-center retrospective cohort benchmarked against contemporaneous CDC and SART IVF registry data from the same year. It is the first published head-to-head comparison of RRM and IVF outcomes.</p>
            <p>For broader scale, the largest published <a href="/library/natural-procreative-technology-naprotechnology-for-infertility-take-home-baby-ra-recv02qu0r8ycnzoa/">NaProTechnology cohort to date</a> enrolled 1,310 couples across a five-year single-center study in Madrid. The crude live-birth rate was 35.3%. The adjusted-cumulative rate reached 50% at 22-24 months and plateaued at 62.1% from 31 months onward. These rates come from a cohort with a mean age of 35.0 and 27.5% prior ART. They are not directly comparable to IVF per-cycle benchmarks.</p>
            <p>A full course of NaProTechnology-based care typically runs $2,000 to $5,000, covering evaluation, targeted diagnostics, and treatment for the underlying conditions driving infertility <a href="/library/revitalizing-reproductive-health-innovations-and-future-frontiers-in-restorative-reccddj5kun7yn1ir/">[source]</a>. The right comparison for that number is the full cost of IVF to reach a baby, which runs far higher than a single cycle.</p>
            <p>A single IVF cycle in the United States, including medications, runs about $19,200 <a href="https://www.asrm.org/practice-guidance/ethics-opinions/disparities-in-access-to-effective-treatment-for-infertility-in-the-united-states-an-ethics-committee-opinion-2021/" rel="noopener">[source]</a>. Most couples do not succeed in one cycle. A US prospective cohort put the total treatment cost per successful outcome at roughly $61,000 <a href="/library/costs-of-infertility-treatment-results-from-an-18month-prospective-cohort-study-8owrwrej/">[source]</a>. A more recent patient-reported figure is about $50,000 across an average of 2.3 cycles <a href="https://www.fertilityiq.com/ivf-in-vitro-fertilization/costs-of-ivf" rel="noopener">[source]</a>. A global review figure of $10,000 to $15,000 per IVF cycle also exists <a href="/library/revitalizing-reproductive-health-innovations-and-future-frontiers-in-restorative-reccddj5kun7yn1ir/">[source]</a>, but that is a worldwide average; it reads low for the US market. The honest comparison is RRM's full course cost to IVF's cumulative cost to a live birth: $2,000 to $5,000 for care that diagnoses and treats the problem, versus roughly $50,000 to $61,000 for a technology that bypasses it.</p>
            <p>The <a href="/art-registries-and-codes/">ART registries and reporting codes page</a> covers how IVF outcomes are measured, categorized, and reported at the population level.</p>

