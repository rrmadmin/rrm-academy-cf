---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatCards from '../../components/StatCards.astro';
import SupporterTicker from '../../components/SupporterTicker.astro';
import SupporterWall from '../../components/SupporterWall.astro';
import FoundingSupporters from '../../components/FoundingSupporters.astro';

const pageTitle = 'Help the Next Generation Find Restorative Care';
const pageDescription = 'Women lose years searching for real care. Your gift to the RRM Foundation builds the verified RRM Care Directory, so the next generation of women and girls finds an RRM-trained clinician on the first try.';
const canonical = 'https://rrmacademy.org/providers/';

// $10,000 goal. The live thermometer fetches real dollars raised from
// /api/fund-progress (campaign='provider-directory'); these are the honest
// server-rendered defaults shown until that fetch resolves.
const GOAL_CENTS = 1000000;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DonateAction',
  name: pageTitle,
  description: pageDescription,
  url: canonical,
  recipient: {
    '@type': 'NGO',
    name: 'Restorative Reproductive Medicine Foundation Inc.',
    url: 'https://rrmacademy.org',
    taxID: '93-4594315',
    nonprofitStatus: 'Nonprofit501c3',
  },
};
---
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonical}
  jsonLd={jsonLd}
>
  <div class="page-wrapper">
    <div class="container container--narrow">

      <!-- Hero -->
      <header class="fund-hero">
        <p class="fund-eyebrow">RRM Care Directory</p>
        <h1 class="fund-title">Help the next generation of women and girls find restorative care</h1>
        <p class="fund-subhead">You remember what the search cost you: the years, the dismissals, the doors that closed. Your gift builds the verified directory of RRM-trained clinicians, so the next girl never has to search the way you did.</p>
      </header>

      <!-- Live thermometer + give widget -->
      <section id="give" class="fund-panel card" aria-labelledby="fund-give-heading">
        <h2 id="fund-give-heading" class="sr-only">Donate to the care directory</h2>

        <div
          class="fund-thermo"
          id="fund-thermo"
          role="progressbar"
          aria-valuemin="0"
          aria-valuemax={GOAL_CENTS}
          aria-valuenow="0"
          data-goal-cents={GOAL_CENTS}
          aria-label="Raised toward our $10,000 goal"
        >
          <div class="fund-thermo__head">
            <span class="fund-thermo__raised" id="fund-raised">$0</span>
            <span class="fund-thermo__goal">raised of $10,000 goal</span>
          </div>
          <div class="fund-thermo__track">
            <div class="fund-thermo__fill" id="fund-fill"></div>
          </div>
          <p class="fund-thermo__meta" id="fund-supporters" hidden></p>
        </div>

        <div class="fund-give">
          <div class="fund-amounts" role="group" aria-label="Choose a gift amount">
            <button type="button" class="fund-amount-btn" data-amount="2500" aria-pressed="false">$25</button>
            <button type="button" class="fund-amount-btn active" data-amount="5000" aria-pressed="true">$50</button>
            <button type="button" class="fund-amount-btn" data-amount="10000" aria-pressed="false">$100</button>
            <button type="button" class="fund-amount-btn" data-amount="25000" aria-pressed="false">$250</button>
          </div>
          <div class="fund-custom">
            <label for="fund-custom-amount" class="form-label">Or enter another amount</label>
            <div class="fund-custom-wrap">
              <span class="fund-currency" aria-hidden="true">$</span>
              <input type="number" id="fund-custom-amount" class="form-input" min="5" max="999999" inputmode="numeric" placeholder="Enter amount" />
            </div>
          </div>
          <button type="button" id="fund-give-btn" class="btn btn--primary btn--lg fund-give-btn">Give $50 for the next generation</button>
          <p id="fund-error" class="fund-error" role="alert" hidden></p>
        </div>
      </section>

      <!-- Recent supporters (hides until there are gifts) -->
      <section class="fund-section fund-recognition" aria-label="Recent supporters">
        <SupporterTicker />
      </section>

      <!-- The ask -->
      <section class="fund-section">
        <p class="fund-ask">You remember the years it took: appointments that went nowhere, answers that were not answers, time you cannot get back. The next generation of women and girls does not have to inherit that. We are raising $10,000 to build and launch the RRM Care Directory, so that when a daughter, a niece, or a young woman you will never meet starts looking for real care, she finds a verified, RRM-trained clinician on the first try. Your gift to the RRM Foundation funds verification, expansion, and the infrastructure that keeps every listing current.</p>
      </section>

      <!-- Stat band: the cost of the wait -->
      <section class="fund-stats" aria-labelledby="fund-stats-heading">
        <h2 id="fund-stats-heading" class="fund-stats__heading">This is the wait we are trying to end</h2>
        <div class="fund-stats__grid">
          <div class="fund-stat">
            <span class="fund-stat__num">9 years</span>
            <span class="fund-stat__label">The median time a woman waits, from her first symptom to a diagnosis of endometriosis.</span>
          </div>
          <div class="fund-stat">
            <span class="fund-stat__num">Up to 1 in 10</span>
            <span class="fund-stat__label">Women of reproductive age live with endometriosis. Many are still waiting for someone to name it.</span>
          </div>
          <div class="fund-stat">
            <span class="fund-stat__num">6+ visits</span>
            <span class="fund-stat__label">A third of women see a doctor six or more times before anyone takes their pain seriously.</span>
          </div>
        </div>
        <p class="fund-stats__note">Endometriosis is the clearest measure of a pattern that repeats across the conditions restorative medicine treats: real, diagnosable, and missed for years. A directory of clinicians actually trained to look is how the wait gets shorter.</p>
      </section>

      <!-- Why your gift matters -->
      <section class="fund-section" aria-labelledby="fund-why-heading">
        <h2 id="fund-why-heading">What your gift makes possible</h2>
        <div class="fund-why-grid">
          <div class="fund-why-card card">
            <h3>A name she can trust</h3>
            <p>When she finds a clinician here, the listing is real: restorative training confirmed, practice verified, contact information that works. Her first call is not another dead end.</p>
          </div>
          <div class="fund-why-card card">
            <h3>Care within reach</h3>
            <p>More clinicians trained in NaProTechnology, FEMM, and related methods, in more places, so the nearest real answer is not three states away and no one has to settle for being dismissed.</p>
          </div>
          <div class="fund-why-card card">
            <h3>Ready when she needs it</h3>
            <p>The girl asking her first hard questions years from now will find a directory that is still accurate, still current, and waiting for her.</p>
          </div>
        </div>
      </section>

      <!-- Story -->
      <section class="fund-section" aria-labelledby="fund-story-heading">
        <h2 id="fund-story-heading">She should not have to search like you did</h2>
        <p>Most women lose those years the same way: pain called normal, symptoms waved off, birth control offered as the only answer, and the slow, grinding sense that no one is ever going to look deeper. And the years are not empty. The disease progresses. Pain worsens. For many, fertility quietly narrows. By the time a woman finally finds a clinician trained to treat root causes, some of what the waiting cost her cannot be given back.</p>
        <p>The RRM Care Directory will be one searchable, trustworthy home for clinicians trained in NaProTechnology, FEMM, and related restorative methods. Every listing is verified against training credentials, contact information, and practice status before it goes live, and kept current after it does, so it works the first time someone needs it.</p>
        <p>Verification, data infrastructure, and upkeep cost real money. Most of us would never spend this on ourselves. But this is not for you. It is for the teenage girl whose pain is being dismissed today, for your daughters and nieces, and for women you will never meet who are still being told nothing more can be done. Build it so they never search the way you did.</p>
      </section>

      <!-- Recognition: by the numbers + who is building this (hides until gifts arrive) -->
      <section class="fund-section fund-recognition" aria-label="People building the directory">
        <StatCards />
        <SupporterWall />
        <FoundingSupporters />
      </section>

      <!-- Closing CTA -->
      <section class="fund-cta-close">
        <p class="fund-cta-close__line">Nine years, or one search. Your gift decides which one the next girl gets.</p>
        <a href="#give" class="btn btn--primary btn--lg fund-cta-close__btn">Give for the next generation</a>
      </section>

      <!-- Donor FAQ -->
      <section class="fund-section" aria-labelledby="fund-faq-heading">
        <h2 id="fund-faq-heading">Questions</h2>
        <div class="fund-faq">
          <details class="fund-faq-item">
            <summary>Who receives my gift?</summary>
            <p>Your gift goes to the RRM Foundation (EIN 93-4594315), the 501(c)(3) public charity that supports RRM Academy's educational mission. RRM Academy is the educational platform. The Foundation is the charitable entity that receives donations.</p>
          </details>
          <details class="fund-faq-item">
            <summary>How will my gift be used?</summary>
            <p>Your gift funds verification, directory expansion, and the infrastructure that keeps listings current. After standard payment processing fees, gifts are applied to building and maintaining the directory.</p>
          </details>
          <details class="fund-faq-item">
            <summary>When will the directory launch?</summary>
            <p>The directory launches once verification is complete. Funding directly accelerates that work. Every listing is checked before it goes live, because a directory you cannot trust is worse than no directory at all.</p>
          </details>
        </div>
      </section>

      <p class="fund-trust">
        Gifts go to the RRM Foundation, a registered 501(c)(3) nonprofit (EIN 93-4594315).
        Contributions are tax-deductible to the extent permitted by law.
      </p>

    </div>
  </div>

  <script>
    import { initFundThermo } from '../../scripts/fund-thermo';
    const root = document.getElementById('fund-thermo');
    if (root) {
      const goal = Number(root.dataset.goalCents) || 0;
      initFundThermo(root, goal);
    }
  </script>

  <script is:inline>
    (function () {
      // ---- Give widget ----
      var amountBtns = document.querySelectorAll('.fund-amount-btn');
      var customInput = document.getElementById('fund-custom-amount');
      var giveBtn = document.getElementById('fund-give-btn');
      var errorEl = document.getElementById('fund-error');
      var selectedCents = 5000;

      var entryReferrer = '';
      var entryUrl = '';
      try {
        entryReferrer = sessionStorage.getItem('entry_ref') || '';
        entryUrl = sessionStorage.getItem('entry_url') || '';
      } catch (e) { /* storage blocked (Safari strict / private mode) — proceed without attribution */ }

      function setButtonLabel(cents) {
        var d = cents / 100;
        var amount = (cents % 100 === 0)
          ? Math.round(d).toLocaleString()
          : d.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        giveBtn.textContent = 'Give $' + amount + ' for the next generation';
      }

      function selectAmount(cents) {
        selectedCents = cents;
        setButtonLabel(cents);
        amountBtns.forEach(function (b) {
          var isSel = parseInt(b.dataset.amount, 10) === cents;
          b.classList.toggle('active', isSel);
          b.setAttribute('aria-pressed', isSel ? 'true' : 'false');
        });
      }

      function clearAmountSelection() {
        amountBtns.forEach(function (b) {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
      }

      amountBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          customInput.value = '';
          selectAmount(parseInt(btn.dataset.amount, 10));
        });
      });

      customInput.addEventListener('input', function () {
        var raw = customInput.value.trim();
        if (raw === '') {
          selectAmount(5000);
          return;
        }
        var val = parseFloat(raw);
        if (val >= 5) {
          selectedCents = Math.round(val * 100);
          giveBtn.textContent = 'Give $' + val.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 2 }) + ' for the next generation';
          clearAmountSelection();
        } else {
          selectedCents = Math.round((val || 0) * 100);
          giveBtn.textContent = 'Give for the next generation';
          clearAmountSelection();
        }
      });

      giveBtn.addEventListener('click', function () {
        if (selectedCents < 500) {
          errorEl.textContent = 'Minimum gift is $5.';
          errorEl.hidden = false;
          return;
        }
        errorEl.hidden = true;
        giveBtn.disabled = true;
        var label = giveBtn.textContent;
        giveBtn.textContent = 'Redirecting...';

        fetch('/api/create-checkout', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            mode: 'payment',
            amount: selectedCents,
            campaign: 'provider-directory',
            entry_referrer: entryReferrer,
            entry_url: entryUrl,
          }),
        })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            if (data.ok && data.url) {
              window.location.href = data.url;
            } else {
              errorEl.textContent = data.error || 'Something went wrong. Please try again.';
              errorEl.hidden = false;
              giveBtn.disabled = false;
              giveBtn.textContent = label;
            }
          })
          .catch(function () {
            errorEl.textContent = 'Connection error. Please try again.';
            errorEl.hidden = false;
            giveBtn.disabled = false;
            giveBtn.textContent = label;
          });
      });

      // bfcache restore: if the donor went to Stripe and hit back, the button
      // can be restored in its disabled "Redirecting..." state. Re-enable it.
      window.addEventListener('pageshow', function (e) {
        if (!e.persisted) return;
        giveBtn.disabled = false;
        setButtonLabel(selectedCents);
      });
    })();
  </script>
</BaseLayout>

<style>
  /* SP2 recognition: stack the social-proof components with breathing room */
  .fund-recognition {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  /* Hero */
  .fund-hero {
    text-align: center;
    padding: var(--space-8) 0 var(--space-6);
  }
  .fund-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 var(--space-3);
  }
  .fund-title {
    margin: 0 0 var(--space-4);
  }
  .fund-subhead {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 540px;
    margin: 0 auto;
  }

  /* Panel: thermometer + give */
  .fund-panel {
    max-width: 560px;
    margin: 0 auto var(--space-10);
    padding: var(--space-6);
  }

  /* Thermometer */
  .fund-thermo {
    margin-bottom: var(--space-6);
  }
  .fund-thermo__head {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .fund-thermo__raised {
    font-family: 'Cormorant Garamond', 'Georgia', serif;
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .fund-thermo__goal {
    font-size: 0.9375rem;
    color: var(--text-tertiary);
  }
  .fund-thermo__track {
    height: 14px;
    background: var(--border-light);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }
  .fund-thermo__fill {
    height: 100%;
    width: 0;
    background: var(--accent);
    border-radius: var(--radius-pill);
    /* one-time fill transition after the live fetch resolves */
    transition: width 0.6s ease-out;
  }
  .fund-thermo__meta {
    margin: var(--space-3) 0 0;
    font-size: 0.8125rem;
    color: var(--text-tertiary);
  }

  /* Give widget */
  .fund-amounts {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: var(--space-5);
  }
  .fund-amount-btn {
    flex: 1 1 auto;
    min-width: 72px;
    padding: 10px 18px;
    border: 1.5px solid var(--border-color);
    border-radius: var(--radius-pill);
    background: var(--bg-surface);
    color: var(--text-primary);
    font-size: 1rem;
    font-weight: 500;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, color 0.15s;
  }
  .fund-amount-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .fund-amount-btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px var(--focus-ring);
  }
  .fund-amount-btn.active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--white);
  }

  .fund-custom {
    max-width: 260px;
    margin: 0 auto var(--space-5);
  }
  .fund-custom .form-label {
    display: block;
    text-align: center;
    margin-bottom: var(--space-2);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-secondary);
  }
  .fund-custom-wrap {
    position: relative;
  }
  .fund-currency {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-tertiary);
    font-weight: 500;
  }
  .fund-custom .form-input {
    width: 100%;
    padding-left: var(--space-8);
    box-sizing: border-box;
    text-align: center;
  }

  .fund-give-btn {
    display: block;
    width: 100%;
  }
  .fund-error {
    color: var(--color-error);
    font-size: 0.8125rem;
    text-align: center;
    margin: var(--space-3) 0 0;
  }
  .fund-onetime-note {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    text-align: center;
    margin: var(--space-4) 0 0;
  }

  /* Sections */
  .fund-section {
    margin: 0 auto var(--space-10);
  }
  .fund-section h2 {
    font-size: 1.5rem;
    margin-bottom: var(--space-5);
  }
  .fund-section p {
    font-size: 0.9375rem;
    line-height: 1.8;
    color: var(--text-secondary);
    margin: 0 0 var(--space-4);
  }
  .fund-ask {
    font-size: 1.125rem !important;
    line-height: 1.8;
    color: var(--text-primary) !important;
    border-left: 3px solid var(--accent);
    padding-left: var(--space-5);
    margin: 0 !important;
  }

  /* Why grid */
  .fund-why-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  .fund-why-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
  }
  .fund-why-card h3 {
    font-size: 1.125rem;
    margin: 0;
    color: var(--text-primary);
  }
  .fund-why-card p {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Stat band */
  .fund-stats {
    margin: 0 auto var(--space-10);
    text-align: center;
  }
  .fund-stats__heading {
    font-size: 1.5rem;
    margin-bottom: var(--space-6);
  }
  .fund-stats__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-6);
  }
  .fund-stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: center;
  }
  .fund-stat__num {
    font-family: 'Cormorant Garamond', 'Georgia', serif;
    font-size: 2.75rem;
    font-weight: 600;
    line-height: 1;
    color: var(--accent);
  }
  .fund-stat__label {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 280px;
    margin: 0 auto;
  }
  .fund-stats__note {
    font-size: 0.9375rem;
    line-height: 1.8;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
  }

  /* Closing CTA */
  .fund-cta-close {
    text-align: center;
    margin: 0 auto var(--space-10);
  }
  .fund-cta-close__line {
    font-family: 'Cormorant Garamond', 'Georgia', serif;
    font-size: 1.5rem;
    line-height: 1.4;
    color: var(--text-primary);
    max-width: 520px;
    margin: 0 auto var(--space-5);
  }
  .fund-cta-close__btn {
    display: inline-block;
  }

  /* Donor FAQ */
  .fund-faq {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .fund-faq-item {
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
    background: var(--bg-surface);
  }
  .fund-faq-item summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--text-primary);
    list-style: none;
  }
  .fund-faq-item summary::-webkit-details-marker {
    display: none;
  }
  .fund-faq-item summary::after {
    content: '+';
    float: right;
    color: var(--accent);
    font-weight: 600;
  }
  .fund-faq-item[open] summary::after {
    content: '\2013';
  }
  .fund-faq-item p {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin: var(--space-3) 0 0;
  }

  /* Trust line */
  .fund-trust {
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--text-tertiary);
    text-align: center;
    max-width: 480px;
    margin: 0 auto var(--space-10);
  }

  /* Responsive */
  @media (min-width: 640px) {
    .fund-why-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .fund-stats__grid {
      grid-template-columns: repeat(3, 1fr);
      align-items: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fund-thermo__fill {
      transition: none;
    }
  }
</style>
