---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProviderCard from '../../../components/ProviderCard.astro';
import {
  getTelehealthProviders,
  stateName,
  NON_STATE_REGIONS,
  type Provider,
} from '../../../lib/providers';

const providers = getTelehealthProviders();

// Count located-in (non-INTL) states represented among telehealth providers,
// for the counts line and the "browse by state" tile grid.
const stateCounts: Record<string, number> = {};
for (const p of providers) {
  if (!NON_STATE_REGIONS.has(p.region)) stateCounts[p.region] = (stateCounts[p.region] || 0) + 1;
}
const stateTiles = Object.entries(stateCounts)
  .map(([code, count]) => ({ code, name: stateName(code), count }))
  .sort((a, b) => a.name.localeCompare(b.name));

const pageUrl = 'https://rrmacademy.org/providers/telehealth/';

const faqs = [
  {
    q: 'What is telehealth RRM care?',
    a: 'Telehealth restorative reproductive medicine lets you work with an RRM-trained clinician by video or phone instead of traveling to a clinic. Because diagnosis in RRM starts with fertility-cycle charting you record at home, much of the work, including history, chart review, lab and ultrasound ordering, and treatment planning, can be done remotely.',
  },
  {
    q: 'Can RRM and fertility-awareness providers treat me remotely?',
    a: 'Many can. The providers listed here offer telehealth visits. A clinician can interpret your charts, order labs and imaging near you, prescribe treatment, and follow your progress over time. Hands-on procedures such as surgery are still done in person, often coordinated with a local clinic.',
  },
  {
    q: 'Does telehealth availability depend on my state?',
    a: 'Yes. Clinicians are generally licensed in specific states, so telehealth coverage can vary by where you live. Browse by state below, or confirm directly with a provider that they can see patients in your state before you book.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ItemList',
      '@id': `${pageUrl}#providers`,
      name: 'Telehealth RRM and Fertility-Awareness Providers',
      numberOfItems: providers.length,
      itemListElement: providers.map((p: Provider, i: number) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `https://rrmacademy.org/providers/${p.slug}/`,
        name: p.displayName,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://rrmacademy.org/' },
        { '@type': 'ListItem', position: 2, name: 'Find a Provider', item: 'https://rrmacademy.org/providers/' },
        { '@type': 'ListItem', position: 3, name: 'Telehealth Providers', item: pageUrl },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---
<BaseLayout
  bodyClass="page-providers-collection"
  title="Telehealth RRM & Fertility-Awareness Providers"
  description={`Find ${providers.length} restorative reproductive medicine and fertility-awareness providers offering telehealth visits for remote, root-cause fertility care.`}
  canonicalUrl={pageUrl}
  jsonLd={jsonLd}
  noindex={false}
>
  <section class="collection">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/providers/">Find a Provider</a>
        <span aria-hidden="true"> &rsaquo; </span>
        <span>Telehealth</span>
      </nav>

      <header class="collection__head">
        <h1>Telehealth RRM &amp; Fertility-Awareness Providers</h1>
        <p class="collection__intro">
          Remote restorative reproductive care makes it possible to work with an RRM-trained
          clinician wherever you live. Because diagnosis begins with fertility-cycle charting
          you record at home, history, chart review, lab and ultrasound ordering, and treatment
          planning can all happen by video. Read the <a href="/library/">research library</a> for
          the evidence base, or learn <a href="/what-is-rrm/">what restorative reproductive
          medicine is</a> before you reach out.
        </p>
        <p class="collection__counts tabular">
          {providers.length.toLocaleString()} telehealth providers
          <span aria-hidden="true"> &middot; </span>
          {stateTiles.length} states represented
        </p>
      </header>

      <section class="collection__all" aria-labelledby="all-heading">
        <h2 id="all-heading" class="collection__label">All telehealth providers</h2>
        <div class="provider-grid" data-pagefind-ignore="all">
          {providers.map((p) => <ProviderCard provider={p} />)}
        </div>
      </section>

      {stateTiles.length > 0 && (
        <section class="collection__bystate" aria-labelledby="bystate-heading">
          <h2 id="bystate-heading" class="collection__label">Browse telehealth by state</h2>
          <ul class="state-grid" role="list" data-pagefind-ignore="all">
            {stateTiles.map((s) => (
              <li>
                <a href={`/providers/telehealth/${s.code}/`} class="state-tile">
                  <span class="state-tile__name">{s.name}</span>
                  <span class="state-tile__count tabular">{s.count.toLocaleString()}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="collection__faq" aria-labelledby="faq-heading">
        <h2 id="faq-heading">Frequently asked questions</h2>
        <dl class="faq-list">
          {faqs.map((f) => (
            <div class="faq-item">
              <dt>{f.q}</dt>
              <dd>{f.a}</dd>
            </div>
          ))}
        </dl>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .collection { padding: var(--space-8) 0 var(--space-16); }

  .breadcrumb {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    margin-bottom: var(--space-4);
  }
  .breadcrumb a { color: var(--text-secondary); }

  .collection__head { margin-bottom: var(--space-10); }
  .collection__head h1 { margin: 0 0 var(--space-4); }
  .collection__intro {
    max-width: var(--max-width-article);
    color: var(--text-secondary);
    font-size: 1.0625rem;
    line-height: 1.6;
    margin: 0 0 var(--space-4);
  }
  .collection__counts {
    font-size: 0.875rem;
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
    margin: 0;
  }

  .collection__label {
    font-size: 0.75rem;
    font-family: var(--font-body);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    margin: 0 0 var(--space-4);
  }

  .collection__all,
  .collection__bystate { margin-bottom: var(--space-10); }

  .provider-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-4);
  }

  .state-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: var(--space-2);
  }
  .state-tile {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--text-primary);
    transition: border-color 0.15s, transform 0.15s;
  }
  .state-tile:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    text-decoration: none;
  }
  .state-tile:focus-visible {
    outline: 0;
    border-color: var(--purple-700);
    box-shadow: 0 0 0 3px var(--focus-ring);
  }
  .state-tile__name { font-weight: 500; font-size: 0.9375rem; }
  .state-tile__count {
    font-size: 0.75rem;
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
  }

  .collection__faq h2 { margin: 0 0 var(--space-5); }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: var(--max-width-article);
    margin: 0;
  }
  .faq-item dt {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }
  .faq-item dd {
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.6;
  }
</style>
