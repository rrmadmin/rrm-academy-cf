---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProviderCard from '../../../components/ProviderCard.astro';
import {
  getTelehealthProviders,
  stateName,
  US_STATE_NAMES,
  NON_STATE_REGIONS,
  type Provider,
} from '../../../lib/providers';

export async function getStaticPaths() {
  // Helpers live INSIDE getStaticPaths: Astro hoists this function to module
  // scope, so render-body consts/functions are not in scope here. We compute
  // the serving list per state and pass it through as props.
  // telehealthStates is sparse + mixed-format (2-letter codes AND full names);
  // normalize to a 2-letter code.
  const nameToCode: Record<string, string> = Object.fromEntries(
    Object.entries(US_STATE_NAMES).map(([c, n]) => [n.toLowerCase(), c]),
  );
  const codesFor = (p: Provider): string[] =>
    (p.telehealthStates || [])
      .map((s) => {
        const t = String(s).trim();
        if (t.length === 2) return t.toUpperCase();
        return nameToCode[t.toLowerCase()] || '';
      })
      .filter(Boolean);
  // A telehealth provider "serves" a state if it declares that state OR is
  // physically located in it (located-in fallback, since most do not publish
  // per-state coverage).
  const serves = (p: Provider, code: string): boolean => codesFor(p).includes(code) || p.region === code;

  const tele = getTelehealthProviders();
  const codes = new Set<string>();
  for (const p of tele) {
    if (!NON_STATE_REGIONS.has(p.region)) codes.add(p.region);
    for (const c of codesFor(p)) if (US_STATE_NAMES[c]) codes.add(c);
  }
  return [...codes].sort().map((code) => ({
    params: { state: code },
    props: {
      code,
      serving: tele.filter((p) => serves(p, code)),
      declaredCount: tele.filter((p) => codesFor(p).includes(code)).length,
    },
  }));
}

const { code, serving, declaredCount } = Astro.props;
const name = stateName(code);

const pageUrl = `https://rrmacademy.org/providers/telehealth/${code}/`;

const faqs = [
  {
    q: `How do I see an RRM doctor by telehealth if I live in ${name}?`,
    a: `Start with the providers listed on this page. Each offers telehealth visits and either serves ${name} directly or practices there. Open a provider profile to find contact and scheduling details, then confirm with the provider that they can see patients in ${name}, since telehealth licensing rules differ by state.`,
  },
  {
    q: 'What can a telehealth RRM visit cover?',
    a: 'Because restorative reproductive medicine diagnosis begins with fertility-cycle charting you record at home, a telehealth visit can cover your history, chart interpretation, lab and ultrasound ordering, prescriptions, and ongoing treatment planning. Hands-on procedures such as surgery still happen in person, often coordinated with a local clinic.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ItemList',
      '@id': `${pageUrl}#providers`,
      name: `Telehealth RRM Providers Serving ${name}`,
      numberOfItems: serving.length,
      itemListElement: serving.map((p: Provider, i: number) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `https://rrmacademy.org/providers/${p.slug}/`,
        name: p.displayName,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://rrmacademy.org/' },
        { '@type': 'ListItem', position: 2, name: 'Find a Provider', item: 'https://rrmacademy.org/providers/' },
        { '@type': 'ListItem', position: 3, name: 'Telehealth Providers', item: 'https://rrmacademy.org/providers/telehealth/' },
        { '@type': 'ListItem', position: 4, name: `Serving ${name}`, item: pageUrl },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---
<BaseLayout
  bodyClass="page-providers-collection"
  title={`Telehealth RRM Providers Serving ${name}`}
  description={`Find restorative reproductive medicine providers offering telehealth visits to patients in ${name}. ${serving.length} providers serving ${name} remotely.`}
  canonicalUrl={pageUrl}
  jsonLd={jsonLd}
  noindex={false}
>
  <section class="collection">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/providers/">Find a Provider</a>
        <span aria-hidden="true"> &rsaquo; </span>
        <a href="/providers/telehealth/">Telehealth</a>
        <span aria-hidden="true"> &rsaquo; </span>
        <span>{name}</span>
      </nav>

      <header class="collection__head">
        <h1>Telehealth RRM Providers Serving {name}</h1>
        <p class="collection__intro">
          These restorative reproductive medicine providers offer telehealth visits and may be
          able to care for patients in {name} remotely. Read the
          <a href="/library/">research library</a> for the evidence base, or learn
          <a href="/what-is-rrm/">what restorative reproductive medicine is</a> before you reach out.
        </p>
        <p class="collection__counts tabular">
          {serving.length.toLocaleString()} providers serving {name}
        </p>
        <p class="collection__note">
          {declaredCount > 0
            ? `${declaredCount} of these providers list ${name} in their telehealth coverage; the rest are telehealth-capable providers located in ${name}. Confirm coverage with the provider before booking.`
            : `Most providers do not publish per-state telehealth coverage, so this list shows telehealth-capable providers located in ${name}. Confirm coverage with the provider before booking.`}
        </p>
      </header>

      <section class="collection__all" aria-labelledby="all-heading">
        <h2 id="all-heading" class="collection__label">Telehealth providers serving {name}</h2>
        <div class="provider-grid" data-pagefind-ignore="all">
          {serving.map((p) => <ProviderCard provider={p} />)}
        </div>
      </section>

      <section class="collection__faq" aria-labelledby="faq-heading">
        <h2 id="faq-heading">Frequently asked questions</h2>
        <dl class="faq-list">
          {faqs.map((f) => (
            <div class="faq-item">
              <dt>{f.q}</dt>
              <dd>{f.a}</dd>
            </div>
          ))}
        </dl>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .collection { padding: var(--space-8) 0 var(--space-16); }

  .breadcrumb {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    margin-bottom: var(--space-4);
  }
  .breadcrumb a { color: var(--text-secondary); }

  .collection__head { margin-bottom: var(--space-10); }
  .collection__head h1 { margin: 0 0 var(--space-4); }
  .collection__intro {
    max-width: var(--max-width-article);
    color: var(--text-secondary);
    font-size: 1.0625rem;
    line-height: 1.6;
    margin: 0 0 var(--space-4);
  }
  .collection__counts {
    font-size: 0.875rem;
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
    margin: 0 0 var(--space-3);
  }
  .collection__note {
    font-size: 0.875rem;
    color: var(--text-tertiary);
    line-height: 1.55;
    margin: 0;
    max-width: var(--max-width-article);
  }

  .collection__label {
    font-size: 0.75rem;
    font-family: var(--font-body);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    margin: 0 0 var(--space-4);
  }

  .collection__all { margin-bottom: var(--space-10); }

  .provider-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-4);
  }

  .collection__faq h2 { margin: 0 0 var(--space-5); }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: var(--max-width-article);
    margin: 0;
  }
  .faq-item dt {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }
  .faq-item dd {
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.6;
  }
</style>
