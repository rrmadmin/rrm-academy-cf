---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProviderCard from '../../../components/ProviderCard.astro';
import {
  COLLECTION_METHODS,
  getProvidersByMethod,
  methodLabel,
  type Provider,
} from '../../../lib/providers';

export async function getStaticPaths() {
  // One collection page per canonical method that actually has providers.
  // Methods with zero matches are skipped entirely (no empty pages).
  return COLLECTION_METHODS
    .filter((m) => getProvidersByMethod(m).length > 0)
    .map((m) => ({ params: { method: m }, props: { method: m } }));
}

interface Props { method: string; }
const { method } = Astro.props;

const label = methodLabel(method);
const providers = getProvidersByMethod(method);

// Counts line inputs.
const stateSet = new Set(providers.filter((p) => p.region !== 'INTL').map((p) => p.region));
const teleProviders = providers.filter((p) => p.telehealth === 'yes');

// Telehealth strip: surface up to 8 telehealth-available providers first.
const teleStrip = teleProviders.slice(0, 8);

const pageUrl = `https://rrmacademy.org/providers/method/${method}/`;

// Per-method intro copy. Restorative framing, no em dashes. Falls back to a
// generic accurate sentence for any method without bespoke copy.
const METHOD_INTROS: Record<string, string> = {
  napro: 'NaProTechnology is a restorative reproductive medicine system that uses standardized fertility-cycle charting to identify and treat the underlying causes of conditions such as infertility, recurrent miscarriage, endometriosis, and PCOS, rather than bypassing or suppressing them.',
  creighton: 'The Creighton Model FertilityCare System is a standardized method of charting biological markers of the cycle. It serves as the diagnostic foundation for NaProTechnology, helping clinicians pinpoint and restore healthy reproductive function.',
  billings: 'The Billings Ovulation Method teaches a person to recognize natural cervical-mucus patterns to identify the fertile window. Providers use these observations to support family planning and to investigate cycle-related health concerns.',
  'sympto-thermal': 'Sympto-thermal methods combine basal body temperature with cervical-mucus and other fertility signs to map the cycle. Providers trained in these methods help patients understand their fertility and address underlying reproductive-health issues.',
  femm: 'FEMM (Fertility Education and Medical Management) pairs cycle-charting education with medical management, training patients to read their hormonal health and connecting them with clinicians who treat the root cause of cycle and fertility problems.',
  marquette: 'The Marquette Model uses an electronic hormonal monitor alongside cycle observations to identify the fertile window with precision. Providers apply it for family planning and to support the diagnosis of reproductive-health conditions.',
  neofertility: 'NeoFertility is a restorative reproductive medicine approach, rooted in fertility-awareness charting, that diagnoses and treats the underlying causes of infertility, miscarriage, and cycle disorders while working with the body rather than overriding it.',
};
const intro = METHOD_INTROS[method]
  || `${label} is a fertility-awareness-based method used within restorative reproductive medicine to chart the cycle and identify the underlying causes of reproductive-health concerns.`;

const faqs = [
  {
    q: `What is ${label}?`,
    a: intro,
  },
  {
    q: `How do I find a ${label} provider?`,
    a: `Browse the providers listed on this page. Each card links to a full profile with location, contact details, methods offered, and verification sources. You can also filter the wider directory by state or by telehealth availability to find a ${label} provider who fits your situation.`,
  },
  {
    q: `Can I see a ${label} provider by telehealth?`,
    a: teleProviders.length > 0
      ? `Yes. ${teleProviders.length} of the ${label} providers in this directory offer telehealth visits, so you may be able to receive care remotely. Telehealth availability can vary by state, so confirm coverage with the provider before booking.`
      : `Telehealth availability varies by provider and by state. Check each provider profile, or browse the telehealth directory, to confirm whether remote ${label} care is offered where you live.`,
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ItemList',
      '@id': `${pageUrl}#providers`,
      name: `${label} Providers`,
      numberOfItems: providers.length,
      itemListElement: providers.map((p: Provider, i: number) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `https://rrmacademy.org/providers/${p.slug}/`,
        name: p.displayName,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://rrmacademy.org/' },
        { '@type': 'ListItem', position: 2, name: 'Find a Provider', item: 'https://rrmacademy.org/providers/' },
        { '@type': 'ListItem', position: 3, name: `${label} Providers`, item: pageUrl },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---
<BaseLayout
  bodyClass="page-providers-collection"
  title={`${label} Providers | Find a Provider`}
  description={`Find ${label} providers offering restorative reproductive care. ${providers.length} providers across ${stateSet.size} states, ${teleProviders.length} offering telehealth.`}
  canonicalUrl={pageUrl}
  jsonLd={jsonLd}
  noindex={false}
>
  <section class="collection">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/providers/">Find a Provider</a>
        <span aria-hidden="true"> &rsaquo; </span>
        <span>{label}</span>
      </nav>

      <header class="collection__head">
        <h1>{label} Providers</h1>
        <p class="collection__intro">
          {intro} Explore the <a href="/library/">research library</a> for the evidence base,
          or read <a href="/what-is-rrm/">what restorative reproductive medicine is</a> to
          understand how these methods fit into root-cause fertility care.
        </p>
        <p class="collection__counts tabular">
          {providers.length.toLocaleString()} providers across {stateSet.size} states
          <span aria-hidden="true"> &middot; </span>
          {teleProviders.length.toLocaleString()} offer telehealth
        </p>
      </header>

      {teleStrip.length > 0 && (
        <section class="collection__strip" aria-labelledby="tele-strip-heading">
          <div class="collection__strip-head">
            <h2 id="tele-strip-heading" class="collection__label">Available via telehealth</h2>
            <a href="/providers/telehealth/" class="link-arrow">All telehealth providers &rarr;</a>
          </div>
          <div class="provider-grid" data-pagefind-ignore="all">
            {teleStrip.map((p) => <ProviderCard provider={p} />)}
          </div>
        </section>
      )}

      <section class="collection__all" aria-labelledby="all-heading">
        <h2 id="all-heading" class="collection__label">All {label} providers</h2>
        <div class="provider-grid" data-pagefind-ignore="all">
          {providers.map((p) => <ProviderCard provider={p} />)}
        </div>
      </section>

      <section class="collection__faq" aria-labelledby="faq-heading">
        <h2 id="faq-heading">Frequently asked questions</h2>
        <dl class="faq-list">
          {faqs.map((f) => (
            <div class="faq-item">
              <dt>{f.q}</dt>
              <dd>{f.a}</dd>
            </div>
          ))}
        </dl>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .collection { padding: var(--space-8) 0 var(--space-16); }

  .breadcrumb {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    margin-bottom: var(--space-4);
  }
  .breadcrumb a { color: var(--text-secondary); }

  .collection__head { margin-bottom: var(--space-10); }
  .collection__head h1 { margin: 0 0 var(--space-4); }
  .collection__intro {
    max-width: var(--max-width-article);
    color: var(--text-secondary);
    font-size: 1.0625rem;
    line-height: 1.6;
    margin: 0 0 var(--space-4);
  }
  .collection__counts {
    font-size: 0.875rem;
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
    margin: 0;
  }

  .collection__label {
    font-size: 0.75rem;
    font-family: var(--font-body);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    margin: 0;
  }

  .collection__strip,
  .collection__all { margin-bottom: var(--space-10); }

  .collection__strip-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }
  .collection__all .collection__label { margin-bottom: var(--space-4); }

  .link-arrow {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--accent);
    white-space: nowrap;
  }

  .provider-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-4);
  }

  .collection__faq h2 { margin: 0 0 var(--space-5); }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: var(--max-width-article);
    margin: 0;
  }
  .faq-item dt {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }
  .faq-item dd {
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.6;
  }
</style>
