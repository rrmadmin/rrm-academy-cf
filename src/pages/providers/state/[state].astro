---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProviderCard from '../../../components/ProviderCard.astro';
import {
  statesWithProviders,
  getProvidersInState,
  getTelehealthProviders,
  stateName,
  methodLabel,
  US_STATE_NAMES,
  type Provider,
} from '../../../lib/providers';

export async function getStaticPaths() {
  // One page per US state that has at least one located-in provider.
  return statesWithProviders().map((s) => ({
    params: { state: s.code },
    props: { code: s.code },
  }));
}

interface Props { code: string; }
const { code } = Astro.props;
const name = stateName(code);

// telehealthStates is sparse (only ~60 of 496 telehealth providers populate it)
// and inconsistent: some entries are 2-letter codes ("PA"), some full names
// ("Illinois"). Normalize both forms to a 2-letter code so matching is reliable.
const NAME_TO_CODE: Record<string, string> = Object.fromEntries(
  Object.entries(US_STATE_NAMES).map(([c, n]) => [n.toLowerCase(), c]),
);
function telehealthCodes(p: Provider): string[] {
  return (p.telehealthStates || [])
    .map((s) => {
      const t = String(s).trim();
      if (t.length === 2) return t.toUpperCase();
      return NAME_TO_CODE[t.toLowerCase()] || '';
    })
    .filter(Boolean);
}

// "Located in {state}" grid.
const located = getProvidersInState(code);

// Telehealth-in-state: a telehealth provider whose declared telehealthStates
// includes this code, OR (fallback, since telehealthStates is mostly empty) a
// telehealth provider physically located in this state.
const allTele = getTelehealthProviders();
const teleInState = allTele.filter(
  (p) => telehealthCodes(p).includes(code) || p.region === code,
);
// Coverage note: most telehealth providers do not declare per-state coverage,
// so this list is dominated by the located-in fallback. Surface that honestly.
const teleDeclaredCount = allTele.filter((p) => telehealthCodes(p).includes(code)).length;

// Method breakdown across located-in providers.
const methodCounts: Record<string, number> = {};
for (const p of located) for (const m of p.methods) methodCounts[m] = (methodCounts[m] || 0) + 1;
const methodBreakdown = Object.entries(methodCounts)
  .map(([id, count]) => ({ label: methodLabel(id), count }))
  .sort((a, b) => b.count - a.count);

const teleProvidersForList = allTele.length;
const pageUrl = `https://rrmacademy.org/providers/state/${code}/`;

// JSON-LD ItemList = located-in providers (the canonical set for this state).
const faqs = [
  {
    q: `Can I see an RRM doctor by telehealth in ${name}?`,
    a: teleInState.length > 0
      ? `Yes. ${teleInState.length} restorative reproductive medicine providers in this directory may offer telehealth visits to patients in ${name}, either by serving the state directly or by practicing there. Confirm state coverage with the provider before booking, since telehealth rules differ by state.`
      : `Telehealth options for ${name} depend on the individual provider and on state licensing rules. Check the providers located in ${name} below, or browse the wider telehealth directory, to confirm whether remote care is available where you live.`,
  },
  {
    q: 'How does telehealth fertility care work?',
    a: 'In restorative reproductive medicine, much of the diagnostic work begins with fertility-cycle charting, which patients can record at home and review with a clinician remotely. Telehealth visits cover history, chart interpretation, lab and ultrasound ordering, and treatment planning. Any hands-on care, such as surgery, still happens in person, often coordinated with a local clinic.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ItemList',
      '@id': `${pageUrl}#providers`,
      name: `Restorative Reproductive Medicine Providers in ${name}`,
      numberOfItems: located.length,
      itemListElement: located.map((p: Provider, i: number) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `https://rrmacademy.org/providers/${p.slug}/`,
        name: p.displayName,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://rrmacademy.org/' },
        { '@type': 'ListItem', position: 2, name: 'Find a Provider', item: 'https://rrmacademy.org/providers/' },
        { '@type': 'ListItem', position: 3, name: `Providers in ${name}`, item: pageUrl },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---
<BaseLayout
  bodyClass="page-providers-collection"
  title={`Restorative Reproductive Medicine Providers in ${name}`}
  description={`Find restorative reproductive medicine and fertility-awareness providers in ${name}. ${located.length} located in ${name}, plus telehealth options for remote care.`}
  canonicalUrl={pageUrl}
  jsonLd={jsonLd}
  noindex={false}
>
  <section class="collection">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/providers/">Find a Provider</a>
        <span aria-hidden="true"> &rsaquo; </span>
        <span>{name}</span>
      </nav>

      <header class="collection__head">
        <h1>Restorative Reproductive Medicine Providers in {name}</h1>
        <p class="collection__intro">
          These restorative reproductive medicine and fertility-awareness providers serve
          patients in {name} with root-cause fertility and reproductive-health care. Learn
          more in the <a href="/library/">research library</a> or read
          <a href="/what-is-rrm/">what restorative reproductive medicine is</a> before you reach out.
        </p>
        <p class="collection__counts tabular">
          {located.length.toLocaleString()} located in {name}
          <span aria-hidden="true"> &middot; </span>
          {teleInState.length.toLocaleString()} telehealth options
        </p>
      </header>

      <section class="collection__strip" aria-labelledby="tele-heading">
        <div class="collection__strip-head">
          <h2 id="tele-heading" class="collection__label">Available via telehealth in {name}</h2>
          <a href="/providers/telehealth/" class="link-arrow">All telehealth providers &rarr;</a>
        </div>
        {teleInState.length > 0 ? (
          <>
            <p class="collection__note">
              {teleDeclaredCount > 0
                ? `${teleDeclaredCount} providers list ${name} in their telehealth coverage; the rest are telehealth-capable providers located in ${name}. Confirm coverage before booking.`
                : `Most providers do not publish per-state telehealth coverage, so this list shows telehealth-capable providers located in ${name}. Confirm coverage before booking.`}
            </p>
            <div class="provider-grid" data-pagefind-ignore="all">
              {teleInState.map((p) => <ProviderCard provider={p} />)}
            </div>
          </>
        ) : (
          <p class="collection__note">
            No telehealth providers in this directory currently list {name} coverage. Browse
            the <a href="/providers/telehealth/">telehealth directory</a> to see providers who
            may be able to serve you remotely.
          </p>
        )}
      </section>

      {located.length > 0 && (
        <section class="collection__all" aria-labelledby="located-heading">
          <h2 id="located-heading" class="collection__label">Located in {name}</h2>
          <div class="provider-grid" data-pagefind-ignore="all">
            {located.map((p) => <ProviderCard provider={p} />)}
          </div>
        </section>
      )}

      {methodBreakdown.length > 0 && (
        <section class="collection__methods" aria-labelledby="methods-heading">
          <h2 id="methods-heading" class="collection__label">Methods in {name}</h2>
          <p class="collection__breakdown">
            {methodBreakdown.map((m, i) => (
              <span class="collection__breakdown-item">
                {m.label} <span class="tabular">({m.count})</span>{i < methodBreakdown.length - 1 ? ' · ' : ''}
              </span>
            ))}
          </p>
        </section>
      )}

      <section class="collection__faq" aria-labelledby="faq-heading">
        <h2 id="faq-heading">Frequently asked questions</h2>
        <dl class="faq-list">
          {faqs.map((f) => (
            <div class="faq-item">
              <dt>{f.q}</dt>
              <dd>{f.a}</dd>
            </div>
          ))}
        </dl>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .collection { padding: var(--space-8) 0 var(--space-16); }

  .breadcrumb {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    margin-bottom: var(--space-4);
  }
  .breadcrumb a { color: var(--text-secondary); }

  .collection__head { margin-bottom: var(--space-10); }
  .collection__head h1 { margin: 0 0 var(--space-4); }
  .collection__intro {
    max-width: var(--max-width-article);
    color: var(--text-secondary);
    font-size: 1.0625rem;
    line-height: 1.6;
    margin: 0 0 var(--space-4);
  }
  .collection__counts {
    font-size: 0.875rem;
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
    margin: 0;
  }

  .collection__label {
    font-size: 0.75rem;
    font-family: var(--font-body);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    margin: 0;
  }

  .collection__strip,
  .collection__all,
  .collection__methods { margin-bottom: var(--space-10); }

  .collection__strip-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .collection__all .collection__label { margin-bottom: var(--space-4); }
  .collection__methods .collection__label { margin-bottom: var(--space-3); }

  .collection__note {
    font-size: 0.875rem;
    color: var(--text-tertiary);
    line-height: 1.55;
    margin: 0 0 var(--space-4);
    max-width: var(--max-width-article);
  }

  .collection__breakdown {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.7;
  }
  .collection__breakdown-item .tabular { font-variant-numeric: tabular-nums; color: var(--text-tertiary); }

  .link-arrow {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--accent);
    white-space: nowrap;
  }

  .provider-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-4);
  }

  .collection__faq h2 { margin: 0 0 var(--space-5); }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: var(--max-width-article);
    margin: 0;
  }
  .faq-item dt {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }
  .faq-item dd {
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.6;
  }
</style>
