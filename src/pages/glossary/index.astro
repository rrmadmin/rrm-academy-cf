  /* Mobile: keep the strip on ONE compact, horizontally-scrollable line so it
     never consumes large vertical space and never causes page overflow. The
     "Jump to" label stays pinned; the chips scroll under it. */
  @media (max-width: 640px) {
    .az-index {
      gap: var(--space-1);
