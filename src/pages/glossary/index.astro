<script>
  // @ts-nocheck
  // Glossary directory client enhancement. Operates ENTIRELY over the
  // already-rendered DOM — never re-fetches or re-renders the term list.
  //
  //  1. Clamp: every entry with more than its first <p> block gets collapsed to
  //     its first paragraph + a "Show more" disclosure. Single-paragraph terms
  //     are left fully visible. The full body always stays in the DOM (display
  //     toggled, never removed) for AEO + Pagefind.
  //  2. Search: hides entries whose data-search haystack doesn't contain the
  //     query; auto-expands a clamped entry when the match is in the hidden part.
  //  3. Topic chips + tag buttons: set the active topic; non-matching entries
  //     hide. Search + topic compose (AND).
  //  4. Empty letter dividers hide; A-Z jump letters dim.
  (function () {
    var list = document.querySelector('[data-glossary-list]');
    if (!list) return;
    var input = document.getElementById('glossary-search-input');
    var clearBtn = document.getElementById('glossary-search-clear');
    var countEl = document.getElementById('glossary-count');
    var noMatchEl = document.getElementById('glossary-no-matches');
    var resetLink = document.getElementById('glossary-reset');
    var chips = Array.prototype.slice.call(document.querySelectorAll('.glossary-chips .sr-chip'));
    var azLetterLinks = Array.prototype.slice.call(document.querySelectorAll('[data-az-letter]'));
    var groups = Array.prototype.slice.call(document.querySelectorAll('.glossary-letter-group'));
    var entries = Array.prototype.slice.call(document.querySelectorAll('[data-glossary-entry]'));
    var total = parseInt((countEl && countEl.getAttribute('data-total')) || entries.length, 10);

    var activeTopic = 'all';
    var query = '';

    // ── Clamp setup ──
    // The GlossaryTerm body renders as sibling blocks after the
    // .glossary-term__header (and after a possible <slot name="post-heading">,
    // which the pillar doesn't use). We collapse every block AFTER the first
    // <p>/<ul>/<ol> content block up to (but not including) the
    // .term-spoke-link paragraph, which must always stay visible.
    function clampEntry(entry) {
      var header = entry.querySelector('.glossary-term__header');
      if (!header) return;
      // Walk forward from the header to collect body blocks.
      var node = header.nextElementSibling;
      var blocks = [];
      while (node) {
        if (node.classList && node.classList.contains('term-spoke-link')) break;
        blocks.push(node);
        node = node.nextElementSibling;
      }
      if (blocks.length <= 1) return; // first paragraph only — nothing to clamp
      // Hide every block after the first.
      var spokeLink = entry.querySelector('.term-spoke-link');
      for (var i = 1; i < blocks.length; i++) {
        blocks[i].classList.add('glossary-clamp-hidden');
      }
      entry.classList.add('is-clamped');

      // Build the Show-more button. Inserted right before the spoke link (or
      // appended) so it reads as the disclosure control for the collapsed body.
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'glossary-show-more';
      btn.setAttribute('aria-expanded', 'false');
      var labelSpan = document.createElement('span');
      labelSpan.className = 'glossary-show-more__label';
      labelSpan.textContent = 'Show more';
      var chev = document.createElement('span');
      chev.className = 'glossary-show-more__chevron';
      chev.setAttribute('aria-hidden', 'true');
      chev.textContent = '▾';
      btn.appendChild(labelSpan);
      btn.appendChild(chev);
      btn.addEventListener('click', function () {
        var expanded = entry.classList.toggle('is-expanded');
        entry.classList.toggle('is-clamped', !expanded);
        btn.setAttribute('aria-expanded', expanded ? 'true' : 'false');
        labelSpan.textContent = expanded ? 'Show less' : 'Show more';
      });
      entry._glossaryShowMore = btn;
      entry._glossaryClampable = true;
      if (spokeLink) spokeLink.parentNode.insertBefore(btn, spokeLink);
      else entry.appendChild(btn);
    }

    entries.forEach(clampEntry);

    function expandEntry(entry) {
      if (!entry._glossaryClampable) return;
      entry.classList.add('is-expanded');
      entry.classList.remove('is-clamped');
      if (entry._glossaryShowMore) {
        entry._glossaryShowMore.setAttribute('aria-expanded', 'true');
        var lbl = entry._glossaryShowMore.querySelector('.glossary-show-more__label');
        if (lbl) lbl.textContent = 'Show less';
      }
    }
    function recollapseEntry(entry) {
      if (!entry._glossaryClampable) return;
      entry.classList.remove('is-expanded');
      entry.classList.add('is-clamped');
      if (entry._glossaryShowMore) {
        entry._glossaryShowMore.setAttribute('aria-expanded', 'false');
        var lbl = entry._glossaryShowMore.querySelector('.glossary-show-more__label');
        if (lbl) lbl.textContent = 'Show more';
      }
    }

    // ── Filtering ──
    function applyFilters() {
      var q = query.trim().toLowerCase();
      var shown = 0;
      // Which first letters still have a visible entry.
      var letterHasVisible = {};

      for (var i = 0; i < entries.length; i++) {
        var entry = entries[i];
        var topicOk = activeTopic === 'all' || entry.getAttribute('data-topic') === activeTopic;
        var haystack = entry.getAttribute('data-search') || '';
        var searchOk = !q || haystack.indexOf(q) !== -1;
        var visible = topicOk && searchOk;
        entry.hidden = !visible;
        if (visible) {
          shown++;
          var grp = entry.closest('.glossary-letter-group');
          if (grp) letterHasVisible[grp.getAttribute('data-letter-group')] = true;
          // Auto-expand a clamped entry when the match is inside its hidden body
          // (not just the first paragraph / name). Recollapse when query clears.
          if (q && entry._glossaryClampable) {
            expandEntry(entry);
          } else if (!q && entry._glossaryClampable) {
            recollapseEntry(entry);
          }
        }
      }

      // Hide empty letter groups.
      for (var g = 0; g < groups.length; g++) {
        var letter = groups[g].getAttribute('data-letter-group');
        groups[g].hidden = !letterHasVisible[letter];
      }
      // Dim A-Z jump letters with no visible terms.
      for (var a = 0; a < azLetterLinks.length; a++) {
        var l = azLetterLinks[a].getAttribute('data-az-letter');
        if (letterHasVisible[l]) azLetterLinks[a].removeAttribute('data-az-empty');
        else azLetterLinks[a].setAttribute('data-az-empty', '');
      }

      // Count + no-match state.
      if (countEl) countEl.textContent = 'Showing ' + shown + ' of ' + total;
      if (noMatchEl) noMatchEl.hidden = shown !== 0;
    }

    // ── Search wiring ──
    var debounce;
    function onInput() {
      query = input.value;
      clearBtn.classList.toggle('hidden', !query);
      clearTimeout(debounce);
      debounce = setTimeout(applyFilters, 120);
    }
    if (input) input.addEventListener('input', onInput);
    if (clearBtn) clearBtn.addEventListener('click', function () {
      input.value = '';
      query = '';
      clearBtn.classList.add('hidden');
      applyFilters();
      input.focus();
    });

    // ── Topic chip wiring ──
    function setTopic(topic) {
      activeTopic = topic;
      for (var i = 0; i < chips.length; i++) {
        var isActive = chips[i].getAttribute('data-topic') === topic;
        chips[i].classList.toggle('sr-chip--active', isActive);
        chips[i].setAttribute('aria-pressed', isActive ? 'true' : 'false');
      }
      applyFilters();
    }
    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        setTopic(chip.getAttribute('data-topic'));
      });
    });
    // Per-term tag buttons act as topic filters too.
    document.querySelectorAll('[data-tag-filter]').forEach(function (tagBtn) {
      tagBtn.addEventListener('click', function () {
        setTopic(tagBtn.getAttribute('data-tag-filter'));
        var controls = document.querySelector('[data-glossary-controls]');
        if (controls && controls.scrollIntoView) controls.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    // ── Reset ──
    if (resetLink) resetLink.addEventListener('click', function () {
      if (input) input.value = '';
      query = '';
      if (clearBtn) clearBtn.classList.add('hidden');
      setTopic('all');
    });

    // Apply once on load (no-op unless a value was prefilled).
    applyFilters();
  })();
</script>
