  .az-index__letters li { margin: 0; }
  .az-index__letters a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 36px;
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
