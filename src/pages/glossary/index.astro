  /* ── Sticky control bar ── */
  .glossary-controls {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg-body);
    padding: var(--space-4) 0 var(--space-3);
    margin-bottom: var(--space-5);
    border-bottom: 1px solid var(--border-light);
