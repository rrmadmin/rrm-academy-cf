---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MaybeShell from '../../components/MaybeShell.astro';
import { isShellEnabled } from '../../lib/shell-routes';
import BackToTop from '../../components/BackToTop.astro';
import PdfDownload from '../../components/PdfDownload.astro';
import LastUpdated from '../../components/LastUpdated.astro';
import GlossaryTerm from '../../components/GlossaryTerm.astro';
import glossaryData from '../../data/glossary.json';
import pageDates from '../../data/page-dates.json';
import { safeJsonLd } from '../../lib/jsonld';

const SHELL_ENABLED = isShellEnabled('guides');

const PAGE_PATH = '/glossary/';
const LAST_MODIFIED = pageDates.dates[PAGE_PATH] || '2026-03-15';

// Static part metadata. `topic` is the short, scannable filter label shown as
// a per-term tag + chip; `desc` is the keyword-rich blurb reused in the intro
// so topical keywords stay on-page now that the Part <h2> sections are gone.
const PARTS = [
  { part: 'I',    id: 'core-rrm-principles',     title: 'Part I: Core RRM Principles',                       shortTitle: 'Core RRM Principles',                   topic: 'Core',        desc: 'foundational principles of restorative reproductive medicine' },
  { part: 'II',   id: 'fertility-awareness',     title: 'Part II: Fertility Awareness and Charting Methods', shortTitle: 'Fertility Awareness and Charting Methods', topic: 'FABMs',     desc: 'fertility awareness-based methods (FABMs) and cycle charting' },
  { part: 'III',  id: 'clinical-approaches',     title: 'Part III: Clinical Approaches',                     shortTitle: 'Clinical Approaches',                   topic: 'Clinical',    desc: 'NaProTechnology and other clinical RRM treatment approaches' },
  { part: 'IV',   id: 'diagnostic-tools',        title: 'Part IV: Diagnostic Tools and Techniques',          shortTitle: 'Diagnostic Tools and Techniques',       topic: 'Diagnostics', desc: 'diagnostic tools, hormone testing, and imaging techniques' },
  { part: 'V',    id: 'surgical-techniques',     title: 'Part V: Surgical Techniques',                       shortTitle: 'Surgical Techniques',                   topic: 'Surgery',     desc: 'reproductive surgical techniques and procedures' },
  { part: 'VI',   id: 'conditions',              title: 'Part VI: Key Conditions Addressed by RRM',          shortTitle: 'Key Conditions Addressed by RRM',       topic: 'Conditions',  desc: 'conditions RRM addresses such as endometriosis, PCOS, infertility, and recurrent miscarriage' },
  { part: 'VII',  id: 'overlapping-disciplines', title: 'Part VII: Overlapping Disciplines',                 shortTitle: 'Overlapping Disciplines',               topic: 'Overlapping', desc: 'overlapping disciplines in endocrinology, nutrition, and reproductive health' },
  { part: 'VIII', id: 'broader-framework',       title: 'Part VIII: The Broader RRM Framework',              shortTitle: 'The Broader RRM Framework',             topic: 'Framework',   desc: 'the broader ethical, scientific, and care-model framework of RRM' },
];
const PART_TO_TOPIC: Record<string, string> = Object.fromEntries(PARTS.map(p => [p.part, p.topic]));

interface GlossaryTerm {
  id: string;
  slug: string;
  name: string;
  part: string;
  sortOrder: number;
  bodyHtml: string;
  abbreviation: string | null;
  pillarLink: string | null;
  status: string;
}
interface GlossaryReference {
  refNum: number;
  anchorText: string;
  url: string;
  publisher: string | null;
  journal: string | null;
}
interface GlossaryAbbreviation {
  abbreviation: string;
  fullTerm: string;
  termSlug: string | null;
  sortOrder: number;
}
// Only render published terms. Drafts/classified entries in glossary.json
// must not appear in visible H3s, the A-Z index, or the DefinedTermSet
// JSON-LD; the latter would otherwise emit @id values that point at spoke
// pages getStaticPaths refuses to build (status='published' filter), causing
// structured-data references to 404.
const terms: GlossaryTerm[] = (glossaryData.terms ?? []).filter((t: GlossaryTerm) => t.status === 'published');
const references: GlossaryReference[] = glossaryData.references ?? [];
const abbreviations: GlossaryAbbreviation[] = (glossaryData.abbreviations ?? [])
  .slice()
  .sort((a: GlossaryAbbreviation, b: GlossaryAbbreviation) => (a.sortOrder ?? 0) - (b.sortOrder ?? 0));

// Plain-text searchable haystack per term (name + abbreviation + body, HTML
// stripped, lowercased). Stamped onto each rendered term as a data attribute so
// the client-side search filters over the already-rendered DOM (never re-fetch).
function plainText(html: string | null | undefined): string {
  if (!html) return '';
  return html.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
}

// ── Alphabetical-by-default directory ──
// Letter dividers REPLACE the 8 Part <h2> sections. Terms are flattened into a
// single A-Z list; each carries a topic tag (its Part's short name) for the
// click-to-filter control. Part grouping survives only as the topic taxonomy.
function firstLetter(name: string): string {
  const m = name.match(/\p{L}/u);
  return m ? m[0].toUpperCase() : '#';
}
const sortedTerms = terms
  .slice()
  .sort((a, b) => a.name.localeCompare(b.name, 'en', { sensitivity: 'base' }));

// Group into ordered [letter, terms[]] buckets for build-time dividers.
const azMap = new Map<string, GlossaryTerm[]>();
for (const t of sortedTerms) {
  const letter = firstLetter(t.name);
  if (!azMap.has(letter)) azMap.set(letter, []);
  azMap.get(letter)!.push(t);
}
const azLetters = [...azMap.keys()].sort((a, b) => a.localeCompare(b, 'en'));
const azGroups = azLetters.map(letter => ({ letter, items: azMap.get(letter)! }));

// Word count estimate (bodies + overview + key takeaways + refs).
function wordsIn(html: string | null | undefined): number {
  if (!html) return 0;
  const text = html.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
  return text ? text.split(' ').length : 0;
}
const bodyWords = terms.reduce((n, t) => n + wordsIn(t.bodyHtml), 0);
const FIXED_WORD_OVERHEAD = 600; // intro, key takeaways, abbr table labels, etc.
const wordCount = bodyWords + FIXED_WORD_OVERHEAD;

// Schema: MedicalWebPage + Article (UNCHANGED hard invariant — the per-Part
// articleSection / hasPart anchors still describe the topical taxonomy even
// though the visible layout is now alphabetical. The #<part-id> anchors are
// re-emitted as invisible landmarks at the start of the list so these URLs
// keep resolving for any external link or AI citation that targets them.)
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': ['Article', 'MedicalWebPage'],
  headline: 'RRM Glossary: A Detailed Reference to Restorative Reproductive Medicine',
  description: 'A detailed, evidence-based glossary of Restorative Reproductive Medicine (RRM) terminology covering core principles, fertility awareness methods, NaProTechnology, diagnostic tools, surgical techniques, key conditions, and abbreviations.',
  // Glossary is a compiled reference work — RRM Academy is the author entity,
  // Dr. Whittaker is the medical reviewer. Pillar guides (/what-is-rrm/, etc.)
  // keep Naomi as author since they're written in her clinical voice.
  author: { '@id': 'https://rrmacademy.org/#organization' },
  reviewedBy: { '@id': 'https://rrmacademy.org/#naomi-whittaker' },
  publisher: {
    '@type': 'EducationalOrganization',
    '@id': 'https://rrmacademy.org/#organization',
    name: 'RRM Academy',
  },
  datePublished: '2026-03-15',
  dateModified: LAST_MODIFIED,
  wordCount,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': 'https://rrmacademy.org/glossary/',
  },
  about: {
    '@type': 'MedicalTherapy',
    name: 'Restorative Reproductive Medicine',
    alternateName: 'RRM',
  },
  articleSection: [
    ...PARTS.map(p => p.shortTitle),
    'Abbreviations and Quick Reference',
    'References',
  ],
  hasPart: [
    { '@type': 'WebPageElement', name: 'Overview', url: 'https://rrmacademy.org/glossary/#overview' },
    ...PARTS.map(p => ({
      '@type': 'WebPageElement',
      name: p.shortTitle,
      url: `https://rrmacademy.org/glossary/#${p.id}`,
    })),
    { '@type': 'WebPageElement', name: 'Abbreviations and Quick Reference', url: 'https://rrmacademy.org/glossary/#abbreviations' },
    { '@type': 'WebPageElement', name: 'References', url: 'https://rrmacademy.org/glossary/#references' },
  ],
};

// Breadcrumb schema
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://rrmacademy.org/' },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://rrmacademy.org/guides/' },
    { '@type': 'ListItem', position: 3, name: 'Glossary', item: 'https://rrmacademy.org/glossary/' },
  ],
};

// DefinedTermSet: each term as a citable AEO entity (@id=#slug).
// Prefer the bold lead sentence; if short, also include the next paragraph for AEO citation pickup.
// Target ~600-800 chars (AEO sweet spot per SEO Operator review 2026-04-18).
function extractDescription(bodyHtml: string): string {
  if (!bodyHtml) return '';
  const stripped = bodyHtml.replace(/<sup\b[^>]*>[\s\S]*?<\/sup>/g, '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
  const boldMatch = bodyHtml.match(/<strong>([\s\S]+?)<\/strong>/);
  if (boldMatch) {
    const bold = boldMatch[1].replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
    if (bold.length >= 400) return bold.length > 800 ? bold.slice(0, 797) + '...' : bold;
    const idx = stripped.indexOf(bold);
    const start = idx >= 0 ? idx : 0;
    const window = stripped.slice(start, start + 800).trim();
    return window.length > 800 ? window.slice(0, 797) + '...' : window;
  }
  return stripped.length > 800 ? stripped.slice(0, 797) + '...' : stripped;
}
const TERM_SET_ID = 'https://rrmacademy.org/glossary/#defined-term-set';
const definedTermSetSchema = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  '@id': TERM_SET_ID,
  name: 'RRM Glossary',
  description: 'Evidence-based glossary of Restorative Reproductive Medicine terminology, methods, conditions, and procedures.',
  url: 'https://rrmacademy.org/glossary/',
  inLanguage: 'en-US',
  hasDefinedTerm: terms.map(t => {
    const entry: Record<string, unknown> = {
      '@type': 'DefinedTerm',
      '@id': `https://rrmacademy.org/glossary/${t.slug}/#term`,
      name: t.name,
      description: extractDescription(t.bodyHtml),
      inDefinedTermSet: TERM_SET_ID,
      url: `https://rrmacademy.org/glossary/${t.slug}/`,
    };
    if (t.abbreviation) entry.termCode = t.abbreviation;
    return entry;
  }),
};
---

<BaseLayout
  title="RRM Glossary: A Detailed Reference to Restorative Reproductive Medicine"
  description="Evidence-based glossary of RRM terminology: fertility awareness methods, NaProTechnology, diagnostic tools, surgical techniques, and key conditions."
  canonicalUrl="https://rrmacademy.org/glossary/"
  ogType="article"
  publishDate="2026-03-15"
  jsonLd={pageSchema}
  speakable={['.pillar-lead', '.pillar-lead strong']}
  chrome={SHELL_ENABLED ? 'shell' : 'default'}
  trackScroll
>
  <!-- Separate JSON-LD block for breadcrumbs -->
  <script type="application/ld+json" set:html={safeJsonLd(breadcrumbSchema)} />

  <!-- DefinedTermSet: per-term citable entities for AEO -->
  <script type="application/ld+json" set:html={safeJsonLd(definedTermSetSchema)} />

  <MaybeShell enabled={SHELL_ENABLED} context="page" currentPath={Astro.url.pathname} hasRail={SHELL_ENABLED}>
  {/* Right rail: A-Z jump nav lives here when the shell is enabled (Brian
      preference 2026-05-07). The collapsible <details> jump nav below is
      suppressed via the `!SHELL_ENABLED` gate to avoid duplication. Empty
      letters dim live (data-az-letter) as the client filter runs. */}
  {SHELL_ENABLED && (
    <Fragment slot="rail">
      <nav class="app-shell-middle-column__section glossary-rail" aria-label="Jump to a letter">
        <h2 class="app-shell-middle-column__heading">A-Z ({terms.length})</h2>
        <ol class="glossary-rail__letters">
          {azLetters.map(letter => (
            <li><a href={`#letter-${letter}`} data-az-letter={letter}>{letter}</a></li>
          ))}
        </ol>
      </nav>
    </Fragment>
  )}

  <div class="page-wrapper" data-pagefind-body>
    <span data-pagefind-meta="type:Guide" style="display:none"></span>
    <span data-pagefind-meta="title:RRM Glossary: A Detailed Reference" style="display:none"></span>
    <div class="container">

      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true"> &rsaquo; </span>
        <a href="/guides/">Guides</a>
        <span aria-hidden="true"> &rsaquo; </span>
        <span>Glossary</span>
      </nav>

      <h1>RRM Glossary: A Detailed Reference to Restorative Reproductive Medicine</h1>

      {/* Glossary byline: org-authored + clinically reviewed. */}
      <div class="author-byline">
        <div class="author-avatar-stack">
          <img src="/apple-touch-icon.png" alt="RRM Academy" class="author-byline__photo" width="48" height="48" />
          <img src="/images/authors/naomi-whittaker.webp" alt="Dr. Naomi Whittaker, MD" class="author-byline__photo" width="48" height="48" />
        </div>
        <div class="author-byline__text has-reviewer">
          <span class="byline-author">By <strong>RRM Academy</strong></span>
          <span class="byline-reviewer">Reviewed by <strong><a href="/commentary/rrm-spotlight-naomi-whittaker-md/">Dr. Naomi Whittaker, MD, Board-Certified OBGYN, MIGS, NFPMC, FCI</a></strong></span>
          <LastUpdated path="/glossary/" prefix="Updated" class="byline-date" />
          <PdfDownload slug="glossary" />
        </div>
      </div>

      <!-- Keyword-rich intro. Names + briefly describes the 8 topic areas so the
           topical keywords from the old Part headings stay on-page despite the
           alphabetical layout. -->
      <section id="overview" class="glossary-intro">
        <p class="pillar-lead"><strong>This glossary defines the clinical terms, methods, and conditions used in restorative reproductive medicine (RRM), drawn from peer-reviewed research and active clinical practice, and maintained by RRM Academy for patients and clinicians.</strong></p>
        <p>Every published term is listed below in one searchable, alphabetical directory. Use the search box to find a term by name or wording, or filter by topic area: <strong>Core RRM principles</strong>, <strong>fertility awareness-based methods (FABMs)</strong> and cycle charting, <strong>clinical approaches</strong> including NaProTechnology, <strong>diagnostic tools</strong> and hormone testing, reproductive <strong>surgical techniques</strong>, key <strong>conditions</strong> such as endometriosis, PCOS, infertility, and recurrent miscarriage, <strong>overlapping disciplines</strong> in endocrinology and reproductive health, and the broader RRM <strong>framework</strong>. Each definition leads with an answer-first summary; tap "Show more" to read the full entry.<sup><a href="#ref-1">1</a></sup></p>
      </section>

      {/* Always-visible A-Z jump strip (no disclosure / never collapsible).
          Renders a compact, tappable, horizontally-scrollable letter row.
          When SHELL_ENABLED, the right rail holds the same nav for DESKTOP, so
          the `az-index--shell-mobile` modifier hides THIS strip ≥901px (rail
          covers it) but keeps it visible on mobile, where the rail is
          display:none. When shell is off, the strip is visible at every
          viewport. Empty letters dim live via data-az-letter as the client
          filter runs. */}
      <nav
        class:list={['az-index', { 'az-index--shell-mobile': SHELL_ENABLED }]}
        aria-label="Jump to a letter"
      >
        <span class="az-index__label" aria-hidden="true">Jump to</span>
        <ol class="az-index__letters">
          {azLetters.map(letter => (
            <li><a href={`#letter-${letter}`} data-az-letter={letter}>{letter}</a></li>
          ))}
        </ol>
      </nav>

      {/* Sticky control bar: search + topic chips + live count.
          Progressive enhancement — filters operate over the already-rendered
          DOM (client-side only). No-JS users still get the full crawlable
          alphabetical directory below. */}
      <div class="glossary-controls" data-glossary-controls>
        <div class="glossary-search">
          <svg class="search-icon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input
            type="search"
            class="search-input"
            id="glossary-search-input"
            placeholder="Search terms…"
            autocomplete="off"
            aria-label="Search the glossary by term name or wording"
          />
          <button class="search-clear hidden" id="glossary-search-clear" type="button" aria-label="Clear search">✕</button>
        </div>
        <div class="glossary-chips" role="group" aria-label="Filter glossary by topic area">
          <button class="sr-chip sr-chip--active" type="button" data-topic="all" aria-pressed="true">All<span class="sr-chip-count">{terms.length}</span></button>
          {PARTS.map(p => (
            <button class="sr-chip" type="button" data-topic={p.topic} aria-pressed="false">{p.topic}<span class="sr-chip-count">{terms.filter(t => t.part === p.part).length}</span></button>
          ))}
        </div>
        <p class="glossary-count" id="glossary-count" aria-live="polite" data-total={terms.length}>Showing {terms.length} of {terms.length}</p>
      </div>

      <!-- Single-column directory (no sticky internal TOC: the search + chips
           bar above is the navigation). -->
      <div class="article-layout article-layout--no-toc">
        <article class="prose glossary-content">

          {/* Hidden Part landmarks: preserve every #<part-id> anchor (and the
              #overview anchor lives on the intro above) so external links and
              AI citations that target the old section anchors still resolve. */}
          <div class="glossary-part-anchors" aria-hidden="true">
            {PARTS.map(p => (<span id={p.id}></span>))}
          </div>

          {/* Alphabetical directory with build-time letter dividers replacing
              the 8 Part sections. Each term carries data-part / data-topic /
              data-search so the client filter can hide/show + auto-expand on
              match. The FULL body stays in the DOM (collapsed via CSS/JS, never
              removed) for AEO + Pagefind. */}
          <div class="glossary-list" data-glossary-list>
            {azGroups.map(group => (
              <section class="glossary-letter-group" data-letter-group={group.letter}>
                <h2 class="glossary-letter" id={`letter-${group.letter}`}>{group.letter}</h2>
                {group.items.map(t => (
                  <div
                    class="glossary-entry"
                    data-glossary-entry
                    data-part={t.part}
                    data-topic={PART_TO_TOPIC[t.part]}
                    data-search={`${t.name} ${t.abbreviation ?? ''} ${plainText(t.bodyHtml)}`.toLowerCase()}
                  >
                    <span class="glossary-entry__tag" data-topic-tag={PART_TO_TOPIC[t.part]}>
                      <button type="button" class="glossary-entry__tag-btn" data-tag-filter={PART_TO_TOPIC[t.part]} aria-label={`Filter by ${PART_TO_TOPIC[t.part]}`}>{PART_TO_TOPIC[t.part]}</button>
                    </span>
                    <GlossaryTerm term={t} headingLevel="h3" mode="pillar" />
                  </div>
                ))}
              </section>
            ))}
          </div>

          {/* No-matches state (shown by client filter only). */}
          <p class="glossary-no-matches" id="glossary-no-matches" hidden role="status">
            No terms match your search. <button type="button" class="glossary-reset-link" id="glossary-reset">Clear filters</button>
          </p>

          <!-- Abbreviations and Quick Reference (data-driven from glossary_abbreviation) -->
          <section id="abbreviations" class="glossary-static-section">
            <h2>Abbreviations and Quick Reference</h2>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Abbreviation</th>
                    <th>Full Term</th>
                  </tr>
                </thead>
                <tbody>
                  {abbreviations.map(a => (
                    <tr>
                      <td>{a.abbreviation}</td>
                      <td>{a.termSlug
                        ? <a href={`#${a.termSlug}`}>{a.fullTerm}</a>
                        : a.fullTerm}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>

          <!-- References: data-driven from glossary_reference -->
          <section class="references glossary-static-section" id="references">
            <h2>References</h2>
            <ol>
              {references.map(r => {
                const safeUrl = /^(https?:|mailto:|tel:|\/|#)/i.test((r.url || '').trim()) ? r.url : '#';
                return (
                  <li id={`ref-${r.refNum}`}>
                    <a
                      href={safeUrl}
                      rel={safeUrl.startsWith('https://rrmacademy.org') ? undefined : 'noopener'}
                      target={safeUrl.startsWith('https://rrmacademy.org') ? undefined : '_blank'}
                    >{r.anchorText}</a>.{r.journal ? <em>{r.journal}</em> : r.publisher}.
                  </li>
                );
              })}
            </ol>
          </section>

          <div class="cta-box glossary-static-section">
            <h3>Ready to learn more?</h3>
            <p>Explore our other guides on specific RRM approaches and topics.</p>
            <p><a href="/naprotechnology/" class="btn btn--primary">NaProTechnology Guide</a></p>
            <p><a href="/femm/" class="btn btn--secondary">FEMM Guide</a></p>
            <p><a href="/neofertility/" class="btn btn--secondary">NeoFertility Guide</a></p>
            <p><a href="/what-is-rrm/" class="btn btn--secondary">What is RRM?</a></p>
            <p><a href="/library/" class="btn btn--secondary">Browse the Research Library</a></p>
          </div>

          <p class="disclaimer glossary-static-section"><em>This content is for educational purposes only and does not constitute medical advice. Consult an RRM clinician or healthcare provider for guidance specific to your situation. Statistics represent published research averages, not guarantees of individual outcomes.</em></p>

        </article>
      </div>
    </div>
  </div>
  <p class="page-updated">Last updated: April 2026 &middot; {terms.length} terms &middot; {references.length} references</p>
  <BackToTop />
  </MaybeShell>
</BaseLayout>

<style is:global>
  /* Rail A-Z jump nav (shell-enabled glossary). is:global so the rules apply
     inside AppShellChrome's slot (Astro scopes <style> to the component by
     default, which would skip slotted content). */
  .glossary-rail__letters {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }
  .glossary-rail__letters li { margin: 0; }
  .glossary-rail__letters a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 30px;
    height: 30px;
    padding: 0 4px;
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .glossary-rail__letters a:hover {
    border-color: var(--accent);
    background: var(--purple-50);
  }
  /* Dimmed letter = no visible terms under the active filter/search. */
  .glossary-rail__letters a[data-az-empty] {
    opacity: 0.3;
    pointer-events: none;
  }
</style>

<style>
  .author-byline {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-top: calc(-1 * var(--space-2));
    margin-bottom: var(--space-6);
    line-height: 1.6;
  }

  .glossary-intro {
    margin-bottom: var(--space-6);
  }
  .glossary-intro p {
    margin-bottom: var(--space-4);
  }

  /* ── Always-visible A-Z jump strip (in-body; never collapsible) ──
     Compact, tappable letter chips in a single row. Wraps on desktop;
     horizontally scrolls on mobile so it never forces page overflow and never
     eats vertical space. */
  .az-index {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-4) 0 var(--space-5);
  }
  .az-index__label {
    flex-shrink: 0;
    font-family: 'Inter', sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }
  .az-index__letters {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
