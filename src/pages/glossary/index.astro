  .glossary-chips .sr-chip {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-secondary);
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-pill);
    cursor: pointer;
    white-space: nowrap;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .glossary-chips .sr-chip:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .glossary-chips .sr-chip:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px var(--focus-ring);
  }
  .glossary-chips .sr-chip-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 18px;
    height: 16px;
    padding: 0 5px;
    font-size: 0.625rem;
    font-weight: 600;
    color: var(--text-tertiary);
    background: var(--bg-body);
    border-radius: 8px;
    font-variant-numeric: tabular-nums;
  }
  .glossary-chips .sr-chip--active {
    color: #fff;
    background: var(--accent);
    border-color: var(--accent);
  }
  .glossary-chips .sr-chip--active:hover {
    color: #fff;
    border-color: var(--accent);
  }
  .glossary-chips .sr-chip--active .sr-chip-count {
    color: var(--accent);
    background: #fff;
  }

  .glossary-count {
    margin: var(--space-3) 0 0;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }

  /* ── Directory ── */
  .glossary-part-anchors {
    /* Zero-size invisible anchor landmarks; offset so #part-id jumps clear
       the sticky control bar. */
    height: 0;
    overflow: visible;
  }
  .glossary-part-anchors span {
    display: block;
    height: 0;
    scroll-margin-top: 140px;
  }

  .glossary-letter-group {
    margin-bottom: var(--space-6);
  }
  .glossary-letter {
    font-family: 'Cormorant Garamond', 'Georgia', serif;
    font-size: 2rem;
    font-weight: 600;
    color: var(--accent);
    margin: var(--space-8) 0 var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--border-light);
    scroll-margin-top: 140px;
  }
  .glossary-letter-group:first-child .glossary-letter {
    margin-top: 0;
  }

  .glossary-entry {
    margin-bottom: var(--space-8);
    scroll-margin-top: 140px;
  }
  /* Topic tag next to the term name (click-to-filter control). */
  .glossary-entry__tag {
    display: block;
    margin-bottom: 2px;
  }
  .glossary-entry__tag-btn {
    display: inline-flex;
    align-items: center;
    padding: 2px 9px;
    font-family: 'Inter', sans-serif;
    font-size: 0.625rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--sand-700);
    background: var(--sand-300);
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: color 0.15s, background 0.15s, border-color 0.15s;
  }
  .glossary-entry__tag-btn:hover {
    color: #fff;
    background: var(--accent);
  }
  .glossary-entry__tag-btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px var(--focus-ring);
  }

  /* Hidden by client filter (search miss or non-matching topic). */
  .glossary-entry[hidden],
  .glossary-letter-group[hidden] {
    display: none;
  }

  /* Tighter term heading spacing (the GlossaryTerm h3 sits right under the tag). */
  .glossary-entry :global(.glossary-term__heading) {
    margin-top: 0;
  }

  /* ── Clamp / Show-more (JS-enhanced; no-JS shows full body) ──
     The "is-clamped" class is added by JS only when an entry has more than its
     first paragraph. Default (no-JS) state shows everything. */
  .glossary-entry.is-clamped :global(.glossary-clamp-hidden) {
    display: none;
  }
  .glossary-entry.is-expanded :global(.glossary-clamp-hidden) {
    display: revert;
  }
  .glossary-show-more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: var(--space-2);
    padding: 6px 14px;
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--accent);
    background: transparent;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .glossary-show-more:hover {
    border-color: var(--accent);
    background: var(--purple-50);
  }
  .glossary-show-more:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px var(--focus-ring);
  }
  .glossary-show-more__chevron {
    transition: transform 0.2s ease;
  }
  .glossary-entry.is-expanded .glossary-show-more__chevron {
    transform: rotate(180deg);
  }

  .glossary-no-matches {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    padding: var(--space-8) 0;
    text-align: center;
  }
  .glossary-reset-link {
    background: none;
    border: none;
    padding: 0;
    color: var(--accent);
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }
  .glossary-reset-link:hover { color: var(--accent-hover); }

  /* ── Static sections (abbreviations, refs, CTA) ── */
  .table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin-bottom: var(--space-6);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  th {
    background: var(--bg-surface);
    font-weight: 600;
    padding: var(--space-3) var(--space-4);
    text-align: left;
    border-bottom: 2px solid var(--border-color);
  }
  td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border-color);
    vertical-align: top;
    line-height: 1.5;
  }
  tr:last-child td { border-bottom: none; }

  .references {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }
  .references li { margin-bottom: var(--space-3); }

  .cta-box {
    background: var(--bg-surface);
    border: none;
    border-radius: var(--radius-md);
    padding: var(--space-8);
    text-align: center;
    margin-top: var(--space-10);
    box-shadow: var(--shadow-sm);
  }
  .cta-box h3 {
    font-family: 'Cormorant Garamond', 'Georgia', serif;
    margin-bottom: var(--space-3);
  }
  .cta-box p { margin-bottom: var(--space-4); }
  .cta-box p:last-child { margin-bottom: 0; }

  .disclaimer {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    margin-top: var(--space-8);
    line-height: 1.6;
  }

  /* Override container width for article layout */
  @media (min-width: 1024px) {
    .container {
      max-width: calc(var(--max-width-article) + 220px + var(--space-10) + var(--space-8) * 2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glossary-show-more__chevron { transition: none; }
  }
