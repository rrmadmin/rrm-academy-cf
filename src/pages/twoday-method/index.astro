---
// /twoday-method/ FABM method guide (category: methods). Data-driven via GuideLayout.
import GuideLayout from '../../layouts/GuideLayout.astro';
import data from '../../data/twoday-method.json';
const SLUG = 'twoday-method';
const PAGE_URL = `https://rrmacademy.org/${SLUG}/`;
const { published: PUBLISHED, modified: MODIFIED } = data;
const TOC_ITEMS = data.tocItems;
const KEY_TAKEAWAYS_HTML = `<ul>\n${data.keyTakeaways.map((k) => `  <li>${k}</li>`).join('\n')}\n</ul>`;
const FAQS = data.faqs;
const FB = data.factsBox;
const ARTICLE_SECTIONS = ['Key Takeaways','What it is','How it works','How it is taught','How effective is it?','What it is used for','How it supports restorative reproductive medicine','How to learn it','Frequently Asked Questions','Continue exploring','References'];
const citationUrls = [...new Set(JSON.stringify(data).match(/https:\/\/pubmed\.ncbi\.nlm\.nih\.gov\/\d+/g) || [])];
const ABOUT_TYPE_MAP = { MedicalCondition: 'MedicalCondition', MedicalProcedure: 'MedicalProcedure', MedicalTherapy: 'MedicalTherapy' };
const jsonLd = {
  '@context': 'https://schema.org', '@type': ['MedicalWebPage', 'Article'],
  headline: "The TwoDay Method: A Clinician-Reviewed Guide",
  description: "The TwoDay Method uses a yes/no secretion check to identify fertile days. Learn how it works, what the evidence shows, and how it fits within restorative reproductive medicine.",
  url: PAGE_URL, inLanguage: 'en',
  author: { '@id': 'https://rrmacademy.org/#naomi-whittaker' },
  publisher: { '@id': 'https://rrmacademy.org/#organization' },
  datePublished: PUBLISHED, dateModified: MODIFIED,
  image: `https://rrmacademy.org/og/${SLUG}.png`,
  mainEntityOfPage: { '@type': 'WebPage', '@id': PAGE_URL },
  about: data.about.map((a) => ({ '@type': ABOUT_TYPE_MAP[a.type] || 'Thing', name: a.name })),
  articleSection: ARTICLE_SECTIONS,
  citation: citationUrls.map((u) => ({ '@type': 'MedicalScholarlyArticle', '@id': u })),
};
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: FAQS.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answerHtml.replace(/<[^>]+>/g, '') } })) };
---

<GuideLayout slug={SLUG} jsonLd={jsonLd} extraSchema={[faqSchema]} tocItems={TOC_ITEMS} faqs={FAQS} keyTakeawaysHtml={KEY_TAKEAWAYS_HTML}>
  <aside class="facts-box">
    <dl>
      <div><dt>Biomarker</dt><dd>{FB.biomarker}</dd></div>
      <div><dt>Taught by</dt><dd>{FB.taughtBy}</dd></div>
      <div><dt>Tools needed</dt><dd>{FB.toolsNeeded}</dd></div>
      <div><dt>Perfect use</dt><dd set:html={FB.perfectUse} /></div>
      <div><dt>Typical use</dt><dd set:html={FB.typicalUse} /></div>
    </dl>
  </aside>
  <section id="what-it-is"><h2>What it is</h2><Fragment set:html={data.prose.whatItIs} /></section>
  <section id="how-it-works"><h2>How it works</h2><Fragment set:html={data.prose.howItWorks} /></section>
  <section id="taught"><h2>How it is taught</h2><Fragment set:html={data.prose.taughtBy} /></section>
  <section id="effectiveness"><h2>How effective is it?</h2><Fragment set:html={data.prose.effectiveness} /></section>
  <section id="used-for"><h2>What it is used for</h2><Fragment set:html={data.prose.usedFor} /></section>
  <section id="rrm-value"><h2>How it supports restorative reproductive medicine</h2><Fragment set:html={data.prose.rrmValue} /></section>
  <section id="how-to-learn"><h2>How to learn it</h2><Fragment set:html={data.prose.howToLearn} /></section>
  <section id="continue-exploring"><h2>Continue exploring</h2><ul>
    <li><a href="/fertility-awareness-methods-compared/">Fertility awareness methods compared</a></li>
    <li><a href="/naprotechnology/">NaProTechnology</a></li>
    <li><a href="/what-is-rrm/">What is Restorative Reproductive Medicine?</a></li>
    <li><a href="/providers/">Find an RRM provider</a></li>
  </ul></section>
  <section id="references"><h2>References</h2><ol class="references-list">{data.references.map((r) => (<li id={`ref-${r.n}`} set:html={r.html} />))}</ol></section>
</GuideLayout>

<style>
  .facts-box { background: var(--bg-surface); border-left: 3px solid var(--purple-700); border-radius: var(--radius-md); padding: var(--space-4); margin: var(--space-5) 0; }
  .facts-box dl { margin: 0; display: grid; gap: var(--space-3); }
  .facts-box dt { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted); }
  .facts-box dd { margin: var(--space-1) 0 0 0; font-size: 0.9375rem; color: var(--text-primary); line-height: 1.5; }
  .references-list { font-size: 0.875rem; color: var(--text-secondary); line-height: 1.6; padding-left: var(--space-4); }
  .references-list li { margin-bottom: var(--space-2); }
  .references-list a { color: var(--accent); }
</style>
