---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildKnownPages } from '../lib/known-pages.js';

const pageKeys = [
  ...Object.keys(import.meta.glob('/src/pages/*.astro')),
  ...Object.keys(import.meta.glob('/src/pages/*/index.astro')),
];
const knownPages = buildKnownPages(pageKeys);
---
<BaseLayout
  title="Page Not Found | It seems there was a little mix-up"
  description="The page you're looking for doesn't exist or has been moved. Search our research library or explore our site."
  noindex
>
  <section class="not-found">
    <div class="not-found__images" aria-hidden="true">
      <img src="/images/404/peony.webp" alt="" class="not-found__img not-found__img--1" width="400" height="600" loading="eager" />
      <img src="/images/404/eucalyptus.webp" alt="" class="not-found__img not-found__img--2" width="400" height="267" loading="eager" />
      <img src="/images/404/purple-tree.webp" alt="" class="not-found__img not-found__img--3" width="400" height="245" loading="eager" />
    </div>
    <div class="not-found__inner">
      <span class="not-found__code">404</span>
      <h1>It seems there was a little mix-up</h1>
      <p class="not-found__subtitle">We can't find that page. Can we help you find what you're looking for?</p>
      <div class="not-found__suggest" id="nf-suggest" hidden></div>
      <div class="not-found__search" id="nf-search">
        <div class="nf-search-box">
          <svg class="nf-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="search" class="nf-search-input" placeholder="Search articles, topics, conditions..." id="nf-search-input" autocomplete="off" aria-label="Search articles" />
          <button class="nf-search-clear hidden" id="nf-search-clear" aria-label="Clear search">&#x2715;</button>
        </div>
        <div class="nf-search-results" id="nf-search-results"></div>
      </div>
      <nav class="not-found__links" aria-label="Suggested destinations">
        <ul>
          <li><a href="/library/">Research Library</a></li>
          <li><a href="/commentary/">Commentary</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 70vh;
    text-align: center;
    padding: var(--space-16) var(--space-4) var(--space-16);
  }

  /* Decorative image collage — flanks the card, clipped by its own layer
     (NOT the section: the section must never clip the in-flow search results).
     Height caps at one viewport so the composition stays framed around the
     initial view when search results stretch the section — percentage anchors
     resolve against this layer, never the full (possibly very tall) section. */
  .not-found__images {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: min(100%, 100vh);
    overflow: hidden;
    pointer-events: none;
  }
  .not-found__img {
    position: absolute;
    border-radius: var(--radius-lg);
    object-fit: cover;
    opacity: 0.45;
  }
  .not-found__img--1 {
    width: 240px;
    height: 360px;
    left: clamp(8px, 5vw, 96px);
    top: 50%;
    transform: translateY(-50%) rotate(-2deg);
  }
  .not-found__img--2 {
    width: 210px;
    height: 150px;
    right: clamp(8px, 6vw, 120px);
    top: 14%;
    transform: rotate(2deg);
  }
  .not-found__img--3 {
    width: 190px;
    height: 135px;
    right: clamp(16px, 8vw, 150px);
    bottom: 12%;
    transform: rotate(-1.5deg);
  }
  :global([data-theme="dark"]) .not-found__img {
    opacity: 0.22;
  }
  @media (max-width: 1023px) {
    .not-found__img--1 { width: 180px; height: 270px; }
    .not-found__img--2 { width: 150px; height: 107px; }
    .not-found__img--3 { width: 140px; height: 100px; }
  }
  @media (max-width: 768px) {
    .not-found__images {
      display: none;
    }
  }

  /* Content card */
  .not-found__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 600px;
    background: var(--bg-surface);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    padding: var(--space-6) var(--space-8) var(--space-10);
  }
  @media (max-width: 640px) {
    .not-found__inner {
      padding: var(--space-5) var(--space-4) var(--space-8);
    }
  }
  .not-found__code {
    display: block;
    font-family: 'Cormorant Garamond', 'Georgia', serif;
    font-size: clamp(5.5rem, 4rem + 7vw, 8rem);
    font-weight: 600;
    line-height: 0.72;
    letter-spacing: 0.02em;
    color: var(--sand-500);
    margin-bottom: var(--space-4);
  }
  .not-found h1 {
    font-size: clamp(1.625rem, 1.3rem + 1.5vw, 2.125rem);
    margin-bottom: var(--space-3);
  }
  .not-found__subtitle {
    color: var(--text-secondary);
    margin-bottom: var(--space-6);
  }

  /* Search bar */
  .nf-search-box {
    position: relative;
    display: flex;
    align-items: center;
  }
  .nf-search-icon {
    position: absolute;
    left: 14px;
    color: var(--text-muted);
    pointer-events: none;
  }
  .nf-search-input {
    width: 100%;
    padding: 12px 40px 12px 42px;
    font-size: 16px;
    font-family: 'Inter', sans-serif;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-pill);
    outline: none;
    background: var(--bg-surface);
    color: var(--text-primary);
    box-shadow: 0 4px 16px rgba(0,0,0,0.08), 0 1px 4px rgba(0,0,0,0.04);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .nf-search-input:focus {
    border-color: var(--sand-500);
    box-shadow: 0 4px 20px rgba(184,163,143,0.25), 0 0 0 3px rgba(184,163,143,0.12);
  }
  :global([data-theme="dark"]) .nf-search-input {
    border-color: rgba(255,255,255,0.15);
    box-shadow: 0 4px 16px rgba(255,255,255,0.04), 0 1px 4px rgba(255,255,255,0.02);
  }
  :global([data-theme="dark"]) .nf-search-input:focus {
    box-shadow: 0 4px 20px rgba(255,255,255,0.06), 0 0 0 3px var(--focus-ring);
  }
  .nf-search-input::placeholder {
    color: var(--text-muted);
  }
  .nf-search-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
    display: none;
  }
  .nf-search-clear {
    position: absolute;
    right: 12px;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: none;
    color: var(--text-tertiary);
    font-size: 14px;
    cursor: pointer;
    border-radius: 50%;
    padding: 0;
    transition: color 0.15s;
  }
  .nf-search-clear:hover {
    color: var(--text-primary);
  }
  .nf-search-clear.hidden {
    display: none;
  }

  /* Results — in flow (push content below down), never clipped or overlaid */
  .nf-search-results {
    text-align: left;
    margin-top: var(--space-4);
    padding: 0 var(--space-4);
    background: var(--bg-body);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
  }
  .nf-search-results:empty {
    display: none;
  }
  .nf-search-results :global(.sr-count) {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: var(--space-3) 0 var(--space-2);
  }
  .nf-search-results :global(.sr-item) {
    display: block;
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--border-light, var(--border-color));
    text-decoration: none;
  }
  .nf-search-results :global(.sr-item:first-of-type) {
    border-top: 1px solid var(--border-light, var(--border-color));
  }
  .nf-search-results :global(.sr-item:last-child) {
    border-bottom: none;
  }
  .nf-search-results :global(.sr-item:hover .sr-title) {
    color: var(--accent);
  }
  .nf-search-results :global(.sr-title) {
    font-family: 'Cormorant Garamond', 'Georgia', serif;
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--text-primary);
    margin: 0 0 4px;
    transition: color 0.15s;
  }
  /* Inline flow (not flex): the year must follow the last author word on the
     same line instead of wrapping to its own row as a separate flex item. */
  .nf-search-results :global(.sr-meta) {
    font-size: 0.75rem;
    line-height: 1.5;
    margin-bottom: 6px;
  }
  .nf-search-results :global(.sr-authors) {
    color: var(--text-secondary);
    font-weight: 500;
  }
  .nf-search-results :global(.sr-sep) {
    color: var(--text-muted);
    margin: 0 6px;
  }
  .nf-search-results :global(.sr-year) {
    color: var(--text-tertiary);
  }
  .nf-search-results :global(.sr-excerpt) {
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .nf-search-results :global(.sr-excerpt mark) {
    background: var(--status-warn-bg);
    color: inherit;
    padding: 0 1px;
    border-radius: 2px;
  }
  .nf-search-results :global(.sr-more) {
    display: block;
    width: 100%;
    margin: var(--space-2) 0 var(--space-4);
    padding: var(--space-2) var(--space-4);
    font-size: 0.8125rem;
    font-weight: 500;
    font-family: 'Inter', sans-serif;
    color: var(--text-secondary);
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .nf-search-results :global(.sr-more:hover) {
    border-color: var(--accent);
    color: var(--accent);
  }
  .nf-search-results :global(.sr-loading) {
    font-size: 0.8125rem;
    color: var(--text-muted);
    padding: var(--space-4) 0;
  }
  .nf-search-results :global(.sr-empty) {
    font-size: 0.875rem;
    color: var(--text-tertiary);
    padding: var(--space-4) 0;
  }

  /* Navigation pills */
  .not-found__links ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    padding: 0;
    margin: var(--space-8) 0 0;
  }
  .not-found__links a {
    display: inline-flex;
    align-items: center;
    padding: var(--space-3) var(--space-5);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-pill);
    color: var(--text-secondary);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.15s, border-color 0.15s;
  }
  .not-found__links a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .not-found__links a:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px var(--focus-ring);
  }

  /* Did-you-mean suggestions (static-route fallback, above the search box) */
  .not-found__suggest {
    margin-bottom: var(--space-6);
  }
  .nf-suggest__label {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    margin: 0 0 var(--space-2);
  }
  .nf-suggest__links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }
  .nf-suggest__link {
    color: var(--accent);
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .nf-suggest__link--primary {
    font-family: 'Cormorant Garamond', 'Georgia', serif;
    font-size: 1.25rem;
    font-weight: 600;
  }
  .nf-suggest__link:hover {
    color: var(--accent-hover);
  }
</style>

<script is:inline>
(function() {
  var input = document.getElementById('nf-search-input');
  var clearBtn = document.getElementById('nf-search-clear');
  var resultsEl = document.getElementById('nf-search-results');
  if (!input || !resultsEl) return;

  var pagefindReady = null;
  var debounceTimer = null;
  var currentResults = [];
  var shown = 0;
  var PER_PAGE = 3;
  var totalCount = 0;
  var currentQuery = '';

  function ensurePagefind() {
    if (!pagefindReady) {
      pagefindReady = import('/pagefind/pagefind.js').catch(function() {
        return fetch('/pagefind/pagefind.js')
          .then(function(r) { return r.text(); })
          .then(function(js) {
            var blob = new Blob([js], { type: 'application/javascript' });
            return import(URL.createObjectURL(blob));
          });
      }).then(function(pf) {
        return pf.options({ basePath: '/pagefind/' }).then(function() { return pf.init(); }).then(function() { return pf; });
      }).catch(function(err) {
        pagefindReady = null;
        throw err;
      });
    }
    return pagefindReady;
  }

  function onInput() {
    var q = input.value.trim();
    clearBtn.classList.toggle('hidden', !q);
    clearTimeout(debounceTimer);
    if (!q) {
      resultsEl.innerHTML = '';
      currentResults = [];
      currentQuery = '';
      return;
    }
    currentQuery = q;
    debounceTimer = setTimeout(function() { doSearch(q); }, 150);
  }

  async function doSearch(query, quiet) {
    resultsEl.innerHTML = '<p class="sr-loading">Searching…</p>';
    try {
      var pf = await ensurePagefind();
      var search = await pf.search(query);
      if (query !== currentQuery) return;
      totalCount = search.results.length;
      currentResults = search.results;
      shown = 0;
      resultsEl.innerHTML = '';
      if (totalCount === 0) {
        resultsEl.innerHTML = '<p class="sr-empty">No results found for “' + escHtml(query) + '”</p>';
        return;
      }
      var countEl = document.createElement('p');
      countEl.className = 'sr-count';
      countEl.textContent = totalCount + ' result' + (totalCount === 1 ? '' : 's');
      resultsEl.appendChild(countEl);
      await loadMore();
    } catch(e) {
      // An auto-run search fails silently; a user-typed one reports.
      resultsEl.innerHTML = quiet ? '' : '<p class="sr-empty">Search unavailable</p>';
    }
  }

  async function loadMore() {
    var batch = currentResults.slice(shown, shown + PER_PAGE);
    var allData = (await Promise.all(batch.map(function(r) {
      return r.data().catch(function() { return null; });
    }))).filter(Boolean);
    var fragment = document.createDocumentFragment();
    for (var i = 0; i < allData.length; i++) {
      fragment.appendChild(renderResult(allData[i]));
    }
    var oldBtn = resultsEl.querySelector('.sr-more');
    if (oldBtn) oldBtn.remove();
    resultsEl.appendChild(fragment);
    shown += batch.length;
    if (shown < totalCount) {
      var btn = document.createElement('button');
      btn.className = 'sr-more';
      btn.textContent = 'Show more (' + (totalCount - shown) + ' remaining)';
      btn.addEventListener('click', function() { loadMore(); });
      resultsEl.appendChild(btn);
    }
  }

  function toRelative(url) {
    try { return new URL(url).pathname; } catch(e) { return url; }
  }

  function renderResult(data) {
    var a = document.createElement('a');
    a.className = 'sr-item';
    a.href = toRelative(data.url);
    var title = data.meta && data.meta.title ? data.meta.title : '';
    var authors = data.meta && data.meta.authors ? data.meta.authors : '';
    var year = data.meta && data.meta.year ? data.meta.year : '';
    var excerpt = data.excerpt || '';
    var h = document.createElement('h3');
    h.className = 'sr-title';
    h.textContent = title || 'Untitled';
    a.appendChild(h);
    if (authors || year) {
      var meta = document.createElement('div');
      meta.className = 'sr-meta';
      if (authors) {
        var shortAuthors = authors;
        var semiIdx = authors.indexOf(';');
        if (semiIdx > 0 && authors.indexOf(';', semiIdx + 1) > 0) {
          shortAuthors = authors.substring(0, semiIdx) + ' et al.';
        }
        var authSpan = document.createElement('span');
        authSpan.className = 'sr-authors';
        authSpan.textContent = shortAuthors;
        meta.appendChild(authSpan);
      }
      if (year) {
        if (authors) {
          var sep = document.createElement('span');
          sep.className = 'sr-sep';
          sep.textContent = '·';
          meta.appendChild(sep);
        }
        var yearSpan = document.createElement('span');
        yearSpan.className = 'sr-year';
        yearSpan.textContent = year;
        meta.appendChild(yearSpan);
      }
      a.appendChild(meta);
    }
    if (excerpt) {
      var p = document.createElement('p');
      p.className = 'sr-excerpt';
      p.textContent = excerpt.replace(/<\/?mark>/g, '');
      a.appendChild(p);
    }
    return a;
  }

  function escHtml(s) {
    var d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }

  clearBtn.addEventListener('click', function() {
    input.value = '';
    clearBtn.classList.add('hidden');
    resultsEl.innerHTML = '';
    currentResults = [];
    currentQuery = '';
    input.focus();
  });

  input.addEventListener('input', onInput);
  input.addEventListener('focus', function() { ensurePagefind().catch(function(){}); }, { once: true });

  // ---- Content-aware auto-search -------------------------------------------
  // A dead /library/, /commentary/, /faqs/ or /courses/ URL means the visitor
  // wanted a specific piece of content, not a section page. Derive a query
  // from the slug, prefill the box, and run the search so the real article is
  // already on screen. Sets window.__nfAutoSearch so the static "Did you
  // mean" matcher (useless for content URLs — it would just say "Library")
  // stands down.
  var CONTENT_RE = /^\/(library|commentary|faqs|courses)\/(.+?)\/?$/;

  function deriveQuery(pathname) {
    var m = CONTENT_RE.exec(pathname);
    if (!m) return '';
    var segs = m[2].split('/').filter(Boolean);
    if (!segs.length || segs[0] === 'page') return '';
    var slug = segs[segs.length - 1];
    try { slug = decodeURIComponent(slug); } catch (e) { /* keep raw */ }
    var words = slug.toLowerCase().split('-').filter(Boolean);
    // Strip trailing id-ish tokens: legacy Airtable ids ("reczywlbrfq5ksho8")
    // and current short hash suffixes ("xjqi0gys").
    while (words.length > 1) {
      var last = words[words.length - 1];
      if (/^rec[a-z0-9]{8,}$/.test(last) || (/\d/.test(last) && /^[a-z0-9]{4,17}$/.test(last))) {
        words.pop();
      } else {
        break;
      }
    }
    var q = words.join(' ').trim();
    return q.length >= 4 && /[a-z]/.test(q) ? q : '';
  }

  var autoQuery = deriveQuery(location.pathname);
  if (autoQuery) {
    window.__nfAutoSearch = true;
    input.value = autoQuery;
    clearBtn.classList.remove('hidden');
    currentQuery = autoQuery;
    doSearch(autoQuery, true);
  }
})();
</script>

<script type="application/json" id="nf-known-pages" set:html={JSON.stringify(knownPages).replace(/</g, '\\u003c')}></script>

<script>
  import { bestMatches } from '../lib/url-match.js';

  (function () {
    // Content-route 404s are handled by the auto-search above; suggesting the
    // bare section page ("Library") there is worse than useless.
    if ((window as any).__nfAutoSearch) return;

    const el = document.getElementById('nf-suggest');
    const dataEl = document.getElementById('nf-known-pages');
    if (!el || !dataEl) return;

    let index;
    try {
      index = JSON.parse(dataEl.textContent || '[]');
    } catch {
      return;
    }

    const matches = bestMatches(location.pathname, index);
    if (!matches.length) return;

    const label = document.createElement('p');
    label.className = 'nf-suggest__label';
    label.textContent = 'Did you mean:';
    el.appendChild(label);

    const list = document.createElement('div');
    list.className = 'nf-suggest__links';
    matches.forEach((m, i) => {
      const a = document.createElement('a');
      a.href = m.path;
      a.className = i === 0 ? 'nf-suggest__link nf-suggest__link--primary' : 'nf-suggest__link';
      a.textContent = m.title;
      list.appendChild(a);
    });
    el.appendChild(list);
    el.hidden = false;
  })();
</script>
