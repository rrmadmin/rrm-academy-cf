---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AppShellChrome from '../../../components/AppShellChrome.astro';
import { isShellEnabled } from '../../../lib/shell-routes';
import { CATEGORIES, topicSlug } from '../../../data/library-topics';

const SHELL_ENABLED = isShellEnabled('library');

// Front door for every browsable topic hub. Derived from the topic registry so it
// can never drift from the hubs themselves.
const topics = CATEGORIES.filter((c) => c.browsable).map((c) => ({
  label: c.label,
  descriptor: c.pageDescriptor,
  slug: topicSlug(c.label),
}));

const canonicalUrl = 'https://rrmacademy.org/library/topics/';
const pageTitle = 'Browse the Research Library by Topic';
const pageDescription =
  'Browse the RRM Research Library by topic: endometriosis, PCOS, infertility, NaProTechnology, fertility awareness, pregnancy, surgery, and more. Each topic collects the peer-reviewed studies in restorative reproductive medicine.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonicalUrl}#collection`,
  name: 'RRM Research Library — Topics',
  description: pageDescription,
  url: canonicalUrl,
  inLanguage: 'en',
  isPartOf: { '@id': 'https://rrmacademy.org/#website' },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: topics.length,
    itemListElement: topics.map((t, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `${t.label} research`,
      url: `https://rrmacademy.org/library/topics/${t.slug}/`,
    })),
  },
};

---
<BaseLayout
  bodyClass="page-library page-library-topics-index"
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLd}
  chrome={SHELL_ENABLED ? 'shell' : 'default'}
>
  {SHELL_ENABLED ? (
    <AppShellChrome context="index" currentPath={Astro.url.pathname}>
      <section class="topics-index">
        <div class="container">
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/library/">Research Library</a>
            <span aria-hidden="true"> &rsaquo; </span>
            <span>Topics</span>
          </nav>
          <header class="topics-head">
            <h1>Browse by Topic</h1>
            <p class="topics-lead">Every topic below collects the peer-reviewed research in the RRM Library on that subject. Start here to find the studies behind a condition, a method, or a question.</p>
          </header>
          <ul class="topics-grid">
            {topics.map((t) => (
              <li>
                <a href={`/library/topics/${t.slug}/`} class="topic-card">
                  <span class="topic-card__name">{t.label}</span>
                  <span class="topic-card__desc">{t.descriptor}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </AppShellChrome>
  ) : (
    <section class="topics-index">
      <div class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/library/">Research Library</a>
          <span aria-hidden="true"> &rsaquo; </span>
          <span>Topics</span>
        </nav>
        <header class="topics-head">
          <h1>Browse by Topic</h1>
          <p class="topics-lead">Every topic below collects the peer-reviewed research in the RRM Library on that subject. Start here to find the studies behind a condition, a method, or a question.</p>
        </header>
        <ul class="topics-grid">
          {topics.map((t) => (
            <li>
              <a href={`/library/topics/${t.slug}/`} class="topic-card">
                <span class="topic-card__name">{t.label}</span>
                <span class="topic-card__desc">{t.descriptor}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .topics-index {
    padding: var(--space-6) 0 var(--space-10);
  }
  .breadcrumb {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    margin-bottom: var(--space-5);
  }
  .breadcrumb a {
    color: var(--text-secondary);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .topics-head {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--border-light);
  }
  .topics-head h1 {
    margin: 0 0 var(--space-3);
  }
  .topics-lead {
    margin: 0;
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.6;
    max-width: 62ch;
  }
  .topics-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .topics-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .topics-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .topic-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--bg-surface);
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }
  .topic-card:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  .topic-card__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--text-primary);
    line-height: 1.2;
  }
  .topic-card__desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }
</style>
