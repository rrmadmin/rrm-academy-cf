---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Email Observatory | Admin" description="Email deliverability, broadcasts, and list health across all transactional and newsletter mail" noindex={true} bodyClass="admin-page">

  <div class="admin-bar">
    <div class="container admin-bar__inner">
      <span class="admin-bar__title">RRM Admin</span>
      <nav class="admin-bar__nav">
        <a href="/admin/backlinks/" class="admin-bar__link">Backlinks</a>
        <a href="/admin/conversions/" class="admin-bar__link">Conversions</a>
        <a href="/admin/content/" class="admin-bar__link">Content</a>
        <a href="/admin/email/" class="admin-bar__link admin-bar__link--active">Email</a>
        <a href="/admin/seo/" class="admin-bar__link">SEO</a>
        <a href="/admin/revenue/" class="admin-bar__link">Revenue</a>
        <a href="/admin/enrollments/" class="admin-bar__link">Enrollments</a>
      </nav>
      <div class="admin-bar__actions">
        <a href="/" class="admin-bar__site-link">Return to site</a>
        <button class="admin-bar__logout" id="logout-btn">Logout</button>
      </div>
    </div>
  </div>

  <section class="emd" id="emd-root">
    <div class="emd-wrap">

      <!-- Page head -->
      <div class="head">
        <div>
          <h1>Email Observatory</h1>
          <p>Deliverability, broadcasts, and list health across all transactional + newsletter mail <span class="faint" id="updated-note">&middot; loading&hellip;</span></p>
        </div>
        <div class="seg" id="period-seg" role="group" aria-label="Time period">
          <button type="button" data-days="7">7d</button>
          <button type="button" data-days="30" class="on">30d</button>
          <button type="button" data-days="90">90d</button>
          <button type="button" data-days="365">1y</button>
        </div>
      </div>

      <div class="emd-grid">

      <!-- KPIs (full width) -->
      <div class="kpis span-full" id="kpis">
        <div class="kpi"><div class="kpi__l">Loading&hellip;</div><div class="kpi__v">&middot;</div></div>
      </div>

      <!-- Send volume (full width) -->
      <div class="card span-full">
        <h2>Send volume <span class="faint h2sub">by day, transactional vs newsletter</span></h2>
        <div id="vol-chart" class="emd-chart"></div>
        <p class="note" id="vol-total">&mdash;</p>
      </div>

      <!-- New subscribers (full width) -->
      <div class="card span-full">
        <h2>New subscribers <span class="faint h2sub">organic signups per day</span></h2>
        <div id="subs-chart" class="emd-chart"></div>
        <p class="note" id="subs-total">&mdash;</p>
      </div>

      <!-- 3-column row: deliverability | list health | sources -->
      <div class="card">
        <h2>Deliverability <span class="tag" id="deliv-tag">awaiting feed</span></h2>
        <div class="gauges" id="gauges">
          <div class="gauge" id="g-bounce"></div>
          <div class="gauge" id="g-complaint"></div>
        </div>
        <p class="note" id="deliv-note">Gauged against SES enforcement lines: <b>bounce 5%</b>, <b>complaint 0.1%</b>. Crossing either risks sending suspension.</p>
      </div>

      <div class="card">
        <h2>List health <span class="faint h2sub">current composition (not period-filtered)</span></h2>
        <div id="list-health">
          <div class="cell-empty">Loading&hellip;</div>
        </div>
      </div>

      <div class="card">
        <h2>Top send sources <span class="faint h2sub" id="src-period">period</span></h2>
        <div class="src" id="src">
          <div class="cell-empty">Loading&hellip;</div>
        </div>
      </div>

      <!-- Campaign breakdown (full width) -->
      <div class="card span-full">
        <h2>Campaign breakdown <span class="faint h2sub">per newsletter send &middot; full send metrics</span></h2>
        <div class="x-scroll">
          <table class="tbl">
            <thead><tr><th>Campaign</th><th>Sent</th><th>Funnel</th><th>Delivered</th><th>Open</th><th>Click</th><th>Bounce</th><th>Complaint</th><th>Status</th></tr></thead>
            <tbody id="broadcasts-body">
              <tr><td colspan="9" class="cell-empty">Loading&hellip;</td></tr>
            </tbody>
          </table>
        </div>
        <p class="note">Click any open, click, or bounce count to open the recipient cohort. Detailed per-recipient cohorts populate once the SES event feed is live.</p>
      </div>

      <!-- Event log (full width) -->
      <div class="card span-full">
        <h2>Event log &amp; recipient timeline</h2>
        <div class="emd-filters" id="filters">
          <select class="emd-select" id="f-event" aria-label="Event type">
            <option value="">All events</option>
            <option value="send">Send</option>
            <option value="failed">Failed</option>
            <option value="delivery">Delivery</option>
            <option value="open">Open</option>
            <option value="click">Click</option>
            <option value="bounce">Bounce</option>
            <option value="complaint">Complaint</option>
            <option value="reject">Reject</option>
          </select>
          <select class="emd-select" id="f-category" aria-label="Category">
            <option value="">All categories</option>
            <option value="transactional">Transactional</option>
            <option value="newsletter">Newsletter</option>
          </select>
          <input type="text" class="emd-input" id="f-source" placeholder="Source&hellip;" aria-label="Source" />
          <input type="text" class="emd-input" id="f-email" placeholder="Email prefix&hellip;" aria-label="Email prefix" />
          <button type="button" class="emd-apply" id="apply-btn">Apply</button>
        </div>
        <div class="logwrap">
          <table class="log">
            <thead><tr>
              <th class="sortable" data-sort="created_at">Time<span class="sort-arrow"></span></th>
              <th class="sortable" data-sort="event">Event<span class="sort-arrow"></span></th>
              <th class="sortable" data-sort="email">Recipient<span class="sort-arrow"></span></th>
              <th class="sortable" data-sort="source">Source<span class="sort-arrow"></span></th>
              <th>Subject</th>
              <th>Detail</th>
            </tr></thead>
            <tbody id="log-body">
              <tr><td colspan="6" class="cell-empty">Loading&hellip;</td></tr>
            </tbody>
          </table>
        </div>
        <div class="emd-pager" id="pager">
          <button type="button" class="emd-page-btn" id="prev-btn" disabled>&larr; Prev</button>
          <span class="emd-page-info" id="page-info">Page 1</span>
          <button type="button" class="emd-page-btn" id="next-btn" disabled>Next &rarr;</button>
        </div>
        <p class="note">Click any recipient to open a per-person timeline (sent &rarr; delivered &rarr; opened &rarr; clicked &rarr; bounced), reconstructed from the email log joined to SES events.</p>
      </div>

    </div>

    <!-- Drawer -->
    <div class="emd-drawer" id="drawer" hidden>
      <div class="emd-drawer__scrim" id="drawer-scrim"></div>
      <aside class="emd-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="drawer-title">
        <header class="emd-drawer__head">
          <div>
            <div class="emd-drawer__eyebrow" id="drawer-eyebrow">Cohort</div>
            <h2 class="emd-drawer__title" id="drawer-title">&mdash;</h2>
          </div>
          <button type="button" class="emd-drawer__close" id="drawer-close" aria-label="Close">&times;</button>
        </header>
        <div class="emd-drawer__body" id="drawer-body"></div>
      </aside>
    </div>
  </section>

  <script is:inline>
  /* ====== area-chart house primitive (inlined from skills/area-chart) ======
     Responsive interactive stacked area chart in pure vanilla SVG: smooth
     monotone-cubic areas, per-series gradient fills + stroke line, horizontal
     gridlines, thinned date ticks, hover crosshair + tooltip, legend,
     ResizeObserver re-render, reduced-motion safe. Defines window.areaChart,
     used by the dashboard IIFE below. The .ac- prefix is a unique namespace. */
  (function (global) {
    'use strict';

    var SVGNS = 'http://www.w3.org/2000/svg';
    var MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
                  'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    var uidCounter = 0;

    // ---- small helpers -----------------------------------------------------
    function num(v) { var n = +v; return isFinite(n) ? n : 0; }
    function r2(n) { return Math.round(n * 100) / 100; }
    function clamp(v, lo, hi) { return v < lo ? lo : v > hi ? hi : v; }
    function esc(s) {
      return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;')
        .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    // Parse an ISO date string without timezone drift (YYYY-MM-DD as a local
    // calendar date). Falls back to Date for anything non-canonical.
    function parseISO(iso) {
      var m = /^(\d{4})-(\d{2})-(\d{2})/.exec(String(iso));
      if (m) return { y: +m[1], m: +m[2], d: +m[3] };
      var dt = new Date(iso);
      return { y: dt.getFullYear(), m: dt.getMonth() + 1, d: dt.getDate() };
    }
    function defaultFormatX(iso) { var p = parseISO(iso); return MONTHS[p.m - 1] + ' ' + p.d; }
    function defaultTooltipX(iso) { var p = parseISO(iso); return MONTHS[p.m - 1] + ' ' + p.d + ', ' + p.y; }

    // "nice" number for axis ticks (round 1/2/5 x 10^k).
    function niceNum(range, round) {
      if (range <= 0) return 1;
      var exp = Math.floor(Math.log10(range));
      var f = range / Math.pow(10, exp);
      var nf;
      if (round) nf = f < 1.5 ? 1 : f < 3 ? 2 : f < 7 ? 5 : 10;
      else nf = f <= 1 ? 1 : f <= 2 ? 2 : f <= 5 ? 5 : 10;
      return nf * Math.pow(10, exp);
    }

    // ---- monotone-cubic smooth path (Fritsch-Carlson) ----------------------
    function monotoneTangents(pts) {
      var n = pts.length, m = new Array(n), i;
      if (n < 2) { for (i = 0; i < n; i++) m[i] = 0; return m; }
      var d = new Array(n - 1);
      for (i = 0; i < n - 1; i++) {
        var dx = pts[i + 1].x - pts[i].x;
        d[i] = dx === 0 ? 0 : (pts[i + 1].y - pts[i].y) / dx;
      }
      m[0] = d[0];
      for (i = 1; i < n - 1; i++) m[i] = (d[i - 1] * d[i] <= 0) ? 0 : (d[i - 1] + d[i]) / 2;
      m[n - 1] = d[n - 2];
      for (i = 0; i < n - 1; i++) {
        if (d[i] === 0) { m[i] = 0; m[i + 1] = 0; continue; }
        var a = m[i] / d[i], b = m[i + 1] / d[i], s = a * a + b * b;
        if (s > 9) { var t = 3 / Math.sqrt(s); m[i] = t * a * d[i]; m[i + 1] = t * b * d[i]; }
      }
      return m;
    }
    function curveBody(pts, m) {
      var d = '', i;
      for (i = 0; i < pts.length - 1; i++) {
        var dx = pts[i + 1].x - pts[i].x;
        var c1x = pts[i].x + dx / 3, c1y = pts[i].y + m[i] * dx / 3;
        var c2x = pts[i + 1].x - dx / 3, c2y = pts[i + 1].y - m[i + 1] * dx / 3;
        d += 'C' + r2(c1x) + ' ' + r2(c1y) + ' ' + r2(c2x) + ' ' + r2(c2y) +
             ' ' + r2(pts[i + 1].x) + ' ' + r2(pts[i + 1].y);
      }
      return d;
    }
    function linePathD(pts) {
      if (pts.length < 2) return '';
      return 'M' + r2(pts[0].x) + ' ' + r2(pts[0].y) + curveBody(pts, monotoneTangents(pts));
    }
    function areaPathD(top, bottom) {
      if (top.length < 2) return '';
      var rb = bottom.slice().reverse();
      return 'M' + r2(top[0].x) + ' ' + r2(top[0].y) +
        curveBody(top, monotoneTangents(top)) +
        'L' + r2(rb[0].x) + ' ' + r2(rb[0].y) +
        curveBody(rb, monotoneTangents(rb)) + 'Z';
    }

    // ---- the primitive -----------------------------------------------------
    function areaChart(root, opts) {
      if (!root) return null;
      opts = opts || {};
      var AC_DEFAULTS = ['var(--ac-series-1)', 'var(--ac-series-2)', 'var(--ac-series-3)', 'var(--ac-series-4)', 'var(--ac-series-5)', 'var(--ac-series-6)'];

      var REDUCE = global.matchMedia
        ? global.matchMedia('(prefers-reduced-motion: reduce)') : { matches: false };

      var state = {
        data: (opts.data || []).slice(),
        series: (opts.series || []).map(function (s, i) {
          return {
            key: s.key,
            label: s.label != null ? s.label : s.key,
            color: s.color || AC_DEFAULTS[i % 6]
          };
        }),
        stacked: opts.stacked !== false,
        xKey: opts.xKey || 'x',
        height: +opts.height || 250,
        formatX: typeof opts.formatX === 'function' ? opts.formatX : defaultFormatX,
        formatY: typeof opts.formatY === 'function' ? opts.formatY : function (n) { return String(n); },
        formatTooltipX: typeof opts.formatTooltipX === 'function' ? opts.formatTooltipX : defaultTooltipX
      };

      var uid = 'ac' + (++uidCounter);
      root.classList.add('ac');

      root.innerHTML =
        '<div class="ac-plot"><div class="ac-svgwrap"></div>' +
        '<div class="ac-tooltip" hidden role="status" aria-live="polite"></div></div>' +
        '<div class="ac-legend"></div>';
      var plot = root.querySelector('.ac-plot');
      var svgWrap = root.querySelector('.ac-svgwrap');
      var tooltip = root.querySelector('.ac-tooltip');
      var legend = root.querySelector('.ac-legend');

      var geom = null;
      var firstMount = true;

      function fillOpacities() {
        var cs = global.getComputedStyle(root);
        var top = parseFloat(cs.getPropertyValue('--ac-fill-top-opacity'));
        var bot = parseFloat(cs.getPropertyValue('--ac-fill-bottom-opacity'));
        return {
          top: isFinite(top) ? top : 0.8,
          bot: isFinite(bot) ? bot : 0.1
        };
      }

      function renderLegend() {
        var html = '';
        for (var i = 0; i < state.series.length; i++) {
          var s = state.series[i];
          html += '<span class="ac-legend-item">' +
            '<span class="ac-legend-swatch" style="background:' + s.color + '"></span>' +
            '<span class="ac-legend-label">' + esc(s.label) + '</span></span>';
        }
        legend.innerHTML = html;
      }

      function render() {
        var data = state.data, series = state.series;
        var N = data.length;
        var W = Math.max(120, Math.round(root.clientWidth || root.getBoundingClientRect().width || 600));
        var H = state.height;

        var yMaxRaw = 0, i, si;
        if (state.stacked) {
          for (i = 0; i < N; i++) {
            var sum = 0;
            for (si = 0; si < series.length; si++) sum += num(data[i][series[si].key]);
            if (sum > yMaxRaw) yMaxRaw = sum;
          }
        } else {
          for (i = 0; i < N; i++)
            for (si = 0; si < series.length; si++) {
              var v = num(data[i][series[si].key]);
              if (v > yMaxRaw) yMaxRaw = v;
            }
        }
        if (yMaxRaw <= 0) yMaxRaw = 1;
        var tickCount = 4;
        var step = niceNum(yMaxRaw / tickCount, true);
        var niceMax = Math.ceil(yMaxRaw / step) * step;
        var yticks = [];
        for (var yv = 0; yv <= niceMax + 1e-9; yv += step) yticks.push(r2(yv));

        var maxYLabelLen = 1;
        for (i = 0; i < yticks.length; i++)
          maxYLabelLen = Math.max(maxYLabelLen, state.formatY(yticks[i]).length);
        var padL = clamp(maxYLabelLen * 7 + 14, 34, 72);
        var padR = 12, padT = 12, padB = 28;
        var plotW = Math.max(10, W - padL - padR);
        var plotH = Math.max(10, H - padT - padB);

        var spacing = N > 1 ? plotW / (N - 1) : 0;
        function xAt(idx) { return padL + (N > 1 ? idx * spacing : plotW / 2); }
        function yAt(val) { return padT + plotH - (val / niceMax) * plotH; }
        var yBase = yAt(0);

        var xs = [];
        for (i = 0; i < N; i++) xs.push(xAt(i));

        var ops = fillOpacities();
        var defs = '', areas = '', lines = '';
        var lineTops = [];
        var values = [];
        var lower = [];
        for (i = 0; i < N; i++) lower.push(0);

        for (si = 0; si < series.length; si++) {
          var s = series[si];
          var vals = [];
          for (i = 0; i < N; i++) vals.push(num(data[i][s.key]));
          values.push(vals);

          var topVals;
          if (state.stacked) { topVals = lower.map(function (lv, k) { return lv + vals[k]; }); }
          else { topVals = vals.slice(); }

          var topPts = xs.map(function (x, k) { return { x: x, y: yAt(topVals[k]) }; });
          var botPts = state.stacked
            ? xs.map(function (x, k) { return { x: x, y: yAt(lower[k]) }; })
            : xs.map(function (x) { return { x: x, y: yBase }; });
          lineTops.push(topPts);

          var gid = uid + '-grad-' + si;
          defs += '<linearGradient id="' + gid + '" x1="0" y1="0" x2="0" y2="1">' +
            '<stop offset="0%" style="stop-color:' + s.color + ';stop-opacity:' + ops.top + '"/>' +
            '<stop offset="100%" style="stop-color:' + s.color + ';stop-opacity:' + ops.bot + '"/>' +
            '</linearGradient>';

          var ad = areaPathD(topPts, botPts);
          if (ad) areas += '<path class="ac-area" d="' + ad + '" fill="url(#' + gid + ')"></path>';
          var ld = linePathD(topPts);
          if (ld) lines += '<path class="ac-line" data-si="' + si + '" d="' + ld +
            '" style="stroke:' + s.color + '" pathLength="1"></path>';

          if (state.stacked) lower = topVals;
        }

        var grid = '', ylabels = '';
        for (i = 0; i < yticks.length; i++) {
          var gy = r2(yAt(yticks[i]));
          grid += '<line class="ac-gridline" x1="' + padL + '" y1="' + gy +
            '" x2="' + (W - padR) + '" y2="' + gy + '"></line>';
          ylabels += '<text class="ac-axis-label" x="' + (padL - 8) + '" y="' + gy +
            '" text-anchor="end" dominant-baseline="middle">' + esc(state.formatY(yticks[i])) + '</text>';
        }

        var minGap = 56;
        var labelStep = Math.max(1, Math.ceil(minGap / (spacing || minGap)));
        var xlabels = '';
        for (i = 0; i < N; i += labelStep) {
          var lx = xAt(i), anchor = 'middle';
          if (lx < padL + 10) anchor = 'start';
          else if (lx > W - padR - 10) anchor = 'end';
          xlabels += '<text class="ac-axis-label" x="' + r2(lx) + '" y="' + (H - 10) +
            '" text-anchor="' + anchor + '">' + esc(state.formatX(data[i][state.xKey])) + '</text>';
        }

        var dots = '';
        for (si = 0; si < series.length; si++)
          dots += '<circle class="ac-cursor-dot" data-si="' + si + '" cx="0" cy="0" style="fill:' +
            series[si].color + '"></circle>';
        var cursor = '<g class="ac-cursor" aria-hidden="true">' +
          '<line class="ac-cursor-line" x1="0" y1="' + padT + '" x2="0" y2="' + (padT + plotH) + '"></line>' +
          dots + '</g>';

        var svg =
          '<svg class="ac-svg" width="' + W + '" height="' + H + '" viewBox="0 0 ' + W + ' ' + H +
          '" role="img" aria-label="Area chart">' +
          '<defs>' + defs + '</defs>' +
          '<g class="ac-grid">' + grid + '</g>' +
          '<g class="ac-areas">' + areas + '</g>' +
          '<g class="ac-lines">' + lines + '</g>' +
          '<g class="ac-yaxis">' + ylabels + '</g>' +
          '<g class="ac-xaxis">' + xlabels + '</g>' +
          cursor +
          '<rect class="ac-overlay" x="' + padL + '" y="' + padT + '" width="' + plotW +
          '" height="' + plotH + '" fill="transparent" pointer-events="all"></rect>' +
          '</svg>';

        svgWrap.innerHTML = svg;

        geom = {
          N: N, W: W, H: H, padL: padL, padT: padT, plotW: plotW, plotH: plotH,
          spacing: spacing, xs: xs, lineTops: lineTops, values: values, niceMax: niceMax
        };

        geom.svg = svgWrap.querySelector('.ac-svg');
        geom.cursor = svgWrap.querySelector('.ac-cursor');
        geom.cursorLine = svgWrap.querySelector('.ac-cursor-line');
        geom.dotEls = svgWrap.querySelectorAll('.ac-cursor-dot');

        if (firstMount && !REDUCE.matches && N >= 2) drawIn();
        firstMount = false;
      }

      function drawIn() {
        var dur = parseFloat(global.getComputedStyle(root).getPropertyValue('--ac-dur')) || 620;
        var ease = (global.getComputedStyle(root).getPropertyValue('--ac-ease') || '').trim() ||
          'cubic-bezier(0.23,1,0.32,1)';
        var lineEls = svgWrap.querySelectorAll('.ac-line');
        var areaEls = svgWrap.querySelectorAll('.ac-area');
        var k;
        for (k = 0; k < lineEls.length; k++) {
          if (typeof lineEls[k].animate !== 'function') break;
          lineEls[k].style.strokeDasharray = '1';
          lineEls[k].animate(
            [{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }],
            { duration: dur, easing: ease, fill: 'backwards' }
          ).onfinish = (function (el) { return function () { el.style.strokeDasharray = ''; }; })(lineEls[k]);
        }
        for (k = 0; k < areaEls.length; k++) {
          if (typeof areaEls[k].animate !== 'function') break;
          areaEls[k].animate(
            [{ opacity: 0 }, { opacity: 1 }],
            { duration: dur, easing: ease, fill: 'backwards' }
          );
        }
      }

      function indexFromEvent(ev) {
        if (!geom) return -1;
        var rect = geom.svg.getBoundingClientRect();
        var scale = rect.width ? geom.W / rect.width : 1;
        var localX = (ev.clientX - rect.left) * scale;
        if (geom.N <= 1) return geom.N - 1;
        var idx = Math.round((localX - geom.padL) / geom.spacing);
        return clamp(idx, 0, geom.N - 1);
      }

      function showAt(idx) {
        if (!geom || idx < 0 || geom.N === 0) return;
        var cx = geom.xs[idx];
        geom.cursorLine.setAttribute('x1', r2(cx));
        geom.cursorLine.setAttribute('x2', r2(cx));
        var si;
        for (si = 0; si < geom.dotEls.length; si++) {
          var pt = geom.lineTops[si][idx];
          geom.dotEls[si].setAttribute('cx', r2(pt.x));
          geom.dotEls[si].setAttribute('cy', r2(pt.y));
        }
        geom.cursor.classList.add('ac-cursor--on');

        var iso = state.data[idx][state.xKey];
        var html = '<div class="ac-tip-title">' + esc(state.formatTooltipX(iso)) + '</div>';
        for (si = 0; si < state.series.length; si++) {
          var s = state.series[si];
          html += '<div class="ac-tip-row">' +
            '<span class="ac-tip-swatch" style="background:' + s.color + '"></span>' +
            '<span class="ac-tip-name">' + esc(s.label) + '</span>' +
            '<span class="ac-tip-val">' + esc(state.formatY(geom.values[si][idx])) + '</span></div>';
        }
