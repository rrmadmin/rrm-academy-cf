---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Email Observatory | Admin" description="Email deliverability, broadcasts, and list health across all transactional and newsletter mail" noindex={true} bodyClass="admin-page">

  <div class="admin-bar">
    <div class="container admin-bar__inner">
      <span class="admin-bar__title">RRM Admin</span>
      <nav class="admin-bar__nav">
        <a href="/admin/backlinks/" class="admin-bar__link">Backlinks</a>
        <a href="/admin/conversions/" class="admin-bar__link">Conversions</a>
        <a href="/admin/content/" class="admin-bar__link">Content</a>
        <a href="/admin/email/" class="admin-bar__link admin-bar__link--active">Email</a>
        <a href="/admin/seo/" class="admin-bar__link">SEO</a>
        <a href="/admin/revenue/" class="admin-bar__link">Revenue</a>
        <a href="/admin/enrollments/" class="admin-bar__link">Enrollments</a>
      </nav>
      <div class="admin-bar__actions">
        <a href="/" class="admin-bar__site-link">Return to site</a>
        <button class="admin-bar__logout" id="logout-btn">Logout</button>
      </div>
    </div>
  </div>

  <section class="emd" id="emd-root">
    <div class="emd-wrap">

      <!-- Page head -->
      <div class="head">
        <div>
          <h1>Email Observatory</h1>
          <p>Deliverability, broadcasts, and list health across all transactional + newsletter mail <span class="faint" id="updated-note">&middot; loading&hellip;</span></p>
        </div>
        <div class="seg" id="period-seg" role="group" aria-label="Time period">
          <button type="button" data-days="7">7d</button>
          <button type="button" data-days="30" class="on">30d</button>
          <button type="button" data-days="90">90d</button>
          <button type="button" data-days="365">1y</button>
        </div>
      </div>

      <div class="emd-grid">

      <!-- KPIs (full width) -->
      <div class="kpis span-full" id="kpis">
        <div class="kpi"><div class="kpi__l">Loading&hellip;</div><div class="kpi__v">&middot;</div></div>
      </div>

      <!-- Send volume (full width) -->
      <div class="card span-full">
        <h2>Send volume <span class="faint h2sub">by day, transactional vs newsletter</span></h2>
        <div id="vol-wrap">
          <svg id="vol" viewBox="0 0 720 240" preserveAspectRatio="none" class="vol-svg"></svg>
        </div>
        <div class="legend" id="vol-legend">
          <span><i class="sw-tx"></i>Transactional</span>
          <span><i class="sw-nl"></i>Newsletter</span>
          <span class="faint" id="vol-total">&mdash;</span>
        </div>
      </div>

      <!-- 3-column row: deliverability | list health | sources -->
      <div class="card">
        <h2>Deliverability <span class="tag" id="deliv-tag">awaiting feed</span></h2>
        <div class="gauges" id="gauges">
          <div class="gauge" id="g-bounce"></div>
          <div class="gauge" id="g-complaint"></div>
        </div>
        <p class="note" id="deliv-note">Gauged against SES enforcement lines: <b>bounce 5%</b>, <b>complaint 0.1%</b>. Crossing either risks sending suspension.</p>
      </div>

      <div class="card">
        <h2>List health <span class="faint h2sub">newsletter subscribers</span></h2>
        <div id="list-health">
          <div class="cell-empty">Loading&hellip;</div>
        </div>
      </div>

      <div class="card">
        <h2>Top send sources <span class="faint h2sub" id="src-period">period</span></h2>
        <div class="src" id="src">
          <div class="cell-empty">Loading&hellip;</div>
        </div>
      </div>

      <!-- Campaign breakdown (full width) -->
      <div class="card span-full">
        <h2>Campaign breakdown <span class="faint h2sub">per newsletter send &middot; full send metrics</span></h2>
        <div class="x-scroll">
          <table class="tbl">
            <thead><tr><th>Campaign</th><th>Sent</th><th>Funnel</th><th>Delivered</th><th>Open</th><th>Click</th><th>Bounce</th><th>Complaint</th><th>Status</th></tr></thead>
            <tbody id="broadcasts-body">
              <tr><td colspan="9" class="cell-empty">Loading&hellip;</td></tr>
            </tbody>
          </table>
        </div>
        <p class="note">Click any open, click, or bounce count to open the recipient cohort. Detailed per-recipient cohorts populate once the SES event feed is live.</p>
      </div>

      <!-- Event log (full width) -->
      <div class="card span-full">
        <h2>Event log &amp; recipient timeline</h2>
        <div class="emd-filters" id="filters">
          <select class="emd-select" id="f-event" aria-label="Event type">
            <option value="">All events</option>
            <option value="send">Send</option>
            <option value="failed">Failed</option>
            <option value="delivery">Delivery</option>
            <option value="open">Open</option>
            <option value="click">Click</option>
            <option value="bounce">Bounce</option>
            <option value="complaint">Complaint</option>
            <option value="reject">Reject</option>
          </select>
          <select class="emd-select" id="f-category" aria-label="Category">
            <option value="">All categories</option>
            <option value="transactional">Transactional</option>
            <option value="newsletter">Newsletter</option>
          </select>
          <input type="text" class="emd-input" id="f-source" placeholder="Source&hellip;" aria-label="Source" />
          <input type="text" class="emd-input" id="f-email" placeholder="Email prefix&hellip;" aria-label="Email prefix" />
          <button type="button" class="emd-apply" id="apply-btn">Apply</button>
        </div>
        <div class="logwrap">
          <table class="log">
            <thead><tr>
              <th class="sortable" data-sort="created_at">Time<span class="sort-arrow"></span></th>
              <th class="sortable" data-sort="event">Event<span class="sort-arrow"></span></th>
              <th class="sortable" data-sort="email">Recipient<span class="sort-arrow"></span></th>
              <th class="sortable" data-sort="source">Source<span class="sort-arrow"></span></th>
              <th>Subject</th>
              <th>Detail</th>
            </tr></thead>
            <tbody id="log-body">
              <tr><td colspan="6" class="cell-empty">Loading&hellip;</td></tr>
            </tbody>
          </table>
        </div>
        <div class="emd-pager" id="pager">
          <button type="button" class="emd-page-btn" id="prev-btn" disabled>&larr; Prev</button>
          <span class="emd-page-info" id="page-info">Page 1</span>
          <button type="button" class="emd-page-btn" id="next-btn" disabled>Next &rarr;</button>
        </div>
        <p class="note">Click any recipient to open a per-person timeline (sent &rarr; delivered &rarr; opened &rarr; clicked &rarr; bounced), reconstructed from the email log joined to SES events.</p>
      </div>

    </div>

    <!-- Drawer -->
    <div class="emd-drawer" id="drawer" hidden>
      <div class="emd-drawer__scrim" id="drawer-scrim"></div>
      <aside class="emd-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="drawer-title">
        <header class="emd-drawer__head">
          <div>
            <div class="emd-drawer__eyebrow" id="drawer-eyebrow">Cohort</div>
            <h2 class="emd-drawer__title" id="drawer-title">&mdash;</h2>
          </div>
          <button type="button" class="emd-drawer__close" id="drawer-close" aria-label="Close">&times;</button>
        </header>
        <div class="emd-drawer__body" id="drawer-body"></div>
      </aside>
    </div>
  </section>

  <script is:inline>
  (function () {
    var $ = function (id) { return document.getElementById(id); };

    // ---- helpers ----------------------------------------------------------
    function esc(s) { var d = document.createElement('div'); d.textContent = (s == null ? '' : String(s)); return d.innerHTML; }
    function num(n) { return (Number(n) || 0).toLocaleString(); }
    function fmtPct(rate) {
      var p = (Number(rate) || 0) * 100;
      var dec = p >= 10 ? 1 : 2;
      return p.toFixed(dec) + '%';
    }
    function pad2(n) { return String(n).padStart(2, '0'); }
    function ymd(d) { return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate()); }
    function rangeFor(days) {
      var to = new Date();
      var from = new Date(Date.now() - (days - 1) * 86400 * 1000);
      return { from: ymd(from), to: ymd(to) };
    }
    var MON = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    function fmtTime(iso) {
      if (!iso) return '--';
      var d = new Date(iso);
      if (isNaN(d.getTime())) return esc(iso);
      var h = d.getHours(), ampm = h >= 12 ? 'PM' : 'AM';
      h = h % 12 || 12;
      return MON[d.getMonth()] + ' ' + d.getDate() + ', ' + h + ':' + pad2(d.getMinutes()) + ' ' + ampm;
    }
    var EV_LABEL = { send:'Send', failed:'Failed', delivery:'Delivered', open:'Open', click:'Click', bounce:'Bounce', complaint:'Complaint', reject:'Reject' };
    var EV_CLASS = { send:'send', failed:'bounce', delivery:'deliv', open:'open', click:'click', bounce:'bounce', complaint:'bounce', reject:'bounce' };
    function evBadge(ev) {
      var k = String(ev || '').toLowerCase();
      return '<span class="ev ' + (EV_CLASS[k] || 'send') + '">' + esc(EV_LABEL[k] || ev || '?') + '</span>';
    }
    function emailLink(email) {
      if (!email) return '<span class="faint">--</span>';
      return '<button type="button" class="em emd-recip" data-email="' + esc(email) + '">' + esc(email) + '</button>';
    }

    // ---- state ------------------------------------------------------------
    var state = {
      days: 30,
      from: '', to: '',
      log: { page: 1, pages: 1, sort: 'created_at', order: 'desc' },
      cohortRows: [],
      cohortMeta: null
    };

    // ---- API --------------------------------------------------------------
    async function apiCall(params) {
      var qs = '?' + new URLSearchParams(params).toString();
      var resp = await fetch('/api/admin/email' + qs, { credentials: 'include' });
      if (resp.status === 401 || resp.status === 403) {
        window.location.href = '/login/?redirect=/admin/email/';
        return null;
      }
      var data = await resp.json().catch(function () { return {}; });
      if (!resp.ok || !data || data.ok === false) {
        throw new Error((data && data.error) || ('Request failed (' + resp.status + ')'));
      }
      return data.data;
    }

    // ---- SVG renderers (ported from approved mockup) ----------------------
    function sparkline(d) {
      if (!d || d.length < 2) return '';
      var w = 120, h = 30, min = Math.min.apply(null, d), max = Math.max.apply(null, d), r = (max - min) || 1;
      var pts = d.map(function (v, i) { return [i / (d.length - 1) * w, h - 2 - ((v - min) / r) * (h - 6)]; });
      var path = pts.map(function (p, i) { return (i ? 'L' : 'M') + p[0].toFixed(1) + ' ' + p[1].toFixed(1); }).join(' ');
      var area = path + ' L' + w + ' ' + h + ' L0 ' + h + ' Z';
      return '<svg class="spark" viewBox="0 0 ' + w + ' ' + h + '" preserveAspectRatio="none">' +
        '<path d="' + area + '" fill="rgba(114,94,126,.10)"/>' +
        '<path d="' + path + '" fill="none" stroke="#725E7E" stroke-width="1.6"/></svg>';
    }

    function volumeSvg(byDay) {
      if (!byDay || !byDay.length) return null;
      var days = byDay.length;
      var tx = byDay.map(function (d) { return Number(d.transactional) || 0; });
      var nl = byDay.map(function (d) { return Number(d.newsletter) || 0; });
      var W = 720, H = 240, pad = 24, max = 0;
      for (var j = 0; j < days; j++) { max = Math.max(max, tx[j] + nl[j]); }
      max = Math.max(10, Math.ceil(max / 10) * 10);
      var xw = days > 1 ? (W - pad * 2) / (days - 1) : 0;
      function X(i) { return days > 1 ? pad + i * xw : W / 2; }
      function Y(v) { return H - pad - (v / max) * (H - pad * 2); }
      function areaPath(top, bot) {
        var up = top.map(function (v, i) { return (i ? 'L' : 'M') + X(i).toFixed(1) + ' ' + Y(v).toFixed(1); }).join(' ');
        var dn = [];
        for (var i = bot.length - 1; i >= 0; i--) { dn.push('L' + X(i).toFixed(1) + ' ' + Y(bot[i]).toFixed(1)); }
        return up + ' ' + dn.join(' ') + ' Z';
      }
      var base = tx.map(function () { return 0; });
      var txTop = tx.slice();
      var nlTop = tx.map(function (v, i) { return v + nl[i]; });
      var grid = '';
      for (var g = 0; g <= 4; g++) {
        var gy = pad + (g / 4) * (H - pad * 2);
        grid += '<line x1="' + pad + '" y1="' + gy + '" x2="' + (W - pad) + '" y2="' + gy + '" stroke="#eee" stroke-width="1"/>' +
          '<text x="4" y="' + (gy + 4) + '" font-size="10" fill="#bbb">' + Math.round(max - (g / 4) * max) + '</text>';
      }
      return grid +
        '<path d="' + areaPath(nlTop, base) + '" fill="rgba(114,94,126,.55)"/>' +
        '<path d="' + areaPath(txTop, base) + '" fill="rgba(138,166,198,.65)"/>' +
        '<path d="' + txTop.map(function (v, i) { return (i ? 'L' : 'M') + X(i).toFixed(1) + ' ' + Y(v).toFixed(1); }).join(' ') + '" fill="none" stroke="#5f7da9" stroke-width="1.4"/>';
    }

    function gaugeMarkup(label, val, unit, warn, bad, type, empty) {
      var cx = 75, cy = 78, r = 58;
      function pt(a) { var rad = a * Math.PI / 180; return [cx + r * Math.cos(rad), cy + r * Math.sin(rad)]; }
      function arc(a1, a2, col, wd) {
        var p1 = pt(a1), p2 = pt(a2), large = (a2 - a1) > 180 ? 1 : 0;
        return '<path d="M' + p1[0].toFixed(1) + ' ' + p1[1].toFixed(1) + ' A' + r + ' ' + r + ' 0 ' + large + ' 1 ' + p2[0].toFixed(1) + ' ' + p2[1].toFixed(1) + '" fill="none" stroke="' + col + '" stroke-width="' + wd + '" stroke-linecap="round"/>';
      }
      var frac = Math.min(Math.max(val, 0) / bad, 1);
      var ang = -90 + frac * 180;
      var warnAng = -90 + (warn / bad) * 180;
      var state2 = val >= bad ? 'bad' : val >= warn ? 'warn' : 'ok';
      var needle = pt(ang);
      var valTxt = (Math.round(val * 100) / 100) + unit;
      var svg = '<svg viewBox="0 0 150 100" role="img" aria-label="' + esc(label + ' ' + valTxt) + '">' +
        arc(-90, 90, '#ece6e9', 11) +
        arc(-90, warnAng, '#1f9d57', 11) +
        arc(warnAng, -90 + 0.92 * 180, '#d98324', 11) +
        arc(-90 + 0.92 * 180, 90, '#c0392b', 11) +
        '<line x1="' + cx + '" y1="' + cy + '" x2="' + needle[0].toFixed(1) + '" y2="' + needle[1].toFixed(1) + '" stroke="#2c2530" stroke-width="2.4"/>' +
        '<circle cx="' + cx + '" cy="' + cy + '" r="4" fill="#2c2530"/>' +
        '<text x="75" y="60" text-anchor="middle" font-size="20" font-weight="700" fill="#2c2530">' + esc(valTxt) + '</text>' +
        '</svg>';
      var pill = empty
        ? '<span class="pill warn">awaiting feed</span>'
        : '<span class="pill ' + state2 + '">' + (state2 === 'ok' ? 'healthy' : state2) + ' &middot; line ' + bad + unit + '</span>';
      return '<button type="button" class="gauge-btn emd-drill" data-type="' + esc(type) + '" data-label="' + esc(label) + '">' +
        svg + '<div class="gauge__cap">' + esc(label) + '</div>' + pill + '</button>';
    }

    // ---- summary ----------------------------------------------------------
    function renderKpis(d) {
      var list = d.list || {}, sends = d.sends || {}, deliv = d.deliverability || {}, eng = d.engagement || {};
      var byDay = sends.by_day || [];
      var sendSeries = byDay.map(function (x) { return (Number(x.transactional) || 0) + (Number(x.newsletter) || 0); });
      var delivSeries = (deliv.by_day || []).map(function (x) { return Number(x.delivered) || 0; });
      var hasDeliv = (Number(deliv.delivered) || 0) + (Number(deliv.bounced) || 0) + (Number(deliv.complained) || 0) + (Number(deliv.rejected) || 0) > 0;
      var tracked = !!eng.tracked;

      var cards = [
        { l: 'Active subscribers', v: num(list.active), d: num(list.total) + ' on list', c: 'flat', spark: null, drill: null },
        { l: 'Unsub rate', v: fmtPct(list.unsub_period_rate), d: num(list.unsub_period) + ' unsubscribed in ' + state.days + 'd', c: 'flat', spark: null, drill: null },
        { l: 'Sends (' + state.days + 'd)', v: num(sends.total), d: num(sends.transactional) + ' txn &middot; ' + num(sends.newsletter) + ' nl', c: 'flat', spark: sendSeries, drill: null },
        { l: 'Delivered', v: hasDeliv ? num(deliv.delivered) : '&mdash;', d: hasDeliv ? ('bounce ' + fmtPct(deliv.bounce_rate)) : 'awaiting SES feed', c: hasDeliv ? 'flat' : 'muteline', spark: hasDeliv ? delivSeries : null, drill: hasDeliv ? 'delivery' : null },
        { l: 'Open rate', v: tracked ? fmtPct(eng.open_rate) : '&mdash;', d: tracked ? (num(eng.opened) + ' opens') : 'awaiting SES feed', c: tracked ? 'flat' : 'muteline', spark: null, drill: tracked ? 'open' : null },
        { l: 'Complaint rate', v: hasDeliv ? fmtPct(deliv.complaint_rate) : '&mdash;', d: hasDeliv ? (num(deliv.complained) + ' complaints') : 'awaiting SES feed', c: hasDeliv ? 'flat' : 'muteline', spark: null, drill: hasDeliv ? 'complaint' : null }
      ];

      $('kpis').innerHTML = cards.map(function (k) {
        var drillAttr = k.drill ? ' emd-drill" data-type="' + esc(k.drill) + '" tabindex="0' : '';
        var open = k.drill ? '<div class="kpi kpi--drill' + drillAttr + '" role="button">' : '<div class="kpi">';
        return open +
          '<div class="kpi__l">' + esc(k.l) + '</div>' +
          '<div class="kpi__v tnum">' + k.v + '</div>' +
          '<div class="kpi__d ' + k.c + '">' + k.d + '</div>' +
          (k.spark ? sparkline(k.spark) : '') +
          '</div>';
      }).join('');
    }

    function renderVolume(d) {
      var sends = d.sends || {};
      var byDay = sends.by_day || [];
      var svg = volumeSvg(byDay);
      if (svg === null) {
        $('vol-wrap').innerHTML = '<div class="cell-empty">No sends recorded in this period.</div>';
      } else {
        $('vol-wrap').innerHTML = '<svg id="vol" viewBox="0 0 720 240" preserveAspectRatio="none" class="vol-svg">' + svg + '</svg>';
      }
      $('vol-total').innerHTML = num(sends.total) + ' sends in period &middot; ' +
        num(sends.transactional) + ' transactional, ' + num(sends.newsletter) + ' newsletter';
    }

    function renderGauges(d) {
      var deliv = d.deliverability || {};
      var hasDeliv = (Number(deliv.delivered) || 0) + (Number(deliv.bounced) || 0) + (Number(deliv.complained) || 0) + (Number(deliv.rejected) || 0) > 0;
      var bounceP = (Number(deliv.bounce_rate) || 0) * 100;
      var complP = (Number(deliv.complaint_rate) || 0) * 100;
      $('g-bounce').outerHTML = '<div class="gauge" id="g-bounce">' + gaugeMarkup('Bounce rate', bounceP, '%', 3, 5, 'bounce', !hasDeliv) + '</div>';
      $('g-complaint').outerHTML = '<div class="gauge" id="g-complaint">' + gaugeMarkup('Complaint rate', complP, '%', 0.05, 0.1, 'complaint', !hasDeliv) + '</div>';
      if (hasDeliv) {
        $('deliv-tag').style.display = 'none';
        $('deliv-note').innerHTML = 'Gauged against SES enforcement lines: <b>bounce 5%</b>, <b>complaint 0.1%</b>. Crossing either risks sending suspension.';
      } else {
        $('deliv-tag').style.display = '';
        $('deliv-note').innerHTML = '<b>Awaiting SES event feed.</b> Deliverability populates once SES bounce/complaint/delivery notifications are wired. Gauges read 0 until then.';
      }
    }

    function renderListHealth(d) {
      var list = d.list || {};
      var total = Number(list.total) || 0;
      var segs = [
        { l: 'Active', v: Number(list.active) || 0, cls: 'lh-active' },
        { l: 'Unsubscribed', v: Number(list.unsubscribed) || 0, cls: 'lh-unsub' },
        { l: 'Bounced', v: Number(list.bounced) || 0, cls: 'lh-bounce' },
        { l: 'Complained', v: Number(list.complained) || 0, cls: 'lh-compl' }
      ];
      if (total === 0) {
        $('list-health').innerHTML = '<div class="cell-empty">No subscribers on file.</div>';
        return;
      }
      var bar = '<div class="lh-bar" role="img" aria-label="List composition">' + segs.map(function (s) {
        var w = (s.v / total) * 100;
        if (w <= 0) return '';
        return '<span class="' + s.cls + '" style="width:' + w.toFixed(2) + '%" title="' + esc(s.l + ': ' + num(s.v)) + '"></span>';
      }).join('') + '</div>';
      var rows = segs.map(function (s) {
        return '<div class="lh-row"><span class="lh-key"><i class="' + s.cls + '"></i>' + esc(s.l) + '</span>' +
          '<span class="lh-val tnum">' + num(s.v) + '</span>' +
          '<span class="lh-pct tnum faint">' + (total ? ((s.v / total) * 100).toFixed(1) + '%' : '0%') + '</span></div>';
      }).join('');
      var importedUnsub = Number(list.unsub_imported) || 0;
      var lhNote = importedUnsub > 0 ? '<p class="note">' + num(importedUnsub) + ' of the unsubscribed are imported legacy opt-outs (pre-2026) — suppressed, but not recent churn.</p>' : '';
      $('list-health').innerHTML = bar + '<div class="lh-rows">' + rows +
        '<div class="lh-row lh-total"><span class="lh-key">Total</span><span class="lh-val tnum">' + num(total) + '</span><span class="lh-pct"></span></div></div>' + lhNote;
    }

    function renderSources(d) {
      var sources = (d.sends && d.sends.by_source) || [];
      $('src-period').textContent = state.days + 'd';
      if (!sources.length) {
        $('src').innerHTML = '<div class="cell-empty">No sends in this period.</div>';
        return;
      }
      var smax = Math.max.apply(null, sources.map(function (s) { return Number(s.n) || 0; })) || 1;
      $('src').innerHTML = sources.map(function (s) {
        var label = s.source || '(unknown)';
        var n = Number(s.n) || 0;
        return '<div class="src__row"><b title="' + esc(label) + '">' + esc(label) + '</b>' +
          '<div class="src__bar" style="width:' + Math.max(6, (n / smax * 100)) + '%"></div>' +
          '<span class="src__n tnum">' + num(n) + '</span></div>';
      }).join('');
    }

    async function loadSummary() {
      try {
        var d = await apiCall({ view: 'summary', from: state.from, to: state.to });
        if (!d) return;
        renderKpis(d);
        renderVolume(d);
        renderGauges(d);
        renderListHealth(d);
        renderSources(d);
        $('updated-note').textContent = '· updated ' + fmtTime(new Date().toISOString());
      } catch (e) {
        $('kpis').innerHTML = '<div class="kpi"><div class="kpi__l">Error</div><div class="kpi__d down">' + esc(e.message) + '</div></div>';
      }
    }

    // ---- broadcasts -------------------------------------------------------
    function funnel(sent, delivered, opened, clicked) {
      var s = Math.max(sent, 1);
      var segs = [
        { c: 'f1', v: sent, t: 'Sent' },
        { c: 'f2', v: delivered, t: 'Delivered' },
        { c: 'f3', v: opened, t: 'Opened' },
        { c: 'f4', v: clicked, t: 'Clicked' }
      ];
      return '<div class="funnel">' + segs.map(function (x) {
        var flex = Math.max(0.07, x.v / s);
        return '<span class="' + x.c + '" style="flex:' + flex.toFixed(3) + '" title="' + esc(x.t + ': ' + num(x.v)) + '">' + num(x.v) + '</span>';
      }).join('') + '</div>';
    }

    function renderBroadcasts(rows) {
      if (!rows || !rows.length) {
        $('broadcasts-body').innerHTML = '<tr><td colspan="9" class="cell-empty">No broadcasts sent yet.</td></tr>';
        return;
      }
      $('broadcasts-body').innerHTML = rows.map(function (b) {
        var sent = Number(b.sent) || 0;
        var delivered = Number(b.delivered) || 0;
        var bounced = Number(b.bounced) || 0;
        var complained = Number(b.complained) || 0;
        function ofSent(n) { return sent ? ((n / sent) * 100).toFixed((n / sent) >= 0.1 ? 1 : 2) + '%' : '0%'; }
        var statusCls = (b.status === 'sent' || b.status === 'completed') ? '' : 'stpill--alt';
        var deliveredCell = '<b class="tnum">' + num(delivered) + '</b> <small class="faint">' + ofSent(delivered) + '</small>';
        var openCell = '<button type="button" class="rate emd-cohort" data-type="open" data-send="' + esc(b.id) + '" data-label="' + esc('Opens · ' + (b.subject || '')) + '">' + fmtPct(b.open_rate) + ' <small>' + num(b.opened) + '</small></button>';
        var clickCell = '<button type="button" class="rate emd-cohort" data-type="click" data-send="' + esc(b.id) + '" data-label="' + esc('Clicks · ' + (b.subject || '')) + '">' + fmtPct(b.click_rate) + ' <small>' + num(b.clicked) + '</small></button>';
        var bounceCell = '<button type="button" class="rate emd-cohort" data-type="bounce" data-send="' + esc(b.id) + '" data-label="' + esc('Bounces · ' + (b.subject || '')) + '">' + num(bounced) + ' <small class="faint">' + ofSent(bounced) + '</small></button>';
        var complaintCell = '<button type="button" class="rate emd-cohort" data-type="complaint" data-send="' + esc(b.id) + '" data-label="' + esc('Complaints · ' + (b.subject || '')) + '">' + num(complained) + '</button>';
        return '<tr>' +
          '<td class="subj">' + esc(b.subject || '(no subject)') + '<small>' + esc(fmtTime(b.sent_at)) + '</small></td>' +
          '<td class="tnum">' + num(sent) + '</td>' +
          '<td>' + funnel(sent, delivered, Number(b.opened) || 0, Number(b.clicked) || 0) + '</td>' +
          '<td class="tnum">' + deliveredCell + '</td>' +
          '<td>' + openCell + '</td>' +
          '<td>' + clickCell + '</td>' +
          '<td>' + bounceCell + '</td>' +
          '<td>' + complaintCell + '</td>' +
          '<td><span class="stpill ' + statusCls + '">' + esc(b.status || '--') + '</span></td>' +
          '</tr>';
      }).join('');
    }

    async function loadBroadcasts() {
      try {
        var d = await apiCall({ view: 'broadcasts' });
        if (!d) return;
        renderBroadcasts(d.broadcasts || []);
      } catch (e) {
        $('broadcasts-body').innerHTML = '<tr><td colspan="9" class="cell-empty down">' + esc(e.message) + '</td></tr>';
      }
    }

    // ---- log --------------------------------------------------------------
    function logParams() {
      var p = {
        view: 'log',
        from: state.from, to: state.to,
        page: state.log.page,
        sort: state.log.sort,
        order: state.log.order,
        limit: 50
      };
      var ev = $('f-event').value;
      var cat = $('f-category').value;
      var src = $('f-source').value.trim();
      var email = $('f-email').value.trim();
      if (ev) p.event = ev;
      if (cat) p.category = cat;
      if (src) p.source = src;
      if (email) p.email = email;
      return p;
    }

    function renderLog(d) {
      var events = d.events || [];
      if (!events.length) {
        $('log-body').innerHTML = '<tr><td colspan="6" class="cell-empty">No events match.</td></tr>';
      } else {
        $('log-body').innerHTML = events.map(function (e) {
          return '<tr>' +
            '<td class="faint nowrap">' + esc(fmtTime(e.created_at)) + '</td>' +
            '<td>' + evBadge(e.event) + '</td>' +
            '<td>' + emailLink(e.email) + '</td>' +
            '<td class="muted">' + esc(e.source || '--') + '</td>' +
            '<td class="muted col-subj">' + esc(e.subject || '--') + '</td>' +
            '<td class="muted col-detail">' + esc(e.detail || '') + '</td>' +
            '</tr>';
        }).join('');
      }
      state.log.page = d.page || 1;
      state.log.pages = d.pages || 1;
      $('page-info').textContent = 'Page ' + state.log.page + ' of ' + state.log.pages + ' · ' + num(d.total) + ' events';
      $('prev-btn').disabled = state.log.page <= 1;
      $('next-btn').disabled = state.log.page >= state.log.pages;
      document.querySelectorAll('#filters ~ .logwrap .sortable .sort-arrow, .log .sortable .sort-arrow').forEach(function (a) { a.textContent = ''; });
      var active = document.querySelector('.log th.sortable[data-sort="' + state.log.sort + '"] .sort-arrow');
      if (active) active.textContent = state.log.order === 'asc' ? ' ▲' : ' ▼';
    }

    async function loadLog() {
      $('log-body').innerHTML = '<tr><td colspan="6" class="cell-empty">Loading&hellip;</td></tr>';
      try {
        var d = await apiCall(logParams());
        if (!d) return;
        renderLog(d);
      } catch (e) {
        $('log-body').innerHTML = '<tr><td colspan="6" class="cell-empty down">' + esc(e.message) + '</td></tr>';
      }
    }

    // ---- drawer -----------------------------------------------------------
    var lastFocus = null;
    function openDrawer() {
      var dr = $('drawer');
      if (!dr.hasAttribute('hidden')) return;
      lastFocus = document.activeElement;
      dr.removeAttribute('hidden');
      document.body.style.overflow = 'hidden';
      $('drawer-close').focus();
    }
    function closeDrawer() {
      var dr = $('drawer');
      dr.setAttribute('hidden', '');
      document.body.style.overflow = '';
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }

    function recipientRowsHtml(rows) {
      return rows.map(function (r) {
        var bits = [];
        if (r.bounce_type) bits.push('bounce: ' + r.bounce_type);
        if (r.feedback_type) bits.push('feedback: ' + r.feedback_type);
        if (r.link_url) bits.push(r.link_url);
        if (!bits.length && r.detail) bits.push(r.detail);
        return '<div class="dr-row">' +
          '<button type="button" class="em emd-recip" data-email="' + esc(r.email) + '">' + esc(r.email) + '</button>' +
          '<div class="dr-meta"><span class="faint">' + esc(fmtTime(r.ts)) + '</span>' +
          (bits.length ? '<span class="muted">' + esc(bits.join(' · ')) + '</span>' : '') + '</div></div>';
      }).join('');
    }

    async function openCohort(type, sendId, label) {
      $('drawer-eyebrow').textContent = 'Cohort';
      $('drawer-title').textContent = label || (type.charAt(0).toUpperCase() + type.slice(1));
      $('drawer-body').innerHTML = '<div class="cell-empty">Loading&hellip;</div>';
      openDrawer();
      try {
        var params = { view: 'cohort', type: type, from: state.from, to: state.to, page: 1, limit: 200 };
        if (sendId) params.send_id = sendId;
        var d = await apiCall(params);
        if (!d) return;
        state.cohortRows = d.recipients || [];
        state.cohortMeta = { cohort: d.cohort, send_id: d.send_id, count: d.count };
        var head = '<div class="dr-head"><div><b class="tnum">' + num(d.count) + '</b> ' + esc(d.cohort) + ' recipients' +
          (d.send_id ? ' <span class="faint">(this broadcast)</span>' : ' <span class="faint">(' + state.days + 'd)</span>') + '</div>' +
          (state.cohortRows.length ? '<button type="button" class="emd-csv" id="csv-btn">Export CSV</button>' : '') + '</div>';
        var body = state.cohortRows.length
          ? '<div class="dr-list">' + recipientRowsHtml(state.cohortRows) + '</div>'
          : '<div class="cell-empty">No recipients recorded for this cohort yet. Per-recipient event cohorts populate once the SES event feed is live.</div>';
        $('drawer-body').innerHTML = head + body;
      } catch (e) {
        $('drawer-body').innerHTML = '<div class="cell-empty down">' + esc(e.message) + '</div>';
      }
    }

    function exportCohortCsv() {
      var rows = state.cohortRows || [];
      var cols = ['email', 'ts', 'bounce_type', 'feedback_type', 'link_url', 'detail'];
      var lines = [cols.join(',')];
      rows.forEach(function (r) {
        lines.push(cols.map(function (c) {
          var v = r[c] == null ? '' : String(r[c]);
          if (/[",\n]/.test(v)) v = '"' + v.replace(/"/g, '""') + '"';
          return v;
        }).join(','));
      });
      var blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8' });
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      var meta = state.cohortMeta || {};
      a.href = url;
      a.download = 'cohort-' + (meta.cohort || 'export') + (meta.send_id ? '-' + meta.send_id : '') + '.csv';
      document.body.appendChild(a); a.click(); document.body.removeChild(a);
      setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
    }

    async function openRecipient(email) {
      if (!email) return;
      $('drawer-eyebrow').textContent = 'Recipient timeline';
      $('drawer-title').textContent = email;
      $('drawer-body').innerHTML = '<div class="cell-empty">Loading&hellip;</div>';
      openDrawer();
      try {
        var d = await apiCall({ view: 'recipient', email: email });
        if (!d) return;
        var s = d.summary || {};
        var statGrid = '<div class="dr-stats">' +
          dstat('Sent', num(s.total_sent)) +
          dstat('Delivered', num(s.delivered)) +
          dstat('Opens', num(s.opens)) +
          dstat('Clicks', num(s.clicks)) +
          dstat('Bounces', num(s.bounces)) +
          dstat('Complained', s.complained ? 'Yes' : 'No') +
          '</div>';
        var span = '<p class="note">First seen ' + esc(s.first_seen ? fmtTime(s.first_seen) : '--') +
          ' &middot; last activity ' + esc(s.last_activity ? fmtTime(s.last_activity) : '--') + '</p>';
        var events = d.events || [];
        var timeline = events.length
          ? '<div class="dr-timeline">' + events.map(function (e) {
              return '<div class="dr-tl-row">' + evBadge(e.event) +
                '<div class="dr-tl-main"><div class="dr-tl-top"><span class="faint">' + esc(fmtTime(e.created_at)) + '</span>' +
                (e.source ? '<span class="muted">' + esc(e.source) + '</span>' : '') + '</div>' +
                (e.subject ? '<div class="dr-tl-subj">' + esc(e.subject) + '</div>' : '') +
                (e.detail ? '<div class="dr-tl-detail muted">' + esc(e.detail) + '</div>' : '') +
                '</div></div>';
            }).join('') + '</div>'
          : '<div class="cell-empty">No events recorded for this recipient.</div>';
        $('drawer-body').innerHTML = statGrid + span + '<h3 class="dr-h3">Event timeline</h3>' + timeline;
      } catch (e) {
        $('drawer-body').innerHTML = '<div class="cell-empty down">' + esc(e.message) + '</div>';
      }
    }
    function dstat(label, val) {
      return '<div class="dr-stat"><span class="dr-stat__l">' + esc(label) + '</span><span class="dr-stat__v tnum">' + val + '</span></div>';
    }

    // ---- events -----------------------------------------------------------
    $('logout-btn').addEventListener('click', async function () {
      await fetch('/api/auth/logout', { method: 'POST', credentials: 'include' });
      window.location.href = '/login/';
    });

    $('period-seg').addEventListener('click', function (ev) {
      var btn = ev.target.closest('button[data-days]');
      if (!btn) return;
      state.days = parseInt(btn.dataset.days, 10);
      var r = rangeFor(state.days);
      state.from = r.from; state.to = r.to;
      state.log.page = 1;
      Array.prototype.forEach.call($('period-seg').children, function (b) { b.classList.toggle('on', b === btn); });
      loadSummary(); loadLog();
    });

    $('apply-btn').addEventListener('click', function () { state.log.page = 1; loadLog(); });
    $('f-email').addEventListener('keydown', function (e) { if (e.key === 'Enter') { state.log.page = 1; loadLog(); } });
    $('f-source').addEventListener('keydown', function (e) { if (e.key === 'Enter') { state.log.page = 1; loadLog(); } });

    $('prev-btn').addEventListener('click', function () { if (state.log.page > 1) { state.log.page--; loadLog(); } });
    $('next-btn').addEventListener('click', function () { if (state.log.page < state.log.pages) { state.log.page++; loadLog(); } });

    document.querySelectorAll('.log th.sortable').forEach(function (th) {
      th.addEventListener('click', function () {
        var col = th.dataset.sort;
        if (state.log.sort === col) {
          state.log.order = state.log.order === 'asc' ? 'desc' : 'asc';
        } else {
          state.log.sort = col;
          state.log.order = col === 'created_at' ? 'desc' : 'asc';
        }
        state.log.page = 1;
        loadLog();
      });
    });

    // Delegated clicks for drill-downs + recipient links
    $('emd-root').addEventListener('click', function (ev) {
      var recip = ev.target.closest('.emd-recip');
      if (recip) { ev.preventDefault(); openRecipient(recip.dataset.email); return; }
      var cohort = ev.target.closest('.emd-cohort');
      if (cohort) { ev.preventDefault(); openCohort(cohort.dataset.type, cohort.dataset.send || '', cohort.dataset.label || ''); return; }
      var drill = ev.target.closest('.emd-drill');
      if (drill) { ev.preventDefault(); openCohort(drill.dataset.type, '', drill.dataset.label || ''); return; }
      var csv = ev.target.closest('#csv-btn');
      if (csv) { ev.preventDefault(); exportCohortCsv(); return; }
    });
    // Keyboard activation for drill KPI cards
    $('emd-root').addEventListener('keydown', function (ev) {
      if (ev.key !== 'Enter' && ev.key !== ' ') return;
      var card = ev.target.closest('.kpi--drill');
      if (card) { ev.preventDefault(); openCohort(card.dataset.type, '', ''); }
    });

    $('drawer-scrim').addEventListener('click', closeDrawer);
    $('drawer-close').addEventListener('click', closeDrawer);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !$('drawer').hasAttribute('hidden')) closeDrawer(); });

    // ---- init -------------------------------------------------------------
    (function init() {
      var r = rangeFor(state.days);
      state.from = r.from; state.to = r.to;
      loadSummary();
      loadBroadcasts();
      loadLog();
    })();
  })();
  </script>

</BaseLayout>

<style>
  :root {
    --admin-rose-700: #8a606e;
    --admin-rose-300: #c9a8b2;
    --admin-bg: #faf8f5;
    --admin-surface: #ffffff;
    --admin-border: #d9d3cc;
    --admin-text: #313131;
    --admin-text-muted: #636261;
    --admin-text-faint: #949392;
  }

  :global(.admin-page) :global(.site-header) { display: none; }
  :global(.admin-page) :global(footer) { display: none; }

  .admin-bar { background: #3d2a32; color: #f0e5e9; position: sticky; top: 0; z-index: 100; }
  .admin-bar__inner { display: flex; align-items: center; height: 48px; gap: var(--space-6); }
  .admin-bar__title { font-family: 'Cormorant Garamond', 'Georgia', serif; font-weight: 600; font-size: 1.25rem; color: var(--admin-rose-300); white-space: nowrap; }
  .admin-bar__nav { display: flex; gap: var(--space-1); } @media (max-width: 768px) { .admin-bar__nav { display: none; } }
  .admin-bar__link { font-size: 0.8125rem; font-weight: 400; color: var(--white); text-decoration: none; padding: var(--space-1) var(--space-3); border-radius: var(--radius-sm); transition: color 0.15s, background 0.15s; }
  .admin-bar__link:hover { color: var(--white); text-decoration: none; }
  .admin-bar__link--active { color: var(--white); background: var(--white); font-weight: 500; }
  .admin-bar__actions { display: flex; align-items: center; gap: var(--space-3); margin-left: auto; }
  .admin-bar__site-link { font-size: 0.8125rem; font-weight: 500; color: var(--admin-rose-300); text-decoration: none; padding: 5px var(--space-4); border: 1px solid var(--admin-rose-300); border-radius: var(--radius-pill); transition: color 0.15s, border-color 0.15s; }
  .admin-bar__site-link:hover { color: var(--white); border-color: var(--white); text-decoration: none; }
  .admin-bar__logout { font-size: 0.8125rem; color: var(--white); background: none; border: none; cursor: pointer; padding: var(--space-1) var(--space-2); }
  .admin-bar__logout:hover { color: var(--white); }
</style>

<style is:global>
  /* ====== Email Observatory dashboard (ported from approved mockup) ====== */
  /* All rules namespaced under .emd so generic class names (.card, .tag, etc.) */
  /* never leak site-wide, and styles still reach runtime-injected innerHTML.  */

  .emd {
    --plum: #725E7E; --rose700: #8a606e; --rose300: #c9a8b2; --bar: #3d2a32;
    --bg: #f7f4f1; --surface: #ffffff; --border: #e7ded7; --border2: #d9d3cc;
    --text: #2c2530; --muted: #6c6670; --faint: #9a949e;
    --green: #1f9d57; --greenbg: #e7f5ec; --red: #c0392b; --redbg: #fbeceb;
    --amber: #d98324; --amberbg: #fbf0e2; --blue: #3b6fb0; --bluebg: #eaf1fa;
    --radius: 14px; --shadow: 0 1px 2px rgba(44,37,48,.04), 0 4px 16px rgba(44,37,48,.05);
    display: block; background: var(--bg); color: var(--text); min-height: 82vh;
    font-family: 'Inter', system-ui, sans-serif; -webkit-font-smoothing: antialiased;
  }
  .emd * { box-sizing: border-box; }
  .emd .tnum { font-variant-numeric: tabular-nums; }
  .emd .nowrap { white-space: nowrap; }
  .emd-wrap { max-width: 1280px; margin: 0 auto; padding: 24px 20px 64px; }

  /* head */
  .emd .head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 22px; }
  .emd .head h1 { font-family: 'Cormorant Garamond', 'Georgia', serif; font-weight: 600; font-size: 2.3rem; line-height: 1.05; margin: 0; color: var(--text); }
  .emd .head p { margin: 6px 0 0; color: var(--muted); font-size: 0.92rem; }
  .emd .seg { display: inline-flex; background: var(--surface); border: 1px solid var(--border2); border-radius: 10px; overflow: hidden; }
  .emd .seg button { border: 0; background: none; font: inherit; font-size: 0.82rem; padding: 7px 14px; color: var(--muted); cursor: pointer; }
  .emd .seg button.on { background: var(--plum); color: #fff; font-weight: 600; }

  /* grids — unified 3-column dashboard grid */
  .emd .emd-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; align-items: start; }
  .emd .span-full { grid-column: 1 / -1; }
  @media (max-width: 980px) { .emd .emd-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .emd .emd-grid { grid-template-columns: 1fr; } }
  .emd .kpis { display: grid; grid-template-columns: repeat(6, 1fr); gap: 14px; }
  @media (max-width: 1080px) { .emd .kpis { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 560px) { .emd .kpis { grid-template-columns: repeat(2, 1fr); } }

  .emd .card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); padding: 18px 18px 16px; min-width: 0; }
  .emd .card h2 { font-family: 'Inter', sans-serif; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--faint); margin: 0 0 14px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .emd .h2sub { font-weight: 500; text-transform: none; letter-spacing: 0; }
  .emd .tag { font-size: 0.62rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; padding: 2px 7px; border-radius: 20px; background: var(--amberbg); color: var(--amber); }

  /* kpi card */
  .emd .kpi { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); padding: 14px 15px; min-width: 0; }
  .emd .kpi--drill { cursor: pointer; transition: border-color 0.15s, box-shadow 0.15s; }
  .emd .kpi--drill:hover { border-color: var(--plum); box-shadow: 0 2px 4px rgba(44,37,48,.06), 0 6px 18px rgba(44,37,48,.08); }
  .emd .kpi--drill:focus-visible { outline: none; border-color: var(--plum); box-shadow: 0 0 0 3px rgba(114,94,126,.18); }
  .emd .kpi__l { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--faint); margin-bottom: 7px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .emd .kpi__v { font-size: 1.7rem; font-weight: 600; line-height: 1; color: var(--text); }
  .emd .kpi__v small { font-size: 0.95rem; font-weight: 600; color: var(--muted); }
  .emd .kpi__d { margin-top: 8px; font-size: 0.72rem; font-weight: 600; display: flex; align-items: center; gap: 5px; }
  .emd .up { color: var(--green); } .emd .down { color: var(--red); } .emd .flat { color: var(--muted); } .emd .muteline { color: var(--faint); }
  .emd .spark { margin-top: 8px; height: 30px; width: 100%; display: block; }
  .emd .vol-svg { width: 100%; height: clamp(200px, 22vw, 280px); display: block; }

  /* gauges */
  .emd .gauges { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .emd .gauge { text-align: center; }
  .emd .gauge-btn { width: 100%; background: none; border: 0; padding: 6px 4px 4px; cursor: pointer; border-radius: var(--radius); transition: background 0.15s; display: block; }
  .emd .gauge-btn:hover { background: rgba(114,94,126,.05); }
  .emd .gauge-btn:focus-visible { outline: none; box-shadow: 0 0 0 3px rgba(114,94,126,.18); }
  .emd .gauge-btn svg { width: 100%; max-width: 150px; height: auto; }
