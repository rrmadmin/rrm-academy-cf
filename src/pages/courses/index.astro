---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MaybeShell from '../../components/MaybeShell.astro';
import { isShellEnabled } from '../../lib/shell-routes';
import { buildBreadcrumbList } from '../../lib/identity';
import CourseCard from '../../components/CourseCard.astro';
import coursesData from '../../data/courses.json';
import SuperHeroLogos from '../../components/SuperHeroLogos.astro';

const SHELL_ENABLED = isShellEnabled('courses');

// Members-only courses are LIVE (not coming-soon) — they pass the catalog filter.
// Coming-soon non-members courses stay hidden until promoted.
const isVisible = (c: any) => !(c.comingSoon && c.accessType !== 'members');
const visibleCourses = coursesData.filter(isVisible);

// Topic pills are derived from whatever topics actually appear on visible
// courses (server-rendered order, not the client's DOM order) -- no
// hardcoded taxonomy to keep in sync as courses are added/retagged.
const topicSet = new Map<string, string>();
for (const course of visibleCourses) {
  for (const topic of (course as any).topics ?? []) {
    if (typeof topic !== 'string') continue;
    const trimmed = topic.trim();
    if (!trimmed || trimmed.toLowerCase() === 'all') continue;
    const key = trimmed.toLowerCase();
    if (!topicSet.has(key)) topicSet.set(key, trimmed);
  }
}
const allTopics = [...topicSet.values()].sort((a, b) => String(a).localeCompare(String(b)));

const itemListNode = {
  '@type': 'ItemList',
  name: 'RRM Academy Courses',
  description: 'Evidence-based courses on endometriosis, fertility, and reproductive medicine from Dr. Naomi Whittaker.',
  url: 'https://rrmacademy.org/courses/',
  numberOfItems: visibleCourses.length,
  itemListElement: visibleCourses.map((course: any, i: number) => {
    const isMembers = course.accessType === 'members';
    return {
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Course',
        name: course.title,
        description: course.shortDescription,
        url: `https://rrmacademy.org/courses/${course.slug}/`,
        ...(course.image ? { image: course.image } : {}),
        provider: course.isAffiliate
          ? { '@type': 'Organization', name: 'NeoFertility', url: 'https://www.neofertilitytraining.com/' }
          : { '@type': 'Organization', '@id': 'https://rrmacademy.org/#organization', name: 'RRM Academy', url: 'https://rrmacademy.org/' },
        isAccessibleForFree: !isMembers && course.isFree,
        offers: isMembers
          ? {
              '@type': 'Offer',
              price: '9.00',
              priceCurrency: 'USD',
              availability: 'https://schema.org/InStock',
              category: 'Save the Uterus Club Membership',
              url: 'https://rrmacademy.org/save-the-uterus-club/',
            }
          : {
              '@type': 'Offer',
              price: course.isFree ? '0' : (course.priceCents / 100).toFixed(2),
              priceCurrency: 'USD',
              availability: 'https://schema.org/InStock',
              ...(course.isAffiliate && course.affiliateUrl ? { url: course.affiliateUrl } : {}),
            },
      },
    };
  }),
};

const breadcrumbRaw = buildBreadcrumbList([
  { name: 'Home', url: 'https://rrmacademy.org/' },
  { name: 'Courses', url: 'https://rrmacademy.org/courses/' },
]) as Record<string, unknown>;
const { '@context': _bcCtx, ...breadcrumbNode } = breadcrumbRaw;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [itemListNode, breadcrumbNode],
};
---
<BaseLayout
  title="Online RRM Courses | Endometriosis & Fertility"
  description="Self-paced video courses on endometriosis, fertility, and reproductive health from leading specialists in restorative reproductive medicine. Start free today."
  canonicalUrl="https://rrmacademy.org/courses"
  jsonLd={jsonLd}
  chrome={SHELL_ENABLED ? 'shell' : 'default'}
>
  <MaybeShell enabled={SHELL_ENABLED} context="page" currentPath={Astro.url.pathname}>
  {/* data-shell-wide opts out of the narrow-content rule that constrains
      pillar pages to var(--max-width-article). Courses needs the broader
      catalog grid + hero width Brian had pre-shell. */}
  <div class="page-wrapper" data-shell-wide>
    <div class="container">

      <section class="courses-hero">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true"> &rsaquo; </span>
          <span>Courses</span>
        </nav>
        <h1>Online RRM Courses</h1>
        <p class="courses-hero__sub">Self-paced online training in Restorative Reproductive Medicine for clinicians and patients. Courses cover endometriosis surgery, NaProTechnology fundamentals, cycle-based diagnostics, and fertility care, taught by board-certified OBGYNs and RRM-trained specialists.</p>
      </section>

      <h2 class="sr-only">Available Courses</h2>

      <div class="courses-toolbar courses-toolbar--dropdowns">
        <div class="courses-toolbar__row">
          <div class="cdd" id="courses-topic-dd" data-value="all">
            <button type="button" class="cdd-trigger" aria-haspopup="listbox" aria-expanded="false">
              <span class="cdd-trigger__label">All Topics</span>
              <svg class="cdd-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="cdd-panel" role="listbox" aria-label="Filter by topic" hidden>
              <button type="button" class="cdd-item" role="option" aria-selected="true" data-value="all">
                <svg class="cdd-check" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>All Topics</span>
              </button>
              {allTopics.map((topic) => (
                <button type="button" class="cdd-item" role="option" aria-selected="false" data-value={topic}>
                  <svg class="cdd-check" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  <span>{topic}</span>
                </button>
              ))}
            </div>
          </div>

          <div class="cdd" id="courses-cost-dd" data-value="all">
            <button type="button" class="cdd-trigger" aria-haspopup="listbox" aria-expanded="false">
              <span class="cdd-trigger__label">Any Cost</span>
              <svg class="cdd-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="cdd-panel" role="listbox" aria-label="Filter by cost" hidden>
              <button type="button" class="cdd-item" role="option" aria-selected="true" data-value="all">
                <svg class="cdd-check" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>Any Cost</span>
              </button>
              <button type="button" class="cdd-item" role="option" aria-selected="false" data-value="free">
                <svg class="cdd-check" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>Free</span>
              </button>
              <button type="button" class="cdd-item" role="option" aria-selected="false" data-value="paid">
                <svg class="cdd-check" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>Paid</span>
              </button>
            </div>
          </div>

          <div class="cdd" id="courses-sort-dd" data-value="newest">
            <button type="button" class="cdd-trigger" aria-haspopup="listbox" aria-expanded="false">
              <span class="cdd-trigger__label">Sort: Newest</span>
              <svg class="cdd-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="cdd-panel" role="listbox" aria-label="Sort courses" hidden>
              <button type="button" class="cdd-item" role="option" aria-selected="true" data-value="newest">
                <svg class="cdd-check" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>Sort: Newest</span>
              </button>
              <button type="button" class="cdd-item" role="option" aria-selected="false" data-value="az">
                <svg class="cdd-check" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>Sort: A&ndash;Z</span>
              </button>
              <button type="button" class="cdd-item" role="option" aria-selected="false" data-value="price">
                <svg class="cdd-check" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>Sort: Price, Low to High</span>
              </button>
            </div>
          </div>
        </div>
        <p class="courses-toolbar__count" id="courses-count" aria-live="polite">{visibleCourses.length} course{visibleCourses.length === 1 ? '' : 's'}</p>
      </div>

      <div class="courses-grid" id="courses-grid">
        {visibleCourses.map((course, i) => (
          <div
            class="course-card-wrap"
            data-cost={course.isFree ? 'free' : 'paid'}
            data-topics={JSON.stringify(((course as any).topics ?? []).filter((t: unknown) => typeof t === 'string'))}
            data-title={course.title}
            data-price={course.isFree ? 0 : (course.priceCents ?? 0)}
          >
            <CourseCard course={course} eager={i < 2} />
          </div>
        ))}
      </div>
      <p class="courses-empty" id="courses-empty" hidden>No courses match your filters. <button type="button" id="courses-clear-filters" class="courses-empty__clear">Clear filters</button></p>

      <script>
        const grid = document.getElementById('courses-grid');
        const cards = grid ? Array.from(grid.querySelectorAll<HTMLElement>('.course-card-wrap')) : [];
        const countEl = document.getElementById('courses-count');
        const emptyEl = document.getElementById('courses-empty');
        const clearBtn = document.getElementById('courses-clear-filters');

        // Custom dropdown ("cdd") -- real <button> trigger + role="listbox"
        // panel, matching shadcn's dropdown-menu visual language (rounded
        // popover card, fade+zoom-in, rounded-sm row highlight, left
        // checkmark on the active item) but framework-free.
        class Dropdown {
          root: HTMLElement;
          trigger: HTMLButtonElement;
          panel: HTMLElement;
          items: HTMLButtonElement[];
          onChange: (value: string) => void;

          constructor(rootId: string, onChange: (value: string) => void) {
            this.root = document.getElementById(rootId)!;
            this.trigger = this.root.querySelector('.cdd-trigger')!;
            this.panel = this.root.querySelector('.cdd-panel')!;
            this.items = Array.from(this.root.querySelectorAll('.cdd-item'));
            this.onChange = onChange;

            this.trigger.addEventListener('click', () => this.toggle());
            this.trigger.addEventListener('keydown', (e) => {
              if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                this.open();
                this.items.find((i) => i.getAttribute('aria-selected') === 'true')?.focus();
              }
            });
            this.panel.addEventListener('keydown', (e) => this.onPanelKeydown(e));
            for (const item of this.items) {
              item.addEventListener('click', () => this.select(item));
            }
          }

          get isOpen() {
            return !this.panel.hidden;
          }

          open() {
            if (this.isOpen) return;
            closeAllExcept(this);
            this.panel.hidden = false;
            this.trigger.setAttribute('aria-expanded', 'true');
            requestAnimationFrame(() => this.panel.setAttribute('data-open', ''));
          }

          close() {
            if (!this.isOpen) return;
            this.panel.removeAttribute('data-open');
            this.trigger.setAttribute('aria-expanded', 'false');
            this.panel.hidden = true;
          }

          toggle() {
            this.isOpen ? this.close() : this.open();
          }

          select(item: HTMLButtonElement) {
            const value = item.dataset.value || 'all';
            for (const i of this.items) i.setAttribute('aria-selected', String(i === item));
            const label = this.trigger.querySelector('.cdd-trigger__label');
            if (label) label.textContent = item.querySelector('span')?.textContent || '';
            this.root.dataset.value = value;
            this.close();
            this.trigger.focus();
            this.onChange(value);
          }

          onPanelKeydown(e: KeyboardEvent) {
            const focusIdx = this.items.indexOf(document.activeElement as HTMLButtonElement);
            if (e.key === 'ArrowDown') {
              e.preventDefault();
              this.items[Math.min(focusIdx + 1, this.items.length - 1)]?.focus();
            } else if (e.key === 'ArrowUp') {
              e.preventDefault();
              this.items[Math.max(focusIdx - 1, 0)]?.focus();
            } else if (e.key === 'Escape') {
              e.preventDefault();
              this.close();
              this.trigger.focus();
            } else if (e.key === 'Tab') {
              this.close();
            }
          }
        }

        const dropdowns: Dropdown[] = [];
        function closeAllExcept(active: Dropdown) {
          for (const dd of dropdowns) if (dd !== active) dd.close();
        }
        document.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          for (const dd of dropdowns) {
            if (!dd.root.contains(target)) dd.close();
          }
        });

        function applyFilters() {
          const costFilter = document.getElementById('courses-cost-dd')?.dataset.value || 'all';
          const topicFilter = document.getElementById('courses-topic-dd')?.dataset.value || 'all';
          let visibleCount = 0;
          for (const card of cards) {
            const cost = card.dataset.cost;
            let topics: string[];
            try {
              topics = JSON.parse(card.dataset.topics || '[]');
            } catch {
              topics = [];
            }
            if (!Array.isArray(topics)) topics = [];
            const costMatch = costFilter === 'all' || cost === costFilter;
            const topicMatch = topicFilter === 'all' || topics.some((t) => typeof t === 'string' && t.trim().toLowerCase() === topicFilter.toLowerCase());
            const visible = costMatch && topicMatch;
            card.hidden = !visible;
            if (visible) visibleCount++;
          }
          if (countEl) countEl.textContent = `${visibleCount} course${visibleCount === 1 ? '' : 's'}`;
          if (emptyEl) emptyEl.hidden = visibleCount > 0;
          if (grid) grid.hidden = visibleCount === 0;
        }

        function applySort() {
          if (!grid) return;
          const mode = document.getElementById('courses-sort-dd')?.dataset.value || 'newest';
          if (mode === 'newest') {
            for (const card of cards) grid.appendChild(card);
            return;
          }
          const sorted = [...cards].sort((a, b) => {
            if (mode === 'az') return (a.dataset.title || '').localeCompare(b.dataset.title || '');
            if (mode === 'price') return Number(a.dataset.price || 0) - Number(b.dataset.price || 0);
            return 0;
          });
          for (const card of sorted) grid.appendChild(card);
        }

        dropdowns.push(new Dropdown('courses-topic-dd', applyFilters));
        dropdowns.push(new Dropdown('courses-cost-dd', applyFilters));
        dropdowns.push(new Dropdown('courses-sort-dd', applySort));

        clearBtn?.addEventListener('click', () => {
          const topicDd = document.getElementById('courses-topic-dd');
          const costDd = document.getElementById('courses-cost-dd');
          if (topicDd) {
            topicDd.dataset.value = 'all';
            topicDd.querySelector('.cdd-trigger__label')!.textContent = 'All Topics';
            topicDd.querySelectorAll('.cdd-item').forEach((i) => i.setAttribute('aria-selected', String(i.getAttribute('data-value') === 'all')));
          }
          if (costDd) {
            costDd.dataset.value = 'all';
            costDd.querySelector('.cdd-trigger__label')!.textContent = 'Any Cost';
            costDd.querySelectorAll('.cdd-item').forEach((i) => i.setAttribute('aria-selected', String(i.getAttribute('data-value') === 'all')));
          }
          applyFilters();
        });
      </script>

      <section class="courses-faq">
        <h2>Course FAQ</h2>
        <div class="faq-list">

          <details class="faq-item">
            <summary class="faq-q">What is the format of the courses?</summary>
            <p class="faq-a">Our RRM Academy courses are self-paced and fully online. Each course includes video lectures by expert clinicians, downloadable resources, and quizzes to reinforce your learning. You can start, pause, and return at any time -- there are no deadlines or scheduled sessions. Partner courses may follow a different format (such as live cohorts).</p>
          </details>

          <details class="faq-item">
            <summary class="faq-q">Who are these courses for?</summary>
            <p class="faq-a">Our courses are designed for two audiences: patients navigating reproductive health conditions (endometriosis, infertility, PCOS, hormonal disorders) who want to understand their options beyond standard care; and healthcare professionals seeking education in Restorative Reproductive Medicine and NaProTechnology.</p>
          </details>

          <details class="faq-item">
            <summary class="faq-q">How long will I have access after I enroll?</summary>
            <p class="faq-a">For RRM Academy courses, access is lifetime. Once enrolled, your course remains available in your account with no expiration date -- including any updates or new content added over time. Partner courses have their own access policies set by the partner organization.</p>
          </details>

          <details class="faq-item">
            <summary class="faq-q">What is the difference between the Masterclass in Endometriosis & Surgery and the Long-Term Endometriosis Management course?</summary>
            <p class="faq-a">The Masterclass covers the full journey: understanding endometriosis, evaluating surgical options, choosing a surgeon, and navigating the surgical process. The Long-Term Endometriosis Management course focuses on ongoing and post-surgical care: diet, supplements, lifestyle, and medications. The Long-Term course is included free when you enroll in the Masterclass.</p>
          </details>

          <details class="faq-item">
            <summary class="faq-q">Do the courses offer a certificate of completion?</summary>
            <p class="faq-a">Yes. The Masterclass in Endometriosis & Surgery includes a certificate of completion, issued automatically after you finish all lessons and pass the final assessment with a score of 80% or higher.</p>
          </details>

          <details class="faq-item">
            <summary class="faq-q">Do these courses replace medical advice from my doctor?</summary>
            <p class="faq-a">No. Our courses are educational resources designed to help you understand conditions and treatment options. They do not constitute medical advice and are not a substitute for care from a qualified healthcare provider. Always consult your physician before making medical decisions.</p>
          </details>

          <details class="faq-item">
            <summary class="faq-q">Why do you charge for some courses?</summary>
            <p class="faq-a">Creating high-quality clinical content requires significant time and expertise from our instructors. Paid courses help sustain RRM Academy as a nonprofit. They allow us to keep our free courses free, maintain the Research Library, and continue producing education without ads or outside funding. We charge the minimum needed to support the mission.</p>
          </details>

          <details class="faq-item">
            <summary class="faq-q">Is financial assistance available for paid courses?</summary>
            <p class="faq-a">Yes. If cost is a barrier, please <a href="/contact/">contact us</a>. We offer need-based access on a case-by-case basis and never want cost to prevent someone from getting the education they need.</p>
          </details>

          <details class="faq-item">
            <summary class="faq-q">What is your refund policy?</summary>
            <p class="faq-a">We offer a full refund within 7 days of purchase if you have completed less than 20% of the course. Please <a href="/contact/">contact us</a> with your order details.</p>
          </details>

          <details class="faq-item">
            <summary class="faq-q">What are partner courses?</summary>
            <p class="faq-a">Some courses listed on RRM Academy are offered by trusted training partners in Restorative Reproductive Medicine. These courses are hosted and managed by the partner organization. Enrollment, payment, and course delivery happen on the partner's platform. Partner courses are clearly labeled with a "Partner Course" badge.</p>
          </details>

        </div>
      </section>

      <SuperHeroLogos />

      <p class="page-updated">Last updated: February 2026</p>
    </div>
  </div>
  </MaybeShell>
</BaseLayout>

<style>
  .page-wrapper {
    padding: var(--space-8) 0 var(--space-16);
    min-height: 60vh;
  }

  .courses-hero {
    max-width: 900px;
    margin: 0 auto var(--space-10);
  }
  .courses-hero h1 {
    font-size: clamp(2rem, 1.25rem + 2.5vw, 3.25rem);
    margin-bottom: var(--space-3);
  }
  .courses-hero__sub {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    max-width: 680px;
  }
  .courses-hero__audiences {
    font-size: 0.875rem;
    color: var(--text-secondary);
    max-width: 680px;
    margin-top: var(--space-3);
    line-height: 1.65;
  }
  .courses-hero__audiences strong {
    color: var(--text-primary);
  }

  .courses-toolbar {
    max-width: 900px;
    margin: 0 auto var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .courses-toolbar__row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  /* Custom dropdown ("cdd") -- shadcn dropdown-menu visual language
     (rounded popover, subtle border+shadow, fade+zoom-in, rounded-sm row
     highlight, left checkmark) rebuilt in vanilla CSS on our own tokens. */
  .cdd {
    position: relative;
    flex: 1;
    min-width: 160px;
  }
  .cdd-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    width: 100%;
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    color: var(--text-primary);
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-3);
    cursor: pointer;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .cdd-trigger:hover {
    border-color: var(--accent);
  }
  .cdd-trigger:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .cdd[data-value]:not([data-value="all"]):not([data-value="newest"]) .cdd-trigger {
    border-color: var(--accent);
    color: var(--accent);
  }
  .cdd-trigger__label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cdd-chevron {
    flex-shrink: 0;
    color: var(--text-secondary);
    transition: transform 0.15s;
  }
  .cdd-trigger[aria-expanded="true"] .cdd-chevron {
    transform: rotate(180deg);
  }
  .cdd-panel {
    position: absolute;
    top: calc(100% + var(--space-1));
    left: 0;
    z-index: 20;
    min-width: 100%;
    width: max-content;
    max-width: 280px;
    max-height: 320px;
    overflow-y: auto;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    padding: var(--space-1);
    transform: scale(0.96);
    opacity: 0;
    transition: transform 0.12s ease-out, opacity 0.12s ease-out;
  }
  .cdd-panel[data-open] {
    transform: scale(1);
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .cdd-panel, .cdd-chevron {
      transition: none;
    }
  }
  .cdd-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    font-family: 'Inter', sans-serif;
