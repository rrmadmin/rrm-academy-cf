---
// /marquette-model/ FABM method guide (category: methods). Data-driven via GuideLayout.
import GuideLayout from '../../layouts/GuideLayout.astro';
import data from '../../data/marquette-model.json';
const SLUG = 'marquette-model';
const PAGE_URL = `https://rrmacademy.org/${SLUG}/`;
const { published: PUBLISHED, modified: MODIFIED } = data;
const TOC_ITEMS = data.tocItems;
const KEY_TAKEAWAYS_HTML = `<ul>\n${data.keyTakeaways.map((k) => `  <li>${k}</li>`).join('\n')}\n</ul>`;
const FAQS = data.faqs;
const FB = data.factsBox;
const ARTICLE_SECTIONS = ['Key Takeaways','What is the Marquette Method?','How does the Marquette Method work?','How is the Marquette Method taught?','How effective is the Marquette Method?','What is the Marquette Method used for?','How the Marquette Method supports restorative reproductive medicine','How to learn the Marquette Method','Frequently Asked Questions','Continue exploring','References'];
const citationUrls = [...new Set(JSON.stringify(data).match(/https:\/\/pubmed\.ncbi\.nlm\.nih\.gov\/\d+/g) || [])];
const ABOUT_TYPE_MAP = { MedicalCondition: 'MedicalCondition', MedicalProcedure: 'MedicalProcedure', MedicalTherapy: 'MedicalTherapy' };
const jsonLd = {
  '@context': 'https://schema.org', '@type': ['MedicalWebPage', 'Article'],
  headline: "The Marquette Method",
  description: "The Marquette Method uses urinary estrogen and LH monitoring to identify the fertile window. Learn how it works, what the evidence shows, and how it fits RRM.",
  url: PAGE_URL, inLanguage: 'en',
  author: { '@id': 'https://rrmacademy.org/#naomi-whittaker' },
  publisher: { '@id': 'https://rrmacademy.org/#organization' },
  datePublished: PUBLISHED, dateModified: MODIFIED,
  image: {
    '@type': 'ImageObject',
    url: `https://rrmacademy.org/images/${SLUG}/${SLUG}-at-a-glance.webp`,
    contentUrl: `https://rrmacademy.org/images/${SLUG}/${SLUG}-at-a-glance.webp`,
    representativeOfPage: true,
    creditText: 'RRM Academy',
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': PAGE_URL },
  about: data.about.map((a) => ({ '@type': ABOUT_TYPE_MAP[a.type] || 'Thing', name: a.name })),
  articleSection: ARTICLE_SECTIONS,
  citation: citationUrls.map((u) => ({ '@type': 'MedicalScholarlyArticle', '@id': u })),
};
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: FAQS.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answerHtml.replace(/<[^>]+>/g, '') } })) };
---

<GuideLayout slug={SLUG} jsonLd={jsonLd} extraSchema={[faqSchema]} tocItems={TOC_ITEMS} faqs={FAQS} keyTakeawaysHtml={KEY_TAKEAWAYS_HTML} editingNoticeHtml="<strong>A quick note:</strong> this guide is newly published and still being reviewed by our clinical team, so some details may change as we finalize it. We wanted to share it now rather than make you wait.">
  <figure class="hero-figure">
    <img
      src="/images/marquette-model/marquette-model-at-a-glance.webp"
      width="1040"
      height="996"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      alt="The Marquette Model at a glance: it tracks urinary estrogen and LH with an electronic hormone monitor, is taught by Marquette-trained professionals, has a perfect-use rate of 2.1 per 100 women over 12 months, and supports RRM cycle assessment."
    />
    <figcaption>The Marquette Model at a glance. Perfect-use and typical-use rates measure different things and are not directly comparable. Full numbers and citations are in the guide below.</figcaption>
  </figure>
  <aside class="facts-box">
    <dl>
      <div><dt>Biomarker</dt><dd>{FB.biomarker}</dd></div>
      <div><dt>Taught by</dt><dd>{FB.taughtBy}</dd></div>
      <div><dt>Tools needed</dt><dd>{FB.toolsNeeded}</dd></div>
      <div><dt>Perfect use</dt><dd set:html={FB.perfectUse} /></div>
      <div><dt>Typical use</dt><dd set:html={FB.typicalUse} /></div>
    </dl>
  </aside>
  <section id="what-it-is"><h2>What is the Marquette Method?</h2><Fragment set:html={data.prose.whatItIs} /></section>
  <section id="how-it-works"><h2>How does the Marquette Method work?</h2><Fragment set:html={data.prose.howItWorks} /></section>
  <section id="taught"><h2>How is the Marquette Method taught?</h2><Fragment set:html={data.prose.taughtBy} /></section>
  <section id="effectiveness"><h2>How effective is the Marquette Method?</h2><Fragment set:html={data.prose.effectiveness} /></section>
  <section id="used-for"><h2>What is the Marquette Method used for?</h2><Fragment set:html={data.prose.usedFor} /></section>
  <section id="rrm-value"><h2>How the Marquette Method supports restorative reproductive medicine</h2><Fragment set:html={data.prose.rrmValue} /></section>
  <section id="how-to-learn"><h2>How to learn the Marquette Method</h2><Fragment set:html={data.prose.howToLearn} /></section>
  <section id="continue-exploring"><h2>Continue exploring</h2><ul>
    <li><a href="/fertility-awareness-methods-compared/">Fertility awareness methods compared</a></li>
    <li><a href="/naprotechnology/">NaProTechnology</a></li>
    <li><a href="/what-is-rrm/">What is Restorative Reproductive Medicine?</a></li>
    <li><a href="/providers/">Find an RRM provider</a></li>
  </ul></section>
  <section id="references"><h2>References</h2><ol class="references-list">{data.references.map((r) => (<li id={`ref-${r.n}`} set:html={r.html} />))}</ol></section>
</GuideLayout>

<style>
  .hero-figure { margin: 0 0 var(--space-5); }
  .hero-figure img { display: block; width: 100%; height: auto; max-width: 720px; border-radius: var(--radius-md); border: 1px solid var(--border-color); }
  .hero-figure figcaption { margin-top: var(--space-2); font-size: 0.8125rem; color: var(--text-secondary); line-height: 1.5; }
  .facts-box { background: var(--bg-surface); border-left: 3px solid var(--purple-700); border-radius: var(--radius-md); padding: var(--space-4); margin: var(--space-5) 0; }
  .facts-box dl { margin: 0; display: grid; gap: var(--space-3); }
  .facts-box dt { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted); }
  .facts-box dd { margin: var(--space-1) 0 0 0; font-size: 0.9375rem; color: var(--text-primary); line-height: 1.5; }
  .references-list { font-size: 0.875rem; color: var(--text-secondary); line-height: 1.6; padding-left: var(--space-4); }
  .references-list li { margin-bottom: var(--space-2); }
  .references-list a { color: var(--accent); }
</style>
