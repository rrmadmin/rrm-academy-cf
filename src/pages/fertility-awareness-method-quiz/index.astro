    // Tie-break: when total scores tie, resolve toward the method that matches the user's
    // stated cost/device preference, then toward the simpler/cheaper method. A fixed method
    // list was replaced here because it silently decided ~25% of outcomes by list position.
    const COST_BURDEN = { sdm: 0, twoday: 0, billings: 0, femm: 0, creighton: 1, sensiplan: 1, marquette: 2 };
    const DEVICE_BURDEN = { sdm: 0, twoday: 0, billings: 0, femm: 0, creighton: 0, sensiplan: 1, marquette: 2 };
    const ACCESS_ORDER = ['twoday', 'sdm', 'billings', 'creighton', 'femm', 'sensiplan', 'marquette'];
    function tiebreakKey(m) {
      let k = ACCESS_ORDER.indexOf(m);
      if (answers.budget === 'lowest') k += COST_BURDEN[m] * 100;
      if (answers.device === 'none') k += DEVICE_BURDEN[m] * 20;
      return k;
    }
    function score() {
      const t = { sdm: 0, twoday: 0, billings: 0, creighton: 0, femm: 0, sensiplan: 0, marquette: 0 };
      Object.keys(answers).forEach(function (qid) {
        const d = (RULES[qid] || {})[answers[qid]] || {};
        Object.keys(d).forEach(function (m) { t[m] += d[m]; });
      });
      const ranked = Object.keys(t).sort(function (a, b) { return t[b] !== t[a] ? t[b] - t[a] : tiebreakKey(a) - tiebreakKey(b); });
      return { primary: ranked[0], alternate: ranked[1] };
    }
    function buildWhy() {
      const bits = [];
      if (answers.goal === 'conceive') bits.push('you are trying to conceive');
      if (answers.goal === 'health') bits.push('you want to understand your reproductive health');
      if (answers.cycles === 'irregular') bits.push('your cycles are not always predictable');
      if (answers.cycles === 'vary') bits.push('you are still getting to know your cycles');
      if (answers.postpartum === 'yes') bits.push('you are postpartum or breastfeeding');
      if (answers.offbc === 'yes') bits.push('you recently stopped hormonal birth control');
      if (answers.effort === 'simplest') bits.push('you want to keep tracking simple');
      if (answers.effort === 'detailed') bits.push('you are happy to chart in detail');
      if (answers.device === 'none') bits.push('you prefer no devices');
      if (answers.device === 'monitor') bits.push('you are comfortable with a monitor');
      if (answers.clinical === 'yes') bits.push('you want a doctor to be able to read your chart');
      return bits;
    }
    function renderResult() {
      recommendation = score();
      const p = METHODS[recommendation.primary];
      const a = METHODS[recommendation.alternate];
      document.getElementById('result-icon').innerHTML = ico(p.icon);
      document.getElementById('result-primary').textContent = p.name;
      const why = buildWhy();
      let whyText = 'Based on your answers';
      if (why.length) whyText += ' (' + why.slice(0, 3).join(', ') + ')';
      whyText += ', the ' + p.name + ' looks like the strongest fit, ' + p.blurb + '.';
      document.getElementById('result-why').textContent = whyText;
      document.getElementById('result-alt').innerHTML = '<strong>Also worth a look:</strong> the ' + a.name + ', ' + a.blurb + '.';
      const readLink = document.getElementById('next-read');
      readLink.href = p.learn;
      document.getElementById('next-read-title').textContent = 'Keep reading: how the ' + p.name.replace(' FertilityCare System', '').replace('Sympto-Thermal Method ', '') + ' works';
      document.getElementById('next-read-ico').innerHTML = ico('health-literacy') || ico(p.icon);
      document.getElementById('next-book-ico').innerHTML = ico('stethoscope');
      const g = GUIDES[recommendation.primary];
      if (g) {
        document.getElementById('result-guide').innerHTML =
          '<h3 class="result-guide__title">Your starter guide: ' + g.name + '</h3>' +
          '<dl class="result-guide__dl">' +
          '<dt>How it works</dt><dd>' + g.howItWorks + '</dd>' +
          '<dt>How to start</dt><dd>' + g.howToStart + '</dd>' +
          '<dt>What you need</dt><dd>' + g.tools + '</dd>' +
          '<dt>A good fit if</dt><dd>' + g.goodFitIf + '</dd>' +
          '<dt>Effectiveness</dt><dd>' + g.effectiveness + '</dd>' +
          '<dt>Where to learn</dt><dd><a href="' + g.learnUrl + '" target="_blank" rel="noopener">' + g.learnLabel + '</a></dd>' +
          '</dl>';
      }
      document.getElementById('quiz').hidden = true;
      const r = document.getElementById('result');
      r.hidden = false;
      barEl.style.width = '100%';
      r.scrollIntoView({ behavior: 'smooth', block: 'start' });
      sendResult();
    }
    function sendResult() {
      const payload = { email: userEmail, primary: recommendation.primary, alternate: recommendation.alternate, answers: answers, researchConsent: researchConsent };
      if (typeof turnstile !== 'undefined' && turnstileWidgetId !== null) {
        pendingSubmit = payload;
        clearTimeout(tsWatchdog);
        tsWatchdog = setTimeout(function () { if (pendingSubmit) { const p = pendingSubmit; pendingSubmit = null; doSubmit(p, ''); } }, 8000);
        try { turnstile.reset(turnstileWidgetId); turnstile.execute(turnstileWidgetId); return; } catch (e) {}
      }
      doSubmit(payload, '');
    }
    function doSubmit(payload, token) {
      payload.turnstileToken = token;
      const sent = document.getElementById('result-sent');
      fetch('/api/quiz/request', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      }).then(function (res) { return res.json().then(function (d) { return { ok: res.ok, data: d }; }, function () { return { ok: res.ok, data: {} }; }); })
        .then(function (r) {
          if (r.ok && r.data && r.data.ok) {
            sent.textContent = 'We have also sent this to ' + userEmail + ' with a starter guide.';
          } else if (r.data && r.data.suggestion) {
            sent.textContent = 'Your result is ready above. Did you mean ' + r.data.suggestion + '? Refresh and retake with the corrected email to get your guide.';
          } else {
            sent.textContent = 'Your result is ready above. We could not email a copy just now. Please refresh and retake to receive your starter guide by email.';
          }
        })
        .catch(function () { sent.textContent = 'Your result is ready above. We could not email a copy (network error). Please try again later.'; });
    }

    nextBtn.addEventListener('click', function () {
      if (!answers[QUESTIONS[step].id]) return;
      if (step === QUESTIONS.length - 1) { renderResult(); return; }
      step++; renderStep();
    });
    backBtn.addEventListener('click', function () { if (step > 0) { step--; renderStep(); } });
    document.getElementById('print-result').addEventListener('click', function () { window.print(); });
    document.getElementById('quiz-restart').addEventListener('click', function () {
      Object.keys(answers).forEach(function (k) { delete answers[k]; });
      step = 0;
      document.getElementById('result').hidden = true;
      document.getElementById('quiz').hidden = false;
      renderStep();
      document.getElementById('quiz').scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    let turnstileWidgetId = null, turnstileLoaded = false, pendingSubmit = null, tsWatchdog = null;
    function loadTurnstile() {
      if (turnstileLoaded) return; turnstileLoaded = true;
      const sc = document.createElement('script');
      sc.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      sc.async = true; sc.defer = true; document.head.appendChild(sc);
    }
    function initTurnstile() {
      loadTurnstile();
      const c = document.getElementById('turnstile-container');
      if (!c) return;
      const t = setInterval(function () {
        if (typeof turnstile !== 'undefined') {
          clearInterval(t);
          if (turnstileWidgetId === null) {
            try {
              turnstileWidgetId = turnstile.render(c, {
                sitekey: c.dataset.sitekey,
                size: 'invisible',
                callback: function (tok) { clearTimeout(tsWatchdog); if (pendingSubmit) { const p = pendingSubmit; pendingSubmit = null; doSubmit(p, tok); } },
                'error-callback': function () { clearTimeout(tsWatchdog); pendingSubmit = null; const s = document.getElementById('result-sent'); if (s) { s.textContent = 'Your result is ready above. We could not verify your browser to email a copy. Please refresh and retake to receive it.'; } },
              });
            } catch (e) {}
          }
        }
      }, 250);
      setTimeout(function () { clearInterval(t); }, 10000);
    }
    document.getElementById('start-form').addEventListener('submit', function (e) {
      e.preventDefault();
      const msg = document.getElementById('start-msg');
      const email = document.getElementById('start-email').value.trim();
      if (!email || email.indexOf('@') < 1 || email.indexOf('.') < 0) { msg.textContent = 'Please enter a valid email address.'; return; }
      const consent = document.getElementById('research-consent');
      if (!consent || !consent.checked) { msg.textContent = 'Please check the research consent box to begin.'; return; }
      researchConsent = 1;
      userEmail = email;
      document.getElementById('start').hidden = true;
      document.getElementById('quiz').hidden = false;
      renderStep();
      document.getElementById('quiz').scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    initTurnstile();
  </script>

