---
import BaseLayout from '../../layouts/BaseLayout.astro';
import articlesData from '../../data/articles.json';
import superheroes from '../../data/superheroes.json';

// Live count, mirroring the donate/homepage pattern so this stat never drifts.
const libraryCountRounded = (Math.floor(articlesData.length / 1000) * 1000).toLocaleString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Save the Uterus Club',
  description: 'Join the Save the Uterus Club and help build a future where uteruses are valued, women get real answers, and restorative reproductive medicine becomes the standard of care.',
  url: 'https://rrmacademy.org/save-the-uterus-club/',
  isPartOf: {
    '@type': 'WebSite',
    '@id': 'https://rrmacademy.org/#website',
    name: 'RRM Academy',
    url: 'https://rrmacademy.org/',
  },
  potentialAction: {
    '@type': 'JoinAction',
    name: 'Join the Save the Uterus Club',
    target: 'https://rrmacademy.org/save-the-uterus-club/#tiers',
  },
};
---
<BaseLayout
  title="Save the Uterus Club | Join the RRM Community"
  description="Join a community of patients and providers committed to restorative reproductive medicine. Member resources, live Q&A with Dr. Whittaker, and advocacy updates."
  canonicalUrl="https://rrmacademy.org/save-the-uterus-club"
  jsonLd={jsonLd}
>
  <div class="page-wrapper">
    <div class="container container--narrow">

      <!-- Hero -->
      <section class="stuc-hero">
        <h1>Save the Uterus Club</h1>
        <p class="stuc-tagline">Community, advocacy, and a whole lot of fun, led by our mascot, the Cuterous.</p>
        <p class="stuc-subtext">New research, live calls with Dr. Whittaker, and the next advocacy move reach the group first, before anyone outside the room hears a thing.</p>
        <figure class="stuc-illustration stuc-illustration--mascot">
          <img src="/images/save-the-uterus-club/cuterous.webp" alt="The Cuterous, the Save the Uterus Club's crocheted mascot, sitting beside a scatter of stickers" width="1024" height="1024" loading="lazy" decoding="async" />
          <figcaption>Meet the Cuterous. Our crocheted mascot, our comic relief, and proof you can hold the change. Her whole job is helping the world fall back in love with the uterus.</figcaption>
        </figure>
        <p class="stuc-login-hint" id="stuc-login-hint">Already a member? <a href="/login/?redirect=/save-the-uterus-club/">Log in</a></p>
        <p class="stuc-join-hint" id="stuc-join-hint">Ready to join? <a href="#tiers">See membership options</a></p>
      </section>

      <section class="stuc-section stuc-story">
        <p class="eyebrow">The Twist</p>
        <h2>The Second Tuesday</h2>
        <p>Same woman, two Tuesdays, five months apart.</p>
        <p>First Tuesday: exam room, fluorescent light, five rushed minutes. Same pain she's had for years. A shrug, and nothing that touches why.</p>
        <p>Second Tuesday: laptop open, tea going, she's logged into a Save the Uterus Club live call already in progress. Dr. Whittaker's on screen, walking through cycle charts and lab timing, what a real workup actually looks like. This member finally asks the question she's been sitting on for a year. She gets a real answer. So does everyone else logged in with her.</p>
        <figure class="stuc-illustration">
          <img src="/images/save-the-uterus-club/second-tuesday.webp" alt="A woman at her kitchen table in warm evening light, joining a live video call with a notebook and tea beside her" width="1024" height="1024" loading="lazy" decoding="async" />
        </figure>
        <blockquote class="pull-quote">
          <p>She gets a real answer. So does everyone else logged in with her.</p>
        </blockquote>
        <p>That second Tuesday happens most months. It's why members keep showing up, and it's the whole party.</p>
      </section>

      <hr class="divider" />

      <section class="stuc-section">
        <p class="eyebrow">The Vibe</p>
        <h2>What the Club Actually Is</h2>
        <p>Save the Uterus Club is the community and collaboration arm of RRM Academy, and it runs less like a newsletter and more like a group chat with one mission: restorative reproductive medicine becoming the standard of care.</p>
        <p>We're a do tank, not a think tank. This is where the action happens: live calls, new research, and advocacy letters taking shape in real time in the Uterus Allies chat, often before anyone outside the room hears about it.</p>
        <p>Members team up, so we spend less time duplicating each other's work and more time boosting it. Less work, more fun, bigger impact.</p>
        <p>That's the deal: members fund the work, and in exchange, they get a front-row seat to watch it happen, help shape it, and have some fun along the way.</p>
      </section>

      <hr class="divider" />

      <!-- Meet the Uterus Super Heroes -->
      <section class="stuc-section stuc-spotlight">
        <p class="eyebrow">The A-List</p>
        <h2>Meet the Uterus Super Heroes</h2>
        <p>Two women back the club at the very top tier: $99 a month, a seat at Dr. Whittaker's live quarterly Q&amp;A, and a logo on the RRM Academy homepage. Consider them the club's VIPs. Here's who they are.</p>
        <div class="spotlight-grid">
          {superheroes.map((s) => (
            <div class="card spotlight-card">
              <a href={s.url} target="_blank" rel="noopener" class={`spotlight-logo spotlight-logo--${s.logoShape}`}>
                <img src={s.logo} alt={`${s.org} logo`} loading="lazy" decoding="async" />
              </a>
              <h3>{s.name}</h3>
              <p class="spotlight-org"><a href={s.url} target="_blank" rel="noopener">{s.org}</a></p>
              <p class="spotlight-blurb">{s.blurb}</p>
            </div>
          ))}
        </div>
      </section>

      <hr class="divider" />

      <!-- What You're Let In On -->
      <section class="stuc-section">
        <p class="eyebrow">Behind the Curtain</p>
        <h2>What You're Let In On</h2>
        <p>Depending on where you're standing, the club looks like two different rooms. Either way, it's a good time.</p>
        <figure class="stuc-illustration stuc-illustration--compact">
          <img src="/images/save-the-uterus-club/community.webp" alt="Two women at a table with coffee, one showing the other a page in her notebook" width="1024" height="1024" loading="lazy" decoding="async" />
        </figure>
        <div class="audience-grid">

          <div class="card audience-track">
            <h3>If you're a patient</h3>
            <p>Endometriosis, PCOS, infertility, recurrent loss, or pain nobody's taken seriously: this is the side of the room where you start getting real answers.</p>
            <ul>
              <li>Swap notes with members who found root-cause care before you did.</li>
              <li>Get research turned into plain English you can bring to your next appointment.</li>
              <li>Meet women working through your exact diagnosis, in the group chat and on live calls.</li>
              <li>Ask your question live and get a real answer, on the spot.</li>
              <li>Hold the club in your hands. Uterus Super Heroes get the crochet Cuterous plushie and stickers, mailed to their door.</li>
              <li>Show up for live calls now, and real-life events down the road. Screens are great, but nothing beats an actual conversation.</li>
              <li>Bring your partner in. Fertility's a couple's thing, and male factor accounts for about half of all fertility challenges.</li>
            </ul>
          </div>

          <div class="card audience-track">
            <h3>If you're a provider or advocate</h3>
            <p>Whether you're a clinician, a researcher, an advocacy organization, or someone who's watched a person you love get dismissed, this is where the work gets built.</p>
            <ul>
              <li>Team up instead of duplicating work. Less redundant effort, more boosted impact.</li>
              <li>Watch, and help shape, research and advocacy as it takes shape in the Uterus Allies chat.</li>
              <li>Share your expertise through live Q&amp;As and the resource library.</li>
              <li>Get a seat at the table when the next educational push gets planned.</li>
              <li>Plug in alongside advocacy organizations already doing this work. We compare notes and boost each other's campaigns.</li>
              <li>Take part as a partner, family member, or friend; the movement needs advocates as much as clinicians.</li>
            </ul>
          </div>

        </div>
      </section>

      <hr class="divider" />

      <!-- What's Being Built Right Now -->
      <section class="stuc-section">
        <p class="eyebrow">The Master Plan</p>
        <h2>What's Being Built Right Now</h2>
        <p>This is the long game, and it's already moving through the group chat, the live calls, and the research queue:</p>
        <ol class="goals-list">
          <li><strong>Uteruses valued</strong> instead of treated as disposable</li>
          <li><strong>Women who know their rights</strong> and what good care actually looks like</li>
          <li><strong>Surgery that never gets offered</strong> without a real investigation first</li>
          <li><strong>Painful periods that trigger a real diagnosis</strong></li>
          <li><strong>Couples who get real answers</strong> about what's wrong, and how to fix it, together</li>
          <li><strong>Restorative reproductive medicine</strong> recognized as the standard of care</li>
        </ol>
        <p>None of it happens without funding, without members showing up, and without a community that refuses to settle for 'normal.' That's what your membership builds: one call, one study, one advocacy letter at a time.</p>
      </section>

      <hr class="divider" />

      <!-- What Your Membership Does -->
      <section class="stuc-section">
        <p class="eyebrow">The Receipts</p>
        <h2>What Your Membership Does</h2>
        <p>Here's where the money goes, month over month.</p>
        <ul class="membership-benefits">
          <li><strong>Education</strong> that reaches over 1,000,000 people monthly. Women discovering for the first time that their pain isn't normal, that endometriosis can be treated rather than managed, that fertility problems have causes that can often be addressed.</li>
          <li><strong>Research made accessible.</strong> Over {libraryCountRounded} academic resources in the RRM Research Library, peer-reviewed evidence translated into language women and couples can actually use.</li>
          <li><strong>Training for medical professionals</strong> who want to practice cause-based medicine, finding the root cause behind the symptoms they're currently taught to suppress.</li>
          <li><strong>A space to be heard,</strong> where women swap what medical dismissal actually felt like, and realize they were never the only one.</li>
          <li><strong>Better care for every woman and couple who comes after you,</strong> built by the members who came before them.</li>
        </ul>
        <p class="footnote">Your donation supports the RRM Foundation's operating fund. All donations are tax-deductible (we're a registered 501(c)(3), EIN: 93-4594315).</p>
      </section>

      <hr class="divider" />

      <!-- Active member banner (shown via JS if already subscribed) -->
      <section id="member-banner" class="member-banner" hidden>
        <div class="member-banner__inner card">
          <div class="member-banner__check" aria-hidden="true">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <div class="member-banner__info">
            <h2>You're a <span id="member-tier-name"></span></h2>
            <p id="member-next-date"></p>
          </div>
          <div class="member-banner__actions">
            <button id="manage-billing-btn" class="btn btn--primary btn--sm">Manage Billing</button>
            <a href="/account/" class="btn btn--secondary btn--sm">My Account</a>
          </div>
        </div>
      </section>

      <!-- Welcome-back banner (shown via JS if user previously cancelled) -->
      <section id="member-banner-cancelled" class="member-banner member-banner--cancelled" hidden>
        <div class="member-banner__inner card">
          <div class="member-banner__check" aria-hidden="true">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
          </div>
          <div class="member-banner__info">
            <h2>Welcome back</h2>
            <p>You were a <span id="member-tier-name-cancelled"></span> with us. Pick up where you left off whenever you're ready.</p>
          </div>
        </div>
      </section>

      <!-- Membership Tiers -->
      <section class="stuc-section" id="tiers">
        <p class="eyebrow">Join the Room</p>
        <h2>Membership Tiers</h2>
        <p>Three ways to be part of what happens next. All of it funds the same work; the tiers just decide how far inside the room you sit.</p>
        <div class="tier-grid">

          <div class="tier-card card">
            <div class="tier-header">
              <h3>Member</h3>
              <p class="tier-price">$9<span>/month</span></p>
            </div>
            <p class="tier-desc">What you get:</p>
            <ul>
              <li>Access to Save the Uterus Club member group and live calls</li>
              <li>Exclusive educational resources and podcast library</li>
              <li>Regular updates on research, impact, and new tools</li>
              <li>Invitations to member strategy calls and events</li>
            </ul>
            <button class="btn btn--secondary tier-btn" data-tier="member">Become a Member</button>
          </div>

          <div class="tier-card tier-featured card">
            <span class="tier-badge">Most Popular</span>
            <div class="tier-header">
              <h3>Uterus Hero</h3>
              <p class="tier-price">$19<span>/month</span></p>
            </div>
            <p class="tier-desc">Everything in Member tier, plus:</p>
            <ul>
              <li>Priority access to new resources</li>
              <li>Deeper involvement in advocacy strategy</li>
              <li>Exclusive welcome gift</li>
            </ul>
            <button class="btn btn--primary tier-btn" data-tier="hero">Become a Hero</button>
          </div>

          <div class="tier-card card">
            <div class="tier-header">
              <h3>Uterus Super Hero</h3>
              <p class="tier-price">$99<span>/month</span></p>
            </div>
            <p class="tier-desc">Make a significant difference. Everything in Hero tier, plus:</p>
            <ul>
              <li>Logo placement on the rrmacademy.org homepage</li>
              <li>Live quarterly Q&A calls with Dr. <a href="/commentary/rrm-spotlight-naomi-whittaker-md/">Naomi Whittaker</a></li>
              <li>Handmade uterus plushie and stickers</li>
              <li>Direct input into educational content priorities</li>
            </ul>
            <button class="btn btn--secondary tier-btn" data-tier="superhero">Become a Super Hero</button>
          </div>

        </div>
      </section>

      <hr class="divider" />

      <!-- FAQs -->
      <section class="stuc-section">
        <h2>Questions?</h2>
        <div class="faq-list">
          <details class="faq-item">
            <summary class="faq-question">
              <span class="faq-question-text">What exactly does my donation fund?</span>
              <span class="faq-chevron" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </span>
            </summary>
            <div class="faq-answer">
              <p>Everything. Content creation for RRM Academy. Social media that reaches hundreds of thousands of women and couples monthly. The Research Library. Professional training. Community platforms. Advocacy work. All of it runs on member donations.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span class="faq-question-text">Is this tax-deductible?</span>
              <span class="faq-chevron" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </span>
            </summary>
            <div class="faq-answer">
              <p>All donations to the Restorative Reproductive Medicine Foundation (501(c)(3), EIN: 93-4594315) are tax-deductible.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span class="faq-question-text">Can I cancel anytime?</span>
              <span class="faq-chevron" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </span>
            </summary>
            <div class="faq-answer">
              <p>Monthly donations. Cancel whenever you need to.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span class="faq-question-text">I'm a healthcare professional. How can I get more involved?</span>
              <span class="faq-chevron" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </span>
            </summary>
            <div class="faq-answer">
              <p>Join as a member first. You'll get access to the Uterus Allies chat where we coordinate volunteer projects, educational content, and advocacy strategy. We need your expertise.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span class="faq-question-text">What if I can't afford a monthly donation right now?</span>
              <span class="faq-chevron" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </span>
            </summary>
            <div class="faq-answer">
              <p>Follow us on social media. Share our content. Tell women in your life that they deserve answers. That's advocacy too.</p>
            </div>
          </details>
        </div>
      </section>

      <hr class="divider" />

      <!-- Bottom CTA -->
      <section class="stuc-bottom-cta">
        <p>Somewhere right now, someone's having that first Tuesday. The next call's already on the calendar. The next study's already in the queue.</p>
        <p>The only question left: are you in the room for it?</p>
        <a href="#tiers" class="btn btn--primary btn--lg">Join Us</a>
        <p class="footnote stuc-tax-note">All donations to the Restorative Reproductive Medicine Foundation, a 501(c)(3) non-profit, are tax-deductible. EIN: 93-4594315</p>
      </section>

    </div>

  </div>

  <script is:inline>
    (function () {
      var entryReferrer = sessionStorage.getItem('entry_ref') || '';
      var entryUrl = sessionStorage.getItem('entry_url') || '';
      var tierNames = { member: 'STUC Member', hero: 'Uterus Hero', superhero: 'Uterus Super Hero' };

      // Check billing status for logged-in users
      fetch('/api/billing/status', { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (!data.ok) return;
          var loginHint = document.getElementById('stuc-login-hint');
          if (loginHint) loginHint.hidden = true;
          if (!data.subscription) return;
          var sub = data.subscription;

          // Cancelled member: show welcome-back banner, leave tier buttons enabled so they can restart.
          if (sub.status === 'cancelled') {
            var cancelledBanner = document.getElementById('member-banner-cancelled');
            var cancelledTier = document.getElementById('member-tier-name-cancelled');
            if (cancelledTier) cancelledTier.textContent = tierNames[sub.tier] || sub.tier || 'member';
            if (cancelledBanner) cancelledBanner.hidden = false;
            return;
          }

          if (sub.status !== 'active' && sub.status !== 'trialing') return;

          // Show member banner
          var banner = document.getElementById('member-banner');
          var tierEl = document.getElementById('member-tier-name');
          var dateEl = document.getElementById('member-next-date');
          tierEl.textContent = tierNames[sub.tier] || sub.tier;

          if (sub.cancelAtPeriodEnd && sub.currentPeriodEnd) {
            dateEl.textContent = 'Your membership ends ' + new Date(sub.currentPeriodEnd * 1000).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
          } else if (sub.currentPeriodEnd) {
            dateEl.textContent = 'Next donation: ' + new Date(sub.currentPeriodEnd * 1000).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
          } else {
            dateEl.textContent = 'Active monthly membership';
          }

          banner.hidden = false;

          // Update tier buttons: current tier disabled, others show upgrade/downgrade.
          // Wix-source members can't use Stripe portal or new-tier checkout (would
          // create a parallel Stripe sub on top of their Wix sub = double charge),
          // so route their tier-change action to email instead.
          var isWix = sub.source === 'wix';
          var tierOrder = ['member', 'hero', 'superhero'];
          var currentIdx = tierOrder.indexOf(sub.tier);
          var buttons = document.querySelectorAll('.tier-btn');
          for (var i = 0; i < buttons.length; i++) {
            var btnTier = buttons[i].dataset.tier;
            var btnIdx = tierOrder.indexOf(btnTier);
            if (btnTier === sub.tier) {
              buttons[i].disabled = true;
              buttons[i].textContent = 'Your Plan';
              buttons[i].classList.add('tier-btn--disabled');
            } else if (isWix) {
              buttons[i].textContent = 'Email to Change';
              buttons[i].dataset.target = 'email';
              buttons[i].classList.add('tier-btn--wix-locked');
            } else {
              buttons[i].textContent = btnIdx > currentIdx ? 'Upgrade' : 'Downgrade';
              buttons[i].classList.add('tier-btn--change');
            }
          }

          // Wix-source members: swap "Manage Billing" → "Manage Membership" → /account/
          // (Stripe portal returns 4xx for them since they have no Stripe customer.)
          if (isWix) {
            var manageBtn = document.getElementById('manage-billing-btn');
            if (manageBtn) {
              manageBtn.textContent = 'Manage Membership';
              manageBtn.dataset.target = 'account';
            }
          }

          // Hide bottom CTA and the early hero join-hint (already a member)
          var bottomCta = document.querySelector('.stuc-bottom-cta .btn');
          if (bottomCta) bottomCta.style.display = 'none';
          var joinHint = document.getElementById('stuc-join-hint');
          if (joinHint) joinHint.style.display = 'none';
        })
        .catch(function () {});

      // Manage billing → Stripe portal (Stripe-source) or /account/ (Wix-source)
      document.getElementById('manage-billing-btn').addEventListener('click', function () {
        var btn = this;
        if (btn.dataset.target === 'account') {
          window.location.href = '/account/';
          return;
        }
        btn.disabled = true;
        btn.textContent = 'Opening...';
        fetch('/api/billing/portal', { method: 'POST', credentials: 'same-origin' })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            if (data.ok && data.url) {
              window.location.href = data.url;
            } else {
              btn.disabled = false;
              btn.textContent = 'Manage Billing';
              alert(data.error || 'Unable to open billing portal.');
            }
          })
          .catch(function () {
            btn.disabled = false;
            btn.textContent = 'Manage Billing';
          });
      });

      // Tier buttons → Stripe Checkout (new members), billing portal (Stripe members
      // changing tier), or mailto (Wix-source members — Stripe portal won't work and
      // a fresh checkout would create a parallel sub).
      document.querySelectorAll('.tier-btn[data-tier]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          if (btn.classList.contains('tier-btn--disabled')) return;

          // Wix-source member changing tier → email (no Stripe surface to use)
          if (btn.dataset.target === 'email') {
            var newTier = btn.dataset.tier;
            window.location.href = 'mailto:support@rrmacademy.org?subject=' +
              encodeURIComponent('Change my Save the Uterus Club tier') +
              '&body=' + encodeURIComponent(
                'Please change my Save the Uterus Club membership to the ' + newTier + ' tier.'
              );
            return;
          }

          // Existing Stripe subscriber changing tier → billing portal
          if (btn.classList.contains('tier-btn--change')) {
            btn.disabled = true;
            var label = btn.textContent;
            btn.textContent = 'Opening...';
            fetch('/api/billing/portal', { method: 'POST', credentials: 'same-origin' })
              .then(function (r) { return r.json(); })
              .then(function (data) {
                if (data.ok && data.url) {
                  window.location.href = data.url;
                } else {
                  btn.disabled = false;
                  btn.textContent = label;
                  alert(data.error || 'Unable to open billing portal.');
                }
              })
              .catch(function () {
                btn.disabled = false;
                btn.textContent = label;
              });
            return;
          }

          // New subscriber → Stripe Checkout
          var tier = btn.dataset.tier;
          btn.disabled = true;
          var original = btn.textContent;
          btn.textContent = 'Redirecting...';

          fetch('/api/create-checkout', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ mode: 'subscription', tier: tier, entry_referrer: entryReferrer, entry_url: entryUrl }),
          })
            .then(function (r) { return r.json(); })
            .then(function (data) {
              if (data.ok && data.url) {
                window.location.href = data.url;
              } else {
                btn.disabled = false;
                btn.textContent = original;
                alert(data.error || 'Something went wrong. Please try again.');
              }
            })
            .catch(function () {
              btn.disabled = false;
              btn.textContent = original;
              alert('Connection error. Please try again.');
            });
        });
      });
    })();
  </script>
</BaseLayout>

