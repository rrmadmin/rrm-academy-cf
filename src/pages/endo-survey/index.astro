  /* Disclaimer */
  .survey-disclaimer { margin-top: var(--space-10); padding-top: var(--space-4); border-top: 1px solid var(--border-light); }
  .survey-disclaimer p { font-size: 0.75rem; line-height: 1.6; color: var(--text-secondary); margin: 0; }

  @media (max-width: 879px) {
    .survey-hero { padding: var(--space-10) 0 var(--space-8); }
    .survey-hero__tagline { max-width: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .survey-recap__btn:hover { transform: none; }
    .survey-faq__item[open] .survey-faq__q::after { transition: none; }
  }
</style>

<script>
  const form = document.getElementById('email-form') as HTMLFormElement | null;
  const input = document.getElementById('email-input') as HTMLInputElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const successMsg = document.getElementById('success-msg');
  const errorMsg = document.getElementById('error-msg');
  const errorText = document.getElementById('error-text');
  const sentEmail = document.getElementById('sent-email');

  if (form && input && submitBtn && successMsg && errorMsg && errorText && sentEmail) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorMsg.hidden = true;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';

      const email = input.value.trim();
      if (!email) return;

      // Carry through tracking params
      const params = new URLSearchParams(window.location.search);
      const payload: Record<string, string> = { email };
      const userorigin = params.get('userorigin');
      const utmSource = params.get('utm_source');
      if (userorigin) payload.userorigin = userorigin;
      if (utmSource) payload.utm_source = utmSource;

    try {
      const resp = await fetch('/api/survey/request', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await resp.json();

      if (data.ok) {
        form.hidden = true;
        sentEmail.textContent = email;
        successMsg.hidden = false;
      } else if (data.suggestion) {
        errorText.textContent = data.error;
        errorMsg.hidden = false;
        const emailInput = form.querySelector('input[type="email"]') as HTMLInputElement | null;
        if (emailInput) {
          const useLink = document.createElement('a');
          useLink.href = '#';
          useLink.textContent = 'Use this email instead';
          useLink.style.cssText = 'display:block;margin-top:8px;color:var(--accent);text-decoration:underline;cursor:pointer;';
          useLink.addEventListener('click', function (ev) {
            ev.preventDefault();
            emailInput.value = data.suggestion;
            errorMsg.hidden = true;
          });
          errorMsg.appendChild(useLink);
        }
      } else {
        errorText.textContent = data.error || 'Something went wrong. Please try again.';
        errorMsg.hidden = false;
      }
    } catch (error) {
      errorText.textContent = 'Network error. Please try again.';
      errorMsg.hidden = false;
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Get My Survey Link';
    }
    });
  }
</script>
