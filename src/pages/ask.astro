---
import BaseLayout from '../layouts/BaseLayout.astro';
import MaybeShell from '../components/MaybeShell.astro';
import { isShellEnabled } from '../lib/shell-routes';
import { TURNSTILE_SITE_KEY } from '../lib/turnstile';
import libraryStats from '../data/library-stats.json';

const SHELL_ENABLED = isShellEnabled('ask');

// Exact, build-synced count of research pages in the library
// (written by scripts/sync-library-count.mjs at build time).
const PAGE_COUNT = (libraryStats?.count ?? 0).toLocaleString('en-US');

// Empty-state starter questions, grouped by category (bv4 layout).
const ASK_CATEGORIES = [
  {
    name: 'Conditions',
    questions: [
      'What does RRM say about PCOS and progesterone?',
      'How is endometriosis treated in RRM?',
      'What causes recurrent miscarriage?',
    ],
  },
  {
    name: 'Treatments & approaches',
    questions: [
      'How does excision surgery compare to ablation?',
      'How does NaProTechnology treat infertility?',
      'How does RRM differ from IVF?',
    ],
  },
  {
    name: 'Cycle & charting',
    questions: [
      'Can FABMs help identify ovulatory dysfunction?',
      'What does luteal phase support do?',
      'What can a charted cycle reveal?',
    ],
  },
];
---
<BaseLayout
  title="Ask RRM Academy"
  description="Ask a question about restorative reproductive medicine. Answers drawn from the RRM Academy research library."
  canonicalUrl="https://rrmacademy.org/ask/"
  noindex
  chrome={SHELL_ENABLED ? 'shell' : 'default'}
>
  <MaybeShell enabled={SHELL_ENABLED} context="page" currentPath={Astro.url.pathname}>
  <section class="ask-page">
    <div class="container">
      <header class="ask-header">
        <p class="ask-eyebrow">Research Preview</p>
        <h1>Ask RRM Academy</h1>
        <p class="ask-sub">Answers drawn from our research library, FAQs, and pillar guides.</p>
      </header>

      <div class="ask-thread" id="ask-thread" aria-live="polite"></div>

      <form class="ask-form" id="ask-form" autocomplete="off">
        <label for="ask-input" class="sr-only">Your question</label>
        <textarea
          id="ask-input"
          name="message"
          rows="2"
          maxlength="500"
          placeholder="What does RRM say about PCOS and progesterone?"
          required
        ></textarea>
        <div class="ask-form__row">
          <span class="ask-count" id="ask-count">0 / 500</span>
          <button type="submit" class="btn btn--primary" id="ask-submit">Ask</button>
        </div>
      </form>

      <div class="ask-empty" id="ask-empty">
        <p class="ask-source">Synthesized from <b>{PAGE_COUNT}</b> pages across the RRM Academy research library</p>
        <div class="ask-cats">
          {ASK_CATEGORIES.map((cat) => (
            <div class="ask-cat">
              <div class="ask-cat__name"><span class="ask-cat__dot"></span>{cat.name}</div>
              {cat.questions.map((q) => (
                <button type="button" class="ask-cat__q" data-ask={q}>{q}</button>
              ))}
            </div>
          ))}
        </div>
      </div>

      <p class="ask-footnote">
        This is AI-generated and still learning. Always verify against the cited library sources.
        Library search remains the primary tool for researchers -- head to
        <a href="/library/">/library/</a> for the full database.
        <br>
        <a href="/ask/saved/" class="ask-footnote__saved">View your saved questions &rarr;</a>
      </p>
    </div>
  </section>

  <!-- Inline auth modal: opens on a 401 from /api/ask so anonymous visitors can
       create a free account (or log in) WITHOUT leaving /ask. The typed question
       is preserved and auto-run the moment auth succeeds. -->
  <div class="askauth" id="askauth-modal" role="dialog" aria-modal="true" aria-labelledby="askauth-heading" hidden>
    <div class="askauth__backdrop" data-askauth-close></div>
    <div class="askauth__sheet" role="document">
      <button type="button" class="askauth__close" id="askauth-close" data-askauth-close aria-label="Close">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>

      <h2 id="askauth-heading" class="askauth__heading">Create your free account</h2>
      <p class="askauth__sub" id="askauth-sub">Free account, 3 questions per day on the AI, and your questions and answers saved for later.</p>

      <!-- Signup form -->
      <form id="askauth-signup-form" class="auth-form" novalidate>
        <div class="askauth__row">
          <div class="form-group">
            <label class="form-label" for="askauth-first-name">First name</label>
            <input class="form-input" type="text" id="askauth-first-name" name="firstName" required autocomplete="given-name" maxlength="100" />
          </div>
          <div class="form-group">
            <label class="form-label" for="askauth-last-name">Last name</label>
            <input class="form-input" type="text" id="askauth-last-name" name="lastName" required autocomplete="family-name" maxlength="100" />
          </div>
        </div>
        <div class="form-group">
          <label class="form-label" for="askauth-email">Email</label>
          <input class="form-input" type="email" id="askauth-email" name="email" required autocomplete="email" />
        </div>
        <div class="form-group">
          <label class="form-label" for="askauth-password">Password</label>
          <input class="form-input" type="password" id="askauth-password" name="password" required autocomplete="new-password" minlength="8" />
          <span class="form-hint">At least 8 characters</span>
        </div>
        <button type="submit" class="btn btn--primary askauth__submit" id="askauth-signup-submit">Create account</button>
      </form>

      <!-- Login form (hidden until toggled) -->
      <form id="askauth-login-form" class="auth-form" novalidate hidden>
        <div class="form-group">
          <label class="form-label" for="askauth-login-email">Email</label>
          <input class="form-input" type="email" id="askauth-login-email" name="email" required autocomplete="email" />
        </div>
        <div class="form-group">
          <label class="form-label" for="askauth-login-password">Password</label>
          <input class="form-input" type="password" id="askauth-login-password" name="password" required autocomplete="current-password" />
        </div>
        <button type="submit" class="btn btn--primary askauth__submit" id="askauth-login-submit">Sign in</button>
      </form>

      <div id="askauth-error" class="askauth__error" hidden><p id="askauth-error-text"></p></div>

      <div id="askauth-divider" class="askauth__divider"><span>or</span></div>

      <a id="askauth-google" href="/api/auth/google" class="btn btn--google askauth__google">
        <svg class="google-logo" viewBox="0 0 24 24" width="20" height="20" xmlns="http://www.w3.org/2000/svg">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        <span id="askauth-google-label">Sign up with Google</span>
      </a>

      <p class="askauth__toggle">
        <span id="askauth-toggle-prompt">Already have an account?</span>
        <button type="button" id="askauth-toggle-btn" class="askauth__toggle-btn">Log in</button>
      </p>

      {TURNSTILE_SITE_KEY && (
        <div id="askauth-turnstile" data-sitekey={TURNSTILE_SITE_KEY}></div>
      )}
    </div>
  </div>
  </MaybeShell>

  {TURNSTILE_SITE_KEY && (
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer is:inline></script>
  )}

  <script is:inline>
    (function () {
      var form = document.getElementById('ask-form');
      var input = document.getElementById('ask-input');
      var thread = document.getElementById('ask-thread');
      var submit = document.getElementById('ask-submit');
      var count = document.getElementById('ask-count');
      var askEmpty = document.getElementById('ask-empty');

      function updateCount() { count.textContent = input.value.length + ' / 500'; }
      input.addEventListener('input', updateCount);
      updateCount();

      // Rotating example placeholders (only while input is empty + unfocused)
      var examples = [
        'What does RRM say about PCOS and progesterone?',
        'How does NaProTechnology treat endometriosis?',
        'Can FABMs help identify ovulatory dysfunction?',
        'What are the success rates of RRM for unexplained infertility?',
        'How does excision surgery compare to ablation for endometriosis?',
        'What is the evidence behind excision surgery for endometriosis?',
        'How does RRM differ from IVF for recurrent miscarriage?',
        'What role does luteal phase support play in RRM?'
      ];
      var pIdx = 0;
      function rotatePlaceholder() {
        if (document.activeElement === input || input.value !== '') return;
        input.classList.add('placeholder-fading');
        setTimeout(function () {
          pIdx = (pIdx + 1) % examples.length;
          input.placeholder = examples[pIdx];
          input.classList.remove('placeholder-fading');
        }, 400);
      }
      setInterval(rotatePlaceholder, 4500);

      // Cmd+Enter (Mac) or Ctrl+Enter (Win/Linux) submits the form
      input.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) {
          e.preventDefault();
          if (typeof form.requestSubmit === 'function') form.requestSubmit();
          else form.dispatchEvent(new Event('submit', { cancelable: true }));
        }
      });

      function escapeHtml(s) {
        return String(s)
          .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
      }

      function renderMarkdown(text) {
        var s = escapeHtml(text);
        // Bold: **text**
        s = s.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
        // Italic: *text* (after bold so ** doesn't collide)
        s = s.replace(/(^|[^*])\*([^*\n]+)\*(?!\*)/g, '$1<em>$2</em>');
        // Convert URLs to clickable links (including those in parens)
        s = s.replace(/(https?:\/\/[^\s<)"]+)/g, function (url) {
          var clean = url.replace(/[.,;:!?]+$/, '');
          var tail = url.slice(clean.length);
          return '<a href="' + clean + '" rel="noopener" target="_blank">' + clean + '</a>' + tail;
        });
        // Numbered list items: lines starting with "N. "
        var lines = s.split('\n');
        var out = [];
        var inList = false;
        for (var i = 0; i < lines.length; i++) {
          var line = lines[i];
          if (/^\s*\d+\.\s+/.test(line)) {
            if (!inList) { out.push('<ol>'); inList = true; }
            out.push('<li>' + line.replace(/^\s*\d+\.\s+/, '') + '</li>');
          } else {
            if (inList) { out.push('</ol>'); inList = false; }
            out.push(line);
          }
        }
        if (inList) out.push('</ol>');
        s = out.join('\n');
        // Paragraph breaks on blank lines
        var paras = s.split(/\n\s*\n+/);
        return paras.map(function (p) {
          if (p.trim().indexOf('<ol>') === 0 || p.trim().indexOf('<ul>') === 0) return p;
          return '<p>' + p.replace(/\n/g, '<br>') + '</p>';
        }).join('');
      }

      function renderCitations(list) {
        if (!list || !list.length) return '';
        var items = list.map(function (c) {
          var url = c.url || '#';
          var title = c.title || url;
          return '<li><a href="' + escapeHtml(url) + '" rel="noopener">' + escapeHtml(title) + '</a></li>';
        }).join('');
        return '<ul class="ask-citations">' + items + '</ul>';
      }

      // Tracks the most recent user question so the assistant message
      // that follows can include it in the Save payload.
      var lastQuestion = '';

      function appendMessage(role, text, citations) {
        var wrap = document.createElement('div');
        wrap.className = 'ask-msg ask-msg--' + role;
        var bodyHtml = role === 'assistant'
          ? renderMarkdown(text)
          : '<p>' + escapeHtml(text).replace(/\n/g, '<br>') + '</p>';
        var body = '<div class="ask-msg__body">' + bodyHtml + '</div>';
        if (role === 'assistant') {
          body += renderCitations(citations);
          body += renderActions();
        }
        wrap.innerHTML = body;
        if (role === 'assistant') {
          // Stash the Q/A/citations as data on the element for the
          // save handler to read on click.
          wrap.dataset.question = lastQuestion;
          wrap.dataset.answer = text;
          wrap.dataset.citations = JSON.stringify(citations || []);
        }
        thread.appendChild(wrap);
        wrap.scrollIntoView({ behavior: 'smooth', block: 'end' });
      }

      function renderActions() {
        return '<div class="ask-actions">'
          + '<button type="button" class="ask-action-btn" data-action="save">'
          +   '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>'
          +   '<span>Save</span>'
          + '</button>'
          + '</div>';
      }

      function setSavedState(actionsEl, shareUrl) {
        actionsEl.innerHTML = ''
          + '<button type="button" class="ask-action-btn ask-action-btn--saved" disabled>'
          +   '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>'
          +   '<span>Saved</span>'
          + '</button>'
          + '<button type="button" class="ask-action-btn" data-action="copy" data-url="' + escapeHtml(shareUrl) + '">'
          +   '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>'
          +   '<span>Copy link</span>'
          + '</button>'
          + '<a href="' + escapeHtml(shareUrl) + '" target="_blank" rel="noopener" class="ask-action-btn">'
          +   '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>'
          +   '<span>Open</span>'
          + '</a>';
      }

      // Delegated handler for save / copy clicks within the thread.
      thread.addEventListener('click', function (e) {
        var btn = e.target.closest('.ask-action-btn');
        if (!btn) return;
        var action = btn.getAttribute('data-action');
        if (action === 'save') {
          var msg = btn.closest('.ask-msg--assistant');
          if (!msg) return;
          var actionsEl = msg.querySelector('.ask-actions');
          var orig = btn.innerHTML;
          btn.disabled = true;
          btn.innerHTML = '<span>Saving...</span>';
          var citationsParsed = [];
          try { citationsParsed = JSON.parse(msg.dataset.citations || '[]'); } catch (e2) {}
          fetch('/api/ask/saved', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              question: msg.dataset.question || '',
              answer: msg.dataset.answer || '',
              citations: citationsParsed,
            }),
          })
            .then(function (r) { return r.json().then(function (d) { return { status: r.status, data: d }; }); })
            .then(function (res) {
              var d = res.data || {};
              if (d.ok && d.share_url) {
                setSavedState(actionsEl, d.share_url);
              } else if (res.status === 401) {
                // Anonymous: open the inline auth modal instead of redirecting away.
                // Restore the Save button so the user can retry the save after auth,
                // and record a 'save' intent so auth success re-runs the save (not the question).
                btn.innerHTML = orig;
                btn.disabled = false;
                openAuthModal(msg.dataset.question || '', 'save', msg);
              } else if (res.status === 429) {
                btn.innerHTML = orig;
                btn.disabled = false;
                appendError('You have saved a lot recently. Please try again later.');
              } else {
                btn.innerHTML = orig;
                btn.disabled = false;
                appendError('Could not save. Please try again.');
              }
            })
            .catch(function () {
              btn.innerHTML = orig;
              btn.disabled = false;
              appendError('Network error while saving.');
            });
        } else if (action === 'copy') {
          var url = btn.getAttribute('data-url') || '';
          var span = btn.querySelector('span');
          var origLabel = span ? span.textContent : '';
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(url).then(function () {
              if (span) span.textContent = 'Copied!';
              setTimeout(function () { if (span) span.textContent = origLabel; }, 1800);
            }).catch(function () {
              window.prompt('Copy this link:', url);
            });
          } else {
            window.prompt('Copy this link:', url);
          }
        }
      });

      function appendLoading() {
        var wrap = document.createElement('div');
        wrap.className = 'ask-msg ask-msg--assistant ask-msg--loading';
        wrap.innerHTML = '<div class="ask-msg__body"><span class="ask-dots"><span></span><span></span><span></span></span></div>';
        thread.appendChild(wrap);
        wrap.scrollIntoView({ behavior: 'smooth', block: 'end' });
        return wrap;
      }

      function appendError(msg) {
        var wrap = document.createElement('div');
        wrap.className = 'ask-msg ask-msg--error';
        wrap.innerHTML = '<div class="ask-msg__body">' + escapeHtml(msg) + '</div>';
        thread.appendChild(wrap);
      }

      // Single callable that sends a question to /api/ask and renders the answer.
      // The form submit, the ?q= URL handler, and the post-auth replay all call this
      // so the send logic lives in exactly one place.
      function runAsk(question) {
        var message = (question || '').trim();
        if (message.length < 2) return;

        lastQuestion = message;
        // Hide the empty-state (starter columns) the moment a question is asked.
        if (askEmpty) askEmpty.hidden = true;
        appendMessage('user', message, null);
        // Clear the composer once the question is in-flight (it now lives in the thread).
        input.value = '';
        updateCount();
        submit.disabled = true; submit.textContent = 'Asking...';
        var loader = appendLoading();

        fetch('/api/ask', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message: message }),
        })
          .then(function (r) {
            return r.json().then(function (data) { return { status: r.status, data: data }; });
          })
          .then(function (res) {
            if (loader.parentNode) loader.parentNode.removeChild(loader);
            var d = res.data || {};
            // CF Pages /* headers rule can mangle non-200 status codes, so key
            // decisions off the JSON body's error field as well as res.status.
            if (d.answer) {
              justAuthed = false;
              appendMessage('assistant', d.answer, d.citations);
            } else if (d.error === 'unauthorized' || res.status === 401) {
              if (justAuthed) {
                // We just authed and the session still 401s (e.g. the anti-enumeration
                // decoy returned for an existing email). Do not loop: surface guidance
                // and switch the modal to login rather than reopening blindly.
                justAuthed = false;
                stashedQuestion = message;
                authModal.removeAttribute('hidden');
                document.documentElement.style.overflow = 'hidden';
                setAuthMode('login');
                showAuthError('If you already have an account, log in to continue.');
              } else {
                // Anonymous visitor: open the inline auth modal instead of redirecting
                // away. Stash the question so it auto-runs the moment auth succeeds.
                openAuthModal(message, 'ask');
              }
            } else if (d.error === 'rate_limited' || res.status === 429) {
              appendError('You have reached today\u2019s question limit. Come back tomorrow.');
            } else if (d.error === 'forbidden' || res.status === 403) {
              appendError('This account cannot use /ask right now.');
            } else if (d.error === 'service_unavailable' || res.status === 503) {
              appendError('Service is temporarily unavailable. Please try again in a moment.');
            } else if (d.error === 'upstream_timeout' || res.status === 504) {
              appendError('The answer is taking longer than expected. Please try again.');
            } else if (d.error === 'upstream_error' || res.status === 502) {
              appendError('Research layer is unreachable. Please try again in a moment.');
            } else {
              appendError('Something went wrong. Please try again.');
            }
          })
          .catch(function () {
            if (loader.parentNode) loader.parentNode.removeChild(loader);
            appendError('Network error. Please try again.');
          })
          .then(function () {
            submit.disabled = false; submit.textContent = 'Ask';
            input.focus();
          });
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        runAsk(input.value);
      });

      // Starter questions (empty-state category columns) run the ask directly.
      if (askEmpty) {
        askEmpty.addEventListener('click', function (e) {
          var btn = e.target.closest('.ask-cat__q');
          if (!btn) return;
          e.preventDefault();
          runAsk(btn.getAttribute('data-ask') || btn.textContent || '');
        });
      }

      // \u2500\u2500 Inline auth modal \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500
      // Opened on a 401 from /api/ask. Preserves the typed question and replays it
      // through runAsk() (inline signup/login) or via the ?q= handler (Google OAuth).
      var authModal = document.getElementById('askauth-modal');
      var authSignupForm = document.getElementById('askauth-signup-form');
      var authLoginForm = document.getElementById('askauth-login-form');
      var authSignupSubmit = document.getElementById('askauth-signup-submit');
      var authLoginSubmit = document.getElementById('askauth-login-submit');
      var authError = document.getElementById('askauth-error');
      var authErrorText = document.getElementById('askauth-error-text');
      var authGoogle = document.getElementById('askauth-google');
      var authToggleBtn = document.getElementById('askauth-toggle-btn');
      var authTogglePrompt = document.getElementById('askauth-toggle-prompt');
      var authHeading = document.getElementById('askauth-heading');
      var authClose = document.getElementById('askauth-close');
      var stashedQuestion = '';
      var authMode = 'signup';
      var authLastFocus = null;
      var tsWidgetId = null;
      var tsPending = null; // { kind: 'signup'|'login', ...fields }
      var tsFallbackTimer = null;
      var justAuthed = false;
      var authIntent = 'ask'; // 'ask' | 'save'
      var pendingSaveMsg = null;

      function showAuthError(msg) {
        if (authError) { authErrorText.textContent = msg; authError.hidden = false; }
      }
      function clearAuthError() { if (authError) authError.hidden = true; }

      // Turnstile: one invisible widget, reset between uses. Mirrors signup.astro.
      function initTurnstile() {
        var el = document.getElementById('askauth-turnstile');
        if (!el || typeof turnstile === 'undefined') return;
        tsWidgetId = turnstile.render(el, {
          sitekey: el.dataset.sitekey, size: 'invisible',
          callback: function (token) {
            if (tsFallbackTimer !== null) { clearTimeout(tsFallbackTimer); tsFallbackTimer = null; }
            if (!tsPending) return;
            var p = tsPending; tsPending = null;
            if (p.kind === 'signup') doSignup(p.firstName, p.lastName, p.email, p.password, token);
            else doLogin(p.email, p.password, token);
          },
          'error-callback': function () {
            if (tsFallbackTimer !== null) { clearTimeout(tsFallbackTimer); tsFallbackTimer = null; }
            showAuthError('Spam check failed. Please refresh and try again.');
            resetAuthButtons();
            tsPending = null;
          },
        });
      }
      var tsCheck = setInterval(function () { if (typeof turnstile !== 'undefined') { clearInterval(tsCheck); initTurnstile(); } }, 200);
      setTimeout(function () { clearInterval(tsCheck); }, 10000);

      function resetAuthButtons() {
        if (authSignupSubmit) { authSignupSubmit.disabled = false; authSignupSubmit.textContent = 'Create account'; }
        if (authLoginSubmit) { authLoginSubmit.disabled = false; authLoginSubmit.textContent = 'Sign in'; }
      }

      function cancelPendingAuth() {
        tsPending = null;
        if (tsFallbackTimer !== null) { clearTimeout(tsFallbackTimer); tsFallbackTimer = null; }
        try { if (tsWidgetId !== null) turnstile.reset(tsWidgetId); } catch (_) {}
        resetAuthButtons();
      }

      function setAuthMode(mode) {
        authMode = mode;
        cancelPendingAuth();
        clearAuthError();
        if (mode === 'login') {
          authSignupForm.hidden = true;
          authLoginForm.hidden = false;
          authHeading.textContent = 'Welcome back';
          authTogglePrompt.textContent = 'Need an account?';
          authToggleBtn.textContent = 'Sign up';
        } else {
          authSignupForm.hidden = false;
          authLoginForm.hidden = true;
          authHeading.textContent = 'Create your free account';
          authTogglePrompt.textContent = 'Already have an account?';
          authToggleBtn.textContent = 'Log in';
        }
        focusFirstField();
      }

      function focusFirstField() {
        var first = authMode === 'login'
          ? document.getElementById('askauth-login-email')
          : document.getElementById('askauth-first-name');
        if (first) { try { first.focus(); } catch (_) {} }
      }

      function openAuthModal(question, intent, saveMsg) {
        cancelPendingAuth();
        justAuthed = false;
        authIntent = intent === 'save' ? 'save' : 'ask';
        pendingSaveMsg = authIntent === 'save' ? (saveMsg || null) : null;
        if (typeof question === 'string' && question.trim()) {
          stashedQuestion = question.trim().slice(0, 500);
        } else if (!stashedQuestion) {
          stashedQuestion = (input.value || '').trim().slice(0, 500);
        }
        // Google path preserves + auto-runs the question via the existing ?q= handler.
        if (authGoogle) {
          authGoogle.setAttribute('href', '/api/auth/google?redirect=' + encodeURIComponent('/ask?q=' + encodeURIComponent(stashedQuestion)));
        }
        authLastFocus = document.activeElement;
        clearAuthError();
        resetAuthButtons();
        setAuthMode('signup');
        authModal.removeAttribute('hidden');
        document.documentElement.style.overflow = 'hidden';
        // rAF so focus lands after the dialog paints.
        requestAnimationFrame(focusFirstField);
      }

      function closeAuthModal() {
        if (authModal.hasAttribute('hidden')) return;
        cancelPendingAuth();
        authModal.setAttribute('hidden', '');
        document.documentElement.style.overflow = '';
        if (authLastFocus && typeof authLastFocus.focus === 'function') {
          try { authLastFocus.focus(); } catch (_) {}
        }
      }

      // Close affordances: X button, backdrop click, Escape. The typed question is
      // left untouched in the composer (we never cleared it on a 401).
      authModal.addEventListener('click', function (e) {
        var t = e.target;
        if (t && t.closest && t.closest('[data-askauth-close]')) closeAuthModal();
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !authModal.hasAttribute('hidden')) {
          e.preventDefault();
          closeAuthModal();
        }
      });
      authToggleBtn.addEventListener('click', function () {
        setAuthMode(authMode === 'signup' ? 'login' : 'signup');
      });

      authSignupForm.addEventListener('submit', function (e) {
        e.preventDefault(); clearAuthError();
        var firstName = authSignupForm.firstName.value.trim();
        var lastName = authSignupForm.lastName.value.trim();
        var email = authSignupForm.email.value.trim();
        var password = authSignupForm.password.value;
        if (!firstName) return showAuthError('Please enter your first name.');
        if (!lastName) return showAuthError('Please enter your last name.');
        if (!email) return showAuthError('Please enter your email.');
        if (!password || password.length < 8) return showAuthError('Password must be at least 8 characters.');
        authSignupSubmit.disabled = true; authSignupSubmit.textContent = 'Creating account...';
        if (typeof turnstile !== 'undefined' && tsWidgetId !== null) {
          tsPending = { kind: 'signup', firstName: firstName, lastName: lastName, email: email, password: password };
          try { turnstile.reset(tsWidgetId); turnstile.execute(tsWidgetId); } catch (_) { tsPending = null; doSignup(firstName, lastName, email, password, ''); return; }
          tsFallbackTimer = setTimeout(function () { tsFallbackTimer = null; if (tsPending && tsPending.kind === 'signup') { tsPending = null; doSignup(firstName, lastName, email, password, ''); } }, 5000);
          return;
        }
        doSignup(firstName, lastName, email, password, '');
      });

      authLoginForm.addEventListener('submit', function (e) {
        e.preventDefault(); clearAuthError();
        var email = authLoginForm.email.value.trim();
        var password = authLoginForm.password.value;
        if (!email) return showAuthError('Please enter your email.');
        if (!password) return showAuthError('Please enter your password.');
        authLoginSubmit.disabled = true; authLoginSubmit.textContent = 'Signing in...';
        if (typeof turnstile !== 'undefined' && tsWidgetId !== null) {
          tsPending = { kind: 'login', email: email, password: password };
          try { turnstile.reset(tsWidgetId); turnstile.execute(tsWidgetId); } catch (_) { tsPending = null; doLogin(email, password, ''); return; }
          tsFallbackTimer = setTimeout(function () { tsFallbackTimer = null; if (tsPending && tsPending.kind === 'login') { tsPending = null; doLogin(email, password, ''); } }, 5000);
          return;
        }
        doLogin(email, password, '');
      });

      function runSaveForMsg(msg) {
        if (!msg) return;
        var btn = msg.querySelector('.ask-action-btn[data-action="save"]');
        var actionsEl = msg.querySelector('.ask-actions');
        if (!btn || !actionsEl) return;
        var orig = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span>Saving...</span>';
        var citationsParsed = [];
        try { citationsParsed = JSON.parse(msg.dataset.citations || '[]'); } catch (e2) {}
        fetch('/api/ask/saved', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            question: msg.dataset.question || '',
            answer: msg.dataset.answer || '',
            citations: citationsParsed,
          }),
        })
          .then(function (r) { return r.json().then(function (d) { return { status: r.status, data: d }; }); })
          .then(function (res) {
            var d = res.data || {};
            if (d.ok && d.share_url) {
              setSavedState(actionsEl, d.share_url);
            } else if (res.status === 429) {
              btn.innerHTML = orig; btn.disabled = false;
              appendError('You have saved a lot recently. Please try again later.');
            } else {
              btn.innerHTML = orig; btn.disabled = false;
              appendError('Could not save. Please try again.');
            }
          })
          .catch(function () {
            btn.innerHTML = orig; btn.disabled = false;
            appendError('Network error while saving.');
          });
      }

      // Dispatch the action the user was trying to do before auth interrupted them.
      function runPostAuthIntent() {
        justAuthed = true;
        if (authIntent === 'save') {
          var msg = pendingSaveMsg;
          pendingSaveMsg = null;
          runSaveForMsg(msg);
        } else {
          runAsk(stashedQuestion);
        }
      }

      function doSignup(firstName, lastName, email, password, token) {
        fetch('/api/auth/signup', {
          method: 'POST', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ firstName: firstName, lastName: lastName, email: email, password: password, turnstileToken: token, next: '/ask' }),
        })
          .then(function (r) {
            return r.text().then(function (text) {
              try { return JSON.parse(text); }
              catch (_) { throw new Error('HTTP ' + r.status); }
            });
          })
          .then(function (data) {
            if (data.ok) {
              // Session is already set. Do NOT gate /ask on email verification.
              closeAuthModal();
              appendVerifyNote(email);
              runPostAuthIntent();
            } else if (data.suggestion) {
              showAuthError(data.error || 'Please check your email and try again.');
              resetAuthButtons();
            } else {
              showAuthError(data.error || 'Signup failed.');
              resetAuthButtons();
            }
          })
          .catch(function () {
            showAuthError('Network error. Please try again.');
            resetAuthButtons();
          });
      }

      function doLogin(email, password, token) {
        fetch('/api/auth/login', {
          method: 'POST', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email, password: password, turnstileToken: token }),
        })
          .then(function (r) {
            return r.text().then(function (text) {
              try { return JSON.parse(text); }
              catch (_) { throw new Error('HTTP ' + r.status); }
            });
          })
          .then(function (data) {
            if (data.ok) {
              closeAuthModal();
              runPostAuthIntent();
            } else {
              showAuthError(data.error || 'Sign in failed.');
              resetAuthButtons();
            }
          })
          .catch(function () {
            showAuthError('Network error. Please try again.');
            resetAuthButtons();
          });
      }

      // Small inline note in the thread after signup (verification link sent).
      function appendVerifyNote(email) {
        var wrap = document.createElement('div');
        wrap.className = 'ask-verify-note';
        wrap.innerHTML = '<p>We sent a verification link to ' + escapeHtml(email) + '. You can keep asking in the meantime.</p>';
        thread.appendChild(wrap);
      }

      // Auto-submit when arriving with ?q=<query> in the URL.
      // Trims, caps to the 500-char input limit, pre-fills, and runs once on load.
      // Also the return path for the Google OAuth flow (redirect carries ?q=).
      try {
        var q = new URLSearchParams(window.location.search).get('q');
        if (q) {
          q = q.trim().slice(0, 500);
          if (q) {
            input.value = q;
            updateCount();
            runAsk(q);
          }
        }
      } catch (e) { /* URLSearchParams unavailable -- silently skip */ }
    })();
  </script>
</BaseLayout>

<style is:global>
