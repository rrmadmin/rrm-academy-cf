---
/**
 * RenditionQuiz: secondary "Quiz" tab panel for the course step player
 * (Honen Phase 1). Used ONLY when a quiz is a SECONDARY format on a non-quiz
 * step. The PRIMARY quiz step keeps its own #quiz-container block driven by the
 * existing quiz script (dual-read against /api/courses/quiz). This panel lazy-
 * fetches GET /api/courses/rendition?format=quiz (questions nested under
 * data.quiz, correctIndex already stripped) and reuses the global .qq / .qo /
 * .qr-card question styles. A secondary-tab attempt POSTs /api/courses/quiz but
 * never gates step completion. Scoped via data-* selectors so it never collides
 * with the primary quiz block's ids.
 */
interface Props {
  stepId: string;
}
const { stepId } = Astro.props;
---
<div class="rendition-panel" role="tabpanel" data-rendition-panel="quiz" data-rendition-step={stepId} hidden>
  <div class="rendition-loading" data-rendition-loading>
    <div class="rendition-spinner"></div>
    <p>Loading…</p>
  </div>

  <div class="rquiz" data-rquiz hidden>
    <div class="quiz-header">
      <h2 class="quiz-header__title" data-rquiz-title></h2>
      <p class="quiz-header__desc" data-rquiz-desc></p>
      <div class="quiz-header__meta" data-rquiz-meta></div>
    </div>
    <div class="quiz-questions" data-rquiz-questions></div>
    <div class="quiz-footer">
      <button type="button" class="btn btn--primary btn--lg" data-rquiz-submit disabled>Submit Answers</button>
      <p class="quiz-footer__hint" data-rquiz-hint></p>
    </div>
  </div>

  <div class="rquiz-results" data-rquiz-results hidden></div>
  <div class="rendition-message" data-rendition-message hidden></div>
</div>

<style>
  .rendition-panel[hidden] { display: none; }
  .rquiz, .rquiz-results {
    padding: var(--space-8) var(--space-6);
    max-width: 680px;
    margin: 0 auto;
  }
  .rendition-loading {
    text-align: center;
    padding: var(--space-12) 0;
    color: var(--text-tertiary);
    font-size: 0.875rem;
  }
  .rendition-spinner {
    width: 28px;
    height: 28px;
    border: 3px solid var(--neutral-200);
    border-top-color: var(--accent);
    border-radius: 50%;
    margin: 0 auto var(--space-3);
    animation: rqspin 0.7s linear infinite;
  }
  @keyframes rqspin { to { transform: rotate(360deg); } }
  .rendition-message {
    text-align: center;
    padding: var(--space-12) var(--space-6);
    color: var(--text-muted);
    font-size: 0.875rem;
    max-width: var(--max-width-article);
    margin: 0 auto;
  }
  @media (max-width: 768px) {
    .rquiz, .rquiz-results { padding: var(--space-6) var(--space-4); }
  }
</style>
