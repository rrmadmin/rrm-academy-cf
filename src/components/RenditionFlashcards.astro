---
/**
 * RenditionFlashcards: secondary "Cards" tab panel for the course step player
 * (Honen Phase 1). Empty shell; the player's inline script lazy-fetches
 * GET /api/courses/rendition?format=flashcards on first activation, then drives
 * one-card-at-a-time flip / prev / next / shuffle and got-it/again piles. Pile
 * state persists in localStorage keyed flashcards:<userId>:<stepId>, cleared on
 * logout. Markup + styles only; never an access input.
 */
interface Props {
  stepId: string;
}
const { stepId } = Astro.props;
---
<div class="rendition-panel" role="tabpanel" data-rendition-panel="flashcards" data-rendition-step={stepId} hidden>
  <div class="rendition-loading" data-rendition-loading>
    <div class="rendition-spinner"></div>
    <p>Loading…</p>
  </div>

  <div class="flashcards" data-flashcards hidden>
    <div class="flashcards__top">
      <span class="flashcards__progress" data-fc-progress>1 / 1</span>
      <button type="button" class="flashcards__shuffle" data-fc-shuffle>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 3 21 3 21 8"/><line x1="4" y1="20" x2="21" y2="3"/><polyline points="21 16 21 21 16 21"/><line x1="15" y1="15" x2="21" y2="21"/><line x1="4" y1="4" x2="9" y2="9"/></svg>
        Shuffle
      </button>
    </div>

    <button type="button" class="flashcard" data-fc-card aria-live="polite">
      <div class="flashcard__inner" data-fc-inner>
        <div class="flashcard__face flashcard__face--front">
          <span class="flashcard__hint">Front</span>
          <p class="flashcard__text" data-fc-front></p>
        </div>
        <div class="flashcard__face flashcard__face--back">
          <span class="flashcard__hint">Back</span>
          <p class="flashcard__text" data-fc-back></p>
        </div>
      </div>
    </button>
    <p class="flashcard__flip-hint">Tap the card to flip</p>

    <div class="flashcards__piles">
      <button type="button" class="flashcards__pile flashcards__pile--again" data-fc-again>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
        Again <span class="flashcards__pile-count" data-fc-again-count>0</span>
      </button>
      <button type="button" class="flashcards__pile flashcards__pile--gotit" data-fc-gotit>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        Got it <span class="flashcards__pile-count" data-fc-gotit-count>0</span>
      </button>
    </div>

    <div class="flashcards__nav">
      <button type="button" class="btn btn--secondary flashcards__prev" data-fc-prev>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        Previous
      </button>
      <button type="button" class="btn btn--secondary flashcards__next" data-fc-next>
        Next
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>
  </div>

  <div class="rendition-message" data-rendition-message hidden></div>
</div>

<style>
  .rendition-panel[hidden] { display: none; }
  .flashcards {
    padding: var(--space-8) var(--space-6);
    max-width: 560px;
    margin: 0 auto;
  }
  .flashcards__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }
  .flashcards__progress {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .flashcards__shuffle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    background: none;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-3);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-secondary);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .flashcards__shuffle:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .flashcard {
    display: block;
    width: 100%;
    border: none;
    background: none;
    padding: 0;
    perspective: 1200px;
    cursor: pointer;
  }
  .flashcard__inner {
    position: relative;
    width: 100%;
    min-height: 220px;
    transition: transform 0.45s;
    transform-style: preserve-3d;
  }
  .flashcard--flipped .flashcard__inner {
    transform: rotateY(180deg);
  }
  .flashcard__face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-8) var(--space-6);
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  .flashcard__face--back {
    transform: rotateY(180deg);
    background: var(--purple-50);
    border-color: var(--purple-200);
  }
  .flashcard__hint {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-tertiary);
  }
  .flashcard__text {
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.3;
    color: var(--text-primary);
    text-align: center;
    margin: 0;
  }
  .flashcard__flip-hint {
    text-align: center;
    font-size: 0.75rem;
    color: var(--text-tertiary);
    margin: var(--space-3) 0 var(--space-5);
  }

  .flashcards__piles {
    display: flex;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }
  .flashcards__pile {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--bg-surface);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-secondary);
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, color 0.15s;
  }
  .flashcards__pile--again:hover {
    border-color: var(--sand-500);
    color: var(--sand-700);
  }
  .flashcards__pile--gotit:hover {
    border-color: var(--sage-500);
    color: var(--sage-700);
  }
  .flashcards__pile-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: var(--radius-pill);
    background: var(--neutral-100);
    font-size: 0.6875rem;
    font-weight: 600;
  }

  .flashcards__nav {
    display: flex;
    gap: var(--space-3);
  }
  .flashcards__nav .btn {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
  }

  .rendition-loading {
    text-align: center;
    padding: var(--space-12) 0;
    color: var(--text-tertiary);
    font-size: 0.875rem;
  }
  .rendition-spinner {
    width: 28px;
    height: 28px;
    border: 3px solid var(--neutral-200);
    border-top-color: var(--accent);
    border-radius: 50%;
    margin: 0 auto var(--space-3);
    animation: rendition-spin 0.7s linear infinite;
  }
  @keyframes rendition-spin { to { transform: rotate(360deg); } }
  .rendition-message {
    text-align: center;
    padding: var(--space-12) var(--space-6);
    color: var(--text-muted);
    font-size: 0.875rem;
    max-width: var(--max-width-article);
    margin: 0 auto;
  }
  @media (max-width: 768px) {
    .flashcards { padding: var(--space-6) var(--space-4); }
  }
</style>
