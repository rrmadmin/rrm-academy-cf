---
import type { Article } from '../lib/airtable';
import { abstractSnippet } from '../lib/abstract-snippet.mjs';

interface Props {
  article: Article;
  compact?: boolean;
  basePath?: string;
  /** Layout variant.
   *  - 'card' (default) — outlined sheet in a grid (homepage rails, related lists)
   *  - 'list'  — single-column editorial row: large Cormorant title, category
   *    eyebrow + leaf chips above it, full author string, journal/PMID citation
   *    line, hairline divider, no card chrome. Used on browse + topic-hub pages
   *    (2026-07-13). All Zotero/COinS, access-badge and data-* hooks are shared
   *    with the card variant — do not fork this into a separate component. */
  variant?: 'card' | 'list';
}

const { article, compact = false, basePath = '/library/', variant = 'card' } = Astro.props;
const isList = variant === 'list';
const href = `${basePath}${article.slug}/`;
const truncLen = compact ? 120 : 200;
const truncatedAbstract = article.abstract
  ? article.abstract.slice(0, truncLen) + (article.abstract.length > truncLen ? '...' : '')
  : '';

// Parse short citation parts. Year is always rendered as its own
// non-truncating span so it survives ellipsis on long author strings
// (e.g. "Practice Committee of the American Society for Reproductive
// Medicine, 2026" would otherwise truncate before the year).
const firstAuthor = article.authors?.split(';')[0]?.split(',')[0]?.trim() || '';
const yearStr = article.year ? String(article.year) : '';
let authorsForDisplay = '';
if (article.shortCitation) {
  // Strip a trailing ", YYYY" or " YYYY" so the year span isn't duplicated.
  authorsForDisplay = article.shortCitation.replace(/[,\s]+\d{4}\.?\s*$/, '').trim();
} else if (firstAuthor) {
  authorsForDisplay = `${firstAuthor}${article.authors?.includes(';') ? ' et al.' : ''}`;
}

// Show journal if available
const journalDisplay = article.journal || article.journalAbbv || '';

// Build COinS (ContextObjects in Spans) for Zotero multi-select
function buildCOinS(a: Article): string {
  const params: string[] = [
    'ctx_ver=Z39.88-2004',
    'rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal',
    'rft.genre=article',
  ];
  if (a.title) params.push('rft.atitle=' + encodeURIComponent(a.title));
  if (a.journal) params.push('rft.jtitle=' + encodeURIComponent(a.journal));
  if (a.volume) params.push('rft.volume=' + encodeURIComponent(a.volume));
  if (a.issue) params.push('rft.issue=' + encodeURIComponent(a.issue));
  if (a.pages) {
    const [sp, ep] = a.pages.split(/[-–]/);
    if (sp) params.push('rft.spage=' + encodeURIComponent(sp.trim()));
    if (ep) params.push('rft.epage=' + encodeURIComponent(ep.trim()));
  }
  if (a.datePublished) params.push('rft.date=' + encodeURIComponent(a.datePublished));
  else if (a.year) params.push('rft.date=' + encodeURIComponent(String(a.year)));
  // Authors
  const authors = a.authors?.split(';').map(s => s.trim()).filter(Boolean) || [];
  authors.forEach(au => params.push('rft.au=' + encodeURIComponent(au)));
  // Identifiers
  if (a.doi) params.push('rft_id=' + encodeURIComponent('info:doi/' + a.doi));
  if (a.pmid) params.push('rft_id=' + encodeURIComponent('info:pmid/' + a.pmid));
  return params.join('&');
}

const coinsTitle = buildCOinS(article);

// --- list-variant derived fields ---
// Topics are stored as hierarchical breadcrumbs ("Endometriosis > Comorbidities
// > Cardiometabolic Risk"). Eyebrow = top-level category of the first topic;
// chips = the LEAF of each distinct path (short), deduped, max 3.
const topicLeaf = (t: string) => t.split('>').pop()?.trim() || t;
const topicRoot = (t: string) => t.split('>')[0]?.trim() || t;
const listEyebrow = article.topics?.length ? topicRoot(article.topics[0]) : 'Research';
const listSeen = new Set<string>();
const listChips = (article.topics ?? [])
  .map(topicLeaf)
  .filter((t) => t && t !== listEyebrow && !listSeen.has(t) && (listSeen.add(t), true))
  .slice(0, 3);
// Meta line (treatment C, approved 2026-07-13): "Schliep KC et al., 2026 ·
// J Gynecol Obstet Hum Reprod" + a 2-line abstract snippet. Rationale: the meta
// line must answer "should I click this?" — a full author list never does. The
// journal carries the credibility signal, so it gets the italic serif and the
// authors/year stay quiet. PMID (75% coverage) and volume:pages are citation
// apparatus, not scan signals — they live on the detail page. Do not re-add.
// Coverage: shortCitation 100%, journalAbbv 87% (journal 96% fallback),
// abstract 89%.
const listShortCite =
  article.shortCitation ||
  [authorsForDisplay, yearStr].filter(Boolean).join(', ');
const listJournal = article.journalAbbv || article.journal || '';
// Strip the leading structured-abstract label so the snippet opens on a real
// sentence. Vocabulary derived from the actual corpus (top labels by frequency:
// OBJECTIVE 581, BACKGROUND 468, PURPOSE 62, INTRODUCTION 58, STUDY QUESTION 55,
// CONTEXT 36, IMPORTANCE 28, ...). Matches an optional "X and Y" / "X/Y" compound
// and a trailing plural, e.g. "BACKGROUND AND OBJECTIVES:", "BACKGROUND/AIMS:".
// Label-stripping lives in src/lib/abstract-snippet.mjs (single source of truth,
// shared with scripts/gates/validate-abstract-snippets.mjs).
const listSnippet = abstractSnippet(article.abstract);
---
{isList ? (
<article class="article-row" data-article-card data-slug={article.slug} data-title={article.title || ''}>
  <span class="Z3988" title={coinsTitle}></span>

  <div class="article-row__meta">
    <span class="article-row__eyebrow">{listEyebrow}</span>
    {listChips.map((t) => <span class="article-row__chip">{t}</span>)}
    {article.accessLevel === 'open' && (
      <span class="access-badge access-badge--open article-row__access" title={article.oaType ? `${article.oaType} Open Access` : 'Open Access'}>
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/></svg>
        Open Access
      </span>
    )}
    {article.accessLevel === 'free' && (
      <span class="access-badge access-badge--free article-row__access" title="Free to Read (Bronze OA)">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/></svg>
        Free to Read
      </span>
    )}
    {article.accessLevel === 'restricted' && article.isCopyrighted && (
      <span class="access-badge access-badge--restricted article-row__access" title="Restricted">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      </span>
    )}
  </div>

  <h3 class="article-row__title">
    <a href={href} class="article-row__link">{article.title}</a>
  </h3>

  {(listShortCite || listJournal) && (
    <p class="article-row__line">
      {listShortCite && <span class="article-row__cite">{listShortCite}</span>}
      {listShortCite && listJournal && <span class="article-row__sep" aria-hidden="true">·</span>}
      {listJournal && <span class="article-row__journal">{listJournal}</span>}
    </p>
  )}
  {listSnippet && <p class="article-row__snippet">{listSnippet}</p>}
</article>
) : (
<article class:list={['article-card', { 'article-card--compact': compact }]} data-article-card data-slug={article.slug} data-title={article.title || ''}>
  <span class="Z3988" title={coinsTitle}></span>
  <a href={href} class="article-card__link">
    <h3 class="article-card__title">{article.title}</h3>
  </a>

  <div class="article-card__meta">
    <span class="article-card__authors">{authorsForDisplay}</span>
    {yearStr && <span class="article-card__year">{yearStr}</span>}
    {article.accessLevel === 'open' && (
      <span class="access-badge access-badge--open" title={article.oaType ? `${article.oaType} Open Access` : 'Open Access'}>
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/></svg>
        Open Access
      </span>
    )}
    {article.accessLevel === 'free' && (
      <span class="access-badge access-badge--free" title="Free to Read (Bronze OA)">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/></svg>
        Free to Read
      </span>
    )}
    {article.accessLevel === 'restricted' && article.isCopyrighted && (
      <span class="access-badge access-badge--restricted" title="Restricted">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      </span>
    )}
    {journalDisplay && (
      <span class="article-card__journal">{journalDisplay}</span>
    )}
  </div>

  {!compact && truncatedAbstract && (
    <p class="article-card__abstract">{truncatedAbstract}</p>
  )}

  {!compact && article.topics.length > 0 && (
    <div class="article-card__topics">
      {article.topics.slice(0, 3).map(t => {
        const leaf = t.split('>').pop()?.trim() || t;
        return <span class="article-card__topic" title={t}>{leaf}</span>;
      })}
    </div>
  )}
</article>
)}

<style>
  /* Full card — outlined sheet matching the library homepage Recently Published
     cards: 1px border, hover lifts + tints border with the accent. */
  .article-card {
    position: relative;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    transition: border-color 0.15s, transform 0.15s, box-shadow 0.2s;
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
  }
  .article-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    cursor: pointer;
  }
  .article-card:focus-within {
    border-color: var(--purple-700);
    box-shadow: 0 0 0 3px var(--focus-ring);
  }

  .article-card__link {
    text-decoration: none;
    color: inherit;
  }
  .article-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .article-card__link:hover {
    text-decoration: none;
  }

  .article-card__title {
    font-family: 'Cormorant Garamond', 'Georgia', serif;
    font-weight: 600;
    font-size: 1.125rem;
    line-height: 1.3;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
    transition: color 0.15s;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .article-card:hover .article-card__title {
    color: var(--accent);
  }

  .article-card__meta {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: var(--space-1);
    margin-bottom: var(--space-3);
    font-size: 0.75rem;
    line-height: 1.5;
    min-width: 0;
    white-space: nowrap;
  }
  .article-card__authors {
    color: var(--text-secondary);
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }
  /* Year is rendered as its own span so it never truncates with the
     authors string. Authors get ellipsis; year is always visible. */
  .article-card__year {
    color: var(--text-secondary);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
    white-space: nowrap;
  }
  .article-card__year::before {
    content: ', ';
    color: var(--text-secondary);
  }
  .article-card__journal {
    color: var(--text-secondary);
    font-style: italic;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .article-card__journal::before {
    content: '\b7';
    margin-right: var(--space-1);
    font-style: normal;
    color: var(--text-muted);
  }

  .article-card__abstract {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-3);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .article-card__topics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .article-card__topic {
    font-size: 0.625rem;
    font-weight: 500;
    color: var(--text-secondary);
    background: var(--neutral-100);
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
    max-width: 100%;
  }

  /* Compact variant — clean text row */
  .article-card--compact {
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--border-light);
    border-radius: 0;
    padding: var(--space-3) 0;
  }
  .article-card--compact:hover {
    border-color: var(--border-light);
    transform: none;
    box-shadow: none;
  }
  .article-card--compact .article-card__title {
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.4;
    margin-bottom: var(--space-1);
  }
  .article-card--compact .article-card__meta {
    margin-bottom: 0;
    font-size: 0.6875rem;
  }

  /* ── List variant (variant="list") ──────────────────────────────────────
     Single-column editorial row: no card chrome, large Cormorant title,
     category eyebrow + leaf chips above it, full author string, citation
     line, hairline divider. Parent supplies the column width; the row owns
     its own vertical rhythm and separator. */
  .article-row {
    padding: var(--space-10) 0;
    border-bottom: 1px solid var(--border-light);
  }
  .article-row:last-child {
    border-bottom: none;
  }

  .article-row__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }
  .article-row__eyebrow {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-right: var(--space-1);
  }
  .article-row__chip {
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--neutral-700);
    background: var(--white);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    border: 1px solid var(--neutral-200);
  }
  .article-row__access {
    margin-left: auto;
  }

  .article-row__title {
    font-family: 'Cormorant Garamond', 'Georgia', serif;
    font-size: clamp(1.5rem, 1.25rem + 1.25vw, 2rem);
    font-weight: 600;
    line-height: 1.2;
    margin: 0 0 var(--space-3);
  }
  .article-row__link {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.15s;
  }
  .article-row__link:hover {
    color: var(--accent);
  }
  .article-row__link:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px var(--focus-ring);
    border-radius: var(--radius-sm);
  }

  /* Meta line: quiet authors/year, journal carries the credibility signal so it
     gets the italic serif and the primary text colour. */
  .article-row__line {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .article-row__cite {
    color: var(--text-secondary);
    font-weight: 500;
  }
  .article-row__sep {
    color: var(--neutral-300);
  }
  .article-row__journal {
    font-family: 'Cormorant Garamond', 'Georgia', serif;
    font-style: italic;
    font-size: 1rem;
    color: var(--text-primary);
  }
  .article-row__snippet {
    margin: var(--space-3) 0 0;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .article-row {
      padding: var(--space-8) 0;
    }
    .article-row__access {
      margin-left: 0;
    }
  }
</style>
