---
// Recognition strip for Uterus Super Hero members ($99/mo Save the Uterus Club
// tier, which promises logo placement). Follows the homepage journal trust-bar
// pattern: quiet tagline, bare muted logos on the page background, no box.
// Data-driven from superheroes.json so adding a supporter is a JSON edit.
import superheroes from '../data/superheroes.json';

interface Props {
  heading?: string;
}

const { heading = 'Supported by our Uterus Super Heroes' } = Astro.props;
---
{superheroes.length > 0 && (
  <section class="shl" aria-labelledby="shl-heading" data-pagefind-ignore>
    <p id="shl-heading" class="shl__tagline">{heading}</p>
    <ul class="shl__logos">
      {superheroes.map((s) => (
        <li class="shl__cell">
          <a href={s.url} target="_blank" rel="noopener" class="shl__link" title={`${s.name}, ${s.org}`}>
            <img
              src={s.logo}
              alt={`${s.org} logo`}
              class={`shl__logo shl__logo--${s.logoShape}`}
              loading="lazy"
              decoding="async"
            />
          </a>
        </li>
      ))}
    </ul>
    <p class="shl__cta"><a href="/save-the-uterus-club/">Become a Super Hero</a></p>
  </section>
)}

<style>
  .shl {
    text-align: center;
    padding: var(--space-6) 0;
  }

  .shl__tagline {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    letter-spacing: 0.01em;
    margin: 0 0 var(--space-4);
  }

  .shl__logos {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3) var(--space-8);
    flex-wrap: wrap;
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
  }
  .shl__cell {
    display: block;
  }
  .shl__link {
    display: inline-flex;
    align-items: center;
  }
  .shl__link:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px var(--focus-ring);
    border-radius: var(--radius-sm);
  }

  /* Muted at rest, full color on hover (sponsor-strip convention) */
  .shl__logo {
    display: block;
    filter: grayscale(1);
    opacity: 0.65;
    transition: filter 0.2s, opacity 0.2s;
  }
  .shl__link:hover .shl__logo {
    filter: none;
    opacity: 1;
  }

  .shl__logo--square {
    width: 44px;
    height: 44px;
  }
  .shl__logo--wide {
    width: 150px;
    height: auto;
  }

  /* Dark mode: invert the grayscaled marks so they read as light-gray on dark */
  :global([data-theme="dark"]) .shl__logo {
    filter: grayscale(1) invert(0.85);
    opacity: 0.7;
  }
  :global([data-theme="dark"]) .shl__link:hover .shl__logo {
    filter: none;
    opacity: 1;
  }

  .shl__cta {
    font-size: 0.8125rem;
    margin: 0;
  }
  .shl__cta a {
    color: var(--accent);
    text-decoration: none;
  }
  .shl__cta a:hover {
    text-decoration: underline;
  }

  @media (max-width: 480px) {
    .shl__logos {
      gap: var(--space-3) var(--space-6);
    }
    .shl__logo--wide {
      width: 128px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shl__logo {
      transition: none;
    }
  }
</style>
