---
interface Props {
  apa: string;
  vancouver: string;
  mla: string;
}
const { apa, vancouver, mla } = Astro.props;
const hasCitations = apa || vancouver || mla;

// Stored citation strings mark italics with markdown asterisks (*Journal*).
// Render them as real <em> (escaping everything else); strip the asterisks
// from the copied plain text, where they are not valid citation syntax.
const escapeHtml = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const citationHtml = (s: string) =>
  escapeHtml(s).replace(/\*([^*]+)\*/g, '<em>$1</em>');
const citationText = (s: string) => s.replace(/\*([^*]+)\*/g, '$1');
---
{hasCitations && (
  <div class="citation-tabs" data-citation-tabs>
    <div class="citation-tab-bar" role="tablist">
      {apa && (
        <button
          role="tab"
          class="citation-tab active"
          aria-selected="true"
          data-tab="apa"
        >APA 7th</button>
      )}
      {vancouver && (
        <button
          role="tab"
          class="citation-tab"
          aria-selected={!apa ? "true" : "false"}
          data-tab="vancouver"
        >Vancouver</button>
      )}
      {mla && (
        <button
          role="tab"
          class="citation-tab"
          aria-selected={!apa && !vancouver ? "true" : "false"}
          data-tab="mla"
        >MLA 9th</button>
      )}
    </div>
    {apa && (
      <div role="tabpanel" class="citation-panel" data-panel="apa">
        <p set:html={citationHtml(apa)} />
        <button class="citation-copy-btn" data-copy={citationText(apa)}>
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          Copy
        </button>
      </div>
    )}
    {vancouver && (
      <div role="tabpanel" class="citation-panel" data-panel="vancouver" hidden={!!apa}>
        <p set:html={citationHtml(vancouver)} />
        <button class="citation-copy-btn" data-copy={citationText(vancouver)}>
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          Copy
        </button>
      </div>
    )}
    {mla && (
      <div role="tabpanel" class="citation-panel" data-panel="mla" hidden={!!(apa || vancouver)}>
        <p set:html={citationHtml(mla)} />
        <button class="citation-copy-btn" data-copy={citationText(mla)}>
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          Copy
        </button>
      </div>
    )}
  </div>
)}

<script>
  document.querySelectorAll('[data-citation-tabs]').forEach(container => {
    const tabs = container.querySelectorAll('[role="tab"]');
    const panels = container.querySelectorAll('[role="tabpanel"]');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = (tab as HTMLElement).dataset.tab;
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');
        panels.forEach(p => {
          const panel = p as HTMLElement;
          panel.hidden = panel.dataset.panel !== target;
        });
      });
    });
  });

  document.querySelectorAll('.citation-copy-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      if ((btn as HTMLButtonElement).disabled) return;
      (btn as HTMLButtonElement).disabled = true;
      const text = (btn as HTMLElement).dataset.copy || '';
      const original = btn.innerHTML;
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = 'Copied!';
      } catch {
        btn.textContent = 'Copy failed';
      }
      setTimeout(() => {
        btn.innerHTML = original;
        (btn as HTMLButtonElement).disabled = false;
      }, 1500);
    });
  });
</script>
