    ".mss-modal__results .mss-groups[data-active-filter=\"Course\"] .mss-group[data-group-type=\"Course\"],\n" +
    ".mss-modal__results .mss-groups[data-active-filter=\"Article\"] .mss-group[data-group-type=\"Article\"],\n" +
    ".mss-modal__results .mss-groups[data-active-filter=\"Research\"] .mss-group[data-group-type=\"Research\"] {\n" +
    "  display: block;\n" +
    "}\n" +
    ".mss-modal__results .mss-groups[data-active-filter]:not([data-active-filter=\"all\"]) .mss-show-all {\n" +
    "  display: none;\n" +
    "}\n" +
    "\n" +
    ".mss-modal__results .mss-show-all {\n" +
    "  display: block;\n" +
    "  width: 100%;\n" +
    "  margin-top: var(--space-3);\n" +
    "  padding: 9px 14px;\n" +
    "  font-family: 'Inter', sans-serif;\n" +
    "  font-size: 0.8125rem;\n" +
    "  font-weight: 500;\n" +
    "  color: var(--text-secondary);\n" +
    "  background: var(--bg-surface);\n" +
    "  border: 1px solid var(--border-color);\n" +
    "  border-radius: var(--radius-pill);\n" +
    "  cursor: pointer;\n" +
    "  text-align: left;\n" +
    "}\n" +
    ".mss-modal__results .mss-show-all:active {\n" +
    "  color: var(--accent);\n" +
    "  border-color: var(--accent);\n" +
    "}\n" +
    "/* Mobile button->field expand is a JS WAAPI FLIP on .mss-modal__field (see script). */\n";
  var _mssLazyCssApplied = false;
  function injectLazyMssCss() {
    if (_mssLazyCssApplied) return;
    var s = document.createElement("style");
    s.id = "mss-lazy-css";
    s.textContent = MSS_LAZY_CSS;
    document.head.appendChild(s);
    _mssLazyCssApplied = true;
  }

  // ── Mobile button->bar expand (WAAPI FLIP) ──────────────────────────────────
  // On mobile, tapping the bar's search button expands it into the full search
  // field: a width + translateX animation on .mss-modal__field from the button's
  // exact box to the field's natural box (NO scale, so nothing distorts; height is
  // a fixed CSS value, so it never varies by font-load). The X is pinned absolute
  // so the width change can't shove it. On desktop this is skipped (plain modal).
  var REDUCE_MOTION = window.matchMedia('(prefers-reduced-motion: reduce)');
  var fieldEl = modal.querySelector('.mss-modal__field'); // the search-bar container (icon + input)
  var lastTriggerEl = null;
  var pendingOpen = false; // true while waiting for the drawer to slide out before opening
  var deferTimer = null;   // handle for the drawer-slide-out defer, so a dismiss can cancel it

  function setExpanded(state) {
    if (trigger) trigger.setAttribute('aria-expanded', state ? 'true' : 'false');
    for (var ai = 0; ai < auxTriggers.length; ai++) auxTriggers[ai].setAttribute('aria-expanded', state ? 'true' : 'false');
  }

  function revealOpen() {
    modal.removeAttribute('hidden');
    setExpanded(true);
    document.documentElement.style.overflow = 'hidden';
    if (!resultsEl.innerHTML) {
      resultsEl.innerHTML = '<p class="mss-hint">Try a topic, condition, or author.</p>';
    }
  }

  function revealClose() {
    modal.setAttribute('hidden', '');
    setExpanded(false);
    document.documentElement.style.overflow = '';
    stopLoadingSpinner();
    // Universal cleanup for EVERY close path — morph, non-morph (desktop / reduced
    // motion), AND the case where canMorph() flipped mid-open because the viewport
    // crossed 768px. Cancel any held field/results animations (a cancelled WAAPI
    // animation never fires 'finish', so finish-handler cleanup can't be relied on)
    // and clear their inline state, so the next open measures a clean natural field
    // and the hint is never stuck hidden.
    fieldEl.getAnimations().forEach(function(a){ try { a.cancel(); } catch (e) {} });
    resultsEl.getAnimations().forEach(function(a){ try { a.cancel(); } catch (e) {} });
    resetFieldInline();
    resultsEl.style.opacity = '';
    resultsEl.style.transform = '';
    // Restore the bar trigger + hamburger that were hidden during the morph.
    if (lastTriggerEl) lastTriggerEl.style.visibility = '';
    var hb = document.querySelector('.mobile-toggle');
    if (hb) hb.style.visibility = ''; // restore the bar hamburger
    var cb = document.getElementById('mss-close');
    if (cb) cb.classList.remove('is-x'); // reset to hamburger for the next open
  }

  function canMorph() {
    // Mobile only — on desktop, keep the previous plain modal open (the sheet's
    // CSS slide-down). The button->field expand is a mobile-bar interaction.
    return !REDUCE_MOTION.matches
      && typeof fieldEl.animate === 'function'
      && window.matchMedia('(max-width: 768px)').matches;
  }

  // The expand is a slide-like motion, so it uses the screen-slides house curve
  // (more even than the reveal curve, which front-loaded and finished too fast).
  var EASE_SLIDE = 'cubic-bezier(0.32, 0.72, 0, 1)';

  // Clear any inline sizing left on the field so getBoundingClientRect() reads its
  // natural (flex) box again.
  function resetFieldInline() {
    fieldEl.style.flex = '';
    fieldEl.style.width = '';
    fieldEl.style.height = '';
    fieldEl.style.overflow = '';
    fieldEl.style.transform = '';
  }

  // FLIP via real WIDTH/HEIGHT + translateX (NOT scale) so nothing distorts. The
  // field grows from the trigger button's exact box to its natural box. The X is
  // pinned absolute (CSS) so the width change never shoves it. The magnifier icon
  // sits at the field's left edge, so it travels in from the button position for
  // free as the box widens. expand=true grows; false collapses.
  function flipField(expand) {
    // Cancel any in-flight / fill-holding field+input animations FIRST. With
    // fill:'both', a finished close animation keeps holding the field at button
    // width, so the next open measured 42px and animated 42->42 (instant, no
    // expand). Cancelling returns the field to its natural box for measurement.
    fieldEl.getAnimations().forEach(function(a) { try { a.cancel(); } catch (e) {} });
    var inEl = fieldEl.querySelector('.mss-modal__input');
    if (inEl) inEl.getAnimations().forEach(function(a) { try { a.cancel(); } catch (e) {} });
    resetFieldInline(); // measure the natural box, not a leftover one
    var t = lastTriggerEl.getBoundingClientRect();
    var f = fieldEl.getBoundingClientRect();
    if (!t.width || !f.width) return null;
    // Animate width + position only. Height is a FIXED CSS value (see mobile block)
    // so it never varies between the first open (font still loading -> taller) and
    // later opens. Measuring height here was the "taller first time" bug.
    var smallKey = { width: t.width + 'px', transform: 'translateX(' + (t.left - f.left) + 'px)' };
    var fullKey = { width: f.width + 'px', transform: 'translateX(0px)' };
    fieldEl.style.flex = 'none';
    fieldEl.style.overflow = 'hidden';
    // Same duration both ways — the 480ms expand stretched the slide curve's dead
    // tail into a visible "crawl to full" (struggle); 340ms matches the clean close.
    var dur = 340;
    var inp = fieldEl.querySelector('.mss-modal__input');
    if (inp) {
      // Placeholder is revealed by the widening box; a short fade keeps it from
      // snapping in while the box is still narrow.
      var fade = expand ? [{ opacity: 0, offset: 0 }, { opacity: 0, offset: 0.45 }, { opacity: 1, offset: 1 }]
                        : [{ opacity: 1 }, { opacity: 0 }];
      inp.animate(fade, { duration: dur, easing: 'ease-out', fill: 'both' })
        .addEventListener('finish', function() { inp.style.opacity = ''; });
    }
    return fieldEl.animate(expand ? [smallKey, fullKey] : [fullKey, smallKey],
      { duration: dur, easing: EASE_SLIDE, fill: 'both' });
  }

  function openModal(srcEl) {
    if (!modal.hasAttribute('hidden') || pendingOpen) return;
    injectLazyMssCss();
    lastFocus = document.activeElement;
    lastTriggerEl = (srcEl && srcEl.nodeType === 1) ? srcEl : trigger;
    // If the mobile drawer is open, close it FIRST and let it slide out at its
    // normal speed (same as tapping the X) before the search opens — otherwise the
    // modal covers the drawer mid-slide and it looks like it vanished instantly.
    var navToggle = document.getElementById('nav-toggle');
    var wasDrawerOpen = !!(navToggle && navToggle.checked);
    if (wasDrawerOpen) navToggle.checked = false;
    // Preload Pagefind on open so first keystroke is instant
    ensurePagefind().catch(function(){});

    var proceed = function() {
      revealOpen();
      // Close button starts as a hamburger and rotates into an X (drawer-style
      // transform, not a blip). rAF so the transition runs from the displayed state.
      var closeBtn = document.getElementById('mss-close');
      if (closeBtn) {
        closeBtn.classList.remove('is-x');
        requestAnimationFrame(function() { closeBtn.classList.add('is-x'); });
      }
      if (canMorph() && lastTriggerEl && fieldEl) {
        // Hide the real bar button + hamburger so they don't show as static
        // duplicates behind the modal (the field reads AS the button growing).
        lastTriggerEl.style.visibility = 'hidden';
        var hb = document.querySelector('.mobile-toggle');
        if (hb) hb.style.visibility = 'hidden';
        var anim = flipField(true);
        if (anim) anim.addEventListener('finish', resetFieldInline);
        // The modal BG is already there (sheet shows instantly). The body WORDS
        // slide down only AFTER the bar finishes expanding (delay = the expand
        // duration), so they appear to drop out of the now-open search bar.
        // fill:backwards holds the offset+hidden start through the delay.
        resultsEl.getAnimations().forEach(function(a){ try { a.cancel(); } catch (e) {} });
        resultsEl.animate(
          [{ transform: 'translateY(-16px)', opacity: 0 }, { transform: 'translateY(0)', opacity: 1 }],
          { duration: 300, easing: EASE_SLIDE, delay: 340, fill: 'backwards' }
        );
        // Guard: if the modal was closed during the wait, don't focus a hidden input
        // (it would steal focus from the restored lastFocus).
        setTimeout(function() { if (!modal.hasAttribute('hidden')) input.focus(); }, 340);
      } else {
        // Defer focus so the dialog is painted first (avoids iOS keyboard jank)
        setTimeout(function() { if (!modal.hasAttribute('hidden')) input.focus(); }, 30);
      }
    };

    // 280ms matches the drawer's slide-out transition (.main-nav transform 0.28s).
    if (wasDrawerOpen) {
      pendingOpen = true;
      deferTimer = setTimeout(function() { pendingOpen = false; deferTimer = null; proceed(); }, 280);
    } else {
      proceed();
    }
  }

  // Cancel a queued drawer->search open (during the 280ms defer). Returns true if
  // it cancelled one, so callers can stop (the modal isn't open yet).
  function cancelPendingOpen() {
    if (!pendingOpen) return false;
    pendingOpen = false;
    if (deferTimer) { clearTimeout(deferTimer); deferTimer = null; }
    return true;
  }

  function closeModal() {
    // A dismiss during the drawer->search defer cancels the queued open.
    if (cancelPendingOpen()) return;
    if (modal.hasAttribute('hidden')) return;
    // X rotates back into the hamburger (transform, not blip).
    var cb = document.getElementById('mss-close');
    if (cb) cb.classList.remove('is-x');
    if (canMorph() && lastTriggerEl && fieldEl) {
      // Body words slide up + fade out IMMEDIATELY (concurrent with the bar slide-
      // back), so the modal starts disappearing on X-click instead of vanishing only
      // after the bar finishes. fill:forwards holds it hidden until the modal closes.
      resultsEl.getAnimations().forEach(function(a){ try { a.cancel(); } catch (e) {} });
      resultsEl.animate(
        [{ transform: 'translateY(0)', opacity: 1 }, { transform: 'translateY(-12px)', opacity: 0 }],
        { duration: 200, easing: 'ease-in', fill: 'forwards' }
      );
      var anim = flipField(false);
      // revealClose() now owns all field/results animation-cancel + inline reset
      // (the universal cleanup), so done() just hides + restores focus.
      var done = function() {
        revealClose();
        if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
      };
      if (anim) anim.addEventListener('finish', done);
      else done();
    } else {
      revealClose();
      if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
    }
  }

  if (trigger) trigger.addEventListener('click', function(e) { openModal(e.currentTarget); });
  for (var ti = 0; ti < auxTriggers.length; ti++) {
    auxTriggers[ti].addEventListener('click', function(e) { openModal(e.currentTarget); });
  }

  // Close on backdrop or cancel
  modal.addEventListener('click', function(e) {
    var t = e.target;
    if (t && t.closest && t.closest('[data-mss-close]')) {
      closeModal();
    }
  });

  // ESC key. stopPropagation so this consumer alone acts (prevents the Header's
  // drawer-Esc handler from also firing if open-states ever decouple). Also cancels
  // a pending drawer->search open during the defer window.
  document.addEventListener('keydown', function(e) {
    if (e.key !== 'Escape') return;
    if (cancelPendingOpen()) { e.preventDefault(); e.stopPropagation(); return; }
    if (!modal.hasAttribute('hidden')) {
      e.preventDefault();
      e.stopPropagation();
      closeModal();
    }
  });

  function startLoadingSpinner() {
    stopLoadingSpinner();
    resultsEl.innerHTML = '<p class="mss-loading">Searching <span class="mss-loading-spinner"></span></p>';
    var el = resultsEl.querySelector('.mss-loading-spinner');
    if (!el) return;
    var fi = 0;
    el.textContent = waveFrames[0];
    spinnerTimer = setInterval(function() {
      fi = (fi + 1) % waveFrames.length;
      el.textContent = waveFrames[fi];
    }, 160);
  }
  function stopLoadingSpinner() {
    if (spinnerTimer) { clearInterval(spinnerTimer); spinnerTimer = null; }
  }

  function beaconQuery(query, resultsCount) {
    if (!query || query.length < 2 || query.length > 500) return;
    if (query === lastBeaconedQuery) return;
    lastBeaconedQuery = query;
    try {
      fetch('/api/search/log', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ query: query, results_count: resultsCount, source: 'pagefind-mobile' }),
        keepalive: true,
        credentials: 'same-origin',
      }).catch(function(){});
    } catch(e) {}
    // GA4 mirror via /api/track. Sends query_length only (PII rule, spec §10).
    track('search_submit', {
      query_length: query.length,
      surface: 'mobile-modal',
      results_count: resultsCount,
    });
  }

  function ensurePagefind() {
    if (!pagefindReady) {
      // Use a runtime-computed string so Rollup doesn't try to statically
      // resolve the path. Pagefind ships /pagefind/pagefind.js at the site
      // root (npx pagefind output), which doesn't exist at Astro build time.
      var pfModulePath = '/' + 'pagefind/pagefind.js';
      pagefindReady = import(/* @vite-ignore */ pfModulePath).catch(function() {
        return fetch('/pagefind/pagefind.js')
          .then(function(r) { return r.text(); })
          .then(function(js) {
            var blob = new Blob([js], { type: 'application/javascript' });
            return import(URL.createObjectURL(blob));
          });
      }).then(function(pf) {
        return pf.options({ basePath: '/pagefind/' }).then(function() { return pf.init(); }).then(function() { return pf; });
      }).catch(function(err) {
        pagefindReady = null;
        throw err;
      });
    }
    return pagefindReady;
  }

  var _engWordRe = /^(the|of|in|and|for|with|a|an|to|from|by|on|at|or|is|are|was|were|after|before|between|during|through|about|into|over|its|their|this|that|these|those|which|who|has|have|had|not|but|can|may|should|will|be|been|do|each|all|both|more|most|some|such|no|only|other|same|so|also|new|based|using|associated|among|without|within|upon|including|following|versus|compared|effect|role|impact|review|study|analysis|treatment|outcomes|risk|women|patients|clinical|use|health)$/i;
  function isNonEnglish(title) {
    if (!title) return false;
    var t = title.replace(/müller\w*/gi, '').replace(/café/gi, '').replace(/naïve/gi, '');
    var nonAscii = (t.match(/[^\x00-\x7F]/g) || []).length;
    if (nonAscii >= 3) return true;
    var words = title.split(/[\s\-–—:,;.()]+/).filter(function(w) { return w.length > 0; });
    if (words.length < 5) return false;
    var engCount = 0;
    for (var i = 0; i < words.length; i++) {
      if (_engWordRe.test(words[i])) engCount++;
    }
    return (engCount / words.length) < 0.10;
  }

  function onInput() {
    var q = input.value.trim();
    if (q) clearBtn.removeAttribute('hidden'); else clearBtn.setAttribute('hidden', '');
    clearTimeout(debounceTimer);
    if (!q) {
      stopLoadingSpinner();
      preloadedData = [];
      currentQuery = '';
      activeFilter = 'all';
      activeIdx = -1;
      input.setAttribute('aria-expanded', 'false');
      input.removeAttribute('aria-activedescendant');
      resultsEl.innerHTML = '<p class="mss-hint">Try a topic, condition, or author.</p>';
      return;
    }
    currentQuery = q;
    debounceTimer = setTimeout(function() { doSearch(q); }, 150);
  }

  async function doSearch(query) {
    startLoadingSpinner();
    try {
      if (inflightSemanticCtl) inflightSemanticCtl.abort();
      inflightSemanticCtl = new AbortController();
      // Anchor the semantic timeout to fetch start, not to after-Pagefind. Cold-load
      // Pagefind (200-500ms) used to silently extend the semantic budget; now the
      // 300ms ceiling is consistent regardless of Pagefind warm/cold state.
      var semanticStart = Date.now();
      var semanticPromise = fetch('/api/search/semantic?q=' + encodeURIComponent(query), { signal: inflightSemanticCtl.signal })
        .then(function(r) { return r.json(); })
        .catch(function(err) {
          if (err && err.name === 'AbortError') return { results: [], aborted: true };
          console.warn('Semantic search failed:', err && (err.message || err));
          return { results: [] };
        });

      var pf = await ensurePagefind();
      var search = await pf.search(query);
      if (query !== currentQuery) { stopLoadingSpinner(); return; }
      var toPreload = search.results.slice(0, PRELOAD_CAP);
      var pfLoaded = (await Promise.all(
        toPreload.map(function(r, i) {
          return r.data().then(function(d) {
            d._pfRank = i;
            if (isNonEnglish(d.meta && d.meta.title)) d._pfRank += 1000;
            return d;
          }).catch(function() { return null; });
        })
      )).filter(Boolean);
      if (query !== currentQuery) { stopLoadingSpinner(); return; }

      var semanticRemaining = Math.max(0, 300 - (Date.now() - semanticStart));
      var semanticData = await Promise.race([
        semanticPromise,
        new Promise(function(resolve) { setTimeout(function() { resolve(null); }, semanticRemaining); })
      ]);
      if (query !== currentQuery) { stopLoadingSpinner(); return; }

      var semanticResults = (semanticData && semanticData.results || []).filter(function(sr) { return sr.score >= 0.5; });

      var RRF_K = 60;
      var fusedMap = {};
      function toRelative(url) { try { return new URL(url).pathname; } catch(e) { return url; } }
      function extractRecId(url) { var m = url.match(/-(rec[a-zA-Z0-9]{14})\/?$/); return m ? m[1].toLowerCase() : null; }
      var recIdToKey = {};

      for (var pi = 0; pi < pfLoaded.length; pi++) {
        var pItem = pfLoaded[pi];
        var pUrl = toRelative(pItem.url);
        pItem.url = pUrl;
        var pRecId = extractRecId(pUrl);
        var existingKey = pRecId && recIdToKey[pRecId];
        if (existingKey) {
          fusedMap[existingKey].score += 1 / (RRF_K + pItem._pfRank);
        } else if (fusedMap[pUrl]) {
          fusedMap[pUrl].score += 1 / (RRF_K + pItem._pfRank);
        } else {
          fusedMap[pUrl] = { score: 1 / (RRF_K + pItem._pfRank), data: pItem };
          if (pRecId) recIdToKey[pRecId] = pUrl;
        }
      }

      for (var si = 0; si < semanticResults.length; si++) {
        var sItem = semanticResults[si];
        var sUrl = toRelative(sItem.url);
        var sRank = si;
        if (isNonEnglish(sItem.title)) sRank += 1000;
        var sRecId = extractRecId(sUrl);
        var matchKey = fusedMap[sUrl] ? sUrl : (sRecId && recIdToKey[sRecId]) ? recIdToKey[sRecId] : null;

        if (matchKey) {
          fusedMap[matchKey].score += 1 / (RRF_K + sRank);
          if (matchKey !== sUrl) fusedMap[matchKey].data.url = sUrl;
          if (fusedMap[matchKey].data.meta && !fusedMap[matchKey].data.meta.type && sItem.type) {
            fusedMap[matchKey].data.meta.type = sItem.type;
          }
        } else {
          // Propagate rrmRelevance from semantic payload so the rlRank tiering (0/10/25/45/60)
          // applies; without this, semantic-only Research items defaulted to rlRank=30.
          var sMeta = { title: sItem.title, authors: sItem.authors || '', year: sItem.year ? String(sItem.year) : '', type: sItem.type || 'Research' };
          if (sItem.rrmRelevance) sMeta.rrmRelevance = sItem.rrmRelevance;
          if (sItem.sentiment) sMeta.sentiment = sItem.sentiment;
          fusedMap[sUrl] = {
            score: 1 / (RRF_K + sRank),
            data: {
              url: sUrl, excerpt: '',
              meta: sMeta,
              _pfRank: -1
            }
          };
          if (sRecId && !recIdToKey[sRecId]) recIdToKey[sRecId] = sUrl;
        }
      }

      var RECENCY_K = 30;
      var currentYear = new Date().getFullYear();
      for (var rKey in fusedMap) {
        var entry = fusedMap[rKey];
        var yr = parseInt(entry.data.meta && entry.data.meta.year, 10);
        if (yr > 0) {
          var age = Math.max(0, currentYear - yr);
          if (age < 20) {
            var recencyRank = Math.round(age * 2.5);
            entry.score += 1 / (RECENCY_K + recencyRank);
          }
        }
      }

      var RELEVANCE_K = 50;
      var _relevanceMap = { '5 - Core RRM': 0, '4 - Highly Relevant': 10, '3 - Relevant': 25, '2 - Peripheral': 45, '1 - Not RRM': 60 };
      var _ownContentTypes = { 'Article': 1, 'FAQ': 1, 'Course': 1, 'Guide': 1, 'Glossary': 1 };
      for (var rlKey in fusedMap) {
        var rlEntry = fusedMap[rlKey];
        var rlMeta = rlEntry.data.meta || {};
        var rlRank = 30;
        if (_ownContentTypes[rlMeta.type]) rlRank = 0;
        else if (rlMeta.rrmRelevance && _relevanceMap[rlMeta.rrmRelevance] !== undefined) rlRank = _relevanceMap[rlMeta.rrmRelevance];
        rlEntry.score += 1 / (RELEVANCE_K + rlRank);
        var rlSentiment = rlMeta.sentiment;
        if (rlSentiment === 'hostile') rlEntry.score -= 0.02;
        else if (rlSentiment === 'critical') rlEntry.score -= 0.01;
      }

      var fusedList = [];
      for (var fKey in fusedMap) fusedList.push(fusedMap[fKey]);
      fusedList.sort(function(a, b) { return b.score - a.score; });

      preloadedData = fusedList.map(function(f) { f.data._score = f.score; return f.data; });
      totalCount = preloadedData.length;
      activeFilter = 'all';
      stopLoadingSpinner();
      beaconQuery(query, totalCount);
      renderPanel();

      if (!semanticData) {
        semanticPromise.then(function(lateData) {
          if (query !== currentQuery) return;
          if (lateData && lateData.aborted) return;
          var lateResults = (lateData && lateData.results || []).filter(function(sr) { return sr.score >= 0.5; });
          var existingUrls = {};
          var existingRecIds = {};
          for (var ei = 0; ei < preloadedData.length; ei++) {
            var eUrl = toRelative(preloadedData[ei].url).toLowerCase();
            existingUrls[eUrl] = true;
            var eRecId = extractRecId(eUrl);
            if (eRecId) existingRecIds[eRecId] = true;
          }
          var added = 0;
          for (var li = 0; li < lateResults.length; li++) {
            var lr = lateResults[li];
            var lrUrl = toRelative(lr.url).toLowerCase();
            var lrRecId = extractRecId(lrUrl);
            if (existingUrls[lrUrl] || (lrRecId && existingRecIds[lrRecId])) continue;
            var lrType = lr.type || 'Research';
            var lrTitle = lr.title || '';
            if (isNonEnglish(lrTitle)) continue;
            var lrRank = li;
            var lrScore = 1 / (RRF_K + lrRank);
            var lrYear = parseInt(lr.year, 10);
            if (lrYear > 0) {
              var lrAge = Math.max(0, currentYear - lrYear);
              if (lrAge < 20) lrScore += 1 / (RECENCY_K + Math.round(lrAge * 2.5));
            }
            var lrRelRank = 30;
            if (_ownContentTypes[lrType]) lrRelRank = 0;
            else if (lr.rrmRelevance && _relevanceMap[lr.rrmRelevance] !== undefined) lrRelRank = _relevanceMap[lr.rrmRelevance];
            lrScore += 1 / (RELEVANCE_K + lrRelRank);
            if (lr.sentiment === 'hostile') lrScore -= 0.02;
            else if (lr.sentiment === 'critical') lrScore -= 0.01;
            preloadedData.push({
              url: lr.url, excerpt: '',
              meta: { title: lrTitle, authors: lr.authors || '', year: lr.year ? String(lr.year) : '', type: lrType },
              _pfRank: -1,
              _score: lrScore
            });
            added++;
          }
          if (added > 0) {
            preloadedData.sort(function(a, b) { return (b._score || 0) - (a._score || 0); });
            totalCount = preloadedData.length;
            renderPanel();
          }
        });
      }
    } catch(e) {
      console.error('Search failed:', e);
      stopLoadingSpinner();
      if (query !== currentQuery) return;
      resultsEl.innerHTML = '<p class="mss-empty">Search unavailable</p>';
    }
  }

  function renderPanel() {
    resultsEl.innerHTML = '';
    // Reset keyboard nav state on every full re-render (filter change, late
    // semantic merge, fresh search).
    activeIdx = -1;
    input.removeAttribute('aria-activedescendant');
    if (totalCount === 0) {
      resultsEl.innerHTML = '<p class="mss-empty">No results found for "' + escHtml(currentQuery) + '"</p>';
      input.setAttribute('aria-expanded', 'false');
      return;
    }
    input.setAttribute('aria-expanded', 'true');

    var buckets = {};
    for (var i = 0; i < preloadedData.length; i++) {
      var item = preloadedData[i];
      var t = (item.meta && item.meta.type) || 'Research';
      if (!buckets[t]) buckets[t] = [];
      buckets[t].push(item);
    }

    var chips = document.createElement('div');
    chips.className = 'mss-chips';
    chips.appendChild(makeChip('all', 'All', totalCount));
    for (var ci = 0; ci < TYPE_ORDER.length; ci++) {
      var ct = TYPE_ORDER[ci];
      if (buckets[ct] && buckets[ct].length) {
        chips.appendChild(makeChip(ct, TYPE_LABEL[ct], buckets[ct].length));
      }
    }
    resultsEl.appendChild(chips);

    var groupsEl = document.createElement('div');
    groupsEl.className = 'mss-groups';
    groupsEl.setAttribute('data-active-filter', activeFilter);
    for (var gi = 0; gi < TYPE_ORDER.length; gi++) {
      var gt = TYPE_ORDER[gi];
      var items = buckets[gt];
      if (!items || !items.length) continue;
      var section = document.createElement('section');
      section.className = 'mss-group';
      section.setAttribute('data-group-type', gt);

      var heading = document.createElement('h4');
      heading.className = 'mss-group-heading';
      heading.appendChild(document.createTextNode(TYPE_LABEL[gt]));
      if (items.length > 1) {
        var countSpan = document.createElement('span');
        countSpan.className = 'mss-group-count';
        countSpan.textContent = items.length;
        heading.appendChild(countSpan);
      }
      section.appendChild(heading);

      var preview = GROUP_PREVIEW[gt] || 3;
      for (var ii = 0; ii < items.length; ii++) {
        var a = renderResult(items[ii]);
        if (ii >= preview) a.setAttribute('data-over-preview', '');
        section.appendChild(a);
      }

      if (items.length > preview) {
        var showAll = document.createElement('button');
        showAll.className = 'mss-show-all';
        showAll.setAttribute('data-filter-target', gt);
        showAll.textContent = 'Show all ' + items.length + ' in ' + TYPE_LABEL[gt] + ' →';
        showAll.addEventListener('click', function(e) {
          setFilter(e.currentTarget.getAttribute('data-filter-target'));
        });
        section.appendChild(showAll);
      }

      groupsEl.appendChild(section);
    }
    resultsEl.appendChild(groupsEl);
  }

  function makeChip(value, label, count) {
    var chip = document.createElement('button');
    chip.className = 'mss-chip' + (activeFilter === value ? ' mss-chip--active' : '');
    chip.setAttribute('data-filter', value);
    chip.appendChild(document.createTextNode(label));
    var c = document.createElement('span');
    c.className = 'mss-chip-count';
    c.textContent = count;
    chip.appendChild(c);
    chip.addEventListener('click', function() {
      setFilter(chip.getAttribute('data-filter'));
    });
    return chip;
  }

  function setFilter(type) {
    activeFilter = type;
    var groupsEl = resultsEl.querySelector('.mss-groups');
    if (groupsEl) groupsEl.setAttribute('data-active-filter', type);
    var chipNodes = resultsEl.querySelectorAll('.mss-chip');
    for (var i = 0; i < chipNodes.length; i++) {
      var c = chipNodes[i];
      if (c.getAttribute('data-filter') === type) c.classList.add('mss-chip--active');
      else c.classList.remove('mss-chip--active');
    }
    if (resultsEl.scrollTo) resultsEl.scrollTo({ top: 0, behavior: 'smooth' });
    else resultsEl.scrollTop = 0;
    // Visibility changed -- clear active option so next ArrowDown starts at 0.
    clearActiveOption();
  }

  // ── Keyboard navigation (WCAG 2.1.1) -- sibling parity with SearchBar.astro ──
  function getVisibleItems() {
    var nodes = resultsEl.querySelectorAll('.mss-item');
    var out = [];
    for (var i = 0; i < nodes.length; i++) {
      if (nodes[i].offsetParent !== null) out.push(nodes[i]);
    }
    return out;
  }

  function clearActiveOption() {
    if (activeIdx < 0) return;
    var prior = resultsEl.querySelectorAll('.mss-item[aria-selected="true"]');
    for (var i = 0; i < prior.length; i++) prior[i].setAttribute('aria-selected', 'false');
    activeIdx = -1;
    input.removeAttribute('aria-activedescendant');
  }

  function setActiveOption(idx) {
    var items = getVisibleItems();
    if (!items.length) return;
    if (idx < 0) idx = items.length - 1;
    if (idx >= items.length) idx = 0;
    var prior = resultsEl.querySelectorAll('.mss-item[aria-selected="true"]');
    for (var i = 0; i < prior.length; i++) prior[i].setAttribute('aria-selected', 'false');
    var el = items[idx];
    el.setAttribute('aria-selected', 'true');
    activeIdx = idx;
    if (el.id) input.setAttribute('aria-activedescendant', el.id);
    if (typeof el.scrollIntoView === 'function') {
      el.scrollIntoView({ block: 'nearest' });
    }
  }

  function renderResult(data) {
    var a = document.createElement('a');
    a.className = 'mss-item';
    a.href = data.url;
    a.setAttribute('role', 'option');
    a.setAttribute('aria-selected', 'false');
    a.id = 'mss-opt-' + (++_mss_idx_counter);

    var title = data.meta && data.meta.title ? data.meta.title : '';
    var authors = data.meta && data.meta.authors ? data.meta.authors : '';
    var type = data.meta && data.meta.type ? data.meta.type : '';
    var excerpt = data.excerpt || '';

    var titleRow = document.createElement('div');
    titleRow.className = 'mss-title-row';
    var h = document.createElement('h3');
    h.className = 'mss-title';
    h.textContent = title || 'Untitled';
    titleRow.appendChild(h);
    if (type) {
      var badge = document.createElement('span');
      badge.className = 'mss-type mss-type--' + type.toLowerCase();
      badge.textContent = type;
      titleRow.appendChild(badge);
    }
    a.appendChild(titleRow);

    if (authors && (type === 'Research' || type === 'Article' || !type)) {
      var meta = document.createElement('div');
      meta.className = 'mss-meta';
      meta.textContent = authors;
      a.appendChild(meta);
    }

    var displayExcerpt = excerpt;
    if (type === 'Course' && data.meta && data.meta.description) displayExcerpt = data.meta.description;
    if (displayExcerpt) {
      var p = document.createElement('p');
      p.className = 'mss-excerpt';
      p.textContent = displayExcerpt.replace(/<\/?mark>/g, '');
      a.appendChild(p);
    }

    a.addEventListener('pointerdown', function () {
      // Fire GA4 search_result_click. Rank = position of this anchor among
      // visible .mss-item nodes (matches what the user sees).
      try {
        var visible = Array.prototype.slice.call(resultsEl.querySelectorAll('.mss-item'));
        var rank = visible.indexOf(a);
        track('search_result_click', {
          surface: 'mobile-modal',
          result_type: type || 'unknown',
          rank: rank >= 0 ? rank : 0,
          query_length: (currentQuery || '').length,
        });
      } catch (_) { /* analytics must never break navigation */ }

      var clickedHref = a.getAttribute('href') || '';
      var isCommentaryClick = clickedHref.indexOf('/commentary/') !== -1;
      var pathSubstring = isCommentaryClick ? '/commentary/' : '/library/';
      var resultSource = isCommentaryClick ? 'commentary' : 'library';

      var allLinks = document.querySelectorAll('#mss-results a[href*="' + pathSubstring + '"]');
      var slugs = [];
      var titles = [];
      allLinks.forEach(function (link) {
        try {
          var u = new URL(link.getAttribute('href'), location.origin);
          var pm = u.pathname.match(/^\/(library|commentary)\/([a-z0-9][a-z0-9-]{0,250})\/?$/);
          if (!pm) return;
          if (pm[1] !== resultSource) return;
          slugs.push(pm[2]);
          var titleEl = link.querySelector('.mss-title') ||
                        (link.closest('.mss-item') && link.closest('.mss-item').querySelector('.mss-title'));
          titles.push(titleEl ? (titleEl.textContent || '').trim().slice(0, 300) : '');
        } catch (err) { /* malformed URL — skip */ }
      });
      if (slugs.length === 0) return;
      pendingSearchContext = {
        source: resultSource,
        label: 'Search · "' + (currentQuery || '').slice(0, 80) + '" · ' + slugs.length + ' results',
        slugs: slugs.slice(0, 500),
        titles: titles.slice(0, 500),
        returnUrl: '/' + resultSource + '/?q=' + encodeURIComponent(currentQuery || ''),
        filters: { q: currentQuery || '' },
        writtenAt: Date.now()
      };
    });

    return a;
  }

  function escHtml(s) {
    var d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }

  clearBtn.addEventListener('click', function() {
    clearTimeout(debounceTimer);
    stopLoadingSpinner();
    input.value = '';
    clearBtn.setAttribute('hidden', '');
    preloadedData = [];
    currentQuery = '';
    activeFilter = 'all';
    activeIdx = -1;
    input.setAttribute('aria-expanded', 'false');
    input.removeAttribute('aria-activedescendant');
    resultsEl.innerHTML = '<p class="mss-hint">Try a topic, condition, or author.</p>';
    input.focus();
  });

  window.addEventListener('pagehide', function () {
    if (window.__rrmClearRequested__) return;
    if (!pendingSearchContext) return;
    try {
      sessionStorage.setItem('rrm-shell-context', JSON.stringify(pendingSearchContext));
    } catch (err) {}
  });

  input.addEventListener('input', onInput);

  // Keyboard handling on the input (sibling parity with SearchBar.astro):
  //  - ArrowDown/Up : move active option through visible .mss-item nodes
  //  - Enter        : if an option is active, follow its href; else re-run search
  //  - Escape       : clear active option first; if none active, document-level
  //                   handler will close the modal (we stopPropagation when
  //                   we consume the key so the modal stays open)
  input.addEventListener('keydown', function(e) {
    if (e.key === 'ArrowDown') {
      var items = getVisibleItems();
      if (!items.length) return;
      e.preventDefault();
      setActiveOption(activeIdx < 0 ? 0 : activeIdx + 1);
      return;
    }
    if (e.key === 'ArrowUp') {
      var items2 = getVisibleItems();
      if (!items2.length) return;
      e.preventDefault();
      setActiveOption(activeIdx < 0 ? items2.length - 1 : activeIdx - 1);
      return;
    }
    if (e.key === 'Escape') {
      if (activeIdx >= 0) {
        e.preventDefault();
        e.stopPropagation();
        clearActiveOption();
      }
      return;
    }
    if (e.key === 'Enter') {
      var items3 = getVisibleItems();
      if (activeIdx >= 0 && items3[activeIdx]) {
        e.preventDefault();
        items3[activeIdx].click();
        return;
      }
      e.preventDefault();
      var q = input.value.trim();
      if (q) { clearTimeout(debounceTimer); doSearch(q); }
    }
  });
})();
</script>
