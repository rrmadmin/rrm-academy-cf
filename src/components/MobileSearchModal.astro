---
// Unified search modal for mobile: trigger pill in top bar (outside hamburger)
// opens a full-screen popup. Results render inline -- no nav to /library.
// Self-contained: own IDs (mss-*) so it can coexist with SearchBar on library pages.
---
<button type="button" class="mss-trigger" id="mss-trigger" aria-label="Open search" aria-haspopup="dialog" aria-expanded="false" aria-controls="mss-modal">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="11" cy="11" r="8"/>
    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
  </svg>
  <span class="mss-trigger__label">Search</span>
</button>

<div class="mss-modal" id="mss-modal" role="dialog" aria-modal="true" aria-label="Search RRM Academy" hidden>
  <div class="mss-modal__backdrop" data-mss-close></div>
  <div class="mss-modal__sheet" role="document">
    <div class="mss-modal__header">
      <div class="mss-modal__field">
        <svg class="mss-modal__field-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input
          type="search"
          id="mss-input"
          class="mss-modal__input"
          placeholder="Search articles, FAQs, courses..."
          autocomplete="off"
          enterkeyhint="search"
          aria-label="Search articles"
          role="combobox"
          aria-autocomplete="list"
          aria-expanded="false"
          aria-controls="mss-results"
          aria-haspopup="listbox"
        />
        <button type="button" class="mss-modal__clear" id="mss-clear" aria-label="Clear search" hidden>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
      <button type="button" class="mss-modal__close" id="mss-close" data-mss-close aria-label="Close search">
        <span class="mss-x" aria-hidden="true"></span>
      </button>
    </div>
    <div class="mss-modal__results" id="mss-results" role="listbox" aria-label="Search results"></div>
  </div>
</div>

<style>
  /* Trigger pill -- visible only on mobile, sits in Header top bar */
  .mss-trigger {
    display: none;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    line-height: 1;
    color: var(--text-secondary);
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-pill);
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    font-weight: 500;
    /* transform timing per the tap-press primitive (cubic-bezier(0.2,0,0,1) @120ms) */
    transition: color 0.15s, border-color 0.15s, background 0.15s, transform 120ms cubic-bezier(0.2, 0, 0, 1);
  }
  .mss-trigger:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 6%, transparent);
  }
  .mss-trigger:active {
    transform: scale(0.97);
  }
  .mss-trigger svg {
    flex-shrink: 0;
    color: var(--text-secondary);
  }
  .mss-trigger__label {
    color: var(--text-secondary);
  }


  /* Modal-shell + results-render CSS (~10 KiB) is lazily injected on first
     openModal() -- see MSS_LAZY_CSS string literal + injectLazyMssCss() in
     the <script> below. The modal itself is in the DOM with [hidden] but
     none of its selectors match anything user-visible on initial render, so
     PSI was flagging them as unused CSS. Only the trigger pill (above)
     stays eager. */

  /* Show trigger only on mobile. Tablet+ uses the page's SearchBar/header-search.
     Mobile = compact icon-only button (no pill, no label), pushed to the right so it
     sits beside the hamburger. Opens the same full-screen search modal. */
  @media (max-width: 768px) {
    /* A real outlined button (pill around the icon) at rest, so it can morph
       OUT into the full search-field outline when the modal opens. */
    .mss-trigger {
      display: inline-flex;
      margin-left: auto;
      padding: 7px 11px;
      border: 1px solid var(--border-color);
      background: var(--bg-surface);
      border-radius: var(--radius-pill);
    }
    .mss-trigger:hover {
      background: color-mix(in srgb, var(--accent) 8%, transparent);
      border-color: var(--accent);
    }
    .mss-trigger:active {
      transform: scale(0.94); /* tap-press small-icon scale */
      background: color-mix(in srgb, var(--accent) 12%, transparent);
    }
    .mss-trigger:active svg { color: var(--accent); }
    .mss-trigger:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }
    .mss-trigger__label { display: none; }
    .mss-trigger svg { width: 18px; height: 18px; }
  }
</style>


<script>
// @ts-nocheck
// Moved off is:inline (2026-05-14) so Astro extracts this to a hashed,
// long-cached, deferred module bundle (`/_astro/*.js`) instead of inlining
// ~26 KiB into every HTML response. Module scripts are deferred by default,
// so document.getElementById calls below still see a parsed DOM.
// @ts-nocheck above silences strict-null/implicit-any in vanilla JS that
// previously skipped TS via the is:inline directive (no runtime behavior change).
import { track } from '../scripts/track.ts';
(function() {
  var trigger = document.getElementById('mss-trigger');
  var modal = document.getElementById('mss-modal');
  var input = document.getElementById('mss-input');
  var clearBtn = document.getElementById('mss-clear');
  var resultsEl = document.getElementById('mss-results');
  if (!modal || !input || !resultsEl) return;
  // Auxiliary triggers: any element with [data-open-search-modal] opens the same
  // modal. Used by the desktop search-icon button in Header.astro so we don't
  // have to duplicate the open/close JS in two places.
  var auxTriggers = document.querySelectorAll('[data-open-search-modal]');

  var pagefindReady = null;
  var debounceTimer = null;
  var spinnerTimer = null;
  var lastBeaconedQuery = '';
  var totalCount = 0;
  var currentQuery = '';
  var PRELOAD_CAP = 50;
  var preloadedData = [];
  var activeFilter = 'all';
  var inflightSemanticCtl = null;
  var pendingSearchContext = null;
  // Keyboard nav state (WCAG 2.1.1). activeIdx is an index into the visible
  // .mss-item nodes at the time of the keystroke; visibility is recomputed each
  // press so filter chips + show-all expansion don't desync.
  var activeIdx = -1;
  var _mss_idx_counter = 0;

  var TYPE_ORDER = ['Guide', 'Research', 'Glossary', 'Article', 'FAQ', 'Course'];
  var TYPE_LABEL = { Guide: 'Guides', Glossary: 'Glossary', FAQ: 'FAQs', Course: 'Courses', Article: 'Commentary', Research: 'Research' };
  var GROUP_PREVIEW = { Guide: 5, Glossary: 5, FAQ: 5, Course: 5, Article: 3, Research: 3 };
  var lastFocus = null;

  var waveFrames = ['⠖⠉⠉⠑','⡠⠖⠉⠉','⣠⡠⠖⠉','⣄⣠⡠⠖','⠢⣄⣠⡠','⠙⠢⣄⣠','⠉⠙⠢⣄','⠊⠉⠙⠢','⠜⠊⠉⠙','⡤⠜⠊⠉','⣀⡤⠜⠊','⢤⣀⡤⠜','⠣⢤⣀⡤','⠑⠣⢤⣀','⠉⠑⠣⢤','⠋⠉⠑⠣'];

  // The full mss-modal CSS (shell skeleton + results-render rules) is held
  // as a JS string literal and injected as a <style> on first openModal().
  // Bytes are accounted as "used JS" (the var assignment runs at module
  // load), so Lighthouse "Reduce unused CSS" no longer flags them. Modal
  // opens are rare relative to page loads, so even users who never type pay
  // the ~10 KiB once (in the long-cached JS bundle) instead of every HTML
  // response. Eager <style> block above keeps only the trigger pill (the
  // only mss-* selector that matches DOM on initial render).
  var MSS_LAZY_CSS =
    "/* Modal -- full screen on mobile */\n" +
    ".mss-modal {\n" +
    "  position: fixed;\n" +
    "  inset: 0;\n" +
    "  z-index: 200; /* above site-header (100) and nav-overlay (49) */\n" +
    "  display: flex;\n" +
    "  flex-direction: column;\n" +
    "}\n" +
    ".mss-modal[hidden] {\n" +
    "  display: none;\n" +
    "}\n" +
    ".mss-modal__backdrop {\n" +
    "  position: absolute;\n" +
    "  inset: 0;\n" +
    "  background: rgba(0, 0, 0, 0.35);\n" +
    "  backdrop-filter: blur(2px);\n" +
    "  -webkit-backdrop-filter: blur(2px);\n" +
    "}\n" +
    ".mss-modal__sheet {\n" +
    "  position: relative;\n" +
    "  display: flex;\n" +
    "  flex-direction: column;\n" +
    "  width: 100%;\n" +
    "  height: 100dvh;\n" +
    "  background: var(--bg-body);\n" +
    "  animation: mss-slide-down 0.18s ease-out;\n" +
    "}\n" +
    "@keyframes mss-slide-down {\n" +
    "  from { transform: translateY(-12px); opacity: 0; }\n" +
    "  to { transform: translateY(0); opacity: 1; }\n" +
    "}\n" +
    "@media (prefers-reduced-motion: reduce) {\n" +
    "  .mss-modal__sheet { animation: none; }\n" +
    "}\n" +
    "\n" +
    ".mss-modal__header {\n" +
    "  position: relative;\n" + /* anchor for the mobile absolutely-pinned X */
    "  display: flex;\n" +
    "  align-items: center;\n" +
    "  gap: var(--space-2);\n" +
    "  padding: var(--space-3) var(--space-4);\n" + /* desktop default; mobile overrides to 48px below */
    "  background: var(--bg-header);\n" +
    "  border-bottom: 1px solid var(--border-light);\n" +
    "}\n" +
    ".mss-modal__field {\n" +
    "  position: relative;\n" +
    "  display: flex;\n" +
    "  align-items: center;\n" +
    "  flex: 1;\n" +
    "  min-width: 0;\n" +
    "  background: var(--bg-surface);\n" + /* pill lives on the field so it's visible while the box animates */
    "  border: 1px solid var(--border-color);\n" +
    "  border-radius: var(--radius-pill);\n" +
    "  transition: border-color 0.15s, box-shadow 0.15s;\n" +
    "}\n" +
    ".mss-modal__field:focus-within {\n" +
    "  border-color: var(--sand-500);\n" +
    "  box-shadow: 0 0 0 3px rgba(184, 163, 143, 0.18);\n" +
    "}\n" +
    ".mss-modal__field-icon {\n" +
    "  position: absolute;\n" +
    "  left: 12px;\n" +
    "  top: 50%;\n" +
    "  transform: translateY(-50%);\n" +
    "  color: var(--text-secondary);\n" + /* darker, matches the bar button icon (was too pale to see) */
    "  pointer-events: none;\n" +
    "}\n" +
    ".mss-modal__input {\n" +
    "  width: 100%;\n" +
    "  padding: 10px 16px 10px 38px;\n" + /* field now ends before the X, so normal right pad */
    "  font-size: 16px; /* iOS: 16px+ prevents zoom on focus */\n" +
    "  font-family: 'Inter', sans-serif;\n" +
    "  border: none;\n" + /* pill (bg + border + focus ring) is on .mss-modal__field now */
    "  outline: none;\n" +
    "  background: transparent;\n" +
    "  color: var(--text-primary);\n" +
    "  -webkit-appearance: none;\n" +
    "}\n" +
    ".mss-modal__input::placeholder {\n" +
    "  color: var(--text-muted);\n" +
    "}\n" +
    ".mss-modal__input::-webkit-search-cancel-button {\n" +
    "  -webkit-appearance: none;\n" +
    "  display: none;\n" +
    "}\n" +
    ".mss-modal__clear {\n" +
    "  position: absolute;\n" +
    "  right: 8px;\n" +
    "  width: 24px;\n" +
    "  height: 24px;\n" +
    "  display: flex;\n" +
    "  align-items: center;\n" +
    "  justify-content: center;\n" +
    "  border: none;\n" +
    "  background: var(--bg-body);\n" +
    "  color: var(--text-tertiary);\n" +
    "  border-radius: 50%;\n" +
    "  padding: 0;\n" +
    "  cursor: pointer;\n" +
    "  transition: color 0.15s, background 0.15s;\n" +
    "}\n" +
    ".mss-modal__clear:hover {\n" +
    "  color: var(--text-primary);\n" +
    "  background: var(--border-light);\n" +
    "}\n" +
    ".mss-modal__clear[hidden] { display: none; }\n" +
    ".mss-modal__close {\n" +
    "  flex-shrink: 0;\n" + /* in-flow on desktop; mobile pins it absolute below */
    "  width: 40px;\n" +
    "  height: 40px;\n" +
    "  display: flex;\n" +
    "  align-items: center;\n" +
    "  justify-content: center;\n" +
    "  padding: 0;\n" +
    "  background: none;\n" +
    "  border: none;\n" +
    "  color: var(--text-primary);\n" + /* matches the hamburger->X in the bar */
    "  border-radius: var(--radius-pill);\n" +
    "  cursor: pointer;\n" +
    "  transition: background 0.15s, transform 120ms cubic-bezier(0.2, 0, 0, 1);\n" +
    "}\n" +
    ".mss-modal__close:hover { background: color-mix(in srgb, var(--accent) 8%, transparent); }\n" +
    ".mss-modal__close:active { transform: scale(0.9); }\n" +
    /* Hamburger lines that morph to an X (same transform + 0.2s timing as the drawer
       toggle). .is-x is toggled on open/close so the icon transforms, not blips. */
    ".mss-x { display: block; position: relative; width: 18px; height: 2px; background: var(--text-primary); border-radius: 1px; transition: background 0.2s; }\n" +
    ".mss-x::before, .mss-x::after { content: ''; position: absolute; left: 0; width: 100%; height: 2px; background: var(--text-primary); border-radius: 1px; transition: transform 0.2s, top 0.2s; }\n" +
    ".mss-x::before { top: -6px; }\n" +
    ".mss-x::after { top: 6px; }\n" +
    ".mss-modal__close.is-x .mss-x { background: transparent; }\n" +
    ".mss-modal__close.is-x .mss-x::before { top: 0; transform: rotate(45deg); }\n" +
    ".mss-modal__close.is-x .mss-x::after { top: 0; transform: rotate(-45deg); }\n" +
    "\n" +
    "/* Results scroller */\n" +
    ".mss-modal__results {\n" +
    "  flex: 1;\n" +
    "  overflow-y: auto;\n" +
    "  -webkit-overflow-scrolling: touch;\n" +
    "  padding: 0 var(--space-5) var(--space-6);\n" +
    "}\n" +
    ".mss-modal__results:empty {\n" +
    "  display: none;\n" +
    "}\n" +
    "\n" +
    "@media (max-width: 768px) {\n" +
    "  .mss-modal__sheet { animation: none; }\n" + /* no slide/jump-in; the search-bar FLIP is the entrance */
    "  .mss-modal__header { height: 48px; padding: 0 var(--space-3); }\n" + /* match the top bar; no taller */
    "  .mss-modal__field { margin-right: 48px; height: 36px; }\n" + /* FIXED smaller height (font-independent) + reserve space for the pinned X */
    "  .mss-modal__input { padding-top: 0; padding-bottom: 0; }\n" + /* vertical-center in the fixed-height field; no font-driven growth */
    "  .mss-modal__close { position: absolute; right: var(--space-3); top: 50%; transform: translateY(-50%); z-index: 1; }\n" +
    "  .mss-modal__close:active { transform: translateY(-50%) scale(0.9); }\n" +
    "}\n" +
    "@media (min-width: 769px) {\n" +
    "  .mss-modal { align-items: center; padding: 64px 24px 24px; }\n" +
    "  .mss-modal__sheet {\n" +
    "    width: 100%;\n" +
    "    max-width: 720px;\n" +
    "    height: auto;\n" +
    "    max-height: calc(100dvh - 88px);\n" +
    "    border-radius: 14px;\n" +
    "    box-shadow: 0 30px 60px rgba(0,0,0,0.35), 0 8px 20px rgba(0,0,0,0.15);\n" +
    "    overflow: hidden;\n" +
    "  }\n" +
    "  .mss-modal__close { padding: 0; }\n" +
    "}\n" +
    ".mss-modal__results .mss-count {\n" +
    "  font-size: 0.75rem;\n" +
    "  font-weight: 500;\n" +
    "  color: var(--text-tertiary);\n" +
    "  text-transform: uppercase;\n" +
    "  letter-spacing: 0.04em;\n" +
    "  padding: var(--space-4) 0 var(--space-2);\n" +
    "}\n" +
    ".mss-modal__results .mss-item {\n" +
    "  display: block;\n" +
    "  padding: var(--space-4) 0;\n" +
    "  border-bottom: 1px solid var(--border-light);\n" +
    "  text-decoration: none;\n" +
    "  color: var(--text-primary);\n" +
    "}\n" +
    ".mss-modal__results .mss-item:first-of-type {\n" +
    "  border-top: 1px solid var(--border-light);\n" +
    "}\n" +
    ".mss-modal__results .mss-item:active .mss-title {\n" +
    "  color: var(--accent);\n" +
    "}\n" +
    ".mss-modal__results .mss-title-row {\n" +
    "  display: flex;\n" +
    "  align-items: baseline;\n" +
    "  gap: var(--space-2);\n" +
    "}\n" +
    ".mss-modal__results .mss-title {\n" +
    "  font-family: 'Cormorant Garamond', 'Georgia', serif;\n" +
    "  font-size: 1.0625rem;\n" +
    "  font-weight: 600;\n" +
    "  line-height: 1.3;\n" +
    "  color: var(--text-primary);\n" +
    "  margin: 0 0 4px;\n" +
    "  transition: color 0.15s;\n" +
    "}\n" +
    ".mss-modal__results .mss-type {\n" +
    "  flex-shrink: 0;\n" +
    "  font-size: 0.5625rem;\n" +
    "  font-weight: 600;\n" +
    "  font-family: 'Inter', sans-serif;\n" +
    "  text-transform: uppercase;\n" +
    "  letter-spacing: 0.06em;\n" +
    "  padding: 2px 6px;\n" +
    "  border-radius: 3px;\n" +
    "  white-space: nowrap;\n" +
    "}\n" +
    ".mss-modal__results .mss-type--research { color: var(--green-700); background: var(--green-100); }\n" +
    ".mss-modal__results .mss-type--course   { color: var(--purple-700); background: var(--purple-100); }\n" +
    ".mss-modal__results .mss-type--faq      { color: var(--amber-700); background: var(--amber-100); }\n" +
    ".mss-modal__results .mss-type--article  { color: var(--sage-700); background: var(--sage-100); }\n" +
    ".mss-modal__results .mss-type--guide    { color: var(--rose-700); background: var(--rose-100); }\n" +
    ".mss-modal__results .mss-type--glossary { color: var(--sand-700); background: var(--sand-300); }\n" +
    "\n" +
    ".mss-modal__results .mss-meta {\n" +
    "  font-size: 0.75rem;\n" +
    "  color: var(--text-secondary);\n" +
    "  margin-bottom: 6px;\n" +
    "}\n" +
    ".mss-modal__results .mss-excerpt {\n" +
    "  font-size: 0.8125rem;\n" +
    "  line-height: 1.5;\n" +
    "  color: var(--text-secondary);\n" +
    "  display: -webkit-box;\n" +
    "  -webkit-line-clamp: 2;\n" +
    "  -webkit-box-orient: vertical;\n" +
    "  overflow: hidden;\n" +
    "}\n" +
    ".mss-modal__results .mss-more {\n" +
    "  display: block;\n" +
    "  width: 100%;\n" +
    "  margin-top: var(--space-5);\n" +
    "  padding: 10px var(--space-5);\n" +
    "  font-size: 0.8125rem;\n" +
    "  font-weight: 500;\n" +
    "  font-family: 'Inter', sans-serif;\n" +
    "  color: var(--text-secondary);\n" +
    "  background: var(--bg-surface);\n" +
    "  border: 1px solid var(--border-color);\n" +
    "  border-radius: var(--radius-pill);\n" +
    "  cursor: pointer;\n" +
    "}\n" +
    ".mss-modal__results .mss-more:active {\n" +
    "  border-color: var(--accent);\n" +
    "  color: var(--accent);\n" +
    "}\n" +
    ".mss-modal__results .mss-loading {\n" +
    "  font-size: 0.8125rem;\n" +
    "  color: var(--text-muted);\n" +
    "  padding: var(--space-5) 0;\n" +
    "  display: flex;\n" +
    "  align-items: center;\n" +
    "  gap: 0.5em;\n" +
    "}\n" +
    ".mss-modal__results .mss-loading-spinner {\n" +
    "  display: inline-block;\n" +
    "  font-family: monospace;\n" +
    "  font-size: 1rem;\n" +
    "  line-height: 1;\n" +
    "}\n" +
    ".mss-modal__results .mss-empty {\n" +
    "  font-size: 0.875rem;\n" +
    "  color: var(--text-tertiary);\n" +
    "  padding: var(--space-6) 0;\n" +
    "  text-align: center;\n" +
    "}\n" +
    ".mss-modal__results .mss-hint {\n" +
    "  font-size: 0.875rem;\n" +
    "  color: var(--text-tertiary);\n" +
    "  padding: var(--space-6) 0;\n" +
    "  text-align: center;\n" +
    "}\n" +
    "\n" +
    "/* ── Filter chip row ── */\n" +
    ".mss-modal__results .mss-chips {\n" +
    "  display: flex;\n" +
    "  gap: 6px;\n" +
    "  padding: var(--space-3) 0;\n" +
    "  overflow-x: auto;\n" +
    "  -webkit-overflow-scrolling: touch;\n" +
    "  scrollbar-width: none;\n" +
    "  position: sticky;\n" +
    "  top: 0;\n" +
    "  background: var(--bg-body);\n" +
    "  z-index: 1;\n" +
    "  border-bottom: 1px solid var(--border-light);\n" +
    "}\n" +
    ".mss-modal__results .mss-chips::-webkit-scrollbar { display: none; }\n" +
    ".mss-modal__results .mss-chip {\n" +
    "  flex-shrink: 0;\n" +
    "  display: inline-flex;\n" +
    "  align-items: center;\n" +
    "  gap: 6px;\n" +
    "  padding: 7px 14px;\n" +
    "  font-family: 'Inter', sans-serif;\n" +
    "  font-size: 0.8125rem;\n" +
    "  font-weight: 500;\n" +
