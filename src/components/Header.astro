  // Auth-dependent nav: resolve community status when logged in, short-circuit
  // to "anonymous" when not. /community/status already returns access + user,
  // so a separate /api/auth/session fetch is redundant — isLoggedIn is just
  // community.access !== 'anonymous'.
  deferWork(function() {
    var header = document.querySelector('.site-header');

    function applyState(community) {
      var isLoggedIn = community && community.ok && community.access && community.access !== 'anonymous';

      // Broadcast community status for Footer (must fire even for anonymous so
      // Footer's 3s fallback timer is cancelled — otherwise it self-fetches).
      window.dispatchEvent(new CustomEvent('rrm:community-status', { detail: community }));

      // STUC link: swap text for members
      if (community && community.ok && community.access === 'member') {
        var desktopLink = document.getElementById('stuc-nav-link');
        var mobileLink = document.getElementById('stuc-mobile-nav-link');
        if (desktopLink) {
          desktopLink.textContent = 'Save the Uterus Club';
          desktopLink.href = '/community/';
        }
        if (mobileLink) {
          var label = mobileLink.querySelector('.nav-label');
          if (label) label.textContent = 'Save the Uterus Club';
          mobileLink.href = '/community/';
        }
      }

      // Mobile account row: swap "Sign in" -> the user's profile (photo / initials + name).
      // Anonymous visitors keep the server-rendered "Sign in" state (no work needed).
      var acctRow = document.getElementById('mobile-account-row');
      if (acctRow && isLoggedIn && community.user) {
        var uName = (community.user.name || 'My account').trim();
        var nameEl = document.getElementById('mobile-account-name');
        var subEl = document.getElementById('mobile-account-sub');
        var photoEl = document.getElementById('mobile-account-photo');
        var initialsEl = document.getElementById('mobile-account-initials');
        var personEl = acctRow.querySelector('.mobile-account__person');
        if (nameEl) nameEl.textContent = uName;
        if (subEl) subEl.textContent = 'View account';
        acctRow.classList.add('is-authed');
        var initials = uName.split(/\s+/).slice(0, 2).map(function(w) { return w.charAt(0); }).join('').toUpperCase() || 'U';
        var showInitials = function() {
          if (personEl) personEl.style.display = 'none';
          if (photoEl) photoEl.hidden = true;
          if (initialsEl) { initialsEl.textContent = initials; initialsEl.hidden = false; }
        };
        var avatarUrl = community.user.avatarUrl;
        if (avatarUrl && photoEl) {
          photoEl.onerror = showInitials; // photo 404 -> initials fallback
          photoEl.onload = function() {
            if (personEl) personEl.style.display = 'none';
            if (initialsEl) initialsEl.hidden = true;
            photoEl.hidden = false;
          };
          photoEl.src = avatarUrl;
        } else {
          showInitials();
        }
      }

      // Donate vs My Account: show one, hide the other
      var deskDonate = document.getElementById('desktop-donate-btn');
      var deskAccount = document.getElementById('desktop-account-btn');

      if (isLoggedIn) {
        if (deskDonate) deskDonate.style.display = 'none';
      } else {
        if (deskAccount) deskAccount.style.display = 'none';
      }

      // Reveal all auth-dependent elements
      if (header) header.classList.add('auth-resolved');
    }

    if (!hasAuthHint()) {
      // Fast path: no hint cookie => anonymous, no network call.
      applyState({ ok: true, access: 'anonymous' });
      return;
    }

    fetch('/api/community/status', { credentials: 'same-origin' })
      .then(function(r) { return r.json(); })
      .catch(function() { return { ok: false, access: 'anonymous' }; })
      .then(applyState);
  });

  // Saved articles badge (desktop + mobile)
  (function() {
    function setBadge(n) {
      var ids = ['saved-link', 'mobile-saved-link'];
      var countIds = ['saved-count', 'mobile-saved-count'];
      for (var i = 0; i < ids.length; i++) {
        var link = document.getElementById(ids[i]);
        var count = document.getElementById(countIds[i]);
        if (count) count.textContent = n;
        if (link) {
          if (n > 0) link.classList.add('has-items');
          else link.classList.remove('has-items');
        }
      }
    }

    // Instant: show badge from localStorage (no network, no delay)
    try {
      var saved = JSON.parse(localStorage.getItem('rrm_saved') || '[]');
      if (saved.length > 0) setBadge(saved.length);
    } catch(e) {}

    // Deferred: sync with server when idle. Anonymous fast path: no hint
    // cookie => no logged-in session => skip the /api/saved sync entirely.
    // /api/saved would 401 for anonymous anyway, so the only practical effect
    // is one fewer network request on the LCP critical path.
    deferWork(function() {
      if (!hasAuthHint()) return;
      var local = [];
      try { local = JSON.parse(localStorage.getItem('rrm_saved') || '[]'); } catch(e) {}
      if (local.length > 0) {
        fetch('/api/saved', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ articles: local })
        })
          .then(function(r) { return r.json(); })
          .then(function(result) {
            if (result.ok && result.articles) {
              var slugMap = {};
              local.forEach(function(a) { slugMap[a.slug] = a; });
              result.articles.forEach(function(a) { slugMap[a.slug] = a; });
              var merged = Object.values(slugMap);
              merged.sort(function(a, b) { return (b.savedAt || '').localeCompare(a.savedAt || ''); });
              localStorage.setItem('rrm_saved', JSON.stringify(merged));
              setBadge(merged.length);
            }
          }).catch(function() {});
      } else {
        fetch('/api/saved', { credentials: 'same-origin' })
          .then(function(r) { return r.json(); })
          .then(function(result) {
            if (result.ok && result.articles && result.articles.length > 0) {
              localStorage.setItem('rrm_saved', JSON.stringify(result.articles));
              setBadge(result.articles.length);
            }
          }).catch(function() {});
      }
    });
  })();

</script>
