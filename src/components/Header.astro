  // Theme toggle with expanding circle animation (View Transitions API)
  function applyTheme() {
    var html = document.documentElement;
    var current = html.getAttribute('data-theme');
    var next = current === 'dark' ? 'light' : 'dark';
    html.setAttribute('data-theme', next);
    localStorage.setItem('rrm_theme', next);
    // GA4 theme_toggle via the global bridge (track-auto.ts).
    try { if (window.__rrmTrack__) window.__rrmTrack__('theme_toggle', { to: next }); } catch (e) {}
  }

