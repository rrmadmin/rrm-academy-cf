#!/bin/sh
# Pre-commit hook: runs security guard on critical file changes,
# and iOS auto-zoom guard on any staged .astro/.css change.
# Install: npm run guard:install
# Bypass: git commit --no-verify

CRITICAL_FILES="
functions/api/auth/_shared.js
functions/api/auth/login.js
functions/api/auth/signup.js
functions/api/auth/google-callback.js
functions/api/stripe-webhook.js
functions/api/create-checkout.js
functions/api/billing/status.js
functions/api/billing/portal.js
functions/_middleware.js
wrangler.toml
scripts/guard.mjs
guard-manifest.json
"

STAGED=$(git diff --cached --name-only)

# --- CSS token guard: any staged .astro/.css/.js style surface ---
# Blocks undefined-var criticals (var(--x) that resolves nowhere -- the
# white-cards-in-dark-mode bug class). Zero verified false positives.
# Full category ratchet runs in CI (deploy.yml css drift gate).
# Bypass: CSS_AUDIT_DISABLE=1 or --no-verify
if echo "$STAGED" | grep -qE '^(src/.*\.(astro|css)|functions/.*\.js)$'; then
  node scripts/css-audit/audit.mjs --gate-critical
  if [ $? -ne 0 ]; then
    echo ""
    echo "Commit blocked by css-audit guard (broken design-token reference)."
    echo "Fix the var() reference shown above, or bypass with --no-verify."
    exit 1
  fi
fi

# --- iOS auto-zoom guard: any staged .astro or .css file under src/ ---
if echo "$STAGED" | grep -qE '^src/.*\.(astro|css)$'; then
  node scripts/guard-ios-zoom.mjs
  if [ $? -ne 0 ]; then
    echo ""
    echo "Commit blocked by iOS auto-zoom guard."
    echo "Fix sub-16px font-size on form controls, or bypass with --no-verify."
    exit 1
  fi
fi

# --- Agent discovery guard: any staged .well-known/ or agent-readiness file ---
if echo "$STAGED" | grep -qE '^public/(\.well-known/|agents\.md|llms(-full)?\.txt|openapi\.json)'; then
  node scripts/agent-discovery-check.mjs
  if [ $? -ne 0 ]; then
    echo ""
    echo "Commit blocked by agent-discovery guard."
    echo "If a SKILL.md changed: run 'npm run guard:agent-skills:regen' to refresh digests."
    echo "Otherwise fix the drift the guard reported, or bypass with --no-verify."
    exit 1
  fi
fi

# --- Library count drift guard: any staged static-override / agent-surface file ---
if echo "$STAGED" | grep -qE '^(static-overrides/|ssot/(agent-surfaces|site)\.json$|public/(agents\.md|index\.md|pricing\.md|llms(-full)?\.txt|openapi\.json|\.well-known/))'; then
  node scripts/sync-library-count.mjs --check
  if [ $? -ne 0 ]; then
    echo ""
    echo "Commit blocked by library-count drift guard."
    echo "Run 'node scripts/sync-library-count.mjs' to regenerate, or bypass if intentional with --no-verify."
    exit 1
  fi
fi

# --- Glossary spoke pipeline gates: any staged GlossaryTerm component or glossary route ---
if echo "$STAGED" | grep -qE '^src/components/GlossaryTerm\.astro$|^src/pages/glossary/.*\.astro$'; then
  node scripts/gates/validate-glossary-pipeline.mjs --quick
  if [ $? -ne 0 ]; then
    echo ""
    echo "Commit blocked by glossary spoke pipeline gates."
    echo "Status filter, render path, rewriter coverage, heading levels, or schema @ids drifted."
    echo "Fix the failures above, or bypass with --no-verify."
    exit 1
  fi
fi

# --- Pillar registry gate: any staged ssot/guides.json or consumer file ---
if echo "$STAGED" | grep -qE '^ssot/guides\.json$|^src/pages/guides/index\.astro$|^src/integrations/library-sitemaps\.mjs$|^src/components/AppShellChrome\.astro$|^src/layouts/BaseLayout\.astro$|^scripts/build-guides-data\.mjs$|^scripts/build-og-index\.mjs$|^scripts/gates/validate-guides-registry\.mjs$'; then
  node scripts/gates/validate-guides-registry.mjs
  if [ $? -ne 0 ]; then
    echo ""
    echo "Commit blocked by pillar registry gate."
    echo "ssot/guides.json integrity, consumer derivation, or no-hardcoded-bypass drifted."
    echo "Fix the failures above, or bypass with --no-verify."
    exit 1
  fi
fi

# --- Analytics pipeline gates: any staged track endpoint, allowlist, ga4-source, csp, or client helper ---
if echo "$STAGED" | grep -qE '^functions/api/track\.js$|^functions/api/_track-events\.js$|^functions/api/_ga4-source\.js$|^functions/_middleware\.js$|^src/scripts/track(-auto)?\.ts$|^scripts/gates/validate-analytics-pipeline\.mjs$'; then
  node scripts/gates/validate-analytics-pipeline.mjs --quick
  if [ $? -ne 0 ]; then
    echo ""
    echo "Commit blocked by analytics pipeline gates."
    echo "Endpoint contract, allowlist, server/client event separation, PII regex, CSP lockdown, or helper exclusivity drifted."
    echo "Fix the failures above, or bypass with --no-verify."
    exit 1
  fi
fi

# --- Payment pipeline gates: any staged stripe-webhook, create-checkout, or billing/* ---
if echo "$STAGED" | grep -qE '^functions/api/(stripe-webhook|create-checkout)\.js$|^functions/api/billing/.*\.js$|^scripts/gates/validate-payment-pipeline\.mjs$'; then
  node scripts/gates/validate-payment-pipeline.mjs
  if [ $? -ne 0 ]; then
    echo ""
    echo "Commit blocked by payment pipeline gates."
    echo "Webhook signature/dedup, err.message leak, enrollment revocation discipline, or atomicity drifted."
    echo "Fix the failures above, or bypass with --no-verify."
    exit 1
  fi
fi

# --- Courses schema drift gate: staged course migration, course admin endpoint, or the gate script ---
#     CS1 (static, --quick): the migration's CHECK value-sets must equal the
#     admin endpoints' VALID_ACCESS_TYPES / VALID_STATUSES / VALID_TYPES Sets.
#     Catches the access_type='members' class (migration lags the app code).
if echo "$STAGED" | grep -qE '^scripts/migrate-courses-to-d1\.sql$|^functions/api/admin/courses/.*\.js$|^scripts/gates/validate-courses-schema\.mjs$'; then
  node scripts/gates/validate-courses-schema.mjs --quick
  if [ $? -ne 0 ]; then
    echo ""
    echo "Commit blocked by courses schema drift gate (CS1)."
    echo "The course migration CHECK constraints no longer match the admin endpoints' VALID_* Sets."
    echo "Update scripts/migrate-courses-to-d1.sql to match, or bypass with --no-verify."
    exit 1
  fi
fi

# --- Share button gates: any staged change to ArticleHero or the slug page ---
#     SB1: navigator.share is primary branch. SB2: .catch() on writeText.
#     SB3: aria-label="Share". SB4: .action-label visible in .copied state.
if echo "$STAGED" | grep -qE '^src/components/ArticleHero\.astro$|^src/pages/library/\[\.\.\.slug\]\.astro$|^scripts/gates/validate-share-button\.mjs$'; then
  node scripts/gates/validate-share-button.mjs
  if [ $? -ne 0 ]; then
    echo ""
    echo "Commit blocked by share button gates."
    echo "navigator.share primary path, .catch() on clipboard, aria-label, or .copied CSS drifted."
    echo "Fix the failures above, or bypass with --no-verify."
    exit 1
  fi
fi

# --- Removed-ID consumer-mismatch gate: any staged change to a shared
#     component or layout that removes an id="X" still referenced by JS in
#     src/, functions/, or public/. Closes the "remove an id, downstream
#     getElementById quietly breaks" class of bug.
if echo "$STAGED" | grep -qE '^src/(components|layouts)/.*\.astro$'; then
  node scripts/gates/check-removed-ids.mjs
  if [ $? -ne 0 ]; then
    echo ""
    echo "Commit blocked by removed-ID consumer-mismatch gate."
    echo "Update or remove the consumer references before removing the id,"
    echo "or bypass if intentional with --no-verify."
    exit 1
  fi
fi

# --- Security guard: only on critical file changes ---
TRIGGER=0
for file in $CRITICAL_FILES; do
  case "$STAGED" in
    *"$file"*) TRIGGER=1; break ;;
  esac
done

if [ "$TRIGGER" = "0" ]; then
  exit 0
fi

echo "Security guard: critical file change detected, running checks..."
node scripts/guard.mjs

if [ $? -ne 0 ]; then
  echo ""
  echo "Commit blocked. Fix issues or run 'npm run guard:update' after intentional changes."
  echo "Emergency bypass: git commit --no-verify"
  exit 1
fi
