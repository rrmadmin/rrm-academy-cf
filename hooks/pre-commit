#!/bin/sh
# Pre-commit hook: runs security guard on critical file changes,
# and iOS auto-zoom guard on any staged .astro/.css change.
# Install: npm run guard:install
# Bypass: git commit --no-verify

CRITICAL_FILES="
functions/api/auth/_shared.js
functions/api/auth/login.js
functions/api/auth/signup.js
functions/api/auth/google-callback.js
functions/api/stripe-webhook.js
functions/api/create-checkout.js
functions/api/billing/status.js
functions/api/billing/portal.js
functions/_middleware.js
functions/api/_ga4.js
functions/api/_ga4-source.js
wrangler.toml
scripts/guard.mjs
guard-manifest.json
"

STAGED=$(git diff --cached --name-only)

# --- node_modules guard: refuse a staged path named node_modules ---
#     .gitignore's `node_modules/` entry has a trailing slash, so it matches a real
#     DIRECTORY and never a SYMLINK of that name. A `git add -A` sweeps the link in
#     as a 120000 blob. It has reached this repo's main twice (bfff4ab7, 0d98895e),
#     the second time as a link pointing at its own path, which destroys the local
#     dependency tree (ELOOP on every import). CI is green both times because CI
#     runs `npm ci` into a clean workspace, so nothing else catches it -- the merge
#     job and every fresh clone break instead.
#     --diff-filter=AM so the recovery commit (`git rm --cached node_modules`) is
#     never itself blocked. Bypass: ALLOW_NODE_MODULES_COMMIT=1
if [ -z "${ALLOW_NODE_MODULES_COMMIT:-}" ]; then
  NM_STAGED=$(git diff --cached --name-only --diff-filter=AM | awk -F/ '$NF == "node_modules"')
  if [ -n "$NM_STAGED" ]; then
    echo ""
    echo "Commit blocked: a path named node_modules is staged."
    echo "$NM_STAGED" | sed 's/^/  /'
    echo ""
    echo "This is almost always a symlink swept in by 'git add -A'; .gitignore does not catch it."
    echo "Unstage it with:  git rm --cached <path>"
    echo "Deliberate?       ALLOW_NODE_MODULES_COMMIT=1 git commit ..."
    exit 1
  fi
fi

# --- CSS token guard: any staged .astro/.css/.js style surface ---
# Blocks undefined-var criticals (var(--x) that resolves nowhere -- the
# white-cards-in-dark-mode bug class). Zero verified false positives.
# Full category ratchet runs in CI (deploy.yml css drift gate).
# Bypass: CSS_AUDIT_DISABLE=1 or --no-verify
if echo "$STAGED" | grep -qE '^(src/.*\.(astro|css)|functions/.*\.js)$'; then
  node scripts/css-audit/audit.mjs --gate-critical
  if [ $? -ne 0 ]; then
    echo ""
    echo "Commit blocked by css-audit guard (broken design-token reference)."
    echo "Fix the var() reference shown above, or bypass with --no-verify."
    exit 1
  fi
fi

# --- iOS auto-zoom guard: any staged .astro or .css file under src/ ---
if echo "$STAGED" | grep -qE '^src/.*\.(astro|css)$'; then
  node scripts/guard-ios-zoom.mjs
  if [ $? -ne 0 ]; then
    echo ""
    echo "Commit blocked by iOS auto-zoom guard."
    echo "Fix sub-16px font-size on form controls, or bypass with --no-verify."
    exit 1
  fi
fi

# --- Agent discovery guard: any staged .well-known/ or agent-readiness file ---
if echo "$STAGED" | grep -qE '^public/(\.well-known/|agents\.md|llms(-full)?\.txt|openapi\.json)'; then
  node scripts/agent-discovery-check.mjs
  if [ $? -ne 0 ]; then
    echo ""
    echo "Commit blocked by agent-discovery guard."
    echo "If a SKILL.md changed: run 'npm run guard:agent-skills:regen' to refresh digests."
    echo "Otherwise fix the drift the guard reported, or bypass with --no-verify."
    exit 1
  fi
fi

# --- Library count drift guard: any staged static-override / agent-surface file ---
if echo "$STAGED" | grep -qE '^(static-overrides/|ssot/(agent-surfaces|site)\.json$|public/(agents\.md|index\.md|pricing\.md|llms(-full)?\.txt|openapi\.json|\.well-known/))'; then
  node scripts/sync-library-count.mjs --check
  if [ $? -ne 0 ]; then
    echo ""
    echo "Commit blocked by library-count drift guard."
    echo "Run 'node scripts/sync-library-count.mjs' to regenerate, or bypass if intentional with --no-verify."
    exit 1
  fi
fi

# --- Glossary spoke pipeline gates: any staged GlossaryTerm component or glossary route ---
if echo "$STAGED" | grep -qE '^src/components/GlossaryTerm\.astro$|^src/pages/glossary/.*\.astro$'; then
  node scripts/gates/validate-glossary-pipeline.mjs --quick
  if [ $? -ne 0 ]; then
    echo ""
    echo "Commit blocked by glossary spoke pipeline gates."
    echo "Status filter, render path, rewriter coverage, heading levels, or schema @ids drifted."
    echo "Fix the failures above, or bypass with --no-verify."
    exit 1
  fi
fi

# --- Pillar registry gate: any staged ssot/guides.json or consumer file ---
if echo "$STAGED" | grep -qE '^ssot/guides\.json$|^src/pages/guides/index\.astro$|^src/integrations/library-sitemaps\.mjs$|^src/components/AppShellChrome\.astro$|^src/layouts/BaseLayout\.astro$|^scripts/build-guides-data\.mjs$|^scripts/build-og-index\.mjs$|^scripts/gates/validate-guides-registry\.mjs$'; then
  node scripts/gates/validate-guides-registry.mjs
  if [ $? -ne 0 ]; then
    echo ""
    echo "Commit blocked by pillar registry gate."
    echo "ssot/guides.json integrity, consumer derivation, or no-hardcoded-bypass drifted."
    echo "Fix the failures above, or bypass with --no-verify."
    exit 1
  fi
fi

# --- Analytics pipeline gates: any staged track endpoint, allowlist, ga4-source, csp, or client helper ---
if echo "$STAGED" | grep -qE '^functions/api/track\.js$|^functions/api/_track-events\.js$|^functions/api/_ga4-source\.js$|^functions/_middleware\.js$|^src/scripts/track(-auto)?\.ts$|^scripts/gates/validate-analytics-pipeline\.mjs$'; then
  node scripts/gates/validate-analytics-pipeline.mjs --quick
  if [ $? -ne 0 ]; then
    echo ""
    echo "Commit blocked by analytics pipeline gates."
    echo "Endpoint contract, allowlist, server/client event separation, PII regex, CSP lockdown, or helper exclusivity drifted."
    echo "Fix the failures above, or bypass with --no-verify."
    exit 1
  fi
fi

# --- Payment pipeline gates: any staged stripe-webhook, create-checkout, or billing/* ---
if echo "$STAGED" | grep -qE '^functions/api/(stripe-webhook|create-checkout)\.js$|^functions/api/billing/.*\.js$|^scripts/gates/validate-payment-pipeline\.mjs$'; then
  node scripts/gates/validate-payment-pipeline.mjs
  if [ $? -ne 0 ]; then
    echo ""
    echo "Commit blocked by payment pipeline gates."
    echo "Webhook signature/dedup, err.message leak, enrollment revocation discipline, or atomicity drifted."
    echo "Fix the failures above, or bypass with --no-verify."
    exit 1
  fi
fi

# --- Courses schema drift gate: staged course migration, course admin endpoint, or the gate script ---
#     CS1 (static, --quick): the migration's CHECK value-sets must equal the
#     admin endpoints' VALID_ACCESS_TYPES / VALID_STATUSES / VALID_TYPES Sets.
#     Catches the access_type='members' class (migration lags the app code).
if echo "$STAGED" | grep -qE '^scripts/migrate-courses-to-d1\.sql$|^functions/api/admin/courses/.*\.js$|^scripts/gates/validate-courses-schema\.mjs$'; then
  node scripts/gates/validate-courses-schema.mjs --quick
  if [ $? -ne 0 ]; then
    echo ""
    echo "Commit blocked by courses schema drift gate (CS1)."
    echo "The course migration CHECK constraints no longer match the admin endpoints' VALID_* Sets."
    echo "Update scripts/migrate-courses-to-d1.sql to match, or bypass with --no-verify."
    exit 1
  fi
fi

# --- SQL column/table existence gate: any staged JS that can hold SQL ---
#     Every static SQL string is PREPAREd against an in-memory SQLite built from
#     schema.sql + the replayed migrations. SQLite resolves column names at
#     prepare time, so a statement naming a column that does not exist is a hard
#     throw on every call -- exactly the admin course DELETE 500 (step_progress
#     has no `id`). Runs the FULL scan: it is in-memory and takes ~0.3s.
if echo "$STAGED" | grep -qE '^(functions/.*\.(js|mjs)|scripts/.*\.(js|mjs)|src/lib/.*\.(js|mjs)|schema\.sql|scripts/migrations/.*\.sql|migrations/.*\.sql)$'; then
  node scripts/gates/validate-sql-columns.mjs
  if [ $? -ne 0 ]; then
    echo ""
    echo "Commit blocked by SQL column/table existence gate."
    echo "A static SQL string names a column or table that does not exist -- it will throw at PREPARE on every call."
    echo "Fix the identifier above, or bypass with --no-verify."
    exit 1
  fi
fi

# --- Share button gates: any staged change to ArticleHero or the slug page ---
#     SB1: navigator.share is primary branch. SB2: .catch() on writeText.
#     SB3: aria-label="Share". SB4: .action-label visible in .copied state.
if echo "$STAGED" | grep -qE '^src/components/ArticleHero\.astro$|^src/pages/library/\[\.\.\.slug\]\.astro$|^scripts/gates/validate-share-button\.mjs$'; then
  node scripts/gates/validate-share-button.mjs
  if [ $? -ne 0 ]; then
    echo ""
    echo "Commit blocked by share button gates."
    echo "navigator.share primary path, .catch() on clipboard, aria-label, or .copied CSS drifted."
    echo "Fix the failures above, or bypass with --no-verify."
    exit 1
  fi
fi

# --- Removed-ID consumer-mismatch gate: any staged change to a shared
#     component or layout that removes an id="X" still referenced by JS in
#     src/, functions/, or public/. Closes the "remove an id, downstream
#     getElementById quietly breaks" class of bug.
if echo "$STAGED" | grep -qE '^src/(components|layouts)/.*\.astro$'; then
  node scripts/gates/check-removed-ids.mjs
  if [ $? -ne 0 ]; then
    echo ""
    echo "Commit blocked by removed-ID consumer-mismatch gate."
    echo "Update or remove the consumer references before removing the id,"
    echo "or bypass if intentional with --no-verify."
    exit 1
  fi
fi

# --- Magic-link email verification gate: any staged change to a verification
#     email sender or the verify-email handler. The link token must be the full
#     64-hex generateToken() (validated by token alone, no session), the GET
#     confirm entry point must exist, and the token must be consumed single-use.
if echo "$STAGED" | grep -qE '^functions/api/auth/(signup|resend-verification|verify-email)\.js$|^scripts/gates/validate-email-verification\.mjs$'; then
  node scripts/gates/validate-email-verification.mjs
  if [ $? -ne 0 ]; then
    echo ""
    echo "Commit blocked by magic-link email verification gate."
    echo "The link token must be the full generateToken(), GET must exist, token consumed once."
    echo "Fix the invariant above, or bypass with --no-verify."
    exit 1
  fi
fi

# --- Email trickle gate: any staged change to the community email broadcast path ---
#     STUC member-roster broadcasts (notifyNewPost) must be PACED via
#     sendBroadcastTrickle (batched + inter-batch delay), never a bare
#     Promise.all/allSettled blast over the roster. Guards SES send-rate + deliverability.
if echo "$STAGED" | grep -qE '^functions/api/community/_email\.js$|^scripts/gates/validate-email-trickle\.mjs$'; then
  node scripts/gates/validate-email-trickle.mjs
  if [ $? -ne 0 ]; then
    echo ""
    echo "Commit blocked by email trickle gate."
    echo "STUC member broadcasts must go through sendBroadcastTrickle (batched + delayed), not a Promise.all blast."
    echo "Fix the failure above, or bypass with --no-verify."
    exit 1
  fi
fi

# --- Infographic SVG well-formedness gate: any staged infographic file ---
if git diff --cached --name-only | grep -qE 'src/lib/infographic/|scripts/infographic-render\.mjs|scripts/gates/validate-infographic-svg\.mjs'; then
  node scripts/gates/validate-infographic-svg.mjs || { echo "infographic SVG gate failed"; exit 1; }
fi

# --- House lint chain (tools repo): runs on EVERY commit, before the
#     security-guard early-exit below. Each gate blocks only on its BLOCK tier.
# Negation-reframe AI tic. Enforces memory feedback-no-negation-reframe-tic.
# Bypass: --no-verify   Disable: LINT_NEGREFRAME_DISABLE=1
if [ -x ~/iCode/tools/lint-negation-reframe/precommit.sh ]; then
  ~/iCode/tools/lint-negation-reframe/precommit.sh || exit $?
fi

# Canonical entity names (IIRRM/STORRM/CRRM-LLC/NaProTechnology).
# Enforces memory feedback-canonical-names-and-stats.
# Bypass: --no-verify   Disable: LINT_CANONICAL_DISABLE=1
if [ -x ~/iCode/tools/lint-canonical-names/precommit.sh ]; then
  ~/iCode/tools/lint-canonical-names/precommit.sh || exit $?
fi

# --- Abstract-snippet leak guard: staged ArticleCard or the shared stripper ---
# Snippets must not leak structured-abstract labels. Runs against committed
# src/data/articles.json. Bypass: --no-verify
if echo "$STAGED" | grep -qE '^src/components/ArticleCard\.astro$|^src/lib/abstract-snippet\.mjs$|^scripts/gates/validate-abstract-snippets\.mjs$'; then
  node scripts/gates/validate-abstract-snippets.mjs || {
    echo "Commit blocked by abstract-snippet leak guard (a section label survives in a snippet)."
    exit 1
  }
fi

# --- Post-body Markdown guard: staged posts.json ---
# Commentary bodies must be Markdown, never block HTML (2026-07-10 burn).
if echo "$STAGED" | grep -qE '^src/data/posts\.json$|^scripts/gates/validate-post-markdown\.mjs$'; then
  node scripts/gates/validate-post-markdown.mjs || {
    echo "Commit blocked by post-markdown guard (a post body contains block HTML)."
    exit 1
  }
fi

# --- Unfinished-state copy guard: any staged page/component ---
# No accidental "actively edited"/"Owner TBC"/lorem/visible TODO/stale Soon pill.
# "Coming Soon" is allowed. Allowlist: scripts/gates/unfinished-copy-allowlist.txt
if echo "$STAGED" | grep -qE '^src/(pages|components)/.*\.astro$|^scripts/gates/(validate-no-unfinished-copy\.mjs|unfinished-copy-allowlist\.txt)$'; then
  node scripts/gates/validate-no-unfinished-copy.mjs || {
    echo "Commit blocked by unfinished-copy guard (status-confession/placeholder in shipped markup)."
    exit 1
  }
fi

# --- Security guard: only on critical file changes ---
TRIGGER=0
for file in $CRITICAL_FILES; do
  case "$STAGED" in
    *"$file"*) TRIGGER=1; break ;;
  esac
done

if [ "$TRIGGER" = "0" ]; then
  exit 0
fi

echo "Security guard: critical file change detected, running checks..."
node scripts/guard.mjs

if [ $? -ne 0 ]; then
  echo ""
  echo "Commit blocked. Fix issues or run 'npm run guard:update' after intentional changes."
  echo "Emergency bypass: git commit --no-verify"
  exit 1
fi
