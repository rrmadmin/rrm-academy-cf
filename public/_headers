# Cache static assets for 1 year (hashed filenames)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Cache all static images for 1 year. Filenames are unhashed, so when content
# changes, bump a query-string version on the consuming <img src> (?v=2, ?v=3)
# per CLAUDE.md "Rules". A 1y TTL is safe under that discipline and reclaims
# the PSI "Use efficient cache lifetimes" insight (was 7d).
# Covers /images/og/, /images/authors/, /images/course-covers/, journal-logos, etc.
/images/*
  Cache-Control: public, max-age=31536000

# Pagefind: no-store prevents browsers from caching fragments across deploys.
# CF Pages returns 200 (not 404) for missing files, so no-cache + revalidation
# causes browsers to cache HTML 404 pages as valid fragment data after deploys.
# Fragments are small (~2-5KB) and only loaded on search, so no-store is fine.
/pagefind/*
  Cache-Control: no-store

# API endpoints — no caching, lock CORS to production origin
/api/*
  Cache-Control: no-store
  Access-Control-Allow-Origin: https://rrmacademy.org

# ==============================================
# Agent discovery — RFC 8288 Link headers
# sitemap-index, llms.txt (describedby), openapi (service-desc), and api-catalog
# are emitted on every HTML response by functions/_middleware.js. This block adds
# only the homepage-specific extras (library feed, llms-full.txt, markdown twins)
# to avoid duplicate Link headers on the homepage.
# ==============================================

/
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400
  No-Vary-Search: params, except=("q" "topic" "page" "sort")
  Link: </library-feed.jsonl>; rel="alternate"; type="application/x-ndjson"; title="Library Feed (JSONL)"
  Link: </llms-full.txt>; rel="describedby"; type="text/plain"; title="llms-full.txt"
  Link: </index.md>; rel="alternate"; type="text/markdown"; title="Markdown"
  Link: </pricing.md>; rel="alternate"; type="text/markdown"; title="Pricing"

# Machine-readable agent files — correct content types
/llms.txt
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Content-Type: text/plain; charset=utf-8

/library/llms.txt
  Content-Type: text/plain; charset=utf-8

/courses/llms.txt
  Content-Type: text/plain; charset=utf-8

/faqs/llms.txt
  Content-Type: text/plain; charset=utf-8

/library-feed.jsonl
  Content-Type: application/x-ndjson; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=3600

/pricing.md
  Content-Type: text/markdown; charset=utf-8

/index.md
  Content-Type: text/markdown; charset=utf-8

# Per-page Markdown source twins (agent-readiness). Static endpoints emit
# /commentary/<slug>.md, /faqs/<slug>.md, and /glossary.md; CF Pages does not
# preserve a prerendered endpoint's Response Content-Type, so set it here.
/commentary/*.md
  Content-Type: text/markdown; charset=utf-8

/faqs/*.md
  Content-Type: text/markdown; charset=utf-8

/glossary.md
  Content-Type: text/markdown; charset=utf-8

